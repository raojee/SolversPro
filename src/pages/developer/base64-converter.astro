---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Base64 Encoder and Decoder",
  "url": "https://solverspro.com/developer/base64-converter/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online Base64 encoder and decoder to securely convert UTF-8 text to Base64 and decode Base64 strings locally in your browser with zero server uploads.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="Base64 Encoder & Decoder | SolversPro"
  description="Base64 encoder and decoder to convert ASCII and UTF-8 strings to Base64 format and back. Fast client-side encoding with zero server uploads."
  canonical="https://solverspro.com/developer/base64-converter/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Developer Tools', href: '/developer' },
      { label: 'Base64 Converter' },
    ]} />
    <div class="mb-10 mt-4">
      <h1 class="text-4xl font-bold text-white mb-4">Base64 Encoder & Decoder</h1>
      <p class="text-zinc-400 text-lg max-w-2xl">
        The SolversPro Base64 Encoder & Decoder is a free browser-based developer utility that converts plain text or binary data into Base64 format and decodes Base64 strings client-side with zero server uploads.
      </p>
    </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full h-full min-h-[500px]">
        {/* Encoder Side */}
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Text to Encode</h2>
            <button id="btn-encode" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Encode to Base64 &rarr;</button>
          </div>
          <textarea
            id="input-text"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[300px]"
            placeholder="Enter text to encode..."
            spellcheck="false"
          ></textarea>
        </div>

        {/* Decoder Side */}
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <button id="btn-decode" class="px-3 py-1.5 text-xs font-semibold bg-[#ff6b35]/20 hover:bg-[#ff6b35]/30 text-[#ff6b35] rounded transition-colors border border-[#ff6b35]/30">&larr; Decode to Text</button>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Base64 String</h2>
          </div>
          <textarea
            id="input-base64"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[300px]"
            placeholder="Enter Base64 string to decode..."
            spellcheck="false"
          ></textarea>
        </div>
      </div>

      <div class="mt-6 flex justify-center">
        <SaveResultButton id="save-base64-btn" />
      </div>

      <!-- Citable Content: Base64 Character Set Specification -->
      <div class="mt-16 w-full max-w-4xl mx-auto">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-white mb-2">Base64 Character Encoding Specifications (RFC 4648)</h2>
          <p class="text-zinc-400 text-sm">
            6-bit radix-64 representation mapping 64 printable ASCII characters for safe binary transport.
          </p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-white/[0.08] bg-white/[0.02]">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-white/[0.08] bg-white/[0.04] text-zinc-300 font-semibold">
                <th class="py-3 px-4">Binary Range (6-Bit)</th>
                <th class="py-3 px-4">Decimal Index</th>
                <th class="py-3 px-4">Base64 Character Set</th>
                <th class="py-3 px-4">Encoding Purpose & Behavior</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06] text-zinc-400">
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">000000 – 011001</td>
                <td class="py-3 px-4">0 – 25</td>
                <td class="py-3 px-4 font-mono text-zinc-300">A – Z</td>
                <td class="py-3 px-4">Uppercase English alphabet representations</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">011010 – 110011</td>
                <td class="py-3 px-4">26 – 51</td>
                <td class="py-3 px-4 font-mono text-zinc-300">a – z</td>
                <td class="py-3 px-4">Lowercase English alphabet representations</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">110100 – 111101</td>
                <td class="py-3 px-4">52 – 61</td>
                <td class="py-3 px-4 font-mono text-zinc-300">0 – 9</td>
                <td class="py-3 px-4">Numeric digits 0 through 9</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">111110 &amp; 111111</td>
                <td class="py-3 px-4">62 &amp; 63</td>
                <td class="py-3 px-4 font-mono text-zinc-300">+ and /</td>
                <td class="py-3 px-4">Standard Base64 symbols (replaced with - and _ in URL-safe Base64)</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">Pad Indicator</td>
                <td class="py-3 px-4">N/A</td>
                <td class="py-3 px-4 font-mono text-zinc-300">=</td>
                <td class="py-3 px-4">Trailing padding applied when input byte count is not divisible by 3</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <ToolFAQ faqs={[
        { question: "What is Base64 encoding used for?", answer: "Base64 is used to encode binary data into a text-based format. Developers commonly use it to embed images in CSS/HTML or to pass data safely in URLs and JSON payloads." },
        { question: "Is this Base64 converter secure?", answer: "Yes! All encoding and decoding operations happen locally via your browser's native JavaScript APIs. We never send your text or data over the network." },
        { question: "Does this tool support UTF-8 characters?", answer: "Yes, our converter automatically handles UTF-8 encoding so you can safely convert text containing emojis and special characters to Base64." }
      ]} />

      <ToolShare title="Base64 Encoder & Decoder" url="https://solverspro.com/developer/base64-converter" />
      <SimilarTools category="developer" currentPath="/developer/base64-converter" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const textInput = document.getElementById('input-text') as HTMLTextAreaElement;
  const base64Input = document.getElementById('input-base64') as HTMLTextAreaElement;
  
  document.getElementById('btn-encode')?.addEventListener('click', () => {
    try {
      // Encode as UTF-8 then to base64
      const text = textInput.value;
      const utf8Bytes = new TextEncoder().encode(text);
      let binaryString = '';
      for (let i = 0; i < utf8Bytes.length; i++) {
        binaryString += String.fromCharCode(utf8Bytes[i]);
      }
      base64Input.value = btoa(binaryString);
      base64Input.classList.add('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]');
      setTimeout(() => base64Input.classList.remove('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]'), 500);
      showSaveBtn();
    } catch (e) {
      window.showToast?.('Error encoding text — ensure the input is valid UTF-8.', 'error');
    }
  });

  document.getElementById('btn-decode')?.addEventListener('click', () => {
    try {
      const base64 = base64Input.value.trim();
      if (!base64) return;
      const binaryString = atob(base64);
      const bytes = new Uint8Array(binaryString.length);
      for (let i = 0; i < binaryString.length; i++) {
        bytes[i] = binaryString.charCodeAt(i);
      }
      textInput.value = new TextDecoder('utf-8').decode(bytes);
      textInput.classList.add('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]');
      setTimeout(() => textInput.classList.remove('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]'), 500);
      showSaveBtn();
    } catch (e) {
      window.showToast?.('Invalid Base64 string — check your input and try again.', 'error');
    }
  });

  function showSaveBtn() {
    const saveBtn = document.getElementById('save-base64-btn');
    if (saveBtn) {
      saveBtn.classList.remove('hidden');
      saveBtn.onclick = () => {
        if (typeof window.saveToDashboard === 'function') {
          const success = window.saveToDashboard('Base64 Converter', '/developer/base64-converter', {
            type: 'key-value',
            data: {
              'Text': textInput.value.length > 50 ? textInput.value.substring(0, 50) + '...' : textInput.value,
              'Base64': base64Input.value.length > 50 ? base64Input.value.substring(0, 50) + '...' : base64Input.value
            }
          });
          if (success) {
            const textEl = saveBtn.querySelector('.btn-text');
            const iconSave = saveBtn.querySelector('.icon-save');
            const iconCheck = saveBtn.querySelector('.icon-check');
            if (textEl) textEl.textContent = 'Saved!';
            if (iconSave) iconSave.classList.add('hidden');
            if (iconCheck) iconCheck.classList.remove('hidden');
            saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
            saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
            setTimeout(() => {
              if (textEl) textEl.textContent = 'Save Result';
              if (iconSave) iconSave.classList.remove('hidden');
              if (iconCheck) iconCheck.classList.add('hidden');
              saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
            }, 2000);
          }
        }
      };
    }
  }
</script>
