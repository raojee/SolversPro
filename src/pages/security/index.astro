---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const tools = [
  {
    title: 'Random Password Generator',
    description: 'Generate cryptographically secure passwords with custom length, character sets, and strength indicator.',
    icon: '🔐',
    href: '/security/password-generator'
  },
];
---
<BaseLayout
  title="Security Tools | SolversPro"
  description="Free online security tools. Generate strong random passwords, check password strength, and more. 100% private — runs in your browser."
>
  <Header />
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Security Tools' }]} />
    <div class="mb-12 mt-4">
      <h1 class="text-4xl font-bold text-white mb-4">Security Tools</h1>
      <p class="text-zinc-400 text-lg max-w-2xl">Privacy-first security utilities that run entirely in your browser. No data is ever sent to our servers.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {tools.map(tool => <ToolCard {...tool} />)}
    </div>
  </div>
  <Footer />
</BaseLayout>
