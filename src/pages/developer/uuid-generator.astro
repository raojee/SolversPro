---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "UUID v4 Generator",
  "url": "https://solverspro.com/developer/uuid-generator/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online UUID v4 generator to create cryptographically secure, random 128-bit UUID/GUID identifiers locally in your browser with zero server uploads.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="UUID v4 Generator | SolversPro"
  description="UUID v4 generator to create cryptographically secure, random 128-bit UUID/GUID identifiers. Bulk generate up to 100 UUIDs locally with zero server uploads."
  canonical="https://solverspro.com/developer/uuid-generator/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'UUID Generator' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🆔 UUID v4 Generator</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro UUID v4 Generator is a free browser-based developer utility that generates cryptographically secure, random 128-bit UUID (Universally Unique Identifier) strings client-side with zero server uploads.
        </p>
      </div>

      <!-- Controls -->
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 mb-6">
        <div class="flex flex-wrap items-end gap-4">
          <div class="flex-1 min-w-[120px]">
            <label class="text-sm font-semibold uppercase tracking-wider text-zinc-400 block mb-2">Quantity</label>
            <input id="uuid-count" type="number" min="1" max="100" value="1"
              class="w-full p-3 bg-[#1a1a24] border border-white/[0.06] rounded-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none text-zinc-300 font-mono text-sm" />
          </div>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer">
              <input id="uuid-uppercase" type="checkbox" class="accent-[#2dd4bf] w-4 h-4" />
              <span class="text-sm text-zinc-400">Uppercase</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input id="uuid-hyphens" type="checkbox" checked class="accent-[#2dd4bf] w-4 h-4" />
              <span class="text-sm text-zinc-400">Hyphens</span>
            </label>
          </div>
          <button id="btn-generate" class="px-6 py-3 bg-[#2dd4bf] hover:bg-[#5eead4] text-black rounded-xl font-bold transition-all cursor-pointer">
            Generate
          </button>
        </div>
      </div>

      <!-- Output -->
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5">
        <div class="flex justify-between items-center mb-3">
          <label class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Generated UUIDs</label>
          <div class="flex gap-3">
            <button id="btn-copy" class="text-xs font-semibold text-[#2dd4bf] hover:text-[#5eead4] transition-colors cursor-pointer">Copy All</button>
          </div>
        </div>
        <textarea
          id="uuid-output"
          readonly
          class="w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-xl focus:outline-none font-mono text-sm text-[#2dd4bf] resize-none min-h-[200px] cursor-text"
          placeholder="Click Generate to create UUIDs..."
        ></textarea>
      </div>

      <!-- Citable Content: UUID Version Architecture Table -->
      <div class="mt-16 w-full max-w-4xl mx-auto">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-white mb-2">UUID Version & Architecture Specifications (RFC 4122)</h2>
          <p class="text-zinc-400 text-sm">
            Standard specifications, generation mechanisms, and collision risk models across UUID variants.
          </p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-white/[0.08] bg-white/[0.02]">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-white/[0.08] bg-white/[0.04] text-zinc-300 font-semibold">
                <th class="py-3 px-4">UUID Version</th>
                <th class="py-3 px-4">Generation Method</th>
                <th class="py-3 px-4">Collision Probability</th>
                <th class="py-3 px-4">Primary Use Case</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06] text-zinc-400">
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">Version 4 (Random)</td>
                <td class="py-3 px-4">CSPRNG pseudo-random bytes (122 random bits)</td>
                <td class="py-3 px-4 text-emerald-400">&lt; 1 in 2.71 &times; 10¹⁸ (at 1B IDs)</td>
                <td class="py-3 px-4">Distributed database IDs, session tokens, request headers</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">Version 1 (Time-Based)</td>
                <td class="py-3 px-4">60-bit timestamp + host MAC hardware address</td>
                <td class="py-3 px-4 text-zinc-300">Extremely low (clock-dependent)</td>
                <td class="py-3 px-4">Time-series indexing, ordered transaction logs</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">Version 5 (Namespace)</td>
                <td class="py-3 px-4">SHA-1 cryptographic hash of namespace + name</td>
                <td class="py-3 px-4 text-zinc-300">Deterministic (Zero for distinct names)</td>
                <td class="py-3 px-4">Idempotent identity generation from URLs or domain names</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">Version 7 (Epoch Sortable)</td>
                <td class="py-3 px-4">48-bit Unix timestamp + random entropy</td>
                <td class="py-3 px-4 text-emerald-400">Negligible (sub-millisecond unique)</td>
                <td class="py-3 px-4">B-tree database primary keys, relational index optimization</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section with Schema.org JSON-LD -->
      <ToolFAQ faqs={[
        { question: "How are UUID v4 identifiers generated in this tool?", answer: "Identifiers are generated using the browser's native crypto.randomUUID() API, utilizing cryptographic pseudo-random number generators (CSPRNG) seeded by system hardware entropy." },
        { question: "What is the collision probability of a UUID v4?", answer: "A UUID v4 contains 122 bits of random entropy. To have a 50% probability of a single collision, approximately 2.3 quintillion (2.3 x 10^18) UUIDs would need to be generated." },
        { question: "Can I customize the generated UUID formatting?", answer: "Yes. You can toggle between lowercase and uppercase characters, remove hyphens for a clean 32-character hex string, and batch generate up to 100 UUIDs at a time." }
      ]} />

      <ToolShare title="UUID v4 Generator" url="https://solverspro.com/developer/uuid-generator" />
      <SimilarTools category="developer" currentPath="/developer/uuid-generator" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';

  function generateUUID() {
    return crypto.randomUUID();
  }

  function generate() {
    const count = Math.min(100, Math.max(1, parseInt((document.getElementById('uuid-count') as HTMLInputElement).value) || 1));
    const uppercase = (document.getElementById('uuid-uppercase') as HTMLInputElement).checked;
    const hyphens = (document.getElementById('uuid-hyphens') as HTMLInputElement).checked;

    const uuids = [];
    for (let i = 0; i < count; i++) {
      let uuid = generateUUID();
      if (!hyphens) uuid = uuid.replace(/-/g, '');
      if (uppercase) uuid = uuid.toUpperCase();
      uuids.push(uuid);
    }
    (document.getElementById('uuid-output') as HTMLTextAreaElement).value = uuids.join('\n');
  }

  document.getElementById('btn-generate')?.addEventListener('click', generate);
  document.getElementById('btn-copy')?.addEventListener('click', () => {
    const output = (document.getElementById('uuid-output') as HTMLTextAreaElement).value;
    if (output) copyToClipboard(output);
  });

  generate();
</script>
