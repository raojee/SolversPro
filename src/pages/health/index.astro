---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';

const tools = [
 {
 title: 'TDEE Calculator',
 description: 'Calculate your Total Daily Energy Expenditure based on your activity level.',
 icon: '🔥',
 href: '/health/tdee-calculator',
 },
];
---

<BaseLayout
 title="Health Calculators — Free Nutrition & Fitness Tools | SolversPro"
 description="Free health calculators for TDEE, BMI, calories, and body composition. No signup required."
>
 <Header />
 <SearchOverlay />

 <main class="flex-1 py-12">
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
 <Breadcrumbs items={[
 { label: 'Home', href: '/' },
 { label: 'Health' },
 ]} />

 <div class="mb-12">
 <div class="flex items-center gap-4 mb-4">
 <div class="w-14 h-14 rounded-lg flex items-center justify-center text-3xl" style="background-color: #eff6ff; border-radius: 16px;">
 ❤️
 </div>
 <div>
 <h1 class="text-3xl md:text-4xl font-bold text-white ">Health Tools</h1>
 <p class="text-zinc-500 mt-1">Calories, nutrition, BMI, and body composition calculators.</p>
 </div>
 </div>
 </div>

 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
 {tools.map((tool) => (
 <ToolCard {...tool} />
 ))}
 </div>
 </div>
 </main>

 <Footer />
</BaseLayout>
