---
import '../styles/global.css';
import ActivityTracker from '../components/ActivityTracker.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Toast from '../components/Toast.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: object;
  robots?: string;
}

const {
  title = 'SolversPro — Solve Anything. Instantly.',
  description = 'Free problem solvers for finance, health, math, and trades. No signup. No ads. 100% private.',
  canonical,
  ogImage = '/og-image.png',
  schema,
  robots,
} = Astro.props;

const canonicalUrl = canonical || Astro.url.href;

// ── Dynamic SoftwareApplication Schema for Tool Pages ───────────────────────
const TOOL_CATEGORIES = new Set([
  'developer',
  'pdf',
  'math',
  'text',
  'finance',
  'trades',
  'network',
  'health',
  'qr',
  'security',
]);

const CATEGORY_SCHEMA_MAP: Record<string, string> = {
  developer: 'DeveloperApplication',
  finance: 'FinanceApplication',
  health: 'HealthApplication',
  security: 'SecurityApplication',
  pdf: 'UtilitiesApplication',
  text: 'UtilitiesApplication',
  math: 'EducationalApplication',
  trades: 'UtilitiesApplication',
  network: 'DeveloperApplication',
  qr: 'UtilitiesApplication',
};

// Scan public/images/tools at build-time using Vite's import.meta.glob
const toolScreenshots = import.meta.glob('/public/images/tools/*.{png,jpg,webp,svg}', { eager: true });
const existingScreenshotPaths = new Set(
  Object.keys(toolScreenshots).map((key) => key.replace('/public', ''))
);

const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const isToolPage =
  pathSegments.length === 2 &&
  TOOL_CATEGORIES.has(pathSegments[0]) &&
  pathSegments[1] !== 'index';

let softwareAppSchema: Record<string, any> | null = null;

if (isToolPage) {
  const [category, toolSlug] = pathSegments;
  const toolName = title.split('|')[0].replace(/—.*$/, '').trim();
  const applicationCategory = CATEGORY_SCHEMA_MAP[category] || 'UtilitiesApplication';
  const siteOrigin = Astro.site ? Astro.site.origin : 'https://solverspro.com';
  
  // Format canonical URL ensuring trailing slash for tool URLs
  const formattedUrl = canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`;

  // Check if tool screenshot exists in public/images/tools/
  let screenshotUrl: string | undefined = undefined;
  const extensions = ['.png', '.jpg', '.webp', '.svg'];
  for (const ext of extensions) {
    const relPath = `/images/tools/${toolSlug}${ext}`;
    if (existingScreenshotPaths.has(relPath)) {
      screenshotUrl = `${siteOrigin}${relPath}`;
      break;
    }
  }

  // Standard SoftwareApplication Schema
  softwareAppSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    'name': toolName,
    'description': description,
    'applicationCategory': applicationCategory,
    'operatingSystem': 'Any',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
    },
    'url': formattedUrl,
  };

  if (screenshotUrl) {
    softwareAppSchema['screenshot'] = screenshotUrl;
  }

  // Merge with custom schema if passed via props, ensuring mapped applicationCategory is preserved
  if (schema && typeof schema === 'object') {
    softwareAppSchema = {
      ...softwareAppSchema,
      ...schema,
      applicationCategory: applicationCategory,
    };
  }
}
---

<!DOCTYPE html>
<html lang="en" class="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="google-adsense-account" content="ca-pub-8138211887478220">

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {robots && <meta name="robots" content={robots} />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://solverspro.com')} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SolversPro" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site || 'https://solverspro.com')} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1a1a2e" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- SoftwareApplication Schema for Tool Pages -->
  {softwareAppSchema && (
    <script type="application/ld+json" is:raw set:html={JSON.stringify(softwareAppSchema, null, 2)} />
  )}

  <!-- Custom Page Schema (for non-tool pages e.g. category hub FAQs) -->
  {!isToolPage && schema && (
    <script type="application/ld+json" is:raw set:html={JSON.stringify(schema, null, 2)} />
  )}

  <!-- Website Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "SolversPro",
      "url": "https://solverspro.com",
      "description": "Free problem solvers for finance, health, math, and trades.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://solverspro.com/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <!-- Per-page head slot (e.g. KaTeX, extra stylesheets) -->
  <slot name="head" />

  <!-- Analytics -->
  <GoogleAnalytics />

</head>
<body class="min-h-screen flex flex-col bg-[#0a0a0f] text-zinc-400 pt-16">
  <slot />
  <Toast />
  <ActivityTracker />
</body>
</html>
