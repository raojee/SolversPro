---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import ToolCard from '../components/ToolCard.astro';
import { toolsByCategory } from '../data/tools';

// Capitalize helper for category names
const formatCategory = (cat: string) => {
  if (cat === 'qr') return 'QR Code Tools';
  if (cat === 'tools') return 'PDF Tools';
  return cat.charAt(0).toUpperCase() + cat.slice(1) + (cat === 'trades' || cat === 'math' || cat === 'finance' || cat === 'health' || cat === 'developer' || cat === 'security' || cat === 'network' || cat === 'text' ? ' Tools' : '');
};
---

<BaseLayout
  title="All Tools | SolversPro"
  description="Explore our complete collection of 60+ free online calculators, converters, developer utilities, and engineering tools."
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <span class="scifi-badge mb-6">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          TOOLKIT
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">All Tools</h1>
        <p class="text-lg text-zinc-400 max-w-2xl">Browse our complete collection of 60+ free online calculators, converters, developer utilities, and engineering tools.</p>
      </div>

      <div class="space-y-16">
        {Object.entries(toolsByCategory).map(([category, items]) => (
          <section id={category}>
            <div class="flex items-center gap-4 mb-8 border-b border-white/[0.06] pb-4">
              <h2 class="text-2xl font-bold text-white capitalize">{formatCategory(category)}</h2>
              <span class="px-2.5 py-0.5 rounded-full bg-white/[0.05] border border-white/[0.1] text-xs font-mono text-zinc-400">
                {items.length}
              </span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {items.map(tool => (
                <ToolCard
                  title={tool.title}
                  description={tool.description}
                  icon={tool.icon}
                  href={tool.href}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
