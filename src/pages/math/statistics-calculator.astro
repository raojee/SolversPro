---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CalculateButton from '../../components/CalculateButton.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Statistics Calculator",
  "url": "https://solverspro.com/math/statistics-calculator/",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free statistics calculator to compute mean, median, mode, variance, and standard deviation for any dataset. Instant results with clear formula breakdowns.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};

const faqs = [
  {
    question: "What does this statistics calculator compute?",
    answer: "This statistics calculator computes key descriptive summary statistics for any dataset of numbers, including sample count (N), sum, arithmetic mean (average), median, mode, sample variance (s²), population variance (σ²), and sample standard deviation (s)."
  },
  {
    question: "What is the difference between sample variance and population variance?",
    answer: "Sample variance divides the sum of squared deviations by (N - 1) to provide an unbiased estimator of variance for a sample (Bessel's correction). Population variance divides by N, assuming the dataset contains every member of the population."
  },
  {
    question: "When should I use median instead of mean?",
    answer: "Use the median when your dataset contains extreme outliers or has a skewed distribution (such as income or housing prices), as the median represents the 50th percentile and is resistant to distortion from outlier values."
  },
  {
    question: "Can this calculator process negative numbers and decimals?",
    answer: "Yes. The calculator parses floating-point numbers, negative values, and zero seamlessly from your comma-separated input list."
  },
  {
    question: "How do I calculate standard deviation with this statistics calculator?",
    answer: "Simply enter your comma-separated numbers into the data input field and click 'Calculate Stats'. The statistics calculator instantly calculates the sample standard deviation by finding the square root of the sample variance."
  },
  {
    question: "Is this online statistics calculator completely free to use?",
    answer: "Yes. The SolversPro statistics calculator is 100% free with no registration, no subscriptions, and all math runs locally in your web browser for complete data privacy."
  }
];
---

<BaseLayout
  title="Statistics Calculator — Mean, Median & Mode | SolversPro"
  description="Free statistics calculator to compute mean, median, mode, variance, and standard deviation for any dataset. Instant results with clear formula breakdowns."
  canonical="https://solverspro.com/math/statistics-calculator/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Math', href: '/math' },
        { label: 'Statistics Calculator' },
      ]} />

      <div class="mb-8 max-w-3xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Statistics Calculator</h1>
        <p class="text-lg text-zinc-300 leading-relaxed mb-4">
          The SolversPro Statistics Calculator is a free browser-based math utility that evaluates arithmetic mean, median, mode, variance, and sample standard deviation for any numerical dataset in real time.
        </p>
        <p class="text-sm text-zinc-400">
          Enter your numbers separated by commas below to generate an instant statistical summary with formulas and step-by-step breakdowns.
        </p>
      </div>

      <form class="form-container max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 shadow-sm mb-8" id="calculator-form">
        <div class="mb-5">
          <label for="data-set" class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400" style="font-family: 'JetBrains Mono', monospace;">
            Data Set (Comma separated)
          </label>
          <textarea
            id="data-set"
            required
            class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-md py-3 px-4 transition-all duration-200 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:bg-white/[0.05] min-h-[120px] font-mono resize-y"
            placeholder="e.g., 5, 10, 15, 20, 25"
          >5, 10, 15, 20, 25</textarea>
        </div>

        <div class="mt-6">
          <CalculateButton text="Calculate Stats" icon="📊" id="calculate-btn" />
        </div>
      </form>

      <!-- Results -->
      <div id="results-section" class="hidden space-y-8 mb-12 max-w-2xl mx-auto">
        <div class="result-surface p-6 md:p-8 rounded-xl border bg-white/[0.02]">
          <div class="grid grid-cols-2 gap-4 sm:gap-6 mb-6" id="result-grid">
            <!-- Populated via JS -->
          </div>
          <div class="flex justify-end pt-4 border-t border-white/[0.05]">
            <SaveResultButton id="save-stats-btn" />
          </div>
        </div>
      </div>

      <!-- How It Works Section -->
      <div class="mb-12 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">How to Use This Statistics Calculator</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-5 text-center">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3 bg-[#ff6b35]">
              1
            </div>
            <h3 class="font-semibold text-white mb-2">Input Your Numbers</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Type or paste your data into the box separated by commas. Decimals and negative numbers are fully supported.
            </p>
          </div>
          <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-5 text-center">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3 bg-[#2dd4bf]">
              2
            </div>
            <h3 class="font-semibold text-white mb-2">Run Instant Analysis</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Click Calculate Stats. The statistics calculator computes mean, median, mode, variance, and standard deviation in milliseconds.
            </p>
          </div>
          <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-5 text-center">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3 bg-[#a78bfa]">
              3
            </div>
            <h3 class="font-semibold text-white mb-2">Review & Save</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Examine the metrics cards and save your computation history directly to your private local dashboard with one click.
            </p>
          </div>
        </div>
      </div>

      <!-- Worked Example Section -->
      <div class="mb-12 max-w-3xl mx-auto bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-2xl font-bold text-white mb-3">Worked Example: Step-by-Step Calculation</h2>
        <p class="text-sm text-zinc-400 mb-6">
          To see how this statistics calculator works under the hood, let us solve the default sample dataset: <span class="font-mono text-[#2dd4bf] font-semibold">5, 10, 15, 20, 25</span>.
        </p>

        <div class="space-y-4 text-sm text-zinc-300">
          <div class="p-4 bg-white/[0.02] rounded-lg border border-white/[0.04]">
            <h3 class="font-bold text-white mb-1">Step 1: Determine Count and Total Sum</h3>
            <p class="text-zinc-400 text-xs mb-2">Count the total items (N) and sum all values together.</p>
            <p class="font-mono text-xs text-[#2dd4bf]">N = 5</p>
            <p class="font-mono text-xs text-[#2dd4bf]">Sum = 5 + 10 + 15 + 20 + 25 = 75</p>
          </div>

          <div class="p-4 bg-white/[0.02] rounded-lg border border-white/[0.04]">
            <h3 class="font-bold text-white mb-1">Step 2: Find the Arithmetic Mean (Average)</h3>
            <p class="text-zinc-400 text-xs mb-2">Divide the sum of all elements by the total count N.</p>
            <p class="font-mono text-xs text-[#ff6b35]">Mean (x̄) = 75 / 5 = 15.0000</p>
          </div>

          <div class="p-4 bg-white/[0.02] rounded-lg border border-white/[0.04]">
            <h3 class="font-bold text-white mb-1">Step 3: Locate the Median and Mode</h3>
            <p class="text-zinc-400 text-xs mb-2">Sort the values from smallest to largest and pick the center number. With 5 values, the 3rd item is the median. Every number appears once, so there is no mode.</p>
            <p class="font-mono text-xs text-[#a78bfa]">Median (x̃) = 15.0000</p>
            <p class="font-mono text-xs text-[#a78bfa]">Mode = None (all values appear once)</p>
          </div>

          <div class="p-4 bg-white/[0.02] rounded-lg border border-white/[0.04]">
            <h3 class="font-bold text-white mb-1">Step 4: Calculate Sample & Population Variance and Standard Deviation</h3>
            <p class="text-zinc-400 text-xs mb-2">Subtract the mean (15) from each observation, square the results, sum them, and divide by (N - 1) = 4 for a sample or N = 5 for a population.</p>
            <p class="font-mono text-xs text-[#38bdf8]">(5 - 15)² = 100, (10 - 15)² = 25, (15 - 15)² = 0, (20 - 15)² = 25, (25 - 15)² = 100</p>
            <p class="font-mono text-xs text-[#38bdf8]">Sum of Squared Deviations = 100 + 25 + 0 + 25 + 100 = 250</p>
            <p class="font-mono text-xs text-[#38bdf8]">Sample Variance (s²) = 250 / (5 - 1) = 62.5000 | Sample Std Dev (s) = √(62.5) ≈ 7.9057</p>
            <p class="font-mono text-xs text-yellow-400">Population Variance (σ²) = 250 / 5 = 50.0000 | Population Std Dev (σ) = √(50) ≈ 7.0711</p>
          </div>
        </div>
      </div>

      <!-- Descriptive Statistics Core Concepts -->
      <div class="mb-12 max-w-3xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-2xl font-bold text-white mb-4">Core Concepts of Descriptive Statistics</h2>
        <div class="space-y-4 text-sm text-zinc-300 leading-relaxed">
          <p>
            Descriptive statistics summarize and describe the features of a specific collection of information. Instead of drawing conclusions about a larger population, descriptive measures give you an immediate picture of what your dataset looks like.
          </p>
          <figure class="my-4 rounded-xl overflow-hidden border border-white/[0.06] bg-[#0d0d14]">
            <img
              src="/images/tools/statistics-calculator.svg"
              alt="Statistics calculator diagram showing mean, median, mode, variance, and standard deviation distribution"
              width="800"
              height="320"
              loading="lazy"
              decoding="async"
              class="w-full h-auto block"
            />
          </figure>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-4 bg-white/[0.02] rounded-lg border border-white/[0.04]">
              <h3 class="text-base font-semibold text-white mb-1">Measures of Central Tendency</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Central tendency identifies the center point or typical value in a dataset. The mean provides the mathematical balance point, the median reveals the middle ranking value, and the mode identifies the most frequent observation.
              </p>
            </div>
            <div class="p-4 bg-white/[0.02] rounded-lg border border-white/[0.04]">
              <h3 class="text-base font-semibold text-white mb-1">Measures of Dispersion</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Measures of spread show how scattered data points are around the center. Range shows the extreme boundaries, variance calculates average squared distance, and standard deviation translates that spread back into original measurement units.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Citable Reference Table -->
      <div class="mb-12 max-w-3xl mx-auto bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-xl font-bold text-white mb-2">Descriptive Statistics Metric Reference</h2>
        <p class="text-zinc-400 text-sm mb-6">Standard mathematical definitions and formulas for univariate summary statistics.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-400 font-mono text-xs uppercase">
                <th class="py-3 px-4">Statistical Metric</th>
                <th class="py-3 px-4">Mathematical Notation</th>
                <th class="py-3 px-4">Description</th>
                <th class="py-3 px-4">Formula</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-300 font-mono text-xs">
              <tr>
                <td class="py-3 px-4 text-[#2dd4bf] font-bold">Mean (Average)</td>
                <td class="py-3 px-4 text-white font-mono">x̄ (x-bar)</td>
                <td class="py-3 px-4">Central tendency via total sum divided by count</td>
                <td class="py-3 px-4 font-mono">Σxᵢ / N</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#ff6b35] font-bold">Median</td>
                <td class="py-3 px-4 text-white font-mono">x̃</td>
                <td class="py-3 px-4">Middle value when observations are sorted</td>
                <td class="py-3 px-4 font-mono">50th Percentile</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#a78bfa] font-bold">Mode</td>
                <td class="py-3 px-4 text-white font-mono">Mo</td>
                <td class="py-3 px-4">Most frequently occurring value(s)</td>
                <td class="py-3 px-4 font-mono">argmax(Frequency(xᵢ))</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#38bdf8] font-bold">Sample Variance</td>
                <td class="py-3 px-4 text-white font-mono">s²</td>
                <td class="py-3 px-4">Mean squared distance from mean with Bessel correction</td>
                <td class="py-3 px-4 font-mono">Σ(xᵢ - x̄)² / (N - 1)</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-yellow-400 font-bold">Sample Std Deviation</td>
                <td class="py-3 px-4 text-white font-mono">s</td>
                <td class="py-3 px-4">Square root of sample variance in native units</td>
                <td class="py-3 px-4 font-mono">√(s²)</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#38bdf8] font-bold">Population Variance</td>
                <td class="py-3 px-4 text-white font-mono">σ²</td>
                <td class="py-3 px-4">Mean squared deviation across an entire population</td>
                <td class="py-3 px-4 font-mono">Σ(xᵢ - μ)² / N</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-yellow-400 font-bold">Population Std Deviation</td>
                <td class="py-3 px-4 text-white font-mono">σ</td>
                <td class="py-3 px-4">Square root of population variance in native units</td>
                <td class="py-3 px-4 font-mono">√(σ²)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mb-12 max-w-3xl mx-auto">
        <ToolFAQ faqs={faqs} />
      </div>

      <ToolShare title="Statistics Calculator" url="https://solverspro.com/math/statistics-calculator" />
      <SimilarTools category="math" currentPath="/math/statistics-calculator" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  function calculate() {
    const rawInput = (document.getElementById('data-set') as HTMLTextAreaElement)?.value || '';
    
    // Parse input into array of numbers
    const data = rawInput.split(',')
      .map(s => parseFloat(s.trim()))
      .filter(n => !isNaN(n));
      
    if (data.length === 0) {
      window.showToast?.('Please enter a valid comma-separated list of numbers.', 'error');
      return;
    }

    const btn = document.getElementById('calculate-btn');
    btn?.setAttribute('data-loading', 'true');

    setTimeout(() => {
      // Math Calculations
      const n = data.length;
      const sum = data.reduce((a, b) => a + b, 0);
      const mean = sum / n;
      
      const sorted = [...data].sort((a, b) => a - b);
      const mid = Math.floor(n / 2);
      const median = n % 2 !== 0 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
      
      const counts: Record<number, number> = {};
      data.forEach(val => counts[val] = (counts[val] || 0) + 1);
      let maxCount = 0;
      let modes: number[] = [];
      for (const val in counts) {
        if (counts[val] > maxCount) {
          maxCount = counts[val];
          modes = [parseFloat(val)];
        } else if (counts[val] === maxCount) {
          modes.push(parseFloat(val));
        }
      }
      const modeStr = (maxCount === 1 || modes.length === n) ? 'None' : modes.join(', ');
      
      const variance = data.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / (n - 1);
      const popVariance = data.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / n;
      const stdDev = Math.sqrt(variance);
      const popStdDev = Math.sqrt(popVariance);
      
      const results = [
        { label: 'Count (N)', value: n },
        { label: 'Sum', value: sum },
        { label: 'Mean', value: mean.toFixed(4) },
        { label: 'Median', value: median.toFixed(4) },
        { label: 'Mode', value: modeStr },
        { label: 'Min', value: sorted[0] },
        { label: 'Max', value: sorted[n - 1] },
        { label: 'Range', value: (sorted[n - 1] - sorted[0]).toFixed(4) },
        { label: 'Sample Variance (s²)', value: variance.toFixed(4) },
        { label: 'Sample Std Dev (s)', value: stdDev.toFixed(4) },
        { label: 'Population Variance (σ²)', value: popVariance.toFixed(4) },
        { label: 'Population Std Dev (σ)', value: popStdDev.toFixed(4) }
      ];

      const grid = document.getElementById('result-grid');
      if (grid) {
        grid.innerHTML = results.map(r => `
          <div class="bg-white/[0.03] rounded-lg p-4 border border-white/[0.05]">
            <p class="text-xs text-zinc-500 uppercase tracking-widest font-semibold mb-1">${r.label}</p>
            <p class="text-xl sm:text-2xl font-bold text-white">${r.value}</p>
          </div>
        `).join('');
      }

      document.getElementById('results-section')?.classList.remove('hidden');
      btn?.removeAttribute('data-loading');
      
      const saveBtn = document.getElementById('save-stats-btn');
      if (saveBtn) {
        saveBtn.classList.remove('hidden');
        saveBtn.onclick = () => {
          if (typeof window.saveToDashboard === 'function') {
            const resultData: Record<string, string> = {
              'N': n.toString(),
              'Sum': sum.toString(),
              'Mean': mean.toFixed(4),
              'Median': median.toFixed(4),
              'Mode': modeStr,
              'Min': sorted[0].toString(),
              'Max': sorted[n - 1].toString(),
              'Range': (sorted[n - 1] - sorted[0]).toFixed(4),
              'Sample Var': variance.toFixed(4),
              'Sample Std Dev': stdDev.toFixed(4),
              'Pop Var': popVariance.toFixed(4),
              'Pop Std Dev': popStdDev.toFixed(4)
            };
            const success = window.saveToDashboard('Statistics Calculator', '/math/statistics-calculator', {
              type: 'key-value',
              data: resultData
            });
            if (success) {
              const textEl = saveBtn.querySelector('.btn-text');
              const iconSave = saveBtn.querySelector('.icon-save');
              const iconCheck = saveBtn.querySelector('.icon-check');
              if (textEl) textEl.textContent = 'Saved!';
              if (iconSave) iconSave.classList.add('hidden');
              if (iconCheck) iconCheck.classList.remove('hidden');
              saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              setTimeout(() => {
                if (textEl) textEl.textContent = 'Save Result';
                if (iconSave) iconSave.classList.remove('hidden');
                if (iconCheck) iconCheck.classList.add('hidden');
                saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              }, 2000);
            }
          }
        };
      }
    }, 300);
  }

  document.getElementById('calculator-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
</script>
