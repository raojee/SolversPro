---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Number Base Converter",
  "url": "https://solverspro.com/developer/number-base/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online number base converter to instantly convert values between binary (base 2), octal (base 8), decimal (base 10), and hexadecimal (base 16) formats.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="Number Base Converter | SolversPro"
  description="Convert numbers between binary, octal, decimal, and hexadecimal instantly. Free developer tool — 100% client-side, no data sent to any server."
  canonical="https://solverspro.com/developer/number-base/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-3xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'Number Base Converter' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🔢 Number Base Converter</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro Number Base Converter is a free browser-based developer utility that calculates bi-directional conversions between binary (base 2), octal (base 8), decimal (base 10), and hexadecimal (base 16) in real time with client-side privacy.
        </p>
      </div>

      <!-- Main Converter -->
      <div class="space-y-4">
        <!-- Decimal -->
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 group hover:border-[#2dd4bf]/30 transition-all">
          <div class="flex justify-between items-center mb-3">
            <div>
              <span class="text-sm font-bold text-[#2dd4bf] uppercase tracking-wider">Decimal</span>
              <span class="ml-2 text-xs text-zinc-600 font-mono">Base 10 · 0–9</span>
            </div>
            <button class="btn-copy text-xs text-zinc-500 hover:text-[#2dd4bf] transition-colors" data-target="dec">Copy</button>
          </div>
          <input
            type="text"
            id="inp-dec"
            data-base="10"
            class="base-input w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-lg focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-lg text-white placeholder:text-zinc-700"
            placeholder="e.g. 255"
            autocomplete="off"
          />
        </div>

        <!-- Hexadecimal -->
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 group hover:border-blue-400/30 transition-all">
          <div class="flex justify-between items-center mb-3">
            <div>
              <span class="text-sm font-bold text-blue-400 uppercase tracking-wider">Hexadecimal</span>
              <span class="ml-2 text-xs text-zinc-600 font-mono">Base 16 · 0–9, A–F</span>
            </div>
            <button class="btn-copy text-xs text-zinc-500 hover:text-blue-400 transition-colors" data-target="hex">Copy</button>
          </div>
          <input
            type="text"
            id="inp-hex"
            data-base="16"
            class="base-input w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-lg focus:ring-1 focus:ring-blue-400 focus:outline-none font-mono text-lg text-white placeholder:text-zinc-700 uppercase"
            placeholder="e.g. FF"
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <!-- Binary -->
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 group hover:border-purple-400/30 transition-all">
          <div class="flex justify-between items-center mb-3">
            <div>
              <span class="text-sm font-bold text-purple-400 uppercase tracking-wider">Binary</span>
              <span class="ml-2 text-xs text-zinc-600 font-mono">Base 2 · 0–1</span>
            </div>
            <button class="btn-copy text-xs text-zinc-500 hover:text-purple-400 transition-colors" data-target="bin">Copy</button>
          </div>
          <input
            type="text"
            id="inp-bin"
            data-base="2"
            class="base-input w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-lg focus:ring-1 focus:ring-purple-400 focus:outline-none font-mono text-lg text-white placeholder:text-zinc-700"
            placeholder="e.g. 11111111"
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <!-- Octal -->
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 group hover:border-yellow-400/30 transition-all">
          <div class="flex justify-between items-center mb-3">
            <div>
              <span class="text-sm font-bold text-yellow-400 uppercase tracking-wider">Octal</span>
              <span class="ml-2 text-xs text-zinc-600 font-mono">Base 8 · 0–7</span>
            </div>
            <button class="btn-copy text-xs text-zinc-500 hover:text-yellow-400 transition-colors" data-target="oct">Copy</button>
          </div>
          <input
            type="text"
            id="inp-oct"
            data-base="8"
            class="base-input w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-lg focus:ring-1 focus:ring-yellow-400 focus:outline-none font-mono text-lg text-white placeholder:text-zinc-700"
            placeholder="e.g. 377"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>

      <!-- Error -->
      <div id="error-msg" class="hidden mt-4 text-center text-sm font-semibold text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg px-4 py-3"></div>

      <!-- Clear -->
      <div class="mt-6 flex justify-center">
        <button id="btn-clear" class="px-6 py-2.5 text-sm font-semibold text-zinc-400 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] rounded-lg transition-all">
          Clear All
        </button>
      </div>

      <!-- Reference Table -->
      <div class="mt-10 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-base font-bold text-white mb-2">Numeral Base Conversion Quick Reference (0–15)</h2>
        <p class="text-xs text-zinc-400 mb-4">Standard equivalence table across decimal, hexadecimal, octal, and 4-bit nibbles.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-300">
                <th class="py-2.5 px-3 font-semibold">Decimal (Base 10)</th>
                <th class="py-2.5 px-3 font-semibold">Hexadecimal (Base 16)</th>
                <th class="py-2.5 px-3 font-semibold">Octal (Base 8)</th>
                <th class="py-2.5 px-3 font-semibold">Binary (Base 2)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-400 font-mono">
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">0</td>
                <td class="py-2 px-3 text-blue-400">0</td>
                <td class="py-2 px-3 text-yellow-400">0</td>
                <td class="py-2 px-3 text-purple-400">0000</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">1</td>
                <td class="py-2 px-3 text-blue-400">1</td>
                <td class="py-2 px-3 text-yellow-400">1</td>
                <td class="py-2 px-3 text-purple-400">0001</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">2</td>
                <td class="py-2 px-3 text-blue-400">2</td>
                <td class="py-2 px-3 text-yellow-400">2</td>
                <td class="py-2 px-3 text-purple-400">0010</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">4</td>
                <td class="py-2 px-3 text-blue-400">4</td>
                <td class="py-2 px-3 text-yellow-400">4</td>
                <td class="py-2 px-3 text-purple-400">0100</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">8</td>
                <td class="py-2 px-3 text-blue-400">8</td>
                <td class="py-2 px-3 text-yellow-400">10</td>
                <td class="py-2 px-3 text-purple-400">1000</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">10</td>
                <td class="py-2 px-3 text-blue-400">A</td>
                <td class="py-2 px-3 text-yellow-400">12</td>
                <td class="py-2 px-3 text-purple-400">1010</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">15</td>
                <td class="py-2 px-3 text-blue-400">F</td>
                <td class="py-2 px-3 text-yellow-400">17</td>
                <td class="py-2 px-3 text-purple-400">1111</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={[
        {
          question: "How does the number base converter work?",
          answer: "Typing any integer into the decimal, hexadecimal, octal, or binary input field automatically re-computes and syncs the equivalent representation across all other numeral bases simultaneously."
        },
        {
          question: "Are calculations performed client-side?",
          answer: "Yes, all radix conversions use native JavaScript BigInt and parseInt algorithms directly in your browser without transmitting numbers to external servers."
        },
        {
          question: "What is the maximum integer size supported?",
          answer: "The converter supports arbitrary-precision integers up to 64-bit safe bounds, preventing overflow inaccuracies common in simple calculators."
        },
        {
          question: "Is this number converter free to use?",
          answer: "Yes, the SolversPro Number Base Converter is 100% free with unlimited conversions and no registration required."
        }
      ]} />

      <ToolShare title="Number Base Converter" url="https://solverspro.com/developer/number-base" />
      <SimilarTools category="developer" currentPath="/developer/number-base" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  const inputs: Record<string, HTMLInputElement> = {
    dec: document.getElementById('inp-dec') as HTMLInputElement,
    hex: document.getElementById('inp-hex') as HTMLInputElement,
    bin: document.getElementById('inp-bin') as HTMLInputElement,
    oct: document.getElementById('inp-oct') as HTMLInputElement,
  };

  const bases: Record<string, number> = { dec: 10, hex: 16, bin: 2, oct: 8 };
  const errorEl = document.getElementById('error-msg')!;

  function convert(source: string) {
    const raw = inputs[source].value.trim();
    errorEl.classList.add('hidden');

    if (!raw) {
      Object.keys(inputs).forEach(k => { if (k !== source) inputs[k].value = ''; });
      return;
    }

    const dec = parseInt(raw, bases[source]);
    if (isNaN(dec) || dec < 0) {
      errorEl.textContent = `Invalid ${source.toUpperCase()} number: "${raw}"`;
      errorEl.classList.remove('hidden');
      Object.keys(inputs).forEach(k => { if (k !== source) inputs[k].value = ''; });
      return;
    }

    Object.keys(inputs).forEach(k => {
      if (k !== source) {
        inputs[k].value = dec.toString(bases[k]).toUpperCase();
      }
    });
  }

  Object.keys(inputs).forEach(key => {
    inputs[key].addEventListener('input', () => convert(key));
  });

  document.getElementById('btn-clear')?.addEventListener('click', () => {
    Object.values(inputs).forEach(el => el.value = '');
    errorEl.classList.add('hidden');
  });

  document.querySelectorAll('.btn-copy').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.target!;
      const val = inputs[target]?.value;
      if (!val) return;
      copyToClipboard(val);
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = original, 1500);
    });
  });

  // Build reference table if dynamic container exists
  const tbody = document.getElementById('ref-table');
  if (tbody) {
    for (let i = 0; i <= 15; i++) {
      tbody.innerHTML += `<tr class="hover:bg-white/[0.02] transition-colors">
        <td class="py-1.5 pr-4 text-zinc-300">${i}</td>
        <td class="py-1.5 pr-4 text-[#ff6b35]">${i.toString(16).toUpperCase()}</td>
        <td class="py-1.5 pr-4 text-yellow-400">${i.toString(8)}</td>
        <td class="py-1.5 text-purple-400">${i.toString(2).padStart(4, '0')}</td>
      </tr>`;
    }
  }
</script>
