---
interface Props {
  title: string;
  icon: string;
  toolCount: number;
  description: string;
  href: string;
}

const { title, icon, toolCount, description, href } = Astro.props;
---

<a
  href={href}
  class="w-full group block p-8 bg-white/[0.02] border border-white/[0.06] rounded-2xl card-hover-fx no-underline relative overflow-hidden"
>
  <!-- Background Glow FX -->
  <div class="absolute -top-12 -right-12 w-32 h-32 bg-[#ff6b35] opacity-0 blur-[60px] rounded-full transition-opacity duration-500 group-hover:opacity-10 pointer-events-none"></div>

  <!-- Icon & Badge Row -->
  <div class="flex items-center justify-between mb-8 relative z-10">
    <div
      class="w-12 h-12 rounded-lg flex items-center justify-center text-xl bg-[#2dd4bf]/10 border border-[#2dd4bf]/20 text-[#2dd4bf] group-hover:bg-[#2dd4bf]/20 transition-colors"
    >
      {icon}
    </div>
    <span
      class="scifi-badge bg-[#ff6b35]/10 text-[#ff6b35] border-[#ff6b35]/30 group-hover:bg-[#ff6b35]/20"
    >
      {toolCount} Tools
    </span>
  </div>

  <!-- Content -->
  <div class="relative z-10">
    <h3 class="text-2xl font-bold mb-3 text-white" style="font-family: 'JetBrains Mono', monospace;">
      {title}
    </h3>
    <p class="text-[14px] leading-relaxed mb-8 text-zinc-400">
      {description}
    </p>
  </div>

  <!-- CTA -->
  <div class="flex items-center text-[#2dd4bf] font-semibold text-xs relative z-10" style="font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em;">
    Explore <span class="ml-2 transition-transform group-hover:translate-x-1">→</span>
  </div>
</a>
