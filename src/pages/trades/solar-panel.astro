---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InputField from '../../components/InputField.astro';
import CalculateButton from '../../components/CalculateButton.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Solar Panel Calculator",
  "url": "https://solverspro.com/trades/solar-panel/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Calculate photovoltaic solar panel module counts and recommended kilowatt (kW) system size based on daily energy consumption and regional peak sun hours.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqItems = [
  {
    question: "What are Peak Sun Hours?",
    answer: "Peak sun hours refer to the number of hours per day when solar irradiance averages 1,000 watts per square meter. It is not just the hours of daylight, but the hours of usable solar energy."
  },
  {
    question: "Why is System Efficiency defaulted to 80%?",
    answer: "Solar systems never operate at 100% efficiency. Energy is lost due to inverter inefficiency, wiring resistance, shading, dust on the panels, and temperature fluctuations. 80% is a standard conservative estimate for a well-designed grid-tied system."
  },
  {
    question: "How is the number of panels calculated?",
    answer: "We first determine the required total system size (in kW) by dividing your daily usage by your peak sun hours and efficiency factor. Then, we divide that total size (in Watts) by your individual panel wattage and round up to the nearest whole panel."
  },
  {
    question: "How much roof area is needed for a residential solar array?",
    answer: "Each standard residential 400W solar panel occupies approximately 17.5 to 21 square feet (1.6 to 2.0 m²). A typical 20-panel (8 kW) installation requires roughly 350 to 420 square feet of unshaded south or west-facing roof space."
  }
];
---

<BaseLayout
  title="Solar Panel Calculator | SolversPro"
  description="Determine the solar system size and number of solar panels you need based on your daily energy usage and local peak sun hours."
  canonical="https://solverspro.com/trades/solar-panel/"
  jsonLd={jsonLd}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Trades', href: '/trades/' },
        { label: 'Solar Panel Calculator' },
      ]} />

      <div class="mb-8 max-w-3xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Solar Panel Calculator</h1>
        <p class="text-zinc-300 max-w-2xl mx-auto text-base leading-relaxed">SolversPro Solar Panel Calculator is a free renewable energy estimation tool that computes total photovoltaic system kilowatt capacity (kW) and required module panel quantities based on daily kWh consumption and local peak sun hours.</p>
      </div>

      <form class="form-container max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 md:p-10 shadow-sm mb-8" id="solar-form" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
          <InputField label="Daily Energy Usage (kWh/day)" name="usage" value={30} step={0.1} />
          <InputField label="Peak Sun Hours (h)" name="sun_hours" value={5.5} step={0.1} />
          <InputField label="Panel Wattage (W)" name="wattage" value={400} step={1} />
          <InputField label="System Efficiency (%)" name="efficiency" value={80} step={1} />
        </div>

        <div class="mt-6">
          <CalculateButton text="Calculate Solar Requirements" icon="☀️" id="calc-btn" />
        </div>
      </form>

      <!-- Results -->
      <div id="results-section" class="hidden space-y-6 mb-12 max-w-2xl mx-auto">
        <div class="result-surface p-6 md:p-8 rounded-xl border bg-white/[0.02] shadow-sm flex flex-col items-center justify-center min-h-[200px]" id="result-summary">
          <h3 class="text-sm font-semibold uppercase text-zinc-500 tracking-wider mb-2" id="result-title">Required Number of Panels</h3>
          
          <p class="text-6xl font-bold text-[#2dd4bf] mb-2 text-center" id="res-panels">0</p>
          <p class="text-zinc-400 font-medium mb-6 text-center">Panels</p>
          
          <div class="w-full h-px bg-white/[0.03] mb-6"></div>
          
          <div class="text-center w-full">
            <p class="text-xs font-semibold text-zinc-500 uppercase">Recommended System Size</p>
            <p class="text-3xl font-bold text-white mt-2" id="res-size">0.00 kW</p>
          </div>
          <div class="w-full flex justify-end mt-8 border-t border-white/[0.05] pt-4">
            <SaveResultButton id="save-solar-btn" />
          </div>
        </div>
      </div>

      <!-- Citable Reference Table -->
      <div class="mb-12 max-w-3xl mx-auto bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl font-bold text-white mb-4">Regional Peak Sun Hours & System Output Reference</h2>
        <p class="text-zinc-400 text-sm mb-6">Average solar insolation ratings across North American climate zones and expected daily generation for an 8 kW array:</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300">
            <thead class="bg-white/[0.03] text-zinc-200 uppercase text-xs tracking-wider border-b border-white/[0.08]">
              <tr>
                <th class="py-3 px-4">US Climate Zone / Region</th>
                <th class="py-3 px-4">Daily Peak Sun Hours</th>
                <th class="py-3 px-4">8 kW Daily Yield (@ 80% Eff.)</th>
                <th class="py-3 px-4">Estimated Annual Output</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.05]">
              <tr>
                <td class="py-3 px-4 font-semibold text-[#2dd4bf]">Southwest (AZ, NV, Southern CA)</td>
                <td class="py-3 px-4 font-mono">6.0 to 7.0 hours</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">38.4 - 44.8 kWh</td>
                <td class="py-3 px-4 font-mono">14,000 - 16,300 kWh</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-zinc-200">Southeast & Central Plains (TX, FL, CO)</td>
                <td class="py-3 px-4 font-mono">5.0 to 5.8 hours</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">32.0 - 37.1 kWh</td>
                <td class="py-3 px-4 font-mono">11,600 - 13,500 kWh</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-emerald-400">Mid-Atlantic & Midwest (NY, OH, IL)</td>
                <td class="py-3 px-4 font-mono">4.0 to 4.8 hours</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">25.6 - 30.7 kWh</td>
                <td class="py-3 px-4 font-mono">9,300 - 11,200 kWh</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-purple-400">Pacific Northwest & Alaska (WA, OR)</td>
                <td class="py-3 px-4 font-mono">3.2 to 3.8 hours</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">20.5 - 24.3 kWh</td>
                <td class="py-3 px-4 font-mono">7,400 - 8,800 kWh</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="mb-12 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Questions</h2>
        <FAQAccordion items={faqItems} />
      </div>
      <ToolShare title="Solar Panel Calculator" url="https://solverspro.com/trades/solar-panel" />
      <SimilarTools category="trades" currentPath="/trades/solar-panel" />
    

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.getElementById('solar-form')?.addEventListener('submit', () => {
    const usage = parseFloat((document.querySelector('input[name="usage"]') as HTMLInputElement).value) || 0;
    const sunHours = parseFloat((document.querySelector('input[name="sun_hours"]') as HTMLInputElement).value) || 0;
    const wattage = parseFloat((document.querySelector('input[name="wattage"]') as HTMLInputElement).value) || 0;
    const efficiency = parseFloat((document.querySelector('input[name="efficiency"]') as HTMLInputElement).value) || 0;

    const btn = document.getElementById('calc-btn');
    btn?.setAttribute('data-loading', 'true');

    setTimeout(() => {
      if (sunHours > 0 && efficiency > 0 && wattage > 0) {
        const effFactor = efficiency / 100;
        
        // System Size (kW) = (Daily Usage kWh) / (Peak Sun Hours * Efficiency)
        const systemSizeKw = usage / (sunHours * effFactor);
        
        // Number of Panels = (System Size kW * 1000) / Panel Wattage
        const numPanels = Math.ceil((systemSizeKw * 1000) / wattage);

        document.getElementById('res-size')!.textContent = systemSizeKw.toFixed(2) + " kW";
        document.getElementById('res-panels')!.textContent = numPanels.toString();
      }

      document.getElementById('results-section')?.classList.remove('hidden');
      document.getElementById('result-summary')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      btn?.removeAttribute('data-loading');
      
      const saveBtn = document.getElementById('save-solar-btn');
      if (saveBtn) {
        saveBtn.classList.remove('hidden');
        saveBtn.onclick = () => {
          if (typeof window.saveToDashboard === 'function') {
            const size = document.getElementById('res-size')!.textContent;
            const panels = document.getElementById('res-panels')!.textContent;
            const success = window.saveToDashboard('Solar Panel Calculator', '/trades/solar-panel', {
              type: 'key-value',
              data: {
                'Panels': panels,
                'System Size': size
              }
            });
            if (success) {
              const textEl = saveBtn.querySelector('.btn-text');
              const iconSave = saveBtn.querySelector('.icon-save');
              const iconCheck = saveBtn.querySelector('.icon-check');
              if (textEl) textEl.textContent = 'Saved!';
              if (iconSave) iconSave.classList.add('hidden');
              if (iconCheck) iconCheck.classList.remove('hidden');
              saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              setTimeout(() => {
                if (textEl) textEl.textContent = 'Save Result';
                if (iconSave) iconSave.classList.remove('hidden');
                if (iconCheck) iconCheck.classList.add('hidden');
                saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              }, 2000);
            }
          }
        };
      }
    }, 200);
  });
</script>
