---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InputField from '../../components/InputField.astro';
import SelectField from '../../components/SelectField.astro';
import CalculateButton from '../../components/CalculateButton.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "BMI Calculator",
  "url": "https://solverspro.com/health/bmi-calculator/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Calculate your Body Mass Index (BMI) and health category instantly with metric and imperial units. Free, private, and instant.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com/"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqItems = [
  {
    question: "What is BMI?",
    answer: "Body Mass Index (BMI) is an anthropometric screening index calculated by dividing a person's weight in kilograms by the square of their height in meters (kg/m²)."
  },
  {
    question: "What is considered a healthy BMI range?",
    answer: "For adults, a healthy BMI typically ranges between 18.5 and 24.9 according to the World Health Organization (WHO) and CDC guidelines."
  },
  {
    question: "Does BMI distinguish between muscle and body fat?",
    answer: "No. BMI does not measure body composition directly. Muscular athletes may register in the overweight category despite having low body fat, while older adults may have higher body fat with a normal BMI."
  }
];
---

<BaseLayout
  title="BMI Calculator — Body Mass Index Calculator | SolversPro"
  description="Calculate your Body Mass Index (BMI) instantly with metric and imperial units. Free, private, and accurate health calculations."
  canonical="https://solverspro.com/health/bmi-calculator/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Health', href: '/health/' },
        { label: 'BMI Calculator' },
      ]} />

      <div class="mb-8 max-w-3xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">BMI Calculator</h1>
        <p class="text-zinc-300 text-base leading-relaxed mb-4 max-w-2xl mx-auto">
          The SolversPro BMI Calculator is a free health tool that computes your body mass index from height and weight in metric or imperial units to evaluate weight status against clinical categories.
        </p>
        <p class="text-sm text-zinc-400">Calculate your Body Mass Index based on weight and height.</p>
      </div>

      <form class="form-container max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 shadow-sm mb-8" id="calculator-form">
        <SelectField
          label="Unit System"
          name="unitSystem"
          id="select-unit"
          value="metric"
          options={[
            { value: 'metric', label: 'Metric (kg, cm)' },
            { value: 'imperial', label: 'Imperial (lbs, inches)' }
          ]}
        />
        
        <div id="inputs-metric">
          <InputField label="Weight (kg)" name="weightKg" value={70} min={1} step={0.1} />
          <InputField label="Height (cm)" name="heightCm" value={175} min={10} step={0.1} />
        </div>
        
        <div id="inputs-imperial" class="hidden">
          <InputField label="Weight (lbs)" name="weightLbs" value={150} min={1} step={0.1} />
          <InputField label="Height (inches)" name="heightIn" value={70} min={10} step={0.1} />
        </div>

        <div class="mt-6">
          <CalculateButton text="Calculate BMI" icon="⚖️" id="calculate-btn" />
        </div>
      </form>

      <!-- Results -->
      <div id="results-section" class="hidden space-y-8 mb-12 max-w-2xl mx-auto">
        <div class="result-surface p-6 md:p-8 rounded-xl border bg-white/[0.02] text-center" id="result-summary">
          <p class="label mb-2 text-sm font-medium text-zinc-500 uppercase tracking-wider">Your BMI Is</p>
          <p class="text-6xl font-bold text-white mb-4" id="result-bmi">0</p>
          <div class="inline-block px-4 py-2 rounded-full font-bold text-sm tracking-wide" id="result-category">
            CATEGORY
          </div>
          
          <div class="mt-8 pt-8 border-t border-white/[0.05]">
             <p class="text-zinc-400 text-sm mb-4">BMI Categories:</p>
             <div class="flex justify-between text-xs font-mono text-zinc-500 gap-2">
                <div class="flex-1 text-blue-400">Underweight<br/>&lt; 18.5</div>
                <div class="flex-1 text-green-400">Normal<br/>18.5 - 24.9</div>
                <div class="flex-1 text-orange-400">Overweight<br/>25 - 29.9</div>
                <div class="flex-1 text-red-400">Obese<br/>&gt; 30</div>
             </div>
          </div>
          
          <div class="mt-8 flex justify-center">
             <SaveResultButton id="save-bmi-btn" />
           </div>
        </div>
      </div>
      <!-- Reference Table -->
      <div class="result-surface mb-12 p-6 md:p-8 bg-[#0d0d14] border border-white/[0.06] rounded-xl max-w-2xl mx-auto">
        <h2 class="text-xl font-bold text-white mb-4">Adult BMI Weight Status Brackets</h2>
        <p class="text-sm text-zinc-400 mb-4">Clinical reference standards established by the World Health Organization.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300 border-collapse">
            <thead>
              <tr class="border-b border-white/10 text-white font-semibold">
                <th class="py-2.5 px-3">BMI Range</th>
                <th class="py-2.5 px-3">Category</th>
                <th class="py-2.5 px-3">Health Implication</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr>
                <td class="py-2.5 px-3 font-mono text-[#60a5fa]">&lt; 18.5</td>
                <td class="py-2.5 px-3 font-semibold text-white">Underweight</td>
                <td class="py-2.5 px-3 text-zinc-400">Increased risk of nutrient deficiency</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">18.5 – 24.9</td>
                <td class="py-2.5 px-3 font-semibold text-[#2dd4bf]">Normal Weight</td>
                <td class="py-2.5 px-3 text-[#2dd4bf]">Lowest risk of metabolic disorders</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-mono text-[#facc15]">25.0 – 29.9</td>
                <td class="py-2.5 px-3 font-semibold text-white">Overweight</td>
                <td class="py-2.5 px-3 text-zinc-400">Moderate cardiovascular risk</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-mono text-[#ef4444]">&ge; 30.0</td>
                <td class="py-2.5 px-3 font-semibold text-[#ef4444]">Obesity</td>
                <td class="py-2.5 px-3 text-zinc-400">High risk of chronic disease</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mb-12 max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Questions</h2>
        <FAQAccordion items={faqItems} id="general-bmi-faq" />
      </div>

      <ToolShare title="BMI Calculator" url="https://solverspro.com/health/bmi-calculator" />
      <SimilarTools category="health" currentPath="/health/bmi-calculator" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const unitSelect = document.getElementById('select-unit') as HTMLSelectElement;
  
  // Init Measurement System
  try {
    const prefs = JSON.parse(localStorage.getItem('solvers_preferences') || '{}');
    if (prefs.measurementSystem && unitSelect) {
      unitSelect.value = prefs.measurementSystem;
      document.getElementById('inputs-metric')?.classList.add('hidden');
      document.getElementById('inputs-imperial')?.classList.add('hidden');
      document.getElementById(`inputs-${prefs.measurementSystem}`)?.classList.remove('hidden');
    }
  } catch(e) {}
  
  unitSelect?.addEventListener('change', (e) => {
    document.getElementById('inputs-metric')?.classList.add('hidden');
    document.getElementById('inputs-imperial')?.classList.add('hidden');
    const unit = (e.target as HTMLSelectElement).value;
    document.getElementById(`inputs-${unit}`)?.classList.remove('hidden');
    document.getElementById('results-section')?.classList.add('hidden');
  });

  function calculate() {
    const unit = unitSelect?.value;
    const btn = document.getElementById('calculate-btn');
    btn?.setAttribute('data-loading', 'true');

    setTimeout(() => {
      let bmi = 0;
      if (unit === 'metric') {
        const kg = parseFloat((document.getElementById('input-weightKg') as HTMLInputElement)?.value) || 0;
        const cm = parseFloat((document.getElementById('input-heightCm') as HTMLInputElement)?.value) || 0;
        const m = cm / 100;
        if (m > 0 && kg > 0) {
          bmi = kg / (m * m);
        }
      } else {
        const lbs = parseFloat((document.getElementById('input-weightLbs') as HTMLInputElement)?.value) || 0;
        const inc = parseFloat((document.getElementById('input-heightIn') as HTMLInputElement)?.value) || 0;
        if (inc > 0 && lbs > 0) {
          bmi = 703 * (lbs / (inc * inc));
        }
      }

      if (bmi > 0) {
        const bmiFormatted = bmi.toFixed(1);
        document.getElementById('result-bmi')!.textContent = bmiFormatted;
        const categoryEl = document.getElementById('result-category');
        let categoryText = "UNKNOWN";
        
        if (categoryEl) {
          categoryEl.classList.remove('bg-blue-500/20', 'text-blue-400', 'bg-green-500/20', 'text-green-400', 'bg-orange-500/20', 'text-orange-400', 'bg-red-500/20', 'text-red-400');
          if (bmi < 18.5) {
            categoryText = "UNDERWEIGHT";
            categoryEl.classList.add('bg-blue-500/20', 'text-blue-400');
          } else if (bmi < 25) {
            categoryText = "NORMAL WEIGHT";
            categoryEl.classList.add('bg-green-500/20', 'text-green-400');
          } else if (bmi < 30) {
            categoryText = "OVERWEIGHT";
            categoryEl.classList.add('bg-orange-500/20', 'text-orange-400');
          } else {
            categoryText = "OBESE";
            categoryEl.classList.add('bg-red-500/20', 'text-red-400');
          }
          categoryEl.textContent = categoryText;
        }
        document.getElementById('results-section')?.classList.remove('hidden');
        
        // Show save button
        const saveBtn = document.getElementById('save-bmi-btn');
        if (saveBtn) {
          saveBtn.classList.remove('hidden');
          // Update click handler to save latest data
          saveBtn.onclick = () => {
            if (typeof window.saveToDashboard === 'function') {
              const success = window.saveToDashboard('BMI Calculator', '/health/bmi-calculator', {
                type: 'key-value',
                data: {
                  'Your BMI': bmiFormatted,
                  'Category': categoryText
                }
              });
              
              if (success) {
                const textEl = saveBtn.querySelector('.btn-text');
                const iconSave = saveBtn.querySelector('.icon-save');
                const iconCheck = saveBtn.querySelector('.icon-check');
                
                if (textEl) textEl.textContent = 'Saved!';
                if (iconSave) iconSave.classList.add('hidden');
                if (iconCheck) iconCheck.classList.remove('hidden');
                
                saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
                
                setTimeout(() => {
                  if (textEl) textEl.textContent = 'Save Result';
                  if (iconSave) iconSave.classList.remove('hidden');
                  if (iconCheck) iconCheck.classList.add('hidden');
                  saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                  saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
                }, 2000);
              }
            }
          };
        }
      }
      
      btn?.removeAttribute('data-loading');
    }, 300);
  }

  document.getElementById('calculator-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
</script>
