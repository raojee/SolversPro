---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "PDF to Images",
  "url": "https://solverspro.com/pdf/pdf-to-images/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Convert PDF pages into high-resolution PNG images locally in your browser with selectable DPI scaling, instant thumbnail previews, and single-click ZIP archive packaging.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqs = [
  {
    question: "How does the PDF to Image conversion process work?",
    answer: "The tool utilizes an in-browser PDF rendering engine to parse document vector instructions and rasterize each page directly onto an HTML5 Canvas element at your chosen DPI scale, exporting losslessly compressed PNG files."
  },
  {
    question: "What resolution or DPI should I choose for PDF page export?",
    answer: "Standard 72 DPI is optimal for quick web previews and minimal file size, 144 DPI balances crisp readability on Retina displays with modest file sizes, and 216 DPI provides high fidelity suitable for archiving and physical document reproduction."
  },
  {
    question: "Are my confidential PDF pages uploaded to an external server?",
    answer: "No. All rendering, canvas rasterization, and ZIP archive packaging occur strictly inside your local web browser. Your document never leaves your machine."
  },
  {
    question: "Can I download individual pages instead of the full ZIP package?",
    answer: "Yes. Once rendering completes, each page thumbnail includes an individual download button allowing you to save specific pages or grab the entire set bundled into a single ZIP file."
  }
];
---
<BaseLayout title="PDF to Images | SolversPro" description="Convert every PDF page into a high-quality PNG image. Preview and download individually or as a ZIP. Free, private, browser-based." jsonLd={jsonLd}>
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'PDF Tools',href:'/pdf/'},{label:'PDF to Images'}]} />
      <div class="mb-8 mt-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">PDF to Images</h1>
        <p class="text-zinc-300 max-w-2xl mx-auto text-base leading-relaxed">SolversPro PDF to Images is a free browser-based conversion utility that renders each page of a PDF document into high-resolution PNG image files with selectable DPI scaling and instant ZIP archive packaging without uploading files to remote servers.</p>
      </div>
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 space-y-6">
        <div id="drop-zone" class="border-2 border-dashed border-white/[0.1] rounded-xl p-10 text-center cursor-pointer hover:border-[#ff6b35]/50 hover:bg-[#ff6b35]/[0.02] transition-all">
          <div class="text-4xl mb-3">🖼️</div>
          <p class="text-white font-semibold mb-1">Drop PDF here or click to browse</p>
          <p class="text-zinc-500 text-sm">PDF files only</p>
          <input type="file" id="file-input" accept=".pdf" class="hidden" />
        </div>

        <!-- Options -->
        <div id="options" class="hidden grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Quality (DPI Scale)</label>
            <select id="scale-select" class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]">
              <option value="1">72 DPI — Preview</option>
              <option value="1.5">108 DPI — Standard</option>
              <option value="2" selected>144 DPI — High</option>
              <option value="3">216 DPI — Print</option>
            </select>
          </div>
          <div class="flex items-end">
            <button id="convert-btn" class="w-full py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">🖼️ Convert to Images</button>
          </div>
        </div>

        <div id="status" class="hidden">
          <div class="flex justify-between mb-2">
            <span id="status-text" class="text-zinc-400 text-sm"></span>
          </div>
          <div class="w-full bg-white/[0.05] rounded-full h-1.5">
            <div id="progress-fill" class="bg-[#ff6b35] h-1.5 rounded-full transition-all duration-300" style="width:0%"></div>
          </div>
        </div>

        <div id="output-section" class="hidden space-y-4">
          <div class="flex items-center justify-between">
            <p id="img-summary" class="text-sm text-zinc-400"></p>
            <div class="flex gap-2">
              <button id="download-all-btn" class="px-4 py-2 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white text-sm font-semibold rounded-lg transition-colors">⬇️ Download All (ZIP)</button>
              <button id="reset-btn" class="px-4 py-2 bg-white/[0.04] border border-white/[0.06] text-zinc-400 text-sm rounded-lg transition-colors hover:bg-white/[0.08]">↩ New File</button>
            </div>
          </div>
          <div id="image-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4"></div>
        </div>
      </div>

      <!-- Citable Reference Table -->
      <div class="mt-12 bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl font-bold text-white mb-4">PDF Rasterization Resolution & Dimensions Guide</h2>
        <p class="text-zinc-400 text-sm mb-6">Standard rendering dimensions and estimated memory footprint for common US Letter (8.5 &times; 11 in) and ISO A4 page dimensions across rasterization scales:</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300">
            <thead class="bg-white/[0.03] text-zinc-200 uppercase text-xs tracking-wider border-b border-white/[0.08]">
              <tr>
                <th class="py-3 px-4">Scale Factor</th>
                <th class="py-3 px-4">Effective DPI</th>
                <th class="py-3 px-4">US Letter Pixels (W &times; H)</th>
                <th class="py-3 px-4">A4 Pixels (W &times; H)</th>
                <th class="py-3 px-4">Primary Use Case</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.05]">
              <tr>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">1.0x</td>
                <td class="py-3 px-4 font-mono">72 DPI</td>
                <td class="py-3 px-4 font-mono">612 &times; 792 px</td>
                <td class="py-3 px-4 font-mono">595 &times; 842 px</td>
                <td class="py-3 px-4">Screen preview, compact web sharing</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">1.5x</td>
                <td class="py-3 px-4 font-mono">108 DPI</td>
                <td class="py-3 px-4 font-mono">918 &times; 1188 px</td>
                <td class="py-3 px-4 font-mono">893 &times; 1263 px</td>
                <td class="py-3 px-4">Standard desktop presentations</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">2.0x</td>
                <td class="py-3 px-4 font-mono">144 DPI</td>
                <td class="py-3 px-4 font-mono">1224 &times; 1584 px</td>
                <td class="py-3 px-4 font-mono">1190 &times; 1684 px</td>
                <td class="py-3 px-4">Retina displays, sharp typography reading</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">3.0x</td>
                <td class="py-3 px-4 font-mono">216 DPI</td>
                <td class="py-3 px-4 font-mono">1836 &times; 2376 px</td>
                <td class="py-3 px-4 font-mono">1785 &times; 2526 px</td>
                <td class="py-3 px-4">High-resolution printing, OCR intake</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <ToolFAQ faqs={faqs} />
      <ToolShare title="PDF to Images" url="https://solverspro.com/pdf/pdf-to-images" />
      <SimilarTools category="pdf" currentPath="/pdf/pdf-to-images" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  const PDFJS_VERSION = '3.11.174';
  let canvasDataUrls = [];

  function loadScript(src) {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
      const s = document.createElement('script'); s.src = src; s.onload = resolve; s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const optionsEl = document.getElementById('options');
  const convertBtn = document.getElementById('convert-btn');
  const statusEl = document.getElementById('status');
  const statusText = document.getElementById('status-text');
  const progressFill = document.getElementById('progress-fill');
  const outputSection = document.getElementById('output-section');
  const imageGrid = document.getElementById('image-grid');
  const imgSummary = document.getElementById('img-summary');

  let loadedFile = null;

  async function onFileLoaded(file) {
    loadedFile = file;
    dropZone.classList.add('hidden');
    optionsEl.classList.remove('hidden');
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', async (e) => { e.preventDefault(); const f = e.dataTransfer?.files[0]; if(f?.type==='application/pdf') await onFileLoaded(f); });
  fileInput.addEventListener('change', async () => { if(fileInput.files?.[0]) await onFileLoaded(fileInput.files[0]); });

  convertBtn.addEventListener('click', async () => {
    if (!loadedFile) return;
    const scale = parseFloat(document.getElementById('scale-select').value);
    optionsEl.classList.add('hidden');
    statusEl.classList.remove('hidden');
    outputSection.classList.add('hidden');
    canvasDataUrls = [];

    statusText.textContent = 'Loading PDF.js engine...';
    progressFill.style.width = '5%';

    await loadScript(`https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.min.js`);
    window.pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.worker.min.js`;

    const buffer = await loadedFile.arrayBuffer();
    const pdf = await window.pdfjsLib.getDocument({ data: buffer }).promise;
    const total = pdf.numPages;

    imageGrid.innerHTML = '';

    for (let i = 1; i <= total; i++) {
      statusText.textContent = `Rendering page ${i} of ${total}...`;
      progressFill.style.width = `${(i / total) * 95}%`;

      const page = await pdf.getPage(i);
      const viewport = page.getViewport({ scale });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width; canvas.height = viewport.height;
      const ctx = canvas.getContext('2d');
      await page.render({ canvasContext: ctx, viewport }).promise;

      const dataUrl = canvas.toDataURL('image/png');
      canvasDataUrls.push(dataUrl);

      const card = document.createElement('div');
      card.className = 'group relative bg-[#1a1a24] border border-white/[0.06] rounded-xl overflow-hidden';
      card.innerHTML = `
        <img src="${dataUrl}" alt="Page ${i}" class="w-full h-auto block" />
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <a href="${dataUrl}" download="page-${String(i).padStart(3,'0')}.png" 
             class="px-3 py-1.5 bg-[#ff6b35] text-white text-xs font-semibold rounded-lg">
             ⬇ Download
          </a>
        </div>
        <p class="text-xs text-zinc-500 text-center py-2">Page ${i}</p>
      `;
      imageGrid.appendChild(card);
    }

    progressFill.style.width = '100%';
    setTimeout(() => {
      statusEl.classList.add('hidden');
      imgSummary.textContent = `${total} page${total !== 1 ? 's' : ''} converted`;
      outputSection.classList.remove('hidden');
    }, 300);
  });

  document.getElementById('download-all-btn').addEventListener('click', async () => {
    if (canvasDataUrls.length === 0) return;
    const { default: JSZip } = await import('https://cdn.jsdelivr.net/npm/jszip@3.10.1/+esm');
    const zip = new JSZip();
    canvasDataUrls.forEach((dataUrl, i) => {
      const base64 = dataUrl.split(',')[1];
      zip.file(`page-${String(i+1).padStart(3,'0')}.png`, base64, { base64: true });
    });
    const blob = await zip.generateAsync({ type: 'blob' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'pdf-images.zip'; a.click();
  });

  document.getElementById('reset-btn').addEventListener('click', () => {
    fileInput.value = ''; loadedFile = null; canvasDataUrls = [];
    outputSection.classList.add('hidden'); optionsEl.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });
</script>
