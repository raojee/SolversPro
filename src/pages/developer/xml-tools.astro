---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import XmlEditor from '../../components/react/XmlEditor.jsx';
---

<BaseLayout
  title="XML Formatter & Validator | SolversPro"
  description="Format, validate, minify and convert XML documents into data tables. Privacy-first, runs entirely in your browser."
>
  <Header />
  <div class="container mx-auto px-4 py-12 max-w-[1400px]">
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <a href="/developer" class="text-zinc-500 hover:text-white transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </a>
        <h1 class="text-3xl md:text-4xl font-bold text-white">XML Formatter & Validator</h1>
      </div>
      <p class="text-zinc-400 max-w-3xl ml-8">
        Validate your XML markup, beautify or minify documents, and parse complex XML trees into readable data tables. All processing happens locally in your browser.
      </p>
    </div>

    <!-- React App -->
    <div class="min-h-[600px] h-[calc(100vh-250px)]">
      <XmlEditor client:load />
    </div>
  </div>
  <Footer />
</BaseLayout>
