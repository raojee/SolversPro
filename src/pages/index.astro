---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import InteractiveDemos from '../components/InteractiveDemos.astro';
import SmartWelcome from '../components/SmartWelcome.astro';

const tools = [
  {
    title: 'Universal AI Solver',
    description: 'Ask any math, engineering, or logic question. Our Gemini-powered AI breaks down the solution step-by-step.',
    icon: '🧠',
    href: '/solve'
  },
  {
    title: 'PDF Tools',
    description: 'Merge, split, protect, and flatten PDF files locally in your browser. Fast, 100% private and secure.',
    icon: '📄',
    href: '/tools'
  },
  {
    title: 'Mathematics',
    description: 'Solve complex equations, matrix operations, and unit conversions instantly.',
    icon: '📐',
    href: '/math'
  },
  {
    title: 'Financial Analysis',
    description: 'Lightning-fast financial calculations for investments, loans, and market analysis.',
    icon: '📊',
    href: '/finance'
  },
  {
    title: 'Health & Science',
    description: 'Accurate health metrics and scientific calculations running at the speed of light.',
    icon: '🧬',
    href: '/health'
  },
  {
    title: 'Developer Tools',
    description: 'Essential utilities for software engineers. Format payloads, validate syntax, and visualize complex JSON/XML structures.',
    icon: '💻',
    href: '/developer'
  },
  {
    title: 'Trades & Engineering',
    description: 'Instant step-by-step solutions for complex engineering problems with precision tools.',
    icon: '🏗️',
    href: '/trades'
  },
  {
    title: 'Security Tools',
    description: 'Generate strong passwords, check strength, and protect your accounts. 100% private.',
    icon: '🔐',
    href: '/security'
  },
  {
    title: 'Text Tools',
    description: 'Count words, translate Morse code, and more. Real-time text analysis for writers and developers.',
    icon: '📝',
    href: '/text'
  },
  {
    title: 'Network Tools',
    description: 'IP subnet calculators, my IP checker, and essential networking utilities for sysadmins.',
    icon: '🌐',
    href: '/network'
  },
  {
    title: 'QR Code Tools',
    description: 'Generate QR codes for URLs, text, WiFi, and more. Customize and download as PNG instantly.',
    icon: '📱',
    href: '/qr'
  },
  {
    title: 'All Tools Collection',
    description: 'View our complete collection of 60+ free online calculators, converters, and developer utilities in one place.',
    icon: '🧰',
    href: '/all-tools'
  }
];

const testimonials = [
  {
    quote: "As the creator of SolversPro, my goal was to build the fastest, most private suite of tools on the web. I use these tools myself every day, ensuring they meet the highest standards of performance and security.",
    author: "Tahir Rao",
    role: "Founder & Lead Developer",
    linkedin: "https://www.linkedin.com/in/tahirrao/"
  },
  {
    quote: "SolversPro is my go-to for API debugging. The JSON Formatter and Base64 Decoder load instantly without trackers, saving me hours of back-and-forth each week.",
    author: "Sarah Johnson",
    role: "Senior Backend Developer"
  },
  {
    quote: "I use the Compound Interest and ROI calculators with clients daily. The fact that it's 100% client-side means our financial scenarios stay completely private on my iPad.",
    author: "Marcus Williams",
    role: "Financial Advisor"
  }
];
---

<BaseLayout
  title="SolversPro | Solve Anything. Instantly."
  description="Free, lightning-fast, client-side calculation engines for engineering, finance, and health. All running at the speed of light, right in your browser."
>
  <link rel="preload" as="image" href="/hero-dark-tech.webp" fetchpriority="high" slot="head" />
  <Header />

  <main id="main-content" class="flex-1">
  <!-- Hero Section -->
  <section class="relative pt-24 pb-32 overflow-hidden border-b border-white/[0.06]">
    <!-- Abstract Background Element -->
    <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
      <img src="/hero-dark-tech.webp" alt="SolversPro precision computing background" fetchpriority="high" loading="eager" decoding="async" class="w-full h-full object-cover object-top opacity-50 mix-blend-screen" />
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Text Column -->
        <div class="max-w-2xl">
          <div class="mb-6">
            <span class="scifi-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              PRECISION COMPUTING
            </span>
          </div>
          
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-6 text-white tracking-tight leading-[1.1]">
            Master <span id="hero-dynamic-text" class="inline-block transition-opacity duration-300 min-w-[200px] sm:min-w-[320px]">Math</span> <br />
            <span class="text-[#ff6b35]">with Intelligence</span>
          </h1>
          
          <p class="text-lg sm:text-xl text-zinc-400 mb-10 max-w-lg leading-relaxed">
            Free, lightning-fast, client-side calculation engines for engineering, finance, and health. All running at the speed of light, right in your browser.
          </p>
          
          <div class="flex flex-wrap items-center gap-4 mb-12">
            <a href="/solve" class="px-8 py-3.5 bg-[#2dd4bf] hover:bg-[#5eead4] text-slate-900 rounded font-semibold text-sm transition-all shadow-[0_0_15px_rgba(45,212,191,0.3)] hover:shadow-[0_0_25px_rgba(45,212,191,0.5)] flex items-center gap-2" style="font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em;">
              Start Calculating
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/dashboard" class="px-8 py-3.5 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white rounded font-semibold text-sm transition-all shadow-[0_0_15px_rgba(255,107,53,0.3)] flex items-center gap-2" style="font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em;">
              My Dashboard
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            </a>
            <a href="/docs" aria-label="Explore SolversPro documentation and tool guides" class="px-8 py-3.5 bg-transparent border border-white/[0.2] hover:border-white/[0.4] text-white rounded font-semibold text-sm transition-all" style="font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em;">
              Explore Docs
            </a>
          </div>

          <div class="pt-6 border-t border-white/[0.06]">
            <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-4" style="font-family: 'JetBrains Mono', monospace;">Trusted By &amp; Built With</p>
            <div class="flex items-center gap-4 text-sm text-white font-medium flex-wrap" style="font-family: 'JetBrains Mono', monospace;">
              <span>60+ Tools</span>
              <span class="text-[#ff6b35]">•</span>
              <span>100% Client-Side</span>
              <span class="text-[#ff6b35]">•</span>
              <span>Zero Data Stored</span>
              <span class="text-[#ff6b35]">•</span>
              <span class="inline-flex items-center gap-1.5 text-[#2dd4bf]">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                No Account Needed
              </span>
            </div>
          </div>
        </div>

        <!-- AI Typing Demo Column -->
        <div class="hidden lg:block relative">
          <div class="absolute inset-0 bg-gradient-to-tr from-[#2dd4bf]/20 to-[#ff6b35]/20 blur-3xl opacity-50 rounded-full"></div>
          <div class="relative bg-[#0d0d14]/80 border border-white/[0.1] rounded-2xl p-6 shadow-2xl backdrop-blur-md" style="font-family: 'JetBrains Mono', monospace;">
            <!-- Mac style dots -->
            <div class="flex gap-2 mb-6">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            
            <div class="space-y-4 text-sm">
              <!-- User Input -->
              <div class="flex gap-3 text-zinc-300 items-start">
                <span class="text-[#2dd4bf] mt-0.5">❯</span>
                <div class="flex-1">
                  <span id="ai-typing-text"></span><span id="ai-typing-cursor" class="animate-pulse w-2 h-4 bg-[#2dd4bf] inline-block ml-1 align-middle"></span>
                </div>
              </div>
              
              <!-- AI Response (Hidden initially) -->
              <div id="ai-response-box" class="hidden opacity-0 transition-opacity duration-700 pt-5 border-t border-white/[0.06]">
                <div class="flex gap-3 text-white">
                  <span class="text-[#ff6b35] text-lg">🤖</span>
                  <div class="space-y-3 flex-1">
                    <p class="text-[#2dd4bf] font-bold">Step-by-step Solution:</p>
                    <p class="text-zinc-400">1. Apply the power rule: <span class="text-zinc-300">d/dx(x^n) = n*x^(n-1)</span></p>
                    <p class="text-zinc-400">2. Derivative of 4x² = 4 * 2x^(2-1) = <span class="text-white">8x</span></p>
                    <p class="text-zinc-400">3. Derivative of 3x = 3 * 1x^(1-1) = <span class="text-white">3</span></p>
                    <div class="mt-4 p-4 bg-white/[0.03] rounded-xl border border-white/[0.05]">
                      <p class="text-lg font-bold text-white">Result: <span class="text-[#ff6b35]">8x + 3</span></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SmartWelcome />

  <InteractiveDemos />

  <!-- World Clock & Timezone Section -->
  <section class="py-20 border-b border-white/[0.06]" style="background: linear-gradient(180deg, #08080f 0%, #0d0d14 100%);">
    <div class="container mx-auto px-4">
      <div class="mb-12 text-center">
        <span class="scifi-badge mb-6 inline-flex mx-auto">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          WORLD CLOCK
        </span>
        <h2 class="text-4xl font-bold text-white mb-4">Live Time & Timezone Comparison</h2>
        <p class="text-zinc-400 max-w-xl mx-auto text-lg">See your current local time and compare it against any timezone in the world — instantly.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">

        <!-- Local Clock Card -->
        <div class="relative bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 text-center overflow-hidden group hover:border-white/[0.12] transition-all">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none" style="background: radial-gradient(ellipse at 50% 0%, rgba(45,212,191,0.06) 0%, transparent 70%);"></div>
          <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-6 flex items-center justify-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#2dd4bf] animate-pulse inline-block"></span>
            Your Local Time
          </p>
          <div id="local-time" class="text-6xl sm:text-7xl font-bold text-white font-mono tabular-nums tracking-tight mb-3">--:--:--</div>
          <span id="local-ampm" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-[#2dd4bf]/10 text-[#2dd4bf] border border-[#2dd4bf]/20 mb-4">--</span>
          <div id="local-date" class="text-lg text-zinc-300 font-medium mb-2"></div>
          <div id="local-tz-name" class="text-xs text-zinc-600 font-mono mt-2"></div>
          <div id="local-offset" class="text-xs text-zinc-600 font-mono mt-1"></div>
        </div>

        <!-- Timezone Comparison Card -->
        <div class="relative bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 overflow-hidden group hover:border-white/[0.12] transition-all">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none" style="background: radial-gradient(ellipse at 50% 0%, rgba(255,107,53,0.06) 0%, transparent 70%);"></div>

          <label for="tz-select" class="block text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-4">Compare With Timezone</label>

          <select id="tz-select" aria-label="Compare with timezone"
            class="w-full p-3 bg-[#1a1a24] border border-white/[0.08] rounded-xl text-sm text-zinc-300 focus:ring-1 focus:ring-[#ff6b35] focus:outline-none cursor-pointer mb-6 font-mono">
            <optgroup label="Africa">
              <option value="Africa/Cairo">Cairo (Egypt)</option>
              <option value="Africa/Lagos">Lagos (Nigeria)</option>
              <option value="Africa/Johannesburg">Johannesburg (South Africa)</option>
              <option value="Africa/Nairobi">Nairobi (Kenya)</option>
            </optgroup>
            <optgroup label="Asia">
              <option value="Asia/Dubai">Dubai (UAE)</option>
              <option value="Asia/Karachi">Karachi (Pakistan)</option>
              <option value="Asia/Kolkata">Mumbai / Delhi (India)</option>
              <option value="Asia/Dhaka">Dhaka (Bangladesh)</option>
              <option value="Asia/Bangkok">Bangkok (Thailand)</option>
              <option value="Asia/Singapore">Singapore</option>
              <option value="Asia/Shanghai">Beijing / Shanghai (China)</option>
              <option value="Asia/Tokyo">Tokyo (Japan)</option>
              <option value="Asia/Seoul">Seoul (South Korea)</option>
              <option value="Asia/Riyadh">Riyadh (Saudi Arabia)</option>
              <option value="Asia/Tehran">Tehran (Iran)</option>
              <option value="Asia/Kabul">Kabul (Afghanistan)</option>
              <option value="Asia/Colombo">Colombo (Sri Lanka)</option>
              <option value="Asia/Kathmandu">Kathmandu (Nepal)</option>
              <option value="Asia/Tashkent">Tashkent (Uzbekistan)</option>
            </optgroup>
            <optgroup label="Europe">
              <option value="Europe/London">London (UK)</option>
              <option value="Europe/Paris">Paris (France)</option>
              <option value="Europe/Berlin">Berlin (Germany)</option>
              <option value="Europe/Rome">Rome (Italy)</option>
              <option value="Europe/Madrid">Madrid (Spain)</option>
              <option value="Europe/Amsterdam">Amsterdam (Netherlands)</option>
              <option value="Europe/Moscow">Moscow (Russia)</option>
              <option value="Europe/Istanbul">Istanbul (Turkey)</option>
              <option value="Europe/Zurich">Zurich (Switzerland)</option>
              <option value="Europe/Stockholm">Stockholm (Sweden)</option>
            </optgroup>
            <optgroup label="Americas">
              <option value="America/New_York">New York (EST)</option>
              <option value="America/Chicago">Chicago (CST)</option>
              <option value="America/Denver">Denver (MST)</option>
              <option value="America/Los_Angeles">Los Angeles (PST)</option>
              <option value="America/Toronto">Toronto (Canada)</option>
              <option value="America/Vancouver">Vancouver (Canada)</option>
              <option value="America/Sao_Paulo">Sao Paulo (Brazil)</option>
              <option value="America/Argentina/Buenos_Aires">Buenos Aires (Argentina)</option>
              <option value="America/Mexico_City">Mexico City</option>
              <option value="America/Bogota">Bogota (Colombia)</option>
            </optgroup>
            <optgroup label="Pacific / Oceania">
              <option value="Australia/Sydney">Sydney (Australia)</option>
              <option value="Australia/Melbourne">Melbourne (Australia)</option>
              <option value="Pacific/Auckland">Auckland (New Zealand)</option>
              <option value="Pacific/Honolulu">Honolulu (Hawaii)</option>
            </optgroup>
            <optgroup label="UTC">
              <option value="UTC">UTC (Coordinated Universal Time)</option>
            </optgroup>
          </select>

          <div class="text-center">
            <div id="tz-time" class="text-6xl sm:text-7xl font-bold text-[#ff6b35] font-mono tabular-nums tracking-tight mb-3">--:--:--</div>
            <span id="tz-ampm" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-[#ff6b35]/10 text-[#ff6b35] border border-[#ff6b35]/20 mb-4">--</span>
            <div id="tz-date" class="text-lg text-zinc-300 font-medium mb-5"></div>
            <div id="tz-diff" class="inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-bold border transition-all"></div>
          </div>
        </div>
      </div>

      <!-- Quick timezone pills -->
      <div class="mt-6 flex flex-wrap justify-center gap-2 max-w-5xl mx-auto" id="tz-pills">
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="UTC">UTC</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="America/New_York">🇺🇸 New York</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="Europe/London">🇬🇧 London</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="Europe/Berlin">🇩🇪 Berlin</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="Asia/Dubai">🇦🇪 Dubai</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="Asia/Kolkata">🇮🇳 India</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="Asia/Singapore">🇸🇬 Singapore</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="Asia/Tokyo">🇯🇵 Tokyo</button>
        <button class="tz-pill px-4 py-1.5 text-xs font-semibold bg-white/[0.04] hover:bg-[#2dd4bf]/10 border border-white/[0.06] hover:border-[#2dd4bf]/30 hover:text-[#2dd4bf] text-zinc-400 rounded-full transition-all" data-tz="Australia/Sydney">🇦🇺 Sydney</button>
      </div>
    </div>
  </section>

  <!-- Capabilities Section -->
  <section class="py-24 border-b border-white/[0.06] bg-[#0d0d14]">
    <div class="container mx-auto px-4">
      <div class="mb-16">
        <span class="scifi-badge mb-6">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          CAPABILITIES
        </span>
        <h2 class="text-4xl font-bold text-white mb-4">What We Offer</h2>
        <p class="text-lg text-zinc-400 max-w-2xl">
          Powerful calculation engines designed for professionals who demand precision and speed.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tools.map(tool => (
          <ToolCard {...tool} />
        ))}
      </div>
    </div>
  </section>

  <!-- AI Solver Preview Section -->
  <section class="py-24 border-b border-white/[0.06] bg-[#0d0d14] relative overflow-hidden">
    <!-- Abstract glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[#ff6b35]/5 rounded-full blur-[120px] pointer-events-none"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex flex-col lg:flex-row gap-16 items-center">
        <div class="lg:w-1/2">
          <span class="scifi-badge mb-6">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            FLAGSHIP FEATURE
          </span>
          <h2 class="text-4xl font-bold text-white mb-6 leading-tight">Universal AI Solver</h2>
          <p class="text-lg text-zinc-400 mb-8 leading-relaxed">
            Stop searching for scattered formulas. Our Gemini-powered AI engine understands complex math, engineering physics, and logical problems—breaking them down into clear, step-by-step solutions instantly.
          </p>
          <a href="/solve?q=Integrate+x%5E2+*+sin(x)" class="px-8 py-3.5 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white rounded font-bold text-sm transition-all shadow-[0_0_15px_rgba(255,107,53,0.3)] inline-flex items-center gap-2">
            Try an Example
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        
        <div class="lg:w-1/2 w-full">
          <div class="bg-[#0a0a0f] border border-white/[0.1] rounded-xl overflow-hidden shadow-2xl relative">
            <div class="flex items-center px-4 py-3 bg-[#0d0d14] border-b border-white/[0.05]">
              <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
              </div>
              <div class="mx-auto text-xs font-mono text-zinc-500">solvers-pro-terminal</div>
            </div>
            <div class="p-6 font-mono text-sm leading-relaxed overflow-x-auto">
              <div class="text-zinc-400 mb-4"><span class="text-[#2dd4bf]">&gt;</span> Calculate the derivative of f(x) = x² · ln(x)</div>
              <div class="text-white space-y-3 pl-4 border-l border-white/[0.1]">
