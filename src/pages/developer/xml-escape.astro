---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "XML Entity Escape & Unescape",
  "url": "https://solverspro.com/developer/xml-escape/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online XML entity escaper and unescaper for the five predefined XML entities: &amp;, &lt;, &gt;, &quot;, and &apos; client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="XML Entity Escape & Unescape | SolversPro"
  description="Escape XML special characters or unescape XML entities. Safely embed text in XML documents. Free and browser-based."
  canonical="https://solverspro.com/developer/xml-escape/"
  schema={schema}
>
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Developer Tools',href:'/developer'},{label:'XML Escape & Unescape'}]} />
      
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">📐 XML Escape & Unescape</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro XML Escape & Unescape Tool is a free browser-based utility that encodes special characters into the 5 standard W3C XML entities (&amp;amp;, &amp;lt;, &amp;gt;, &amp;quot;, &amp;apos;) and decodes entities back to plain text.
        </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full min-h-[500px]">
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Unescaped Text</h2>
            <button id="btn-escape" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Escape &rarr;</button>
          </div>
          <textarea id="input-raw" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]" placeholder='<tag attr="value">5 > 3 & 2 < 4</tag>' spellcheck="false"></textarea>
        </div>
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <button id="btn-unescape" class="px-3 py-1.5 text-xs font-semibold bg-[#ff6b35]/20 hover:bg-[#ff8c5a]/30 text-[#ff6b35] rounded transition-colors border border-[#ff6b35]/30">&larr; Unescape</button>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Escaped Text</h2>
          </div>
          <textarea id="input-escaped" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]" placeholder="&amp;lt;tag attr=&amp;quot;value&amp;quot;&amp;gt;" spellcheck="false"></textarea>
        </div>
      </div>

      <!-- Reference Table -->
      <div class="mt-10 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-base font-bold text-white mb-2">W3C Predefined XML Entity Reference</h2>
        <p class="text-xs text-zinc-400 mb-4">The five standard XML predefined entities and numeric character references.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-300">
                <th class="py-2.5 px-3 font-semibold">Character</th>
                <th class="py-2.5 px-3 font-semibold">Character Name</th>
                <th class="py-2.5 px-3 font-semibold">Predefined Entity</th>
                <th class="py-2.5 px-3 font-semibold">Decimal Reference</th>
                <th class="py-2.5 px-3 font-semibold">Hex Reference</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-400 font-mono">
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">&amp;</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Ampersand</td>
                <td class="py-2 px-3 text-emerald-400">&amp;amp;</td>
                <td class="py-2 px-3">&amp;#38;</td>
                <td class="py-2 px-3">&amp;#x26;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">&lt;</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Less-than</td>
                <td class="py-2 px-3 text-emerald-400">&amp;lt;</td>
                <td class="py-2 px-3">&amp;#60;</td>
                <td class="py-2 px-3">&amp;#x3C;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">&gt;</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Greater-than</td>
                <td class="py-2 px-3 text-emerald-400">&amp;gt;</td>
                <td class="py-2 px-3">&amp;#62;</td>
                <td class="py-2 px-3">&amp;#x3E;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">"</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Double Quote</td>
                <td class="py-2 px-3 text-emerald-400">&amp;quot;</td>
                <td class="py-2 px-3">&amp;#34;</td>
                <td class="py-2 px-3">&amp;#x22;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">'</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Apostrophe</td>
                <td class="py-2 px-3 text-emerald-400">&amp;apos;</td>
                <td class="py-2 px-3">&amp;#39;</td>
                <td class="py-2 px-3">&amp;#x27;</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={[
        {
          question: "What are the 5 predefined XML entities?",
          answer: "W3C XML standard defines five predefined entities: &amp;amp; (&), &amp;lt; (<), &amp;gt; (>), &amp;quot; (\"), and &amp;apos; (')."
        },
        {
          question: "Does XML require escaping single quotes?",
          answer: "Inside XML attribute values delimited by single quotes, apostrophes must be escaped as &amp;apos; to maintain document well-formedness."
        },
        {
          question: "Does this tool transmit XML strings to a server?",
          answer: "No, all character conversions execute client-side directly in your browser."
        },
        {
          question: "Is this tool free?",
          answer: "Yes, the SolversPro XML Escape tool is completely free with no usage limits."
        }
      ]} />

      <ToolShare title="XML Escape & Unescape" url="https://solverspro.com/developer/xml-escape" />
      <SimilarTools category="developer" currentPath="/developer/xml-escape" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const rawEl = document.getElementById('input-raw') as HTMLTextAreaElement;
  const escEl = document.getElementById('input-escaped') as HTMLTextAreaElement;

  function escapeXml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');
  }
  function unescapeXml(s: string): string {
    return s.replace(/&apos;/g,"'").replace(/&quot;/g,'"').replace(/&gt;/g,'>').replace(/&lt;/g,'<').replace(/&amp;/g,'&');
  }

  document.getElementById('btn-escape')?.addEventListener('click', () => {
    escEl.value = escapeXml(rawEl.value);
    escEl.classList.add('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]');
    setTimeout(() => escEl.classList.remove('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]'), 500);
  });
  document.getElementById('btn-unescape')?.addEventListener('click', () => {
    rawEl.value = unescapeXml(escEl.value);
    rawEl.classList.add('ring-2','ring-[#ff6b35]','border-[#ff6b35]');
    setTimeout(() => rawEl.classList.remove('ring-2','ring-[#ff6b35]','border-[#ff6b35]'), 500);
  });
</script>
