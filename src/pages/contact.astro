---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
---

<BaseLayout
  title="Contact Us | SolversPro"
  description="Get in touch with the SolversPro team. Send us your questions, feedback, or tool suggestions."
  canonical="https://solverspro.com/contact"
>
  <Header />
  <SearchOverlay />
  
  <main class="flex-1 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="mb-12">
        <span class="scifi-badge mb-6">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          GET IN TOUCH
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Contact Us</h1>
        <p class="text-lg text-zinc-400 max-w-2xl">
          Have a question, feedback, or a suggestion for a new tool? We'd love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Info -->
        <div class="space-y-6 pt-2">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded border border-white/[0.1] bg-white/[0.03] flex items-center justify-center text-[#2dd4bf] flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <p class="text-white font-bold text-sm mb-1" style="font-family: 'JetBrains Mono', monospace;">Email</p>
              <a href="mailto:support@solverspro.com" class="text-zinc-400 text-sm hover:text-[#2dd4bf] transition-colors">support@solverspro.com</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded border border-white/[0.1] bg-white/[0.03] flex items-center justify-center text-[#2dd4bf] flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </div>
            <div>
              <p class="text-white font-bold text-sm mb-1" style="font-family: 'JetBrains Mono', monospace;">Twitter / X</p>
              <a href="https://x.com/solverspro_com" target="_blank" rel="noopener noreferrer" class="text-zinc-400 text-sm hover:text-[#2dd4bf] transition-colors">@solverspro_com</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded border border-white/[0.1] bg-white/[0.03] flex items-center justify-center text-[#2dd4bf] flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </div>
            <div>
              <p class="text-white font-bold text-sm mb-1" style="font-family: 'JetBrains Mono', monospace;">GitHub</p>
              <a href="https://github.com/raojee/SolversPro" target="_blank" rel="noopener noreferrer" class="text-zinc-400 text-sm hover:text-[#2dd4bf] transition-colors">github.com/raojee/SolversPro</a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-2 bg-white/[0.02] border border-white/[0.06] rounded-xl p-8">
          <form id="contact-form" class="space-y-5">
            <!-- Web3Forms — get your free key at https://web3forms.com -->
            <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY">
            <input type="hidden" name="subject" value="New Contact Message — SolversPro">
            <input type="hidden" name="from_name" value="SolversPro Contact Form">
            <input type="checkbox" name="botcheck" class="hidden" style="display:none">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold uppercase text-zinc-400 mb-2" style="font-family: 'JetBrains Mono', monospace;">Full Name</label>
                <input type="text" name="name" required placeholder="Jane Doe"
                  class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-lg py-2.5 px-3 focus:border-[#ff6b35] focus:outline-none transition-colors placeholder:text-zinc-600" />
              </div>
              <div>
                <label class="block text-xs font-semibold uppercase text-zinc-400 mb-2" style="font-family: 'JetBrains Mono', monospace;">Email Address</label>
                <input type="email" name="email" required placeholder="jane@example.com"
                  class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-lg py-2.5 px-3 focus:border-[#ff6b35] focus:outline-none transition-colors placeholder:text-zinc-600" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase text-zinc-400 mb-2" style="font-family: 'JetBrains Mono', monospace;">Message</label>
              <textarea name="message" rows="5" required placeholder="How can we help you?"
                class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-lg py-2.5 px-3 focus:border-[#ff6b35] focus:outline-none transition-colors resize-none placeholder:text-zinc-600"></textarea>
            </div>

            <button type="submit" id="contact-submit"
              class="w-full py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-slate-950 rounded-lg font-bold text-sm transition-all shadow-[0_0_15px_rgba(255,107,53,0.3)] flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
              style="font-family: 'JetBrains Mono', monospace;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/></svg>
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerHTML = `<svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Sending...`;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const result = await response.json();

      if (result.success) {
        (window as any).showToast?.("Message sent! We'll get back to you soon.", 'success', 5000);
        form.reset();
      } else {
        throw new Error(result.message || 'Submission failed');
      }
    } catch {
      (window as any).showToast?.('Failed to send. Please email us directly at support@solverspro.com', 'error', 7000);
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/></svg> Send Message`;
    }
  });
</script>
