---
// src/components/SimilarTools.astro
import { toolsByCategory } from '../data/tools';
import ToolCard from './ToolCard.astro';

interface Props {
  category: string;
  currentPath: string;
}

const { category, currentPath } = Astro.props;

// Get tools in the same category, excluding the current tool
const allInCategory = toolsByCategory[category] || [];
const similarTools = allInCategory
  .filter(tool => tool.href !== currentPath)
  .slice(0, 3);
---

{similarTools.length > 0 && (
  <div class="mt-12 pt-8 border-t border-white/[0.06]">
    <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-6 flex items-center gap-2">
      <svg class="w-4 h-4 text-[#ff6b35]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      Similar Tools
    </h3>
    <div class="grid md:grid-cols-3 gap-6">
      {similarTools.map((tool) => (
        <ToolCard 
          title={tool.title}
          description={tool.description}
          icon={tool.icon}
          href={tool.href}
        />
      ))}
    </div>
  </div>
)}
