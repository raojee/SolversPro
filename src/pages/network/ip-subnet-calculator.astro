---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "IP Subnet Calculator",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Calculate IP subnet details including network address, broadcast, host range, subnet mask, and usable hosts. Supports CIDR notation. 100% client-side."
};
---

<BaseLayout
  title="IP Subnet Calculator | SolversPro"
  description="Calculate network address, broadcast address, subnet mask, host range, and usable hosts for any IPv4 subnet. Supports CIDR notation. Free & runs in your browser."
  canonical="https://solverspro.com/network/ip-subnet-calculator"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-3xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Network Tools', href: '/network' },
        { label: 'IP Subnet Calculator' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🌐 IP Subnet Calculator</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">Enter an IPv4 address with CIDR notation or subnet mask to instantly calculate all subnet details — network, broadcast, host range, and more.</p>
      </div>

      <!-- Input Section -->
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6 mb-6">
        <div class="flex flex-col sm:flex-row gap-4">
          <!-- IP Input -->
          <div class="flex-1">
            <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">IP Address</label>
            <input
              id="ip-input"
              type="text"
              value="192.168.1.0"
              class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white font-mono text-lg focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600"
              placeholder="e.g. 192.168.1.0"
            />
          </div>

          <!-- CIDR / Prefix Length -->
          <div class="w-full sm:w-40">
            <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Prefix (CIDR)</label>
            <div class="flex items-center gap-2">
              <span class="text-zinc-500 font-mono text-lg">/</span>
              <select id="cidr-select"
                class="flex-1 px-3 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white font-mono text-lg focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none cursor-pointer"
              >
                {Array.from({ length: 33 }, (_, i) => i).map(n => (
                  <option value={n} selected={n === 24}>{n}</option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <!-- Or subnet mask input -->
        <div class="mt-4">
          <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Or Enter Subnet Mask</label>
          <input
            id="mask-input"
            type="text"
            class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white font-mono text-base focus:ring-1 focus:ring-[#ff6b35] focus:outline-none placeholder-zinc-600"
            placeholder="e.g. 255.255.255.0"
          />
        </div>

        <button id="btn-calculate"
          class="mt-5 w-full py-3.5 bg-[#ff6b35] hover:bg-[#ff8555] active:scale-[0.98] text-white font-bold rounded-xl transition-all shadow-lg shadow-[#ff6b35]/20 text-base"
        >
          Calculate Subnet
        </button>

        <div id="error-msg" class="hidden mt-3 text-red-400 text-sm text-center bg-red-500/10 border border-red-500/20 rounded-lg py-2"></div>
      </div>

      <!-- Results Section -->
      <div id="results-section" class="hidden space-y-4">
        <!-- Main Results Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { id: 'res-network', label: 'Network Address', icon: '🖧', color: '#2dd4bf' },
            { id: 'res-broadcast', label: 'Broadcast Address', icon: '📡', color: '#ff6b35' },
            { id: 'res-mask', label: 'Subnet Mask', icon: '🎭', color: '#a78bfa' },
            { id: 'res-wildcard', label: 'Wildcard Mask', icon: '🃏', color: '#34d399' },
            { id: 'res-first', label: 'First Usable Host', icon: '▶️', color: '#fbbf24' },
            { id: 'res-last', label: 'Last Usable Host', icon: '⏹️', color: '#f472b6' },
          ].map(r => (
            <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 flex items-start justify-between gap-3 group hover:border-white/[0.12] transition-colors">
              <div>
                <div class="text-xs text-zinc-500 uppercase tracking-wider mb-2">{r.icon} {r.label}</div>
                <div id={r.id} class="font-mono text-xl font-bold text-white">—</div>
              </div>
              <button class="copy-btn mt-1 text-zinc-700 hover:text-[#2dd4bf] transition-colors opacity-0 group-hover:opacity-100" data-target={r.id}>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              </button>
            </div>
          ))}
        </div>

        <!-- Host Count & Class -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 text-center">
            <div class="text-xs text-zinc-500 uppercase tracking-wider mb-2">Usable Hosts</div>
            <div id="res-hosts" class="text-3xl font-bold text-[#2dd4bf] tabular-nums">—</div>
          </div>
          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 text-center">
            <div class="text-xs text-zinc-500 uppercase tracking-wider mb-2">Total IPs</div>
            <div id="res-total" class="text-3xl font-bold text-[#ff6b35] tabular-nums">—</div>
          </div>
          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 text-center">
            <div class="text-xs text-zinc-500 uppercase tracking-wider mb-2">IP Class</div>
            <div id="res-class" class="text-3xl font-bold text-[#a78bfa]">—</div>
          </div>
        </div>

        <!-- Binary Representation -->
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5">
          <h3 class="text-xs text-zinc-500 uppercase tracking-wider mb-4">Binary Representation</h3>
          <div class="space-y-2 font-mono text-sm overflow-x-auto">
            <div class="flex gap-3">
              <span class="text-zinc-600 w-20 flex-shrink-0">IP:</span>
              <span id="bin-ip" class="text-[#2dd4bf] tracking-wider whitespace-nowrap">—</span>
            </div>
            <div class="flex gap-3">
              <span class="text-zinc-600 w-20 flex-shrink-0">Mask:</span>
              <span id="bin-mask" class="text-[#ff6b35] tracking-wider whitespace-nowrap">—</span>
            </div>
            <div class="flex gap-3">
              <span class="text-zinc-600 w-20 flex-shrink-0">Network:</span>
              <span id="bin-network" class="text-white tracking-wider whitespace-nowrap">—</span>
            </div>
          </div>
        </div>

        <div class="flex justify-center">
          <SaveResultButton id="save-subnet-btn" />
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  function intToIp(n: number): string {
    return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
  }

  function ipToInt(ip: string): number {
    const parts = ip.split('.').map(Number);
    if (parts.length !== 4 || parts.some(p => isNaN(p) || p < 0 || p > 255)) throw new Error('Invalid IP');
    return ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) >>> 0;
  }

  function maskToCidr(mask: string): number {
    const n = ipToInt(mask);
    let cidr = 0;
    for (let i = 31; i >= 0; i--) {
      if (n & (1 << i)) cidr++;
      else break;
    }
    return cidr;
  }

  function toBinary(n: number): string {
    const bytes = [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255];
    return bytes.map(b => b.toString(2).padStart(8, '0')).join('.');
  }

  function getClass(firstOctet: number): string {
    if (firstOctet < 128) return 'A';
    if (firstOctet < 192) return 'B';
    if (firstOctet < 224) return 'C';
    if (firstOctet < 240) return 'D';
    return 'E';
  }

  function calculate() {
    const ipInput = (document.getElementById('ip-input') as HTMLInputElement).value.trim();
    const cidrVal = parseInt((document.getElementById('cidr-select') as HTMLSelectElement).value);
    const maskInput = (document.getElementById('mask-input') as HTMLInputElement).value.trim();
    const errorEl = document.getElementById('error-msg') as HTMLElement;
    const resultsSection = document.getElementById('results-section') as HTMLElement;

    errorEl.classList.add('hidden');

    let cidr = cidrVal;

    // If mask was entered, use that instead
    if (maskInput) {
      try {
        cidr = maskToCidr(maskInput);
        (document.getElementById('cidr-select') as HTMLSelectElement).value = cidr.toString();
      } catch {
        errorEl.textContent = 'Invalid subnet mask.';
        errorEl.classList.remove('hidden');
        return;
      }
    }

    let ipInt: number;
    try {
      ipInt = ipToInt(ipInput);
    } catch {
      errorEl.textContent = 'Invalid IP address format.';
      errorEl.classList.remove('hidden');
      return;
    }

    const mask = cidr === 0 ? 0 : ((~0 << (32 - cidr)) >>> 0);
    const network = (ipInt & mask) >>> 0;
    const broadcast = (network | (~mask >>> 0)) >>> 0;
    const totalIps = Math.pow(2, 32 - cidr);
    const usableHosts = cidr >= 31 ? totalIps : totalIps - 2;
    const firstHost = cidr < 31 ? network + 1 : network;
    const lastHost = cidr < 31 ? broadcast - 1 : broadcast;
    const firstOctet = (ipInt >>> 24) & 255;

    const set = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    set('res-network', intToIp(network));
    set('res-broadcast', intToIp(broadcast));
    set('res-mask', intToIp(mask));
    set('res-wildcard', intToIp(~mask >>> 0));
    set('res-first', intToIp(firstHost));
    set('res-last', intToIp(lastHost));
    set('res-hosts', usableHosts.toLocaleString());
    set('res-total', totalIps.toLocaleString());
    set('res-class', `Class ${getClass(firstOctet)}`);
    set('bin-ip', toBinary(ipInt));
    set('bin-mask', toBinary(mask));
    set('bin-network', toBinary(network));

    resultsSection.classList.remove('hidden');

    // Save button
    const saveBtn = document.getElementById('save-subnet-btn');
    if (saveBtn) {
      saveBtn.classList.remove('hidden');
      saveBtn.onclick = () => {
        if (typeof (window as any).saveToDashboard === 'function') {
          (window as any).saveToDashboard('IP Subnet Calculator', '/network/ip-subnet-calculator', {
            type: 'key-value',
            data: {
              'Network': intToIp(network) + '/' + cidr,
              'Broadcast': intToIp(broadcast),
              'Usable Hosts': usableHosts.toLocaleString()
            }
          });
        }
      };
    }
  }

  document.getElementById('btn-calculate')?.addEventListener('click', calculate);

  // Sync mask input from CIDR
  document.getElementById('cidr-select')?.addEventListener('change', (e) => {
    const cidr = parseInt((e.target as HTMLSelectElement).value);
    const mask = cidr === 0 ? 0 : ((~0 << (32 - cidr)) >>> 0);
    const intToIp = (n: number) => [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
    (document.getElementById('mask-input') as HTMLInputElement).value = intToIp(mask);
  });

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = (e.currentTarget as HTMLElement).dataset.target;
      if (target) {
        const val = document.getElementById(target)?.textContent || '';
        navigator.clipboard.writeText(val);
      }
    });
  });

  // Auto-calculate on load
  calculate();
</script>
