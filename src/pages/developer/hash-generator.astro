---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cryptographic Hash Generator",
  "url": "https://solverspro.com/developer/hash-generator/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online cryptographic hash generator to compute SHA-1, SHA-256, SHA-384, and SHA-512 hashes locally in your browser with zero server uploads.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="Hash Generator | SolversPro"
  description="Cryptographic hash generator to compute SHA-1, SHA-256, SHA-384, and SHA-512 hashes instantly. Fast client-side Web Crypto API execution with zero server uploads."
  canonical="https://solverspro.com/developer/hash-generator/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'Hash Generator' },
      ]} />
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">Hash Generator</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro Cryptographic Hash Generator is a free browser-based developer utility that calculates SHA-1, SHA-256, SHA-384, and SHA-512 checksums client-side using hardware-accelerated Web Crypto APIs with zero server uploads.
        </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full min-h-[500px]">
        {/* Input Side */}
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Input Text</h2>
          </div>
          <textarea
            id="input-text"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[300px]"
            placeholder="Type or paste your text here..."
            spellcheck="false"
          ></textarea>
        </div>

        {/* Output Side */}
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Generated Hashes</h2>
          </div>
          <div class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl space-y-4">
            
            <div>
              <div class="flex justify-between items-center mb-2">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-[#2dd4bf]">SHA-256</h3>
                <span class="text-xs text-zinc-500 font-mono">64 chars</span>
              </div>
              <input type="text" id="hash-sha256" readonly class="w-full bg-[#0d0d14] p-3 rounded-lg border border-white/[0.05] font-mono text-sm text-zinc-300 focus:outline-none focus:ring-1 focus:ring-[#2dd4bf]" />
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-blue-400">SHA-1</h3>
                <span class="text-xs text-zinc-500 font-mono">40 chars</span>
              </div>
              <input type="text" id="hash-sha1" readonly class="w-full bg-[#0d0d14] p-3 rounded-lg border border-white/[0.05] font-mono text-sm text-zinc-300 focus:outline-none focus:ring-1 focus:ring-blue-500" />
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-orange-400">SHA-384</h3>
                <span class="text-xs text-zinc-500 font-mono">96 chars</span>
              </div>
              <input type="text" id="hash-sha384" readonly class="w-full bg-[#0d0d14] p-3 rounded-lg border border-white/[0.05] font-mono text-sm text-zinc-300 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-purple-400">SHA-512</h3>
                <span class="text-xs text-zinc-500 font-mono">128 chars</span>
              </div>
              <input type="text" id="hash-sha512" readonly class="w-full bg-[#0d0d14] p-3 rounded-lg border border-white/[0.05] font-mono text-sm text-zinc-300 focus:outline-none focus:ring-1 focus:ring-purple-500" />
            </div>

            <div class="mt-6 flex justify-end">
              <SaveResultButton id="save-hash-btn" />
            </div>

          </div>
        </div>
      </div>

      <!-- Citable Content: Cryptographic Hash Specifications Table -->
      <div class="mt-16 w-full max-w-4xl mx-auto">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-white mb-2">Cryptographic Hash Digest Specifications (NIST FIPS 180-4)</h2>
          <p class="text-zinc-400 text-sm">
            Standard bit lengths, hex digest character counts, and security classifications across the Secure Hash Standard family.
          </p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-white/[0.08] bg-white/[0.02]">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-white/[0.08] bg-white/[0.04] text-zinc-300 font-semibold">
                <th class="py-3 px-4">Algorithm</th>
                <th class="py-3 px-4">Digest Output (Bits / Hex)</th>
                <th class="py-3 px-4">Security Classification</th>
                <th class="py-3 px-4">Primary Application</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06] text-zinc-400">
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">SHA-256</td>
                <td class="py-3 px-4 font-mono text-zinc-300">256 bits (64 hex characters)</td>
                <td class="py-3 px-4 text-emerald-400">Cryptographically Secure</td>
                <td class="py-3 px-4">Digital signatures, TLS certificates, blockchain verification</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">SHA-512</td>
                <td class="py-3 px-4 font-mono text-zinc-300">512 bits (128 hex characters)</td>
                <td class="py-3 px-4 text-emerald-400">Cryptographically Secure</td>
                <td class="py-3 px-4">High-throughput hashing on 64-bit CPU architectures</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">SHA-384</td>
                <td class="py-3 px-4 font-mono text-zinc-300">384 bits (96 hex characters)</td>
                <td class="py-3 px-4 text-emerald-400">Cryptographically Secure</td>
                <td class="py-3 px-4">NSA Suite B cryptography, high-grade SSL/TLS ciphers</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4 font-mono text-emerald-400 font-medium">SHA-1</td>
                <td class="py-3 px-4 font-mono text-zinc-300">160 bits (40 hex characters)</td>
                <td class="py-3 px-4 text-amber-400">Legacy / Deprecated (Collision Risk)</td>
                <td class="py-3 px-4">Historical Git commits, non-cryptographic checksum comparison</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <ToolShare title="Hash Generator" url="https://solverspro.com/developer/hash-generator" />
      <SimilarTools category="developer" currentPath="/developer/hash-generator" />
    
      <ToolFAQ faqs={[
        { question: "Can a cryptographic hash be decrypted?", answer: "No, cryptographic hashes like SHA-256 are one-way functions. They are designed to be irreversible, meaning you cannot 'decrypt' a hash back into its original text." },
        { question: "Is this hash generator secure for passwords?", answer: "Yes, this tool runs entirely on your device using the Web Crypto API. However, for storing user passwords in a database, you should use a hashing algorithm designed with a 'work factor' (like bcrypt or Argon2) rather than raw SHA-256." },
        { question: "Does the text length affect the hash length?", answer: "No. A specific hashing algorithm will always output a fixed-length string, regardless of whether the input is one letter or a billion words." }
      ]} />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const inputText = document.getElementById('input-text') as HTMLTextAreaElement;
  const els = {
    'SHA-1': document.getElementById('hash-sha1') as HTMLInputElement,
    'SHA-256': document.getElementById('hash-sha256') as HTMLInputElement,
    'SHA-384': document.getElementById('hash-sha384') as HTMLInputElement,
    'SHA-512': document.getElementById('hash-sha512') as HTMLInputElement,
  };

  async function generateHashes(text: string) {
    if (!text) {
      Object.values(els).forEach(el => el.value = '');
      return;
    }

    const msgUint8 = new TextEncoder().encode(text);
    
    for (const alg of ['SHA-1', 'SHA-256', 'SHA-384', 'SHA-512']) {
      try {
        const hashBuffer = await crypto.subtle.digest(alg, msgUint8);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        els[alg as keyof typeof els].value = hashHex;
      } catch(e) {
        els[alg as keyof typeof els].value = 'Error generating hash';
      }
    }
    
    const saveBtn = document.getElementById('save-hash-btn');
    if (saveBtn) {
      saveBtn.classList.remove('hidden');
      saveBtn.onclick = () => {
        if (typeof window.saveToDashboard === 'function') {
          const success = window.saveToDashboard('Hash Generator', '/developer/hash-generator', {
            type: 'key-value',
            data: {
              'Input': text.length > 20 ? text.substring(0, 20) + '...' : text,
              'SHA-1': els['SHA-1'].value,
              'SHA-256': els['SHA-256'].value,
              'SHA-384': els['SHA-384'].value,
              'SHA-512': els['SHA-512'].value,
            }
          });
          if (success) {
            const textEl = saveBtn.querySelector('.btn-text');
            const iconSave = saveBtn.querySelector('.icon-save');
            const iconCheck = saveBtn.querySelector('.icon-check');
            if (textEl) textEl.textContent = 'Saved!';
            if (iconSave) iconSave.classList.add('hidden');
            if (iconCheck) iconCheck.classList.remove('hidden');
            saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
            saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
            setTimeout(() => {
              if (textEl) textEl.textContent = 'Save Result';
              if (iconSave) iconSave.classList.remove('hidden');
              if (iconCheck) iconCheck.classList.add('hidden');
              saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
            }, 2000);
          }
        }
      };
    }
  }

  inputText?.addEventListener('input', (e) => {
    generateHashes((e.target as HTMLTextAreaElement).value);
  });

  // Select all on click for easy copy
  Object.values(els).forEach(el => {
    el?.addEventListener('click', () => el.select());
  });
</script>
