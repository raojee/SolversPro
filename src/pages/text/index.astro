---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

import { toolsByCategory } from '../../data/tools';
const tools = toolsByCategory['text'] || [];

const faqs = [
  {
    question: "Are SolversPro text utilities safe for confidential drafts and sensitive strings?",
    answer: "Yes. Every tool in the Text Hub executes 100% locally inside your browser using client-side JavaScript. Your text, URLs, and documents are never uploaded to or stored on external servers."
  },
  {
    question: "How does the Word Counter calculate reading time and character counts?",
    answer: "The Word Counter separates whitespace-delimited words, tracks characters with and without spaces, counts sentences and paragraphs, and estimates reading time using an average adult reading speed of 200 words per minute."
  },
  {
    question: "When should I use URL encoding vs. Base64 or HTML escaping?",
    answer: "Use URL encoding when passing text inside query parameters or web addresses, HTML escaping when rendering user text safely inside HTML tags, and Base64 when transporting binary or structured payloads in ASCII-safe channels."
  }
];
---
<BaseLayout
  title="Text Tools — Word Counter & Case Converter | SolversPro"
  description="Free online text tools: Word Counter, Morse Code Translator, URL Encoder/Decoder, Case Converter, and Lorem Ipsum Generator. Runs locally in your browser."
  canonical="https://solverspro.com/text/"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Text & String Utilities — SolversPro",
    "url": "https://solverspro.com/text/",
    "description": "Free online text tools for word counting, case conversion, regex testing, diff checking, and Morse code translation.",
    "publisher": {
      "@type": "Organization",
      "name": "SolversPro",
      "url": "https://solverspro.com/"
    }
  }
  </script>
  <Header />
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Text Tools' }]} />
    <div class="mb-12 mt-4">
      <h1 class="text-4xl font-bold text-white mb-4">Text Tools</h1>
      <p class="text-zinc-300 text-lg leading-relaxed mt-3">SolversPro Text Hub offers free, privacy-first string and typography utilities for word counting, case conversions, regex testing, diff comparisons, Morse code translation, and Lorem Ipsum generation.</p>
      <p class="text-zinc-400 text-lg max-w-2xl mt-2">Handy text utilities for writers, developers, and communicators. All tools run locally in your browser.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {tools.map(tool => <ToolCard {...tool} />)}
    </div>

    <section class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-6 sm:p-8 mb-12 space-y-4">
      <h2 class="text-2xl font-bold text-white">Client-Side Text Processing &amp; Formatting Guide</h2>
      <p class="text-zinc-300 text-sm leading-relaxed">
        Writers, editors, students, and software engineers rely on clean text formatting every day—whether checking strict character limits for SEO meta descriptions, converting headings between <code class="text-[#2dd4bf]">camelCase</code>, <code class="text-[#2dd4bf]">snake_case</code>, and Title Case, encoding special characters for query strings, or generating realistic placeholder copy for UI mockups.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="p-4 bg-[#14141f] rounded-xl border border-white/[0.05]">
          <h3 class="text-sm font-bold text-white mb-1">Editorial &amp; SEO Writing</h3>
          <p class="text-xs text-zinc-400">Monitor exact word counts, reading time, and character thresholds with zero server uploads.</p>
        </div>
        <div class="p-4 bg-[#14141f] rounded-xl border border-white/[0.05]">
          <h3 class="text-sm font-bold text-white mb-1">Web &amp; API Encoding</h3>
          <p class="text-xs text-zinc-400">Safely percent-encode URLs, convert numbers to English words for invoices, and normalize casing.</p>
        </div>
        <div class="p-4 bg-[#14141f] rounded-xl border border-white/[0.05]">
          <h3 class="text-sm font-bold text-white mb-1">Audio &amp; Signal Practice</h3>
          <p class="text-xs text-zinc-400">Translate text to International Morse Code with real-time Web Audio playback and visual flashing.</p>
        </div>
      </div>
    </section>

    <ToolFAQ faqs={faqs} />
  </div>
  <Footer />
</BaseLayout>
