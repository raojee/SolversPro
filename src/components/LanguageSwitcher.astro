---
interface Props {
  class?: string;
  idPrefix?: string;
}

const { class: className = '', idPrefix = 'desktop-' } = Astro.props;

const LANGUAGES = [
  { code: 'en', label: 'EN', name: 'English', nativeName: 'English' },
  { code: 'ja', label: 'JA', name: 'Japanese', nativeName: '日本語' },
  { code: 'es', label: 'ES', name: 'Spanish', nativeName: 'Español' },
  { code: 'de', label: 'DE', name: 'German', nativeName: 'Deutsch' },
  { code: 'fr', label: 'FR', name: 'French', nativeName: 'Français' },
  { code: 'zh-CN', label: 'ZH', name: 'Chinese', nativeName: '简体中文' },
  { code: 'pt', label: 'PT', name: 'Portuguese', nativeName: 'Português' },
  { code: 'it', label: 'IT', name: 'Italian', nativeName: 'Italiano' },
  { code: 'ko', label: 'KO', name: 'Korean', nativeName: '한국어' },
  { code: 'ar', label: 'AR', name: 'Arabic', nativeName: 'العربية' },
  { code: 'hi', label: 'HI', name: 'Hindi', nativeName: 'हिन्दी' },
  { code: 'ru', label: 'RU', name: 'Russian', nativeName: 'Русский' },
];
---

<div class={`relative inline-block language-switcher-container notranslate ${className}`}>
  <!-- Trigger Button -->
  <button
    type="button"
    id={`${idPrefix}lang-toggle-btn`}
    class="lang-dropdown-btn flex items-center gap-1.5 px-2.5 py-1.5 min-h-[38px] rounded-md text-xs text-zinc-300 border border-white/[0.1] bg-white/[0.03] hover:border-[#ff6b35]/50 hover:text-white transition-all cursor-pointer select-none"
    style="font-family: 'JetBrains Mono', monospace;"
    aria-label="Change site language"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <!-- Globe Icon -->
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#ff6b35] flex-shrink-0">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="active-lang-label font-bold text-white tracking-wider">EN</span>
    <!-- Arrow -->
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lang-arrow opacity-60 transition-transform duration-200">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    class="lang-dropdown-menu hidden absolute right-0 top-full mt-2 w-56 z-[999] rounded-xl bg-[#13131d] border border-white/[0.12] shadow-[0_12px_40px_rgba(0,0,0,0.7)] backdrop-blur-xl py-1 max-h-80 overflow-y-auto"
    role="menu"
    aria-orientation="vertical"
  >
    <div class="px-3 py-2 text-[10px] font-bold text-zinc-500 uppercase tracking-widest border-b border-white/[0.06] flex items-center justify-between" style="font-family: 'JetBrains Mono', monospace;">
      <span>Language / 言語</span>
      <span class="text-[#ff6b35]">•</span>
    </div>
    <div class="py-1">
      {LANGUAGES.map((lang) => (
        <button
          type="button"
          data-lang-code={lang.code}
          data-lang-label={lang.label}
          class="lang-option-btn w-full flex items-center justify-between px-3 py-2 text-xs text-zinc-300 hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer text-left group"
          role="menuitem"
        >
          <div class="flex items-center gap-2.5">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-white/[0.05] border border-white/[0.08] text-zinc-400 group-hover:text-[#ff6b35] group-hover:border-[#ff6b35]/30 transition-colors">
              {lang.label}
            </span>
            <div>
              <span class="font-medium text-white block leading-tight">{lang.nativeName}</span>
              <span class="text-[10px] text-zinc-500 font-normal">{lang.name}</span>
            </div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="active-check text-[#ff6b35] opacity-0 transition-opacity">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    // Shared Language Switcher Logic across all instances
    window.__setupLanguageSwitchers = function() {
      var current = localStorage.getItem('solverspro_lang') || 'en';
      var currentUpper = current === 'zh-CN' ? 'ZH' : current.slice(0, 2).toUpperCase();

      // Update active labels and checkmarks
      document.querySelectorAll('.language-switcher-container').forEach(function(container) {
        var labelEl = container.querySelector('.active-lang-label');
        if (labelEl) labelEl.textContent = currentUpper;

        container.querySelectorAll('.lang-option-btn').forEach(function(btn) {
          var code = btn.getAttribute('data-lang-code');
          var check = btn.querySelector('.active-check');
          if (code && code.toLowerCase() === current.toLowerCase()) {
            btn.classList.add('bg-white/[0.08]');
            if (check) check.classList.remove('opacity-0');
          } else {
            btn.classList.remove('bg-white/[0.08]');
            if (check) check.classList.add('opacity-0');
          }
        });
      });
    };

    window.switchSolversProLanguage = function(code) {
      var lang = code || 'en';
      localStorage.setItem('solverspro_lang', lang);
      var domain = window.location.hostname;

      if (lang === 'en') {
        document.cookie = 'googtrans=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
        document.cookie = 'googtrans=; Path=/; Domain=.' + domain + '; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
        document.cookie = 'googtrans=/en/en; path=/;';
        if (domain.includes('.')) {
          document.cookie = 'googtrans=/en/en; path=/; domain=.' + domain + ';';
        }
      } else {
        document.cookie = 'googtrans=/en/' + lang + '; path=/;';
        if (domain.includes('.')) {
          document.cookie = 'googtrans=/en/' + lang + '; path=/; domain=.' + domain + ';';
        }
      }

      // If google combo already exists, trigger it
      var combo = document.querySelector('.goog-te-combo');
      if (combo) {
        combo.value = lang;
        combo.dispatchEvent(new Event('change'));
      }

      // Reload to ensure crisp full-page translation
      window.location.reload();
    };

    // Attach click listeners globally once
    if (!window.__langSwitchersInitialized) {
      window.__langSwitchersInitialized = true;

      document.addEventListener('click', function(e) {
        var toggleBtn = e.target.closest('.lang-dropdown-btn');
        var optionBtn = e.target.closest('.lang-option-btn');
        var container = e.target.closest('.language-switcher-container');

        if (toggleBtn) {
          e.stopPropagation();
          var menu = toggleBtn.nextElementSibling;
          var isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
          var arrow = toggleBtn.querySelector('.lang-arrow');

          // Close all open menus first
          document.querySelectorAll('.lang-dropdown-menu').forEach(function(m) {
            m.classList.add('hidden');
          });
          document.querySelectorAll('.lang-dropdown-btn').forEach(function(b) {
            b.setAttribute('aria-expanded', 'false');
            var arr = b.querySelector('.lang-arrow');
            if (arr) arr.classList.remove('rotate-180');
          });

          if (!isOpen && menu) {
            menu.classList.remove('hidden');
            toggleBtn.setAttribute('aria-expanded', 'true');
            if (arrow) arrow.classList.add('rotate-180');
          }
          return;
        }

        if (optionBtn) {
          e.stopPropagation();
          var code = optionBtn.getAttribute('data-lang-code');
          // Close menus
          document.querySelectorAll('.lang-dropdown-menu').forEach(function(m) {
            m.classList.add('hidden');
          });
          if (code) {
            window.switchSolversProLanguage(code);
          }
          return;
        }

        // Click outside closes all menus
        if (!container) {
          document.querySelectorAll('.lang-dropdown-menu').forEach(function(m) {
            m.classList.add('hidden');
          });
          document.querySelectorAll('.lang-dropdown-btn').forEach(function(b) {
            b.setAttribute('aria-expanded', 'false');
            var arr = b.querySelector('.lang-arrow');
            if (arr) arr.classList.remove('rotate-180');
          });
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          document.querySelectorAll('.lang-dropdown-menu').forEach(function(m) {
            m.classList.add('hidden');
          });
          document.querySelectorAll('.lang-dropdown-btn').forEach(function(b) {
            b.setAttribute('aria-expanded', 'false');
            var arr = b.querySelector('.lang-arrow');
            if (arr) arr.classList.remove('rotate-180');
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', window.__setupLanguageSwitchers);
    } else {
      window.__setupLanguageSwitchers();
    }
  })();
</script>
