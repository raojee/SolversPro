---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "JavaScript Beautifier",
  "url": "https://solverspro.com/developer/js-beautifier/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online JavaScript beautifier to format, un-minify, and indent messy JS and TypeScript code with customizable 2-space, 4-space, or tab indentation.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};

const faqs = [
  {
    question: "What does a JavaScript beautifier do?",
    answer: "A JavaScript beautifier unpacks minified, compressed, or single-line JavaScript and TypeScript scripts into readable code with normalized line breaks, indented lexical scopes, spaced operators, and standardized curly bracket formatting."
  },
  {
    question: "Can a beautifier de-obfuscate mangled variable names?",
    answer: "A beautifier restores code structure and indentation, but it cannot recover original variable names if they were shortened or mangled (e.g., from 'userData' to 'a') during production minification or obfuscation unless a source map is supplied."
  },
  {
    question: "Will beautifying break string literals or regexes?",
    answer: "No. The formatting parser protects string literals (single, double, and backtick template literals) and regular expression literals from unexpected indentation or newline insertion."
  },
  {
    question: "Is my JavaScript code uploaded to any external server?",
    answer: "No. All formatting logic runs 100% client-side inside your browser engine. Your confidential scripts, functions, and API logic never leave your device."
  }
];
---

<BaseLayout title="JavaScript Beautifier — Format & Un-Minify JS Code | SolversPro" description="JavaScript Beautifier formats minified or messy JS scripts into readable, properly indented code with customizable space or tab indentation in your browser." canonical="https://solverspro.com/developer/js-beautifier/" schema={schema}>
  <Header /><SearchOverlay />
  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-5xl">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Developer Tools',href:'/developer'},{label:'JavaScript Beautifier'}]} />
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">⚡ JavaScript Beautifier</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro JavaScript Beautifier is a free, browser-based coding tool that un-minifies, formats, and structures tangled JavaScript and TypeScript code with customizable indentation and clean bracket alignment in real time.
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 min-h-[500px]">
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Minified JS</h2>
            <div class="flex items-center gap-3">
              <select id="indent-size" class="bg-[#1a1a24] border border-white/[0.1] text-xs text-zinc-300 rounded px-2 py-1 outline-none focus:border-[#2dd4bf]">
                <option value="2">2 Spaces</option>
                <option value="4">4 Spaces</option>
                <option value="tab">Tabs</option>
              </select>
              <button id="btn-format" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Format &rarr;</button>
            </div>
          </div>
          <textarea id="input-raw" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[400px]" placeholder='function foo(a,b){if(a>b){return a;}else{return b;}}const arr=[1,2,3];' spellcheck="false"></textarea>
        </div>
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Formatted JS</h2>
            <button id="btn-copy" class="text-xs font-semibold text-[#2dd4bf] hover:text-[#5eead4] transition-colors">Copy</button>
          </div>
          <textarea id="output-code" readonly class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:outline-none font-mono text-sm text-[#2dd4bf] resize-none min-h-[400px]" placeholder="// Formatted JS will appear here"></textarea>
        </div>
      </div>

      <!-- Citable Reference Table -->
      <div class="mt-12 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-xl font-bold text-white mb-2">JavaScript Code Formatting Rules</h2>
        <p class="text-zinc-400 text-sm mb-6">Standard structural rules applied when converting minified scripts into clean, readable code.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-400 font-mono text-xs uppercase">
                <th class="py-3 px-4">Language Construct</th>
                <th class="py-3 px-4">Minified Code Pattern</th>
                <th class="py-3 px-4">Formatted Code Pattern</th>
                <th class="py-3 px-4">Formatting Benefit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-300 font-mono text-xs">
              <tr>
                <td class="py-3 px-4 text-[#2dd4bf] font-bold">Function Definitions</td>
                <td class="py-3 px-4 text-white font-mono">function add(a,b)&#123;return a+b;&#125;</td>
                <td class="py-3 px-4 font-mono">function add(a, b) &#123;<br />&nbsp;&nbsp;return a + b;<br />&#125;</td>
                <td class="py-3 px-4">Parameter spacing and body indentation</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#ff6b35] font-bold">Conditionals & Loops</td>
                <td class="py-3 px-4 text-white font-mono">if(x&gt;0)&#123;doX();&#125;else&#123;doY();&#125;</td>
                <td class="py-3 px-4 font-mono">if (x &gt; 0) &#123;<br />&nbsp;&nbsp;doX();<br />&#125; else &#123;<br />&nbsp;&nbsp;doY();<br />&#125;</td>
                <td class="py-3 px-4">Distinct branch visibility and block separation</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#a78bfa] font-bold">Object Literals</td>
                <td class="py-3 px-4 text-white font-mono">&#123;id:1,name:"test",active:!0&#125;</td>
                <td class="py-3 px-4 font-mono">&#123;<br />&nbsp;&nbsp;id: 1,<br />&nbsp;&nbsp;name: "test"<br />&#125;</td>
                <td class="py-3 px-4">Key-value pair alignment and readable properties</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#38bdf8] font-bold">Array Definitions</td>
                <td class="py-3 px-4 text-white font-mono">[1,2,"three",&#123;val:4&#125;]</td>
                <td class="py-3 px-4 font-mono">[<br />&nbsp;&nbsp;1,<br />&nbsp;&nbsp;2,<br />&nbsp;&nbsp;"three"<br />]</td>
                <td class="py-3 px-4">Element itemization and bracket balancing</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={faqs} />

      <ToolShare title="JavaScript Beautifier" url="https://solverspro.com/developer/js-beautifier" />
      <SimilarTools category="developer" currentPath="/developer/js-beautifier" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  const rawEl = document.getElementById('input-raw') as HTMLTextAreaElement;
  const outEl = document.getElementById('output-code') as HTMLTextAreaElement;
  const indentSelect = document.getElementById('indent-size') as HTMLSelectElement;

  function formatJS(js: string, indentString: string): string {
    let formatted = '';
    let indentLevel = 0;
    
    // Very basic formatting for demonstration/simple minified code
    // A robust solution would use an AST parser like Babel
    js = js.replace(/\s+/g, ' ')
           .replace(/{\s+/g, '{')
           .replace(/}\s+/g, '}')
           .replace(/;\s+/g, ';')
           .replace(/,\s+/g, ',');
           
    let inString = false;
    let stringChar = '';

    for (let i = 0; i < js.length; i++) {
      const char = js.charAt(i);
      
      if ((char === '"' || char === "'" || char === '`') && js.charAt(i-1) !== '\\') {
         if (!inString) {
             inString = true;
             stringChar = char;
         } else if (char === stringChar) {
             inString = false;
         }
         formatted += char;
         continue;
      }
      
      if (inString) {
         formatted += char;
         continue;
      }

      if (char === '{' || char === '[') {
        formatted += ' ' + char + '\n';
        indentLevel++;
        formatted += indentString.repeat(indentLevel);
      } else if (char === '}' || char === ']') {
        indentLevel = Math.max(0, indentLevel - 1);
        formatted = formatted.trimEnd() + '\n' + indentString.repeat(indentLevel) + char;
        // Don't add newline after closing brace if it's followed by else or catch or comma or semicolon
        if (char === '}') {
            const nextTokens = js.slice(i + 1).trim();
            if (nextTokens.startsWith('else') || nextTokens.startsWith('catch')) {
                formatted += ' ';
            } else if (nextTokens.startsWith(',') || nextTokens.startsWith(';')) {
                // let it fall through
            } else {
                formatted += '\n' + indentString.repeat(indentLevel);
            }
        }
      } else if (char === ';') {
        formatted += ';\n' + indentString.repeat(indentLevel);
      } else if (char === ',') {
        // format arrays/objects slightly better
        if (js.charAt(i+1) !== ' ') {
            formatted += ', ';
        } else {
            formatted += ',';
        }
      } else {
        formatted += char;
      }
    }
    
    // cleanup empty lines
    return formatted.replace(/\n\s*\n/g, '\n').trim();
  }

  document.getElementById('btn-format')?.addEventListener('click', () => {
    const val = indentSelect.value;
    const indentStr = val === 'tab' ? '\t' : ' '.repeat(parseInt(val));
    outEl.value = formatJS(rawEl.value, indentStr);
    outEl.classList.add('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]');
    setTimeout(() => outEl.classList.remove('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]'), 500);
  });

  document.getElementById('btn-copy')?.addEventListener('click', () => { if (outEl.value) copyToClipboard(outEl.value); });
</script>
