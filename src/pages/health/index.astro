---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';

import { toolsByCategory } from '../../data/tools';
const tools = toolsByCategory['health'] || [];
---

<BaseLayout
 title="Health Calculators — Free Nutrition & Fitness Tools | SolversPro"
 description="Free online health and fitness calculators. Calculate your TDEE, BMI, daily calories, and track body composition to hit your nutrition goals safely."
>
 <Header />
 <SearchOverlay />

 <main class="flex-1 py-12">
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
 <Breadcrumbs items={[
 { label: 'Home', href: '/' },
 { label: 'Health' },
 ]} />

 <div class="mb-12">
 <div class="flex items-center gap-4 mb-4">
 <div class="w-14 h-14 rounded-lg flex items-center justify-center text-3xl" style="background-color: #eff6ff; border-radius: 16px;">
 ❤️
 </div>
 <div>
 <h1 class="text-3xl md:text-4xl font-bold text-white ">Health Tools</h1>
 <p class="text-zinc-500 mt-1">Calories, nutrition, BMI, and body composition calculators.</p>
 </div>
 </div>
 </div>

  <div class="prose prose-invert max-w-none mb-12 text-zinc-300">
    <h2>Health & Fitness Calculators</h2>
    <p>Welcome to the SolversPro Health Hub. Achieving your physical goals—whether that's losing weight, building muscle, or maintaining a healthy lifestyle—starts with accurate data. Our collection of free online health and fitness calculators gives you the precise metrics you need to tailor your diet and exercise routines.</p>
    <p>Health data is deeply personal. That's why our tools are designed to be 100% private. All calculations happen entirely on your device in your web browser. We do not track, store, or transmit your body measurements, ensuring your privacy is never compromised.</p>
    
    <h3>Tools Available in this Category</h3>
    <ul class="list-disc pl-5 space-y-2 mt-4 mb-6">
      <li><strong>TDEE Calculator:</strong> Your Total Daily Energy Expenditure is the cornerstone of any nutritional plan. Discover exactly how many calories your body burns in a day based on your basal metabolic rate and physical activity levels.</li>
      <li><strong>Adult BMI Calculator:</strong> Calculate your adult Body Mass Index (BMI) using metric or imperial units. Features an interactive visual gauge across six WHO weight categories, age/sex considerations, and instant unit switching.</li>
      <li><strong>Child & Teen BMI Calculator:</strong> Pediatric BMI and growth percentile tool for ages 2–19 powered by official CDC 2000 BMI-for-age LMS growth chart data. Accurately determines your child's BMI percentile and weight status.</li>
      <li><strong>BMI Calculator:</strong> Quickly assess your standard Body Mass Index to see if you fall within a healthy weight range based on your height and weight.</li>
      <li><strong>Macronutrient Calculator (Coming Soon):</strong> Once you know your TDEE, use this tool to split your daily calories into optimal ratios of protein, fats, and carbohydrates tailored to your specific fitness goals.</li>
      <li><strong>1RM Calculator (Coming Soon):</strong> Maximize your strength training. Estimate your One Rep Max safely without having to test it under a dangerously heavy barbell.</li>
    </ul>
    <p>Don't guess when it comes to your health. Use our scientifically-backed formulas to plan your fitness journey with confidence. Select a calculator below to get started.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
  {tools.map((tool) => (
  <ToolCard {...tool} />
  ))}
  </div>

  <section class="mt-16 bg-zinc-900/60 rounded-xl p-8 border border-zinc-800">
    <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-6 text-zinc-300">
      <div>
        <h3 class="text-lg font-semibold text-white mb-2">What is TDEE and why is it important for weight management?</h3>
        <p class="text-zinc-400">TDEE stands for Total Daily Energy Expenditure. It represents the total number of calories your body burns per day based on your basal metabolic rate (BMR) and physical activity level. Understanding your TDEE helps you set realistic calorie targets for weight loss, muscle gain, or weight maintenance.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-white mb-2">Is my health data stored or tracked on SolversPro?</h3>
        <p class="text-zinc-400">No. All health calculations run 100% locally in your web browser. No personal measurements, weight, height, or health data are ever saved or transmitted to any server.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-white mb-2">How is Body Mass Index (BMI) calculated?</h3>
        <p class="text-zinc-400">BMI is calculated by dividing your weight in kilograms by your height in meters squared (kg/m²). It provides a general indicator of whether an adult is underweight, normal weight, overweight, or obese.</p>
      </div>
    </div>
  </section>
  </div>
  </main>

  <script type="application/ld+json" is:raw set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is TDEE and why is it important for weight management?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "TDEE stands for Total Daily Energy Expenditure. It represents the total number of calories your body burns per day based on your basal metabolic rate (BMR) and physical activity level. Understanding your TDEE helps you set realistic calorie targets for weight loss, muscle gain, or weight maintenance."
        }
      },
      {
        "@type": "Question",
        "name": "Is my health data stored or tracked on SolversPro?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. All health calculations run 100% locally in your web browser. No personal measurements, weight, height, or health data are ever saved or transmitted to any server."
        }
      },
      {
        "@type": "Question",
        "name": "How is Body Mass Index (BMI) calculated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BMI is calculated by dividing your weight in kilograms by your height in meters squared (kg/m²). It provides a general indicator of whether an adult is underweight, normal weight, overweight, or obese."
        }
      }
    ]
  })}></script>

  <Footer />
</BaseLayout>
