---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "JSON to Python Converter",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Convert JSON data to Python dataclasses, dictionaries, and lists with type annotations. Free online tool for API integration and data modeling.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqs = [
  {
    question: "Is this JSON to Python converter free to use?",
    answer: "Yes, this converter is 100% free with no usage limits, sign-ups, or paid subscriptions required."
  },
  {
    question: "Does my JSON data get sent to an external server?",
    answer: "No. All parsing and Python code generation runs 100% client-side inside your web browser. Your API keys, payloads, and sensitive JSON data never leave your device."
  },
  {
    question: "Does it support nested JSON objects and lists?",
    answer: "Yes! The converter recursively parses nested JSON objects and arrays, automatically generating separate sub-dataclasses with appropriate PEP 8 type annotations (such as List[...] and Optional[...])."
  }
];
---

<BaseLayout
  title="JSON to Python Converter — Generate Type-Safe Dataclasses | SolversPro"
  description="Convert raw JSON payloads into clean, type-annotated Python dataclasses instantly. Free browser-based developer tool for API models and data pipelines."
  canonical="https://solverspro.com/developer/json-to-python"
  schema={schema}
>
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-5xl">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Developer Tools',href:'/developer'},{label:'JSON to Python'}]} />
      
      <!-- Hero Section -->
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🐍 JSON to Python Converter</h1>
        <p class="text-zinc-300 text-lg leading-relaxed max-w-4xl">
          Convert raw JSON data into clean, strongly-typed Python dataclasses, dictionaries, and list structures instantly. This free online utility is specifically designed for Python developers, data engineers, and backend architects migrating REST API responses, configuring data pipelines, or generating type-safe Python models from JSON schemas. Simply paste your JSON payload below to automatically generate PEP 8-compliant Python code with accurate type hints (<code class="text-[#2dd4bf] font-mono">str</code>, <code class="text-[#2dd4bf] font-mono">int</code>, <code class="text-[#2dd4bf] font-mono">float</code>, <code class="text-[#2dd4bf] font-mono">bool</code>, <code class="text-[#2dd4bf] font-mono">List</code>, and nested classes). All conversion is processed 100% locally inside your web browser—ensuring your sensitive data, API payloads, and tokens never touch an external server.
        </p>
      </div>

      <!-- Converter Tool Interface -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 min-h-[500px]">
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">JSON Input</h2>
            <button id="btn-convert" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Generate &rarr;</button>
          </div>
          <textarea id="input-json" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[400px]" placeholder='{"name":"Alice","age":30,"scores":[95,87],"active":true}' spellcheck="false"></textarea>
        </div>
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Python Output</h2>
            <button id="btn-copy" class="text-xs font-semibold text-[#2dd4bf] hover:text-[#5eead4] transition-colors">Copy</button>
          </div>
          <textarea id="output-code" readonly class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:outline-none font-mono text-sm text-[#2dd4bf] resize-none min-h-[400px]" placeholder="# Generated Python dataclass will appear here"></textarea>
        </div>
      </div>
      <div id="error-msg" class="hidden mt-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-mono"></div>

      <!-- How to Use & Common Use Cases Sections -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-16">
        <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 md:p-8">
          <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-[#ff6b35]">📖</span> How to Use the Converter
          </h2>
          <ol class="space-y-3 text-zinc-300 text-sm list-decimal list-inside leading-relaxed">
            <li><strong>Paste JSON Payload:</strong> Enter or paste your raw JSON string or API response into the JSON Input editor.</li>
            <li><strong>Validate Structure:</strong> Click <strong>Generate &rarr;</strong> to parse your JSON and automatically infer variable types and nested objects.</li>
            <li><strong>Review Generated Code:</strong> Inspect the PEP 8-compliant Python dataclass output complete with type annotations.</li>
            <li><strong>Copy & Integrate:</strong> Click <strong>Copy</strong> to quickly paste the generated dataclass code straight into your Python project.</li>
          </ol>
        </div>

        <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 md:p-8">
          <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-[#2dd4bf]">🚀</span> Common Use Cases
          </h2>
          <ul class="space-y-3 text-zinc-300 text-sm list-disc list-inside leading-relaxed">
            <li><strong>REST API Integration:</strong> Converting JSON responses from external API web services into strongly typed Python models.</li>
            <li><strong>Data Engineering Pipelines:</strong> Structuring unstructured JSON log events or Kafka payloads into Python <code class="text-[#2dd4bf]">@dataclass</code> schemas.</li>
            <li><strong>FastAPI & Pydantic Prototyping:</strong> Quickly bootstrapping data classes for schema validation, serialization, and type checking.</li>
            <li><strong>Codebase Refactoring:</strong> Upgrading raw dictionary-heavy codebases to clean, autocompleted dataclasses for better IDE support.</li>
          </ul>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={faqs} />

      <div class="mt-12">
        <ToolShare title="JSON to Python Converter" url="https://solverspro.com/developer/json-to-python" />
        <SimilarTools category="developer" currentPath="/developer/json-to-python" />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  const jsonEl = document.getElementById('input-json') as HTMLTextAreaElement;
  const outEl = document.getElementById('output-code') as HTMLTextAreaElement;
  const errorEl = document.getElementById('error-msg') as HTMLDivElement;

  function showError(msg: string) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); setTimeout(() => errorEl.classList.add('hidden'), 5000); }
  function capitalize(s: string): string { return s.charAt(0).toUpperCase() + s.slice(1); }
  function toSnake(s: string): string { return s.replace(/([A-Z])/g, '_$1').toLowerCase().replace(/^_/, ''); }

  function pyType(val: any, key: string, classes: Map<string, string>): string {
    if (val === null) return 'Optional[Any]';
    if (Array.isArray(val)) {
      if (val.length === 0) return 'List[Any]';
      return `List[${pyType(val[0], key, classes)}]`;
    }
    if (typeof val === 'object') {
      const name = capitalize(key);
      generateClass(val, name, classes);
      return name;
    }
    if (typeof val === 'number') return Number.isInteger(val) ? 'int' : 'float';
    if (typeof val === 'boolean') return 'bool';
    return 'str';
  }

  function generateClass(obj: Record<string, any>, name: string, classes: Map<string, string>) {
    let code = `@dataclass\nclass ${name}:\n`;
    for (const [key, val] of Object.entries(obj)) {
      const type = pyType(val, key, classes);
      code += `    ${toSnake(key)}: ${type}\n`;
    }
    classes.set(name, code);
  }

  document.getElementById('btn-convert')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      const parsed = JSON.parse(jsonEl.value.trim());
      const classes = new Map<string, string>();
      const root = Array.isArray(parsed) ? (parsed[0] || {}) : parsed;
      generateClass(root, 'RootObject', classes);

      let header = 'from dataclasses import dataclass\nfrom typing import Any, List, Optional\n\n';
      outEl.value = header + Array.from(classes.values()).reverse().join('\n\n');
      outEl.classList.add('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]');
      setTimeout(() => outEl.classList.remove('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]'), 500);
    } catch (e: any) { showError('Invalid JSON: ' + e.message); }
  });

  document.getElementById('btn-copy')?.addEventListener('click', () => { if (outEl.value) copyToClipboard(outEl.value); });
</script>
