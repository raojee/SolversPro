---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import InputField from '../components/InputField.astro';
import CalculateButton from '../components/CalculateButton.astro';
---

<BaseLayout
  title="Contact Us | SolversPro"
  description="Get in touch with the SolversPro team."
>
  <Header />
  <SearchOverlay />
  
  <main class="flex-1 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Contact Us</h1>
      <p class="text-lg text-zinc-400 mb-10">
        Have a question, feedback, or a suggestion for a new tool? We'd love to hear from you. Fill out the form below and our team will get back to you as soon as possible.
      </p>
      
      <form class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-8 shadow-sm space-y-6" onsubmit="event.preventDefault(); alert('Message sent successfully!');">
        <InputField
          label="Full Name"
          name="name"
          type="text"
          placeholder="Jane Doe"
          value=""
        />
        <InputField
          label="Email Address"
          name="email"
          type="email"
          placeholder="jane@example.com"
          value=""
        />
        
        <div class="space-y-2">
          <label class="block text-sm font-semibold text-white">Message</label>
          <textarea 
            name="message" 
            rows="5"
            placeholder="How can we help you?"
            required
            class="w-full px-4 py-3 bg-white/[0.02] border border-white/[0.06] rounded-lg focus:outline-none focus:ring-4 focus:ring-[#ff6b35]/20 focus:border-[#ff6b35] text-white resize-none transition-all duration-200"
          ></textarea>
        </div>
        
        <div class="pt-4">
          <CalculateButton text="Send Message" icon="✉️" />
        </div>
      </form>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
