---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonEditor from '../../components/react/JsonEditor.jsx';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "JSON Formatter & Validator",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free, browser-based JSON formatter, validator, and viewer. Instantly beautify, minify, and parse nested JSON payloads securely with no server uploads."
};
---

<BaseLayout
  title="JSON Formatter & Validator | SolversPro"
  description="Free, browser-based JSON formatter, validator, and viewer. Instantly beautify, minify, and parse nested JSON payloads securely with no server uploads."
  canonical="https://solverspro.com/developer/json-tools"
  schema={schema}
>
  <Header />
  <div class="container mx-auto px-4 py-12 max-w-[1400px]">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Developer Tools', href: '/developer' },
      { label: 'JSON Formatter & Validator' },
    ]} />
    <div class="mb-8 mt-4">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">JSON Formatter & Validator</h1>
      <p class="text-zinc-400 max-w-3xl">
        Validate your JSON structure, beautify or minify the payload, and parse complex nested arrays into readable data tables. All processing happens locally in your browser.
      </p>
    </div>

    <!-- React App -->
    <div class="min-h-[600px] h-[calc(100vh-250px)]">
      <JsonEditor client:load />
    </div>
  </div>
  <Footer />
</BaseLayout>
