---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

import { toolsByCategory } from '../../data/tools';
const tools = toolsByCategory['network'] || [];
---
<BaseLayout
  title="Network Tools — Free Speed Test, Subnet & IP Utilities | SolversPro"
  description="Free online network tools. Test internet speed, calculate IP subnets using CIDR notation, and check your public IP address with location and ISP details."
  canonical="https://solverspro.com/network/"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Network Tools & Utilities — SolversPro",
    "url": "https://solverspro.com/network/",
    "description": "Free online network tools for internet speed testing, CIDR subnet calculations, port reference, and IP address geolocation.",
    "publisher": {
      "@type": "Organization",
      "name": "SolversPro",
      "url": "https://solverspro.com/"
    }
  }
  </script>
  <Header />
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Network Tools' }]} />
    <div class="mb-12 mt-4">
      <h1 class="text-4xl font-bold text-white mb-4">Network Tools</h1>
      <p class="text-zinc-300 text-lg leading-relaxed mt-3">SolversPro Network Hub delivers free, browser-based networking utilities including multi-stream speed testing, CIDR subnet calculators, port lookup reference, and IP geolocation with zero client tracking.</p>
      <p class="text-zinc-400 text-lg max-w-2xl mt-2">Essential networking utilities for sysadmins, developers, and everyday users. Measure bandwidth and latency with our real-time speed test, calculate subnets, and check IP addresses.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {tools.map(tool => <ToolCard {...tool} />)}
    </div>
  </div>
  <Footer />
</BaseLayout>
