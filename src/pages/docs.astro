---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
---

<BaseLayout
  title="Documentation | SolversPro"
  description="API and Documentation for SolversPro coming soon."
>
  <Header />
  <SearchOverlay />
  
  <main class="flex-1 py-24 px-6 flex items-center justify-center">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#ff6b35]/10 text-[#2dd4bf] mb-8">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
      </div>
      
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Documentation Coming Soon</h1>
      <p class="text-xl text-zinc-400 mb-10 max-w-2xl mx-auto">
        We're currently drafting comprehensive documentation for our calculators and upcoming API access.
      </p>
      
      <a href="/" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white transition-all duration-200 bg-[#ff6b35] border border-transparent rounded-xl hover:bg-[#ff8c5a] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#ff6b35]">
        Return Home
      </a>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
