---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "QR Code Generator",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Generate QR codes for URLs, text, emails, phone numbers, and more. Customize size, colors, and download as PNG. 100% free and runs in your browser."
};
---

<BaseLayout
  title="QR Code Generator | SolversPro"
  description="Generate QR codes for URLs, text, email, phone, WiFi, and more. Customize size and colors. Download as PNG. Free and 100% client-side."
  canonical="https://solverspro.com/qr/qr-generator"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <!-- Load QR Code library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" is:inline></script>

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'QR Tools', href: '/qr' },
        { label: 'QR Code Generator' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">📱 QR Code Generator</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">Generate QR codes for URLs, plain text, emails, phone numbers, and WiFi credentials. Customize size, colors, and download instantly.</p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6">
        <!-- Input Panel -->
        <div class="flex-1 space-y-5">

          <!-- Type Selector -->
          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-4">
            <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-3">QR Code Type</label>
            <div class="grid grid-cols-3 sm:grid-cols-5 gap-2">
              {[
                { value: 'url', icon: '🔗', label: 'URL' },
                { value: 'text', icon: '📝', label: 'Text' },
                { value: 'email', icon: '✉️', label: 'Email' },
                { value: 'phone', icon: '📞', label: 'Phone' },
                { value: 'wifi', icon: '📶', label: 'WiFi' },
              ].map((t, i) => (
                <button
                  class={`qr-type-btn flex flex-col items-center gap-1 py-2.5 rounded-lg text-xs font-semibold transition-all border ${i === 0 ? 'bg-[#2dd4bf]/20 text-[#2dd4bf] border-[#2dd4bf]/30' : 'bg-white/[0.03] text-zinc-500 border-white/[0.05] hover:border-white/[0.12] hover:text-zinc-300'}`}
                  data-type={t.value}
                >
                  <span class="text-lg">{t.icon}</span>
                  {t.label}
                </button>
              ))}
            </div>
          </div>

          <!-- Dynamic Input Area -->
          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 space-y-4">
            <!-- URL -->
            <div id="input-url">
              <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Website URL</label>
              <input id="qr-url" type="url" value="https://solverspro.com"
                class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600"
                placeholder="https://example.com"
              />
            </div>

            <!-- Text -->
            <div id="input-text" class="hidden">
              <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Plain Text</label>
              <textarea id="qr-text"
                class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600 resize-none h-28"
                placeholder="Enter any text..."
              ></textarea>
            </div>

            <!-- Email -->
            <div id="input-email" class="hidden space-y-3">
              <div>
                <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Email Address</label>
                <input id="qr-email" type="email"
                  class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600"
                  placeholder="someone@example.com"
                />
              </div>
              <div>
                <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Subject (optional)</label>
                <input id="qr-email-subject" type="text"
                  class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600"
                  placeholder="Hello!"
                />
              </div>
            </div>

            <!-- Phone -->
            <div id="input-phone" class="hidden">
              <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Phone Number</label>
              <input id="qr-phone" type="tel"
                class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600"
                placeholder="+1234567890"
              />
            </div>

            <!-- WiFi -->
            <div id="input-wifi" class="hidden space-y-3">
              <div>
                <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Network Name (SSID)</label>
                <input id="qr-wifi-ssid" type="text"
                  class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600"
                  placeholder="MyWiFiNetwork"
                />
              </div>
              <div>
                <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Password</label>
                <input id="qr-wifi-pass" type="text"
                  class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none placeholder-zinc-600"
                  placeholder="password123"
                />
              </div>
              <div>
                <label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider block mb-2">Security</label>
                <select id="qr-wifi-sec" class="w-full px-4 py-3 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none cursor-pointer">
                  <option value="WPA">WPA/WPA2</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">No Password</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Customization -->
          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 space-y-4">
            <p class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Customization</p>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-xs text-zinc-500 block mb-2">Size</label>
                <select id="qr-size" class="w-full px-3 py-2.5 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white text-sm focus:outline-none cursor-pointer">
                  <option value="128">128×128</option>
                  <option value="256" selected>256×256</option>
                  <option value="384">384×384</option>
                  <option value="512">512×512</option>
                </select>
              </div>
              <div>
                <label class="text-xs text-zinc-500 block mb-2">Error Correction</label>
                <select id="qr-ecc" class="w-full px-3 py-2.5 bg-[#1a1a24] border border-white/[0.08] rounded-lg text-white text-sm focus:outline-none cursor-pointer">
                  <option value="L">L (7%)</option>
                  <option value="M" selected>M (15%)</option>
                  <option value="Q">Q (25%)</option>
                  <option value="H">H (30%)</option>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-xs text-zinc-500 block mb-2">Dark Color</label>
                <input id="qr-dark" type="color" value="#000000"
                  class="w-full h-10 rounded-lg cursor-pointer border border-white/[0.08] bg-[#1a1a24] p-1"
                />
              </div>
              <div>
                <label class="text-xs text-zinc-500 block mb-2">Light Color</label>
                <input id="qr-light" type="color" value="#ffffff"
                  class="w-full h-10 rounded-lg cursor-pointer border border-white/[0.08] bg-[#1a1a24] p-1"
                />
              </div>
            </div>
          </div>

          <button id="btn-generate-qr"
            class="w-full py-4 bg-[#ff6b35] hover:bg-[#ff8555] active:scale-[0.98] text-white font-bold rounded-xl transition-all shadow-lg shadow-[#ff6b35]/20 text-base"
          >
            Generate QR Code
          </button>
        </div>

        <!-- QR Output Panel -->
        <div class="lg:w-72 flex flex-col gap-4">
          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6 flex flex-col items-center gap-5">
            <div class="text-xs font-semibold text-zinc-500 uppercase tracking-wider self-start">Preview</div>
            <div id="qr-canvas-wrap" class="bg-white rounded-xl p-4 w-full flex items-center justify-center min-h-[256px]">
              <div id="qr-placeholder" class="text-center text-gray-400 text-sm">
                <div class="text-4xl mb-3">📱</div>
                <div>QR code will<br/>appear here</div>
              </div>
              <div id="qr-output" class="hidden"></div>
            </div>
            <button id="btn-download" disabled
              class="w-full py-3 bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] font-semibold rounded-xl transition-all border border-[#2dd4bf]/30 text-sm flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              Download PNG
            </button>
          </div>

          <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-4 text-xs text-zinc-600 text-center">
            Higher error correction = more resilient QR code, but denser pattern.
          </div>

          <div class="flex justify-center">
            <SaveResultButton id="save-qr-btn" />
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  declare const QRCode: any;

  let currentType = 'url';
  let qrInstance: any = null;

  // Type switcher
  document.querySelectorAll('.qr-type-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      currentType = (e.currentTarget as HTMLElement).dataset.type || 'url';

      document.querySelectorAll('.qr-type-btn').forEach(b => {
        b.classList.remove('bg-[#2dd4bf]/20', 'text-[#2dd4bf]', 'border-[#2dd4bf]/30');
        b.classList.add('bg-white/[0.03]', 'text-zinc-500', 'border-white/[0.05]');
      });
      (e.currentTarget as HTMLElement).classList.add('bg-[#2dd4bf]/20', 'text-[#2dd4bf]', 'border-[#2dd4bf]/30');
      (e.currentTarget as HTMLElement).classList.remove('bg-white/[0.03]', 'text-zinc-500', 'border-white/[0.05]');

      ['url', 'text', 'email', 'phone', 'wifi'].forEach(t => {
        const el = document.getElementById(`input-${t}`);
        if (el) el.classList.toggle('hidden', t !== currentType);
      });
    });
  });

  function getQRContent(): string {
    switch (currentType) {
      case 'url': return (document.getElementById('qr-url') as HTMLInputElement).value || 'https://solverspro.com';
      case 'text': return (document.getElementById('qr-text') as HTMLTextAreaElement).value || '';
      case 'email': {
        const email = (document.getElementById('qr-email') as HTMLInputElement).value;
        const subj = (document.getElementById('qr-email-subject') as HTMLInputElement).value;
        return `mailto:${email}${subj ? `?subject=${encodeURIComponent(subj)}` : ''}`;
      }
      case 'phone': return `tel:${(document.getElementById('qr-phone') as HTMLInputElement).value}`;
      case 'wifi': {
        const ssid = (document.getElementById('qr-wifi-ssid') as HTMLInputElement).value;
        const pass = (document.getElementById('qr-wifi-pass') as HTMLInputElement).value;
        const sec = (document.getElementById('qr-wifi-sec') as HTMLSelectElement).value;
        return `WIFI:T:${sec};S:${ssid};P:${pass};;`;
      }
      default: return '';
    }
  }

  const eccMap: Record<string, any> = { L: 1, M: 0, Q: 3, H: 2 };

  document.getElementById('btn-generate-qr')?.addEventListener('click', () => {
    const content = getQRContent();
    if (!content) return;

    const size = parseInt((document.getElementById('qr-size') as HTMLSelectElement).value);
    const ecc = (document.getElementById('qr-ecc') as HTMLSelectElement).value;
    const darkColor = (document.getElementById('qr-dark') as HTMLInputElement).value;
    const lightColor = (document.getElementById('qr-light') as HTMLSelectElement).value;

    const outputEl = document.getElementById('qr-output') as HTMLElement;
    const placeholder = document.getElementById('qr-placeholder') as HTMLElement;

    outputEl.innerHTML = '';
    outputEl.classList.remove('hidden');
    placeholder.classList.add('hidden');

    qrInstance = new QRCode(outputEl, {
      text: content,
      width: size,
      height: size,
      colorDark: darkColor,
      colorLight: lightColor,
      correctLevel: eccMap[ecc] ?? 0,
    });

    const downloadBtn = document.getElementById('btn-download') as HTMLButtonElement;
    downloadBtn.disabled = false;

    // Save button
    const saveBtn = document.getElementById('save-qr-btn');
    if (saveBtn) {
      saveBtn.classList.remove('hidden');
      saveBtn.onclick = () => {
        if (typeof (window as any).saveToDashboard === 'function') {
          (window as any).saveToDashboard('QR Code Generator', '/qr/qr-generator', {
            type: 'key-value',
            data: { 'Type': currentType, 'Content': content.substring(0, 40) + (content.length > 40 ? '...' : '') }
          });
        }
      };
    }
  });

  document.getElementById('btn-download')?.addEventListener('click', () => {
    const canvas = document.querySelector('#qr-output canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const link = document.createElement('a');
    link.download = 'qrcode-solverspro.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  });
</script>
