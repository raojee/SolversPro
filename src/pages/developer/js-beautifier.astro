---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

const schema = {
  "@context": "https://schema.org", "@type": "SoftwareApplication",
  "name": "JavaScript Beautifier", "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All", "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Format minified JavaScript into readable, properly indented code. Handles braces, semicolons, and nesting. Free and browser-based."
};
---

<BaseLayout title="JavaScript Beautifier | SolversPro" description="Format minified JavaScript into readable, properly indented code. Handles braces, semicolons, and nesting. Free and browser-based." canonical="https://solverspro.com/developer/js-beautifier" schema={schema}>
  <Header /><SearchOverlay />
  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-5xl">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Developer Tools',href:'/developer'},{label:'JavaScript Beautifier'}]} />
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">⚡ JavaScript Beautifier</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">Format minified JavaScript into readable, properly indented code. Handles nested blocks, functions, and arrays.</p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 min-h-[500px]">
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Minified JS</h2>
            <div class="flex items-center gap-3">
              <select id="indent-size" class="bg-[#1a1a24] border border-white/[0.1] text-xs text-zinc-300 rounded px-2 py-1 outline-none focus:border-[#2dd4bf]">
                <option value="2">2 Spaces</option>
                <option value="4">4 Spaces</option>
                <option value="tab">Tabs</option>
              </select>
              <button id="btn-format" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Format &rarr;</button>
            </div>
          </div>
          <textarea id="input-raw" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[400px]" placeholder='function foo(a,b){if(a>b){return a;}else{return b;}}const arr=[1,2,3];' spellcheck="false"></textarea>
        </div>
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Formatted JS</h2>
            <button id="btn-copy" class="text-xs font-semibold text-[#2dd4bf] hover:text-[#5eead4] transition-colors">Copy</button>
          </div>
          <textarea id="output-code" readonly class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:outline-none font-mono text-sm text-[#2dd4bf] resize-none min-h-[400px]" placeholder="// Formatted JS will appear here"></textarea>
        </div>
      </div>
      <ToolShare title="JavaScript Beautifier" url="https://solverspro.com/developer/js-beautifier" />
      <SimilarTools category="developer" currentPath="/developer/js-beautifier" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  const rawEl = document.getElementById('input-raw') as HTMLTextAreaElement;
  const outEl = document.getElementById('output-code') as HTMLTextAreaElement;
  const indentSelect = document.getElementById('indent-size') as HTMLSelectElement;

  function formatJS(js: string, indentString: string): string {
    let formatted = '';
    let indentLevel = 0;
    
    // Very basic formatting for demonstration/simple minified code
    // A robust solution would use an AST parser like Babel
    js = js.replace(/\s+/g, ' ')
           .replace(/{\s+/g, '{')
           .replace(/}\s+/g, '}')
           .replace(/;\s+/g, ';')
           .replace(/,\s+/g, ',');
           
    let inString = false;
    let stringChar = '';

    for (let i = 0; i < js.length; i++) {
      const char = js.charAt(i);
      
      if ((char === '"' || char === "'" || char === '`') && js.charAt(i-1) !== '\\') {
         if (!inString) {
             inString = true;
             stringChar = char;
         } else if (char === stringChar) {
             inString = false;
         }
         formatted += char;
         continue;
      }
      
      if (inString) {
         formatted += char;
         continue;
      }

      if (char === '{' || char === '[') {
        formatted += ' ' + char + '\n';
        indentLevel++;
        formatted += indentString.repeat(indentLevel);
      } else if (char === '}' || char === ']') {
        indentLevel = Math.max(0, indentLevel - 1);
        formatted = formatted.trimEnd() + '\n' + indentString.repeat(indentLevel) + char;
        // Don't add newline after closing brace if it's followed by else or catch or comma or semicolon
        if (char === '}') {
            const nextTokens = js.slice(i + 1).trim();
            if (nextTokens.startsWith('else') || nextTokens.startsWith('catch')) {
                formatted += ' ';
            } else if (nextTokens.startsWith(',') || nextTokens.startsWith(';')) {
                // let it fall through
            } else {
                formatted += '\n' + indentString.repeat(indentLevel);
            }
        }
      } else if (char === ';') {
        formatted += ';\n' + indentString.repeat(indentLevel);
      } else if (char === ',') {
        // format arrays/objects slightly better
        if (js.charAt(i+1) !== ' ') {
            formatted += ', ';
        } else {
            formatted += ',';
        }
      } else {
        formatted += char;
      }
    }
    
    // cleanup empty lines
    return formatted.replace(/\n\s*\n/g, '\n').trim();
  }

  document.getElementById('btn-format')?.addEventListener('click', () => {
    const val = indentSelect.value;
    const indentStr = val === 'tab' ? '\t' : ' '.repeat(parseInt(val));
    outEl.value = formatJS(rawEl.value, indentStr);
    outEl.classList.add('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]');
    setTimeout(() => outEl.classList.remove('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]'), 500);
  });

  document.getElementById('btn-copy')?.addEventListener('click', () => { if (outEl.value) copyToClipboard(outEl.value); });
</script>
