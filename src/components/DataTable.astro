---
interface Props {
  headers: string[];
  id?: string;
}

const { headers, id = 'data-table' } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border" style="border-color: var(--color-border); border-radius: 16px;" id={id}>
  <table class="w-full text-sm">
    <thead>
      <tr style="background-color: var(--color-sky-light);">
        {headers.map((header, i) => (
          <th
            class="px-4 py-3 font-semibold text-ink text-left"
            style={i > 0 ? 'text-align: right;' : ''}
          >
            {header}
          </th>
        ))}
      </tr>
    </thead>
    <tbody id={`${id}-body`}>
      <!-- Rows populated by JavaScript -->
    </tbody>
  </table>
</div>

<style>
  table tbody tr:nth-child(odd) {
    background-color: var(--color-cream);
  }

  table tbody tr:nth-child(even) {
    background-color: white;
  }

  table tbody tr {
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.15s ease;
  }

  table tbody tr:hover {
    background-color: var(--color-peach) !important;
  }

  table tbody td {
    padding: 12px 16px;
    font-variant-numeric: tabular-nums;
  }

  /* Dark mode */
  :global(.dark) table tbody tr:nth-child(odd) {
    background-color: var(--color-dark-bg);
  }

  :global(.dark) table tbody tr:nth-child(even) {
    background-color: var(--color-dark-surface);
  }

  :global(.dark) table tbody tr:hover {
    background-color: var(--color-dark-border) !important;
  }

  :global(.dark) table thead tr {
    background-color: var(--color-dark-border) !important;
  }

  :global(.dark) table th {
    color: var(--color-cream);
  }

  :global(.dark) div.overflow-x-auto {
    border-color: var(--color-dark-border);
  }

  :global(.dark) table tbody tr {
    border-bottom-color: var(--color-dark-border);
  }

  :global(.dark) table tbody td {
    color: var(--color-cream);
  }
</style>
