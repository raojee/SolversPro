---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';

import { toolsByCategory } from '../../data/tools';
const tools = toolsByCategory['math'] || [];
---

<BaseLayout
 title="Math Calculators — Free Algebra, Calculus & Statistics Tools | SolversPro"
 description="Free online math calculators for algebra, calculus, matrices, and geometry. Solve complex math problems step-by-step instantly in your browser."
>
 <Header />
 <SearchOverlay />

 <main class="flex-1 py-12">
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
 <Breadcrumbs items={[
 { label: 'Home', href: '/' },
 { label: 'Math' },
 ]} />

 <div class="mb-12">
 <div class="flex items-center gap-4 mb-4">
 <div class="w-14 h-14 rounded-lg flex items-center justify-center text-3xl" style="background-color: #eff6ff; border-radius: 16px;">
 📐
 </div>
 <div>
 <h1 class="text-3xl md:text-4xl font-bold text-white ">Math Tools</h1>
 <p class="text-zinc-500 mt-1">Algebra, calculus, statistics, matrices, and advanced STEM tools.</p>
 </div>
 </div>
 </div>

  <div class="prose prose-invert max-w-none mb-12 text-zinc-300">
    <h2>Free Online Math Calculators</h2>
    <p>Welcome to the SolversPro Math Hub. Whether you're a student tackling advanced calculus, an engineer modeling matrix operations, or someone simply looking to find a percentage increase, our collection of free online math calculators is designed to give you instant, accurate results.</p>
    <p>Unlike traditional clunky calculators, our tools run entirely in your web browser. This means absolutely no software downloads, no annoying pop-up ads, and no need to create an account. You get instantaneous computations with complete privacy.</p>
    
    <h3>Tools Available in this Category</h3>
    <ul class="list-disc pl-5 space-y-2 mt-4 mb-6">
      <li><strong>Age Calculator:</strong> Calculate exact chronological age down to the day, month, hour, and minute. Includes next birthday countdown and full milestone lifetime statistics.</li>
      <li><strong>Percentage Calculator:</strong> Solve any percentage problem with three dedicated modes: find X% of Y, discover what percent X is of Y, or calculate percentage increase and decrease.</li>
      <li><strong>Scientific Calculator:</strong> A comprehensive tool featuring trigonometric functions, logarithms, exponentials, and physical constants. Ideal for high school and college STEM coursework.</li>
      <li><strong>Quadratic Equation Solver:</strong> Don't just get the roots—understand the process. This solver breaks down the quadratic formula step-by-step so you can learn how the solution is derived.</li>
      <li><strong>Matrix Calculator:</strong> Easily perform complex linear algebra operations including matrix addition, multiplication, determinants, and inverses. Designed for quick data entry and precise outputs.</li>
      <li><strong>Unit Converter:</strong> Instantly translate between metric and imperial systems. Supports length, weight, temperature, volume, and more, making it indispensable for physics and chemistry problems.</li>
    </ul>
    <p>Our commitment is to provide powerful, step-by-step math solvers that make complex mathematics accessible to everyone. Select a tool below to get started.</p>
  </div>

 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
 {tools.map((tool) => (
 <ToolCard {...tool} />
 ))}
 </div>
 </div>
 </main>

 <Footer />
</BaseLayout>
