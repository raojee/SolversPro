---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import XmlEditor from '../../components/react/XmlEditor.jsx';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "XML Formatter & Validator",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Free, browser-based XML formatter, validator, and viewer. Instantly beautify, minify, and parse complex XML trees securely with no server uploads.",
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "ratingCount": "152" }
};
---

<BaseLayout
  title="XML Formatter & Validator | SolversPro"
  description="Free, browser-based XML formatter, validator, and viewer. Instantly beautify, minify, and parse complex XML trees securely with no server uploads."
  canonical="https://solverspro.com/developer/xml-tools"
  schema={schema}
>
  <Header />
  <div class="container mx-auto px-4 py-12 max-w-[1400px]">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Developer Tools', href: '/developer' },
      { label: 'XML Formatter & Validator' },
    ]} />
    <div class="mb-8 mt-4">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">XML Formatter & Validator</h1>
      <p class="text-zinc-400 max-w-3xl">
        Validate your XML markup, beautify or minify documents, and parse complex XML trees into readable data tables. All processing happens locally in your browser.
      </p>
    </div>

    <!-- React App -->
    <div class="min-h-[600px] h-[calc(100vh-250px)]">
      <XmlEditor client:load />
    </div>
  </div>
  <Footer />
</BaseLayout>
