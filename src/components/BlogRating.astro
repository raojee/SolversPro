---
// src/components/BlogRating.astro
interface Props {
  initialRating?: number;
  totalRatings?: number;
}

const { initialRating = 5, totalRatings = 2 } = Astro.props;
---

<div class="flex items-center gap-4 mt-8 py-6 border-t border-b border-white/[0.06]">
  <div class="flex items-center gap-1 cursor-pointer group" id="blog-rating-stars">
    {[1, 2, 3, 4, 5].map((star) => (
      <svg
        class={`w-6 h-6 transition-colors ${
          star <= initialRating ? 'text-[#ff6b35]' : 'text-zinc-600 group-hover:text-zinc-500'
        } hover:!text-[#ff8c5a]`}
        fill="currentColor"
        viewBox="0 0 20 20"
        data-rating={star}
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>
  <div class="text-sm text-zinc-400 font-medium">
    <span id="rating-value" class="text-white">{initialRating}</span> of <span id="rating-total" class="text-white">{totalRatings}</span> ratings
  </div>
</div>

<script>
  const starsContainer = document.getElementById('blog-rating-stars');
  if (starsContainer) {
    const stars = starsContainer.querySelectorAll('svg');
    let currentRating = 5;

    stars.forEach(star => {
      star.addEventListener('mouseenter', (e) => {
        const hoverVal = parseInt((e.currentTarget as HTMLElement).dataset.rating || '0');
        stars.forEach(s => {
          const val = parseInt(s.dataset.rating || '0');
          if (val <= hoverVal) {
            s.classList.add('text-[#ff8c5a]');
            s.classList.remove('text-[#ff6b35]', 'text-zinc-600');
          } else {
            s.classList.add('text-zinc-600');
            s.classList.remove('text-[#ff6b35]', 'text-[#ff8c5a]');
          }
        });
      });

      star.addEventListener('mouseleave', () => {
        stars.forEach(s => {
          const val = parseInt(s.dataset.rating || '0');
          s.classList.remove('text-[#ff8c5a]');
          if (val <= currentRating) {
            s.classList.add('text-[#ff6b35]');
            s.classList.remove('text-zinc-600');
          } else {
            s.classList.add('text-zinc-600');
            s.classList.remove('text-[#ff6b35]');
          }
        });
      });

      star.addEventListener('click', (e) => {
        currentRating = parseInt((e.currentTarget as HTMLElement).dataset.rating || '0');
        const valEl = document.getElementById('rating-value');
        if (valEl) valEl.textContent = currentRating.toString();
        
        // Only increment total on first vote
        if (!starsContainer.dataset.voted) {
          starsContainer.dataset.voted = 'true';
          const totalEl = document.getElementById('rating-total');
          if (totalEl) totalEl.textContent = (parseInt(totalEl.textContent || '0') + 1).toString();
        }
      });
    });
  }
</script>
