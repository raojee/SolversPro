---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "XML to CSV & CSV to XML Converter",
  "url": "https://solverspro.com/developer/xml-csv/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online bidirectional XML to CSV and CSV to XML converter with DOM parsing, tabular flattening, and client-side processing.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="XML ↔ CSV Converter | SolversPro"
  description="Transform XML documents into CSV tables or convert CSV data into structured XML. Great for legacy data migration. Free and browser-based."
  canonical="https://solverspro.com/developer/xml-csv/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'XML ↔ CSV Converter' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🔄 XML ↔ CSV Converter</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro XML ↔ CSV Converter is a free browser-based developer utility that transforms repeating XML element records into CSV spreadsheets and converts CSV rows into structured XML documents in real time.
        </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full min-h-[500px]">
        <!-- XML Side -->
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">XML</h2>
            <button id="btn-to-csv" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">To CSV &rarr;</button>
          </div>
          <textarea
            id="input-xml"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]"
            placeholder="<users>&#10;  <user><name>Alice</name><age>30</age></user>&#10;  <user><name>Bob</name><age>25</age></user>&#10;</users>"
            spellcheck="false"
          ></textarea>
        </div>

        <!-- CSV Side -->
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <button id="btn-to-xml" class="px-3 py-1.5 text-xs font-semibold bg-[#ff6b35]/20 hover:bg-[#ff8c5a]/30 text-[#ff6b35] rounded transition-colors border border-[#ff6b35]/30">&larr; To XML</button>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">CSV</h2>
          </div>
          <textarea
            id="input-csv"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]"
            placeholder="name,age&#10;Alice,30&#10;Bob,25"
            spellcheck="false"
          ></textarea>
        </div>
      </div>

      <div id="error-msg" class="hidden mt-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-mono"></div>

      <!-- Reference Table -->
      <div class="mt-10 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-base font-bold text-white mb-2">XML to CSV Element Mapping Reference</h2>
        <p class="text-xs text-zinc-400 mb-4">Structural transformations between hierarchical XML tags and tabular columns.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-300">
                <th class="py-2.5 px-3 font-semibold">XML Construct</th>
                <th class="py-2.5 px-3 font-semibold">CSV Component</th>
                <th class="py-2.5 px-3 font-semibold">Translation Rule</th>
                <th class="py-2.5 px-3 font-semibold">Example Output</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-400 font-mono">
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Child Element Name</td>
                <td class="py-2 px-3 text-emerald-400">Column Header</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Tag name becomes column label</td>
                <td class="py-2 px-3 text-zinc-400">&lt;name&gt; &rarr; name</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Repeated Node</td>
                <td class="py-2 px-3 text-emerald-400">Data Row</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Each sibling instance becomes a row</td>
                <td class="py-2 px-3 text-zinc-400">&lt;user&gt;...&lt;/user&gt;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Node Text Content</td>
                <td class="py-2 px-3 text-emerald-400">Cell Value</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Inner text is inserted as cell string</td>
                <td class="py-2 px-3 text-zinc-400">&lt;age&gt;30&lt;/age&gt; &rarr; 30</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Missing Element</td>
                <td class="py-2 px-3 text-emerald-400">Empty Cell</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Omitted tags produce empty commas</td>
                <td class="py-2 px-3 text-zinc-400">Alice,,New York</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={[
        {
          question: "How are repeating XML elements converted into CSV rows?",
          answer: "The tool identifies the repeated child elements under the root container and extracts each child tag as a corresponding column value."
        },
        {
          question: "Can I convert CSV spreadsheets back into XML documents?",
          answer: "Yes, clicking 'To XML' generates an XML document containing a root tag with child record nodes for every spreadsheet row."
        },
        {
          question: "Does this XML conversion tool transmit data over the internet?",
          answer: "No, all DOM parsing and CSV generation run 100% locally in your web browser."
        },
        {
          question: "Is this tool free?",
          answer: "Yes, the SolversPro XML ↔ CSV Converter is completely free to use with no usage restrictions."
        }
      ]} />

      <ToolShare title="XML ↔ CSV Converter" url="https://solverspro.com/developer/xml-csv" />
      <SimilarTools category="developer" currentPath="/developer/xml-csv" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import Papa from 'papaparse';

  const xmlEl = document.getElementById('input-xml') as HTMLTextAreaElement;
  const csvEl = document.getElementById('input-csv') as HTMLTextAreaElement;
  const errorEl = document.getElementById('error-msg') as HTMLDivElement;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
    setTimeout(() => errorEl.classList.add('hidden'), 5000);
  }

  function xmlToObjects(xml: string): Record<string, string>[] {
    const parser = new DOMParser();
    const doc = parser.parseFromString(xml, 'text/xml');
    const err = doc.querySelector('parsererror');
    if (err) throw new Error('Invalid XML: ' + err.textContent?.substring(0, 100));

    const root = doc.documentElement;
    const rows: Record<string, string>[] = [];
    for (const child of Array.from(root.children)) {
      const row: Record<string, string> = {};
      for (const field of Array.from(child.children)) {
        row[field.tagName] = field.textContent || '';
      }
      rows.push(row);
    }
    return rows;
  }

  document.getElementById('btn-to-csv')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      const objects = xmlToObjects(xmlEl.value.trim());
      if (objects.length === 0) { showError('No child elements found in XML root.'); return; }
      csvEl.value = Papa.unparse(objects);
      csvEl.classList.add('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]');
      setTimeout(() => csvEl.classList.remove('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]'), 500);
    } catch (e: any) {
      showError(e.message);
    }
  });

  document.getElementById('btn-to-xml')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      const result = Papa.parse(csvEl.value.trim(), { header: true, skipEmptyLines: true });
      if (result.errors.length > 0) { showError('CSV Error: ' + result.errors[0].message); return; }
      const rows = result.data as Record<string, string>[];
      let xml = '<root>\n';
      for (const row of rows) {
        xml += '  <item>\n';
        for (const [key, val] of Object.entries(row)) {
          const safe = String(val).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          xml += `    <${key}>${safe}</${key}>\n`;
        }
        xml += '  </item>\n';
      }
      xml += '</root>';
      xmlEl.value = xml;
      xmlEl.classList.add('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]');
      setTimeout(() => xmlEl.classList.remove('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]'), 500);
    } catch (e: any) {
      showError(e.message);
    }
  });
</script>
