---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InputField from '../../components/InputField.astro';
import CalculateButton from '../../components/CalculateButton.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Board Feet Calculator",
  "url": "https://solverspro.com/trades/board-feet/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Calculate total board footage (BF) and lumber procurement costs for rough-sawn and dimensional hardwood and softwood stock.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqs = [
  {
    question: "What is the formula to calculate board feet?",
    answer: "Board footage measures volume: Board Feet = (Thickness in inches &times; Width in inches &times; Length in feet) / 12. If length is measured in inches, divide by 144 instead."
  },
  {
    question: "How does nominal lumber thickness differ from rough-sawn hardwood quarter ratings?",
    answer: "Hardwood is sold in quarter-inch nominal increments: 4/4 ('four-quarter') is nominally 1 inch rough, 5/4 is 1.25 inches, 6/4 is 1.5 inches, and 8/4 is 2.0 inches before surface planning."
  },
  {
    question: "How much extra lumber should I order for milling waste?",
    answer: "Woodworkers generally recommend adding 15% to 20% waste allowance for defects, knots, bowing, trimming ends, and jointer/planer surfacing losses."
  },
  {
    question: "Can this calculator compute total project lumber pricing?",
    answer: "Yes. By providing the optional price per board foot quoted by your lumber yard or sawmill, the calculator computes total material cost for your entire cutting list."
  }
];
---

<BaseLayout
  title="Board Feet Calculator | SolversPro"
  description="Calculate the total board footage for lumber and woodworking projects."
  canonical="https://solverspro.com/trades/board-feet/"
  jsonLd={jsonLd}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Trades', href: '/trades/' },
        { label: 'Board Feet' },
      ]} />

      <div class="mb-8 max-w-3xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Board Feet Calculator</h1>
        <p class="text-zinc-300 max-w-2xl mx-auto text-base leading-relaxed">SolversPro Board Feet Calculator is a free woodworking and carpentry estimation tool that computes lumber volume in board feet (BF) and total timber procurement costs based on rough or surfaced board dimensions.</p>
      </div>

      <form class="form-container max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 shadow-sm mb-8" id="calculator-form">
        
        <InputField label="Thickness (inches)" name="thickness" value={1} min={0.1} step={0.1} placeholder="1" />
        <InputField label="Width (inches)" name="width" value={6} min={0.1} step={0.1} placeholder="6" />
        <InputField label="Length (feet)" name="length" value={8} min={0.1} step={0.1} placeholder="8" />
        <InputField label="Quantity (pieces)" name="quantity" value={1} min={1} step={1} placeholder="1" />
        <InputField label="Price per Board Foot (Optional)" name="price" prefix="$" value={0} min={0} step={0.01} placeholder="0.00" />

        <div class="mt-6">
          <CalculateButton text="Calculate" icon="🪵" id="calculate-btn" />
        </div>
      </form>

      <!-- Results -->
      <div id="results-section" class="hidden space-y-8 mb-12 max-w-2xl mx-auto">
        <div class="result-surface p-6 md:p-8 rounded-xl border bg-white/[0.02]">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <p class="label mb-1 text-sm font-medium text-zinc-500 uppercase tracking-wider">Total Board Feet (BF)</p>
              <p class="text-3xl md:text-4xl font-bold text-white" id="result-bf">0</p>
            </div>
            <div id="price-container">
              <p class="label mb-1 text-sm font-medium text-zinc-500 uppercase tracking-wider">Estimated Total Cost</p>
              <p class="text-3xl md:text-4xl font-bold text-[#2dd4bf]" id="result-cost">$0.00</p>
            </div>
          </div>
          <div class="w-full flex justify-end mt-8 border-t border-white/[0.05] pt-4">
            <SaveResultButton id="save-boardfeet-btn" />
          </div>
        </div>
      </div>

      <!-- Citable Reference Table -->
      <div class="mt-12 max-w-4xl mx-auto bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl font-bold text-white mb-4">Hardwood Quarter Sizing & Surfacing Dimensional Guide</h2>
        <p class="text-zinc-400 text-sm mb-6">Rough sawyer quarter ratings compared to finished surfaced two sides (S2S) net thicknesses:</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300">
            <thead class="bg-white/[0.03] text-zinc-200 uppercase text-xs tracking-wider border-b border-white/[0.08]">
              <tr>
                <th class="py-3 px-4">Quarter Rating</th>
                <th class="py-3 px-4">Nominal Rough Thickness</th>
                <th class="py-3 px-4">Finished Planed Thickness (S2S)</th>
                <th class="py-3 px-4">Board Feet (1 Board @ 6" &times; 8')</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.05]">
              <tr>
                <td class="py-3 px-4 font-mono font-bold text-[#2dd4bf]">4/4 ("Four-Quarter")</td>
                <td class="py-3 px-4 font-mono">1.000 in (25.4 mm)</td>
                <td class="py-3 px-4 font-mono">0.750 in (3/4")</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">4.00 BF</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono font-bold text-[#2dd4bf]">5/4 ("Five-Quarter")</td>
                <td class="py-3 px-4 font-mono">1.250 in (31.8 mm)</td>
                <td class="py-3 px-4 font-mono">1.000 in (1")</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">5.00 BF</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono font-bold text-[#2dd4bf]">6/4 ("Six-Quarter")</td>
                <td class="py-3 px-4 font-mono">1.500 in (38.1 mm)</td>
                <td class="py-3 px-4 font-mono">1.250 in (1-1/4")</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">6.00 BF</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono font-bold text-[#2dd4bf]">8/4 ("Eight-Quarter")</td>
                <td class="py-3 px-4 font-mono">2.000 in (50.8 mm)</td>
                <td class="py-3 px-4 font-mono">1.750 in (1-3/4")</td>
                <td class="py-3 px-4 font-mono text-[#ff6b35]">8.00 BF</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="max-w-4xl mx-auto">
        <ToolFAQ faqs={faqs} />
      </div>

      <ToolShare title="Board Feet Calculator" url="https://solverspro.com/trades/board-feet" />
      <SimilarTools category="trades" currentPath="/trades/board-feet" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  function calculate() {
    const t = parseFloat((document.getElementById('input-thickness') as HTMLInputElement)?.value) || 0;
    const w = parseFloat((document.getElementById('input-width') as HTMLInputElement)?.value) || 0;
    const l = parseFloat((document.getElementById('input-length') as HTMLInputElement)?.value) || 0;
    const q = parseFloat((document.getElementById('input-quantity') as HTMLInputElement)?.value) || 1;
    const price = parseFloat((document.getElementById('input-price') as HTMLInputElement)?.value) || 0;
    
    if (t <= 0 || w <= 0 || l <= 0) return;

    const btn = document.getElementById('calculate-btn');
    btn?.setAttribute('data-loading', 'true');

    setTimeout(() => {
      // Formula: (Thickness(in) x Width(in) x Length(ft)) / 12 * Quantity
      const bf = ((t * w * l) / 12) * q;
      const cost = bf * price;

      document.getElementById('result-bf')!.textContent = bf.toFixed(2);
      
      const priceContainer = document.getElementById('price-container');
      if (price > 0) {
        priceContainer?.classList.remove('hidden');
        
        let symbol = '$';
        try {
          const prefs = JSON.parse(localStorage.getItem('solvers_preferences') || '{}');
          if (prefs.defaultCurrency) {
            const CURRENCIES: Record<string, string> = { USD: '$', EUR: '€', GBP: '£', INR: '₹', PKR: '₨', JPY: '¥', CAD: '$', AUD: '$' };
            symbol = CURRENCIES[prefs.defaultCurrency] || '$';
          }
        } catch(e) {}
        
        document.getElementById('result-cost')!.textContent = symbol + cost.toFixed(2);
      } else {
        priceContainer?.classList.add('hidden');
      }

      document.getElementById('results-section')?.classList.remove('hidden');
      btn?.removeAttribute('data-loading');
      
      const saveBtn = document.getElementById('save-boardfeet-btn');
      if (saveBtn) {
        saveBtn.classList.remove('hidden');
        saveBtn.onclick = () => {
          if (typeof window.saveToDashboard === 'function') {
            const data: Record<string, string> = {
              'Board Feet': bf.toFixed(2)
            };
            if (price > 0) {
              let symbol = '$';
              try {
                const prefs = JSON.parse(localStorage.getItem('solvers_preferences') || '{}');
                if (prefs.defaultCurrency) {
                  const CURRENCIES: Record<string, string> = { USD: '$', EUR: '€', GBP: '£', INR: '₹', PKR: '₨', JPY: '¥', CAD: '$', AUD: '$' };
                  symbol = CURRENCIES[prefs.defaultCurrency] || '$';
                }
              } catch(e) {}
              data['Total Cost'] = symbol + cost.toFixed(2);
            }
            const success = window.saveToDashboard('Board Feet Calculator', '/trades/board-feet', {
              type: 'key-value',
              data: data
            });
            if (success) {
              const textEl = saveBtn.querySelector('.btn-text');
              const iconSave = saveBtn.querySelector('.icon-save');
              const iconCheck = saveBtn.querySelector('.icon-check');
              if (textEl) textEl.textContent = 'Saved!';
              if (iconSave) iconSave.classList.add('hidden');
              if (iconCheck) iconCheck.classList.remove('hidden');
              saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              setTimeout(() => {
                if (textEl) textEl.textContent = 'Save Result';
                if (iconSave) iconSave.classList.remove('hidden');
                if (iconCheck) iconCheck.classList.add('hidden');
                saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              }, 2000);
            }
          }
        };
      }
    }, 300);
  }

  document.getElementById('calculator-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });

  // Init Currency
  try {
    const prefs = JSON.parse(localStorage.getItem('solvers_preferences') || '{}');
    if (prefs.defaultCurrency) {
      const CURRENCIES: Record<string, string> = { USD: '$', EUR: '€', GBP: '£', INR: '₹', PKR: '₨', JPY: '¥', CAD: '$', AUD: '$' };
      const symbol = CURRENCIES[prefs.defaultCurrency] || '$';
      const priceInput = document.getElementById('input-price');
      if (priceInput) {
        const wrapper = priceInput.closest('.relative');
        if (wrapper) {
            const prefix = wrapper.querySelector('.prefix-el');
            if (prefix) prefix.textContent = symbol;
        }
      }
    }
  } catch(e) {}
</script>
