---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "JSON to TypeScript Converter",
  "url": "https://solverspro.com/developer/json-to-typescript/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online JSON to TypeScript converter to transform JSON payloads into strongly typed TypeScript interfaces and types client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="JSON to TypeScript Converter | SolversPro"
  description="Generate TypeScript interfaces from JSON data instantly. Infers types, handles nested objects, arrays, and optional fields. Free and browser-based."
  canonical="https://solverspro.com/developer/json-to-typescript/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-5xl">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Developer Tools',href:'/developer'},{label:'JSON to TypeScript'}]} />
      
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🟦 JSON to TypeScript Converter</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro JSON to TypeScript Converter is a free browser-based developer utility that parses arbitrary JSON payloads and generates strongly typed TypeScript interfaces with nested object hierarchies in real time.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 min-h-[500px]">
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">JSON Input</h2>
            <button id="btn-convert" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Generate &rarr;</button>
          </div>
          <textarea id="input-json" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[400px]" placeholder='{"name":"Alice","age":30,"address":{"city":"NYC","zip":"10001"},"tags":["admin","user"]}' spellcheck="false"></textarea>
        </div>
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">TypeScript Output</h2>
            <button id="btn-copy" class="text-xs font-semibold text-[#2dd4bf] hover:text-[#5eead4] transition-colors">Copy</button>
          </div>
          <textarea id="output-code" readonly class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:outline-none font-mono text-sm text-[#2dd4bf] resize-none min-h-[400px]" placeholder="// Generated TypeScript interfaces will appear here"></textarea>
        </div>
      </div>
      <div id="error-msg" class="hidden mt-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-mono"></div>

      <!-- Reference Table -->
      <div class="mt-10 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-base font-bold text-white mb-2">JSON to TypeScript Type Inference Mapping</h2>
        <p class="text-xs text-zinc-400 mb-4">Standard mappings applied during automated TypeScript interface generation.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-300">
                <th class="py-2.5 px-3 font-semibold">JSON Data Type</th>
                <th class="py-2.5 px-3 font-semibold">TypeScript Type</th>
                <th class="py-2.5 px-3 font-semibold">Inference Rule</th>
                <th class="py-2.5 px-3 font-semibold">Example Output</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-400 font-mono">
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">string</td>
                <td class="py-2 px-3 text-emerald-400">string</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">UTF-8 character sequences</td>
                <td class="py-2 px-3 text-zinc-300">name: string;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">number</td>
                <td class="py-2 px-3 text-emerald-400">number</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Integers and floating-point values</td>
                <td class="py-2 px-3 text-zinc-300">count: number;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">boolean</td>
                <td class="py-2 px-3 text-emerald-400">boolean</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">true or false literals</td>
                <td class="py-2 px-3 text-zinc-300">isActive: boolean;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">null</td>
                <td class="py-2 px-3 text-emerald-400">null | any</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Nullable values with fallback</td>
                <td class="py-2 px-3 text-zinc-300">deletedAt: null;</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">array</td>
                <td class="py-2 px-3 text-emerald-400">T[]</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Homogeneous or union item lists</td>
                <td class="py-2 px-3 text-zinc-300">tags: string[];</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">object</td>
                <td class="py-2 px-3 text-emerald-400">InterfaceName</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Nested object decomposed into interface</td>
                <td class="py-2 px-3 text-zinc-300">address: Address;</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={[
        {
          question: "Does this JSON to TypeScript converter run client-side?",
          answer: "Yes, all JSON parsing, interface name generation, and TypeScript type inference occur locally in your browser with zero data transmitted to any external server."
        },
        {
          question: "How are nested objects and arrays handled?",
          answer: "Nested JSON objects are automatically extracted into separate, cleanly named TypeScript interfaces, and array element types are recursively inspected to generate union or specific array types."
        },
        {
          question: "Can I customize the root interface name?",
          answer: "The generated root interface defaults to RootObject and child interfaces derive clean PascalCase names based on property keys."
        },
        {
          question: "Is this tool free to use?",
          answer: "Yes, the SolversPro JSON to TypeScript converter is 100% free with no rate limits or login requirements."
        }
      ]} />

      <ToolShare title="JSON to TypeScript" url="https://solverspro.com/developer/json-to-typescript" />
      <SimilarTools category="developer" currentPath="/developer/json-to-typescript" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';

  const jsonEl = document.getElementById('input-json') as HTMLTextAreaElement;
  const outEl = document.getElementById('output-code') as HTMLTextAreaElement;
  const errorEl = document.getElementById('error-msg') as HTMLDivElement;

  function showError(msg: string) {
    errorEl.textContent = msg; errorEl.classList.remove('hidden');
    setTimeout(() => errorEl.classList.add('hidden'), 5000);
  }

  function capitalize(s: string): string {
    return s.charAt(0).toUpperCase() + s.slice(1);
  }

  function toInterfaceName(key: string): string {
    return capitalize(key.replace(/[^a-zA-Z0-9]/g, '_').replace(/_+/g, '_').replace(/^_|_$/g, ''));
  }

  function inferType(val: any, key: string, interfaces: Map<string, string>): string {
    if (val === null) return 'null';
    if (Array.isArray(val)) {
      if (val.length === 0) return 'any[]';
      const itemType = inferType(val[0], key, interfaces);
      return `${itemType}[]`;
    }
    if (typeof val === 'object') {
      const name = 'I' + toInterfaceName(key);
      generateInterface(val, name, interfaces);
      return name;
    }
    return typeof val; // string | number | boolean
  }

  function generateInterface(obj: Record<string, any>, name: string, interfaces: Map<string, string>) {
    let lines = `export interface ${name} {\n`;
    for (const [key, val] of Object.entries(obj)) {
      const safeKey = /^[a-zA-Z_$][a-zA-Z0-9_$]*$/.test(key) ? key : `'${key}'`;
      const type = inferType(val, key, interfaces);
      lines += `  ${safeKey}: ${type};\n`;
    }
    lines += '}';
    interfaces.set(name, lines);
  }

  document.getElementById('btn-convert')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      const parsed = JSON.parse(jsonEl.value.trim());
      const interfaces = new Map<string, string>();
      if (typeof parsed !== 'object' || parsed === null) {
        showError('JSON must be an object or array of objects');
        return;
      }
      const root = Array.isArray(parsed) ? (parsed[0] || {}) : parsed;
      generateInterface(root, 'IRootObject', interfaces);
      outEl.value = Array.from(interfaces.values()).reverse().join('\n\n');
      outEl.classList.add('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]');
      setTimeout(() => outEl.classList.remove('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]'), 500);
    } catch (e: any) {
      showError('Invalid JSON: ' + e.message);
    }
  });

  document.getElementById('btn-copy')?.addEventListener('click', () => {
    if (outEl.value) copyToClipboard(outEl.value);
  });
</script>
