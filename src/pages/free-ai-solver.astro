---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import UniversalSolver from '../components/react/UniversalSolver.jsx';

// Since this page handles no post requests itself, it can be static,
// but the API endpoint /api/solve.ts requires SSR to build if we export POST.
// For now, this is a standard Astro page.

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free AI Solver — The Universal Solver",
  "url": "https://solverspro.com/free-ai-solver/",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "1450"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  },
  "description": "Type any math, science, or logic problem for an instant, step-by-step solution. Our free AI-powered universal solver breaks down complex problems fast."
};
---

<BaseLayout
  title="Free AI Solver — Step-by-Step AI Problem Solver | SolversPro"
  description="Type any math, science, or logic problem for an instant, step-by-step solution. Our free AI-powered universal solver breaks down complex problems fast."
  canonical="https://solverspro.com/free-ai-solver/"
  schema={schema}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsRQ01PxyUG251qK80nA+rB4LpMQIuz9fX03tFkQ0IeStE/x2YyK0GjOww" crossorigin="anonymous">
  </Fragment>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Free AI Solver' },
      ]} />

      <div class="max-w-3xl mx-auto mt-4">
        <!-- Hero Section -->
        <div class="mb-10 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#ff6b35]/10 text-[#2dd4bf] mb-6 shadow-sm border border-blue-100">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
            Free AI Solver
          </h1>
          <p class="text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto leading-relaxed">
            You think a problem, we solve it. Type any math, science, or logic problem below to see the engine in action.
          </p>
        </div>

        <!-- React App Mounted as an Island -->
        <UniversalSolver client:only="react" />

        <!-- Static SEO & Educational Reference Section -->
        <section class="mt-16 pt-12 border-t border-white/[0.08] space-y-10 text-zinc-300">
          <div>
            <h2 class="text-2xl font-bold text-white mb-3">How the SolversPro Free AI Solver Works</h2>
            <p class="text-zinc-400 leading-relaxed">
              The SolversPro Free AI Solver is a free online step-by-step problem-solving engine for mathematics, physics, chemistry, finance, engineering, and computer science. Enter any equation, word problem, or code logic question in plain English or symbolic notation, and the solver breaks down the derivation into clear, verifiable steps formatted with KaTeX mathematical notation.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
              <h3 class="text-base font-bold text-white mb-2">📐 Calculus &amp; Algebra</h3>
              <p class="text-sm text-zinc-400 leading-relaxed">
                Solve derivatives, definite and indefinite integrals, limits, differential equations, linear systems, eigenvalues, and polynomial factorizations with every intermediate rule explained.
              </p>
            </div>
            <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
              <h3 class="text-base font-bold text-white mb-2">🔬 Physics &amp; Engineering</h3>
              <p class="text-sm text-zinc-400 leading-relaxed">
                Analyze kinematics, thermodynamics, circuit analysis (Ohm's and Kirchhoff's laws), structural mechanics, and unit conversions with explicit formula substitutions and SI units.
              </p>
            </div>
            <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
              <h3 class="text-base font-bold text-white mb-2">💻 Logic, Statistics &amp; Finance</h3>
              <p class="text-sm text-zinc-400 leading-relaxed">
                Compute probability distributions, hypothesis tests, time-value-of-money annuities, Net Present Value (NPV), and algorithmic time complexity (`Big-O`) step by step.
              </p>
            </div>
          </div>

          <div class="p-6 rounded-xl bg-white/[0.02] border border-white/[0.06]">
            <h2 class="text-xl font-bold text-white mb-4">Tips for Getting the Most Accurate Step-by-Step Solutions</h2>
            <ul class="list-disc list-inside space-y-2 text-sm text-zinc-400 leading-relaxed">
              <li><strong class="text-zinc-200">Use explicit parentheses:</strong> Write <code class="text-[#2dd4bf]">Integrate (x^2 + 1) / (x - 1) dx</code> so numerators and denominators are unambiguous.</li>
              <li><strong class="text-zinc-200">Specify the target variable or method:</strong> Include instructions such as <em>"Solve for x over the real numbers"</em>, <em>"Use integration by parts"</em>, or <em>"Show the truth table"</em>.</li>
              <li><strong class="text-zinc-200">Include units for science and trade problems:</strong> Specify whether angles are in degrees or radians, and include metric or imperial units for physics and construction queries.</li>
            </ul>
          </div>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
