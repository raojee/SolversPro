---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Color Converter",
  "url": "https://solverspro.com/developer/color-converter/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online color converter to switch between HEX, RGB, and HSL color values in real time with an interactive color picker and client-side privacy.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="Color Converter | SolversPro"
  description="Convert color codes between HEX, RGB, and HSL formats instantly with live preview. Free, client-side, and interactive color picker for web designers."
  canonical="https://solverspro.com/developer/color-converter/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'Color Converter' },
      ]} />
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">Color Converter</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro Color Converter is a free browser-based utility that transforms color codes bi-directionally between HEX, RGB, and HSL formats in real time with zero server latency.
        </p>
      </div>

      <div class="max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 md:p-8 shadow-sm mb-8 relative overflow-hidden">
        
        <div id="color-preview" class="absolute top-0 left-0 w-full h-2 bg-[#ff6b35] transition-colors duration-300"></div>

        <div class="space-y-6 mt-4">
          <div>
            <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400">HEX Code</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-zinc-500 font-mono">#</span>
              <input type="text" id="input-hex" class="w-full bg-[#0d0d14] border border-white/[0.1] text-white rounded-md py-3 pl-8 pr-4 font-mono focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] transition-colors" placeholder="ff6b35" />
            </div>
          </div>

          <div>
            <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400">RGB</label>
            <input type="text" id="input-rgb" class="w-full bg-[#0d0d14] border border-white/[0.1] text-white rounded-md py-3 px-4 font-mono focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] transition-colors" placeholder="rgb(255, 107, 53)" />
          </div>

          <div>
            <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400">HSL</label>
            <input type="text" id="input-hsl" class="w-full bg-[#0d0d14] border border-white/[0.1] text-white rounded-md py-3 px-4 font-mono focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] transition-colors" placeholder="hsl(16, 100%, 60%)" />
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/[0.06] text-center flex flex-col items-center">
          <input type="color" id="color-picker" value="#ff6b35" class="w-16 h-16 rounded cursor-pointer bg-transparent border-0 p-0" />
          <p class="text-xs text-zinc-500 mt-2 mb-6">Or use the color picker</p>
          
          <SaveResultButton id="save-color-btn" />
        </div>

      </div>

      <!-- Reference Table -->
      <div class="mt-8 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-base font-bold text-white mb-2">CSS Color Model Equivalents Reference</h2>
        <p class="text-xs text-zinc-400 mb-4">Standard web color formats and mathematical representations.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-300">
                <th class="py-2.5 px-3 font-semibold">Color Sample</th>
                <th class="py-2.5 px-3 font-semibold">Color Name</th>
                <th class="py-2.5 px-3 font-semibold">HEX Code</th>
                <th class="py-2.5 px-3 font-semibold">RGB Value</th>
                <th class="py-2.5 px-3 font-semibold">HSL Value</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-400 font-mono">
              <tr>
                <td class="py-2 px-3"><span class="inline-block w-4 h-4 rounded bg-[#000000] border border-white/20 align-middle"></span></td>
                <td class="py-2 px-3 text-zinc-200 font-sans">Pure Black</td>
                <td class="py-2 px-3 text-[#ff6b35]">#000000</td>
                <td class="py-2 px-3">rgb(0, 0, 0)</td>
                <td class="py-2 px-3">hsl(0, 0%, 0%)</td>
              </tr>
              <tr>
                <td class="py-2 px-3"><span class="inline-block w-4 h-4 rounded bg-[#ffffff] border border-white/20 align-middle"></span></td>
                <td class="py-2 px-3 text-zinc-200 font-sans">Pure White</td>
                <td class="py-2 px-3 text-[#ff6b35]">#ffffff</td>
                <td class="py-2 px-3">rgb(255, 255, 255)</td>
                <td class="py-2 px-3">hsl(0, 0%, 100%)</td>
              </tr>
              <tr>
                <td class="py-2 px-3"><span class="inline-block w-4 h-4 rounded bg-[#ff0000] align-middle"></span></td>
                <td class="py-2 px-3 text-zinc-200 font-sans">Vivid Red</td>
                <td class="py-2 px-3 text-[#ff6b35]">#ff0000</td>
                <td class="py-2 px-3">rgb(255, 0, 0)</td>
                <td class="py-2 px-3">hsl(0, 100%, 50%)</td>
              </tr>
              <tr>
                <td class="py-2 px-3"><span class="inline-block w-4 h-4 rounded bg-[#00ff00] align-middle"></span></td>
                <td class="py-2 px-3 text-zinc-200 font-sans">Vivid Lime</td>
                <td class="py-2 px-3 text-[#ff6b35]">#00ff00</td>
                <td class="py-2 px-3">rgb(0, 255, 0)</td>
                <td class="py-2 px-3">hsl(120, 100%, 50%)</td>
              </tr>
              <tr>
                <td class="py-2 px-3"><span class="inline-block w-4 h-4 rounded bg-[#0000ff] align-middle"></span></td>
                <td class="py-2 px-3 text-zinc-200 font-sans">Vivid Blue</td>
                <td class="py-2 px-3 text-[#ff6b35]">#0000ff</td>
                <td class="py-2 px-3">rgb(0, 0, 255)</td>
                <td class="py-2 px-3">hsl(240, 100%, 50%)</td>
              </tr>
              <tr>
                <td class="py-2 px-3"><span class="inline-block w-4 h-4 rounded bg-[#2dd4bf] align-middle"></span></td>
                <td class="py-2 px-3 text-zinc-200 font-sans">Teal Accent</td>
                <td class="py-2 px-3 text-[#ff6b35]">#2dd4bf</td>
                <td class="py-2 px-3">rgb(45, 212, 191)</td>
                <td class="py-2 px-3">hsl(172, 66%, 50%)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={[
        {
          question: "How do I convert HEX to RGB and HSL?",
          answer: "Enter any 3-character or 6-character hexadecimal color code into the HEX field; the tool instantly calculates and updates the corresponding RGB integer values and HSL percentage parameters."
        },
        {
          question: "Does this color converter work offline?",
          answer: "Yes, all mathematical color transformations execute locally in your browser using client-side JavaScript without making network requests."
        },
        {
          question: "What color formats are supported?",
          answer: "The converter supports 3/6-digit HEX codes (with or without #), RGB functional notation rgb(r, g, b), and HSL cylindrical-coordinate representations hsl(h, s%, l%)."
        },
        {
          question: "Is this color conversion tool free?",
          answer: "Yes, the SolversPro Color Converter is completely free to use with no account signups or usage limits."
        }
      ]} />

      <ToolShare title="Color Converter" url="https://solverspro.com/developer/color-converter" />
      <SimilarTools category="developer" currentPath="/developer/color-converter" />
    

    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const hexInput = document.getElementById('input-hex') as HTMLInputElement;
  const rgbInput = document.getElementById('input-rgb') as HTMLInputElement;
  const hslInput = document.getElementById('input-hsl') as HTMLInputElement;
  const picker = document.getElementById('color-picker') as HTMLInputElement;
  const preview = document.getElementById('color-preview');

  let activeInput = '';

  function hexToRgb(hex: string) {
    hex = hex.replace(/^#/, '');
    if (hex.length === 3) hex = hex.split('').map(x => x + x).join('');
    const num = parseInt(hex, 16);
    return [num >> 16, (num >> 8) & 255, num & 255];
  }

  function rgbToHex(r: number, g: number, b: number) {
    return ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toLowerCase();
  }

  function rgbToHsl(r: number, g: number, b: number) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
  }

  function hslToRgb(h: number, s: number, l: number) {
    s /= 100; l /= 100;
    const k = (n: number) => (n + h / 30) % 12;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
    return [Math.round(255 * f(0)), Math.round(255 * f(8)), Math.round(255 * f(4))];
  }

  function updateFromHex(hex: string) {
    const cleanHex = hex.replace(/[^0-9a-fA-F]/g, '');
    if (cleanHex.length === 3 || cleanHex.length === 6) {
      const [r, g, b] = hexToRgb(cleanHex);
      if (activeInput !== 'rgb') rgbInput.value = `rgb(${r}, ${g}, ${b})`;
      const [h, s, l] = rgbToHsl(r, g, b);
      if (activeInput !== 'hsl') hslInput.value = `hsl(${h}, ${s}%, ${l}%)`;
      updatePreview(cleanHex.length === 3 ? cleanHex.split('').map(x=>x+x).join('') : cleanHex);
    }
  }

  function updateFromRgb(rgbStr: string) {
    const match = rgbStr.match(/\d+/g);
    if (match && match.length >= 3) {
      let r = Math.min(255, Math.max(0, parseInt(match[0])));
      let g = Math.min(255, Math.max(0, parseInt(match[1])));
      let b = Math.min(255, Math.max(0, parseInt(match[2])));
      const hex = rgbToHex(r, g, b);
      if (activeInput !== 'hex') hexInput.value = hex;
      const [h, s, l] = rgbToHsl(r, g, b);
      if (activeInput !== 'hsl') hslInput.value = `hsl(${h}, ${s}%, ${l}%)`;
      updatePreview(hex);
    }
  }

  function updateFromHsl(hslStr: string) {
    const match = hslStr.match(/\d+/g);
    if (match && match.length >= 3) {
      let h = Math.min(360, Math.max(0, parseInt(match[0])));
      let s = Math.min(100, Math.max(0, parseInt(match[1])));
      let l = Math.min(100, Math.max(0, parseInt(match[2])));
      const [r, g, b] = hslToRgb(h, s, l);
      if (activeInput !== 'rgb') rgbInput.value = `rgb(${r}, ${g}, ${b})`;
      const hex = rgbToHex(r, g, b);
      if (activeInput !== 'hex') hexInput.value = hex;
      updatePreview(hex);
    }
  }

  function updatePreview(hex: string) {
    if (preview) preview.style.backgroundColor = `#${hex}`;
    if (picker && activeInput !== 'picker') picker.value = `#${hex}`;
    showSaveBtn();
  }

  function showSaveBtn() {
    const saveBtn = document.getElementById('save-color-btn');
    if (saveBtn) {
      saveBtn.classList.remove('hidden');
      saveBtn.onclick = () => {
        if (typeof window.saveToDashboard === 'function') {
          const success = window.saveToDashboard('Color Converter', '/developer/color-converter', {
            type: 'key-value',
            data: {
              'HEX': `#${hexInput.value.replace(/^#/, '')}`,
              'RGB': rgbInput.value,
              'HSL': hslInput.value
            }
          });
          if (success) {
            const textEl = saveBtn.querySelector('.btn-text');
            const iconSave = saveBtn.querySelector('.icon-save');
            const iconCheck = saveBtn.querySelector('.icon-check');
            if (textEl) textEl.textContent = 'Saved!';
            if (iconSave) iconSave.classList.add('hidden');
            if (iconCheck) iconCheck.classList.remove('hidden');
            saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
            saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
            setTimeout(() => {
              if (textEl) textEl.textContent = 'Save Result';
              if (iconSave) iconSave.classList.remove('hidden');
              if (iconCheck) iconCheck.classList.add('hidden');
              saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
            }, 2000);
          }
        }
      };
    }
  }

  hexInput?.addEventListener('input', (e) => {
    activeInput = 'hex';
    updateFromHex((e.target as HTMLInputElement).value);
  });

  rgbInput?.addEventListener('input', (e) => {
    activeInput = 'rgb';
    updateFromRgb((e.target as HTMLInputElement).value);
  });

  hslInput?.addEventListener('input', (e) => {
    activeInput = 'hsl';
    updateFromHsl((e.target as HTMLInputElement).value);
  });

  picker?.addEventListener('input', (e) => {
    activeInput = 'picker';
    const hex = (e.target as HTMLInputElement).value;
    hexInput.value = hex.replace('#', '');
    updateFromHex(hexInput.value);
  });
</script>
