---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';

import { toolsByCategory } from '../../data/tools';
const tools = toolsByCategory['math'] || [];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Math Calculators & Solvers",
  "url": "https://solverspro.com/math/",
  "description": "Free online math calculators for algebra, statistics, matrices, geometry, and scientific calculations. Solve complex STEM problems with step-by-step guidance in your browser.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
 title="Math Calculators — Free Algebra, Calculus & Statistics Tools | SolversPro"
 description="Free online math calculators for algebra, calculus, matrices, and geometry. Solve complex math problems step-by-step instantly in your browser."
 canonical="https://solverspro.com/math/"
 jsonLd={jsonLd}
>
 <Header />
 <SearchOverlay />

 <main class="flex-1 py-12">
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
 <Breadcrumbs items={[
 { label: 'Home', href: '/' },
 { label: 'Math Tools' },
 ]} />

 <div class="mb-12">
 <div class="flex items-center gap-4 mb-4">
 <div class="w-14 h-14 rounded-lg flex items-center justify-center text-3xl" style="background-color: #eff6ff; border-radius: 16px;">
 📐
 </div>
 <div>
 <h1 class="text-3xl md:text-4xl font-bold text-white ">Math Tools</h1>
 <p class="text-zinc-300 max-w-3xl text-base leading-relaxed mt-2">SolversPro Math Tools Hub provides free online mathematical solvers and scientific calculators for algebra, trigonometry, matrix linear algebra, geometry, statistics, and unit conversions running locally in your browser.</p>
 </div>
 </div>
 </div>

  <div class="prose prose-invert max-w-none mb-12 text-zinc-300">
    <h2>Free Online Math Calculators & STEM Solvers</h2>
    <p>Welcome to the SolversPro Math Hub. Whether you're a student tackling advanced algebra, an engineer modeling matrix transformations, or someone looking to analyze statistical datasets, our collection of free online math calculators is designed to give you instant, accurate results.</p>
    <p>Unlike traditional clunky calculators, our tools run entirely in your web browser with zero software downloads, no tracking, and no need to create an account.</p>
    
    <h3>Tools Available in this Category</h3>
    <ul class="list-disc pl-5 space-y-2 mt-4 mb-6">
      <li><strong>Scientific Calculator:</strong> Trigonometric functions, logarithms, powers, and mathematical constants.</li>
      <li><strong>Quadratic Equation Solver:</strong> Step-by-step discriminant factoring and quadratic formula breakdown.</li>
      <li><strong>Matrix Calculator:</strong> Determinants, inverses, additions, and matrix multiplications up to 3&times;3.</li>
      <li><strong>Statistics Calculator:</strong> Real-time mean, median, mode, variance, standard deviation, and IQR metrics.</li>
      <li><strong>Geometry Calculator:</strong> Surface area, perimeter, and volume formulas for 2D and 3D shapes.</li>
      <li><strong>Unit Converter:</strong> Conversion across length, weight, volume, temperature, and speed units.</li>
      <li><strong>Percentage Calculator:</strong> Percent of value, percentage change, and margin ratios.</li>
      <li><strong>Age Calculator:</strong> Exact chronological age, milestone statistics, and birthday countdowns.</li>
      <li><strong>Random Number Generator:</strong> Cryptographically secure integer and floating-point randomization.</li>
    </ul>
    <p>Select any tool below to begin calculating instantly.</p>
  </div>

 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
 {tools.map((tool) => (
 <ToolCard {...tool} />
 ))}
 </div>
 </div>
 </main>

 <Footer />
</BaseLayout>
