---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<BaseLayout title="Compose PDF | SolversPro" description="Create a PDF document from a rich text editor. Add titles, headings, and body content. Download as PDF instantly.">
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'PDF Tools',href:'/pdf'},{label:'Compose PDF'}]} />
      <div class="mb-8 mt-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Compose PDF</h1>
        <p class="text-zinc-400">Write your content and generate a PDF document instantly in your browser.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Editor -->
        <div class="lg:col-span-2 bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-6 space-y-4">
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Document Title</label>
              <input id="doc-title" type="text" placeholder="Enter document title..." class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Author <span class="text-zinc-600 font-normal normal-case">(optional)</span></label>
              <input id="doc-author" type="text" placeholder="Author name..." class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Document Content</label>
            <textarea id="doc-content" rows="18" placeholder="Write your document content here...&#10;&#10;Lines starting with '# ' become headings.&#10;Lines starting with '## ' become subheadings.&#10;Empty lines create paragraph breaks." class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35] resize-y font-mono leading-relaxed"></textarea>
          </div>

          <button id="generate-btn" class="w-full py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">✍️ Generate PDF</button>
          <div id="status" class="hidden text-center py-2 text-zinc-400 text-sm"></div>

          <div id="download-section" class="hidden text-center">
            <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-4 mb-3">
              <p class="text-green-400 font-semibold text-sm">✅ PDF generated!</p>
            </div>
            <a id="download-link" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors text-sm">⬇️ Download PDF</a>
          </div>
        </div>

        <!-- Options sidebar -->
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-6 space-y-5 h-fit">
          <h3 class="text-sm font-bold text-zinc-300 uppercase tracking-wider">PDF Settings</h3>

          <div>
            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Page Size</label>
            <select id="page-size" class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]">
              <option value="a4">A4 (210×297mm)</option>
              <option value="letter">Letter (8.5×11in)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Font Size</label>
            <select id="font-size" class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]">
              <option value="10">10pt — Small</option>
              <option value="12" selected>12pt — Standard</option>
              <option value="14">14pt — Large</option>
              <option value="16">16pt — Extra Large</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Line Spacing</label>
            <select id="line-spacing" class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]">
              <option value="1.2">Compact (1.2)</option>
              <option value="1.5" selected>Normal (1.5)</option>
              <option value="2">Double (2.0)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Include Page Numbers</label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="page-numbers" checked class="accent-[#ff6b35]" />
              <span class="text-sm text-zinc-300">Show page numbers</span>
            </label>
          </div>

          <div class="pt-2 border-t border-white/[0.06]">
            <p class="text-xs text-zinc-600 leading-relaxed">Markdown shortcuts:<br/>
              <code class="text-zinc-500"># Title</code> — Heading 1<br/>
              <code class="text-zinc-500">## Subheading</code> — Heading 2<br/>
              Empty line — Paragraph break
            </p>
          </div>
        </div>
      </div>
      <ToolShare title="Compose PDF" url="https://solverspro.com/pdf/pdf-compose" />
      <SimilarTools category="pdf" currentPath="/pdf/pdf-compose" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { PDFDocument, rgb, StandardFonts } from 'pdf-lib';

  const generateBtn = document.getElementById('generate-btn')!;
  const statusEl = document.getElementById('status')!;
  const downloadSection = document.getElementById('download-section')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;

  generateBtn.addEventListener('click', async () => {
    const title = (document.getElementById('doc-title') as HTMLInputElement).value.trim();
    const author = (document.getElementById('doc-author') as HTMLInputElement).value.trim();
    const content = (document.getElementById('doc-content') as HTMLTextAreaElement).value;
    const pageSize = (document.getElementById('page-size') as HTMLSelectElement).value;
    const fontSize = parseInt((document.getElementById('font-size') as HTMLSelectElement).value);
    const lineSpacingMult = parseFloat((document.getElementById('line-spacing') as HTMLSelectElement).value);
    const showPageNums = (document.getElementById('page-numbers') as HTMLInputElement).checked;

    if (!content.trim()) { statusEl.textContent = '⚠️ Please enter some content.'; statusEl.classList.remove('hidden'); return; }

    statusEl.textContent = '⏳ Generating PDF...';
    statusEl.classList.remove('hidden');
    downloadSection.classList.add('hidden');

    try {
      const doc = await PDFDocument.create();
      if (title) doc.setTitle(title);
      if (author) doc.setAuthor(author);
      doc.setCreator('SolversPro');
      doc.setCreationDate(new Date());

      const fontRegular = await doc.embedFont(StandardFonts.Helvetica);
      const fontBold = await doc.embedFont(StandardFonts.HelveticaBold);

      // Page dimensions
      const pageSizes: Record<string, [number, number]> = {
        a4: [595.28, 841.89],
        letter: [612, 792],
      };
      const [pageW, pageH] = pageSizes[pageSize];
      const margin = 60;
      const maxWidth = pageW - margin * 2;
      const lineHeight = fontSize * lineSpacingMult;

      let page = doc.addPage([pageW, pageH]);
      let y = pageH - margin;
      let pageNum = 1;

      const newPage = () => {
        if (showPageNums) {
          page.drawText(String(pageNum), {
            x: pageW / 2 - 5, y: 30, size: 9,
            font: fontRegular, color: rgb(0.6, 0.6, 0.6),
          });
        }
        page = doc.addPage([pageW, pageH]);
        y = pageH - margin;
        pageNum++;
      };

      const checkY = (needed: number) => { if (y - needed < margin + 20) newPage(); };

      // Draw title
      if (title) {
        checkY(40);
        page.drawText(title, { x: margin, y, size: fontSize + 8, font: fontBold, color: rgb(0.1, 0.1, 0.1) });
        y -= 40;
      }

      // Parse and render content lines
      const lines = content.split('\n');
      for (const raw of lines) {
        const line = raw.trim();

        if (!line) { y -= lineHeight * 0.5; continue; } // empty line = small gap

        if (line.startsWith('## ')) {
          checkY(lineHeight * 2);
          y -= lineHeight * 0.5;
          page.drawText(line.slice(3), { x: margin, y, size: fontSize + 3, font: fontBold, color: rgb(0.15, 0.15, 0.15) });
          y -= lineHeight * 1.5;
        } else if (line.startsWith('# ')) {
          checkY(lineHeight * 2.5);
          y -= lineHeight * 0.5;
          page.drawText(line.slice(2), { x: margin, y, size: fontSize + 6, font: fontBold, color: rgb(0.05, 0.05, 0.05) });
          y -= lineHeight * 2;
        } else {
          // Word-wrap body text
          const words = line.split(' ');
          let curLine = '';
          for (const word of words) {
            const testLine = curLine ? curLine + ' ' + word : word;
            const testWidth = fontRegular.widthOfTextAtSize(testLine, fontSize);
            if (testWidth > maxWidth && curLine) {
              checkY(lineHeight);
              page.drawText(curLine, { x: margin, y, size: fontSize, font: fontRegular, color: rgb(0.1, 0.1, 0.1) });
              y -= lineHeight;
              curLine = word;
            } else {
              curLine = testLine;
            }
          }
          if (curLine) {
            checkY(lineHeight);
            page.drawText(curLine, { x: margin, y, size: fontSize, font: fontRegular, color: rgb(0.1, 0.1, 0.1) });
            y -= lineHeight;
          }
        }
      }

      // Draw page number on last page
      if (showPageNums) {
        page.drawText(String(pageNum), { x: pageW / 2 - 5, y: 30, size: 9, font: fontRegular, color: rgb(0.6, 0.6, 0.6) });
      }

      const saved = await doc.save();
      const blob = new Blob([saved], { type: 'application/pdf' });
      downloadLink.href = URL.createObjectURL(blob);
      downloadLink.download = `${title || 'document'}.pdf`;
      statusEl.classList.add('hidden');
      downloadSection.classList.remove('hidden');
    } catch (e) {
      statusEl.textContent = '❌ Error generating PDF. Please try again.';
    }
  });
</script>
