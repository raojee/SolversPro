---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CalculateButton from '../../components/CalculateButton.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Child & Teen BMI Calculator",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript"
};

const faqItems = [
  {
    question: "Why is BMI calculated differently for children and teens?",
    answer: "Unlike adults, children's body composition changes significantly as they grow. A BMI of 22 might be healthy for a 16-year-old but overweight for a 6-year-old. That's why pediatric BMI is plotted on age-and-sex-specific growth charts and expressed as a percentile rather than a fixed category. This calculator uses the CDC 2000 BMI-for-age growth chart data — the same reference used by pediatricians across the United States."
  },
  {
    question: "What do the BMI percentile categories mean?",
    answer: "The BMI percentile tells you how your child's BMI compares to other children of the same age and sex. Underweight is below the 5th percentile, healthy weight is the 5th to less than the 85th percentile, overweight is the 85th to less than the 95th percentile, and obese is at or above the 95th percentile. These categories are defined by the CDC and are widely used by healthcare providers for pediatric weight screening."
  },
  {
    question: "How accurate is this calculator compared to a doctor's assessment?",
    answer: "This calculator uses the exact same CDC 2000 LMS parameters and Z-score formula that clinical growth chart software uses, so the BMI and percentile results match official CDC calculations within ±1 percentile point. However, a complete pediatric assessment also considers growth trends over time, family history, pubertal stage, and other clinical factors. Always consult your child's pediatrician for a comprehensive evaluation."
  },
];
---

<BaseLayout
  title="Child & Teen BMI Calculator — Percentile Tool (Ages 2–19) | SolversPro"
  description="Free BMI percentile calculator for children and teens ages 2–19. Uses official CDC growth chart data to compute BMI-for-age percentile. 100% private — all calculations run in your browser."
  canonical="https://solverspro.com/health/bmi-calculator-child"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Health', href: '/health' },
        { label: 'Child & Teen BMI Calculator' },
      ]} />

      <!-- Hero -->
      <div class="mb-8 max-w-3xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">
          Child & Teen BMI Calculator
        </h1>
        <p class="text-lg text-zinc-400">
          For children and teens aged 2–19, BMI must be interpreted using age-and-sex-specific growth charts. This calculator uses the official CDC 2000 BMI-for-age LMS parameters to compute an exact BMI percentile — the same data used by pediatricians nationwide. Enter your child's measurements below to see where they fall relative to their peers. All calculations run locally in your browser.
        </p>
      </div>

      <!-- Calculator Form -->
      <form class="form-container max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 shadow-sm mb-8" id="child-bmi-form" novalidate>
        
        <!-- Height Section -->
        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <label class="block text-xs font-semibold uppercase tracking-widest text-zinc-400" style="font-family: 'JetBrains Mono', monospace;">
              Height <span class="text-[#ff6b35]">*</span>
            </label>
            <div class="flex gap-1 bg-white/[0.03] border border-white/[0.1] rounded-md p-0.5" role="radiogroup" aria-label="Height unit">
              <button type="button" class="c-height-unit-btn px-3 py-1 text-xs rounded font-medium transition-all" data-unit="cm" style="font-family: 'JetBrains Mono', monospace;">cm</button>
              <button type="button" class="c-height-unit-btn px-3 py-1 text-xs rounded font-medium transition-all" data-unit="ftin" style="font-family: 'JetBrains Mono', monospace;">ft + in</button>
            </div>
          </div>
          <div id="c-height-cm-group">
            <div class="relative flex items-center">
              <input type="number" id="c-input-height-cm" value="120" min="50" max="220" step="0.1"
                class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-md py-2.5 pl-4 pr-12 transition-all duration-200 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:bg-white/[0.05]"
                style="font-family: 'JetBrains Mono', monospace;"
                aria-label="Height in centimeters"
                aria-describedby="c-height-error" />
              <span class="absolute right-4 text-zinc-400 text-sm select-none pointer-events-none" style="font-family: 'JetBrains Mono', monospace;">cm</span>
            </div>
          </div>
          <div id="c-height-ftin-group" class="hidden">
            <div class="grid grid-cols-2 gap-3">
              <div class="relative flex items-center">
                <input type="number" id="c-input-height-ft" value="3" min="1" max="7" step="1"
                  class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-md py-2.5 pl-4 pr-12 transition-all duration-200 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:bg-white/[0.05]"
                  style="font-family: 'JetBrains Mono', monospace;"
                  aria-label="Height feet" />
                <span class="absolute right-4 text-zinc-400 text-sm select-none pointer-events-none" style="font-family: 'JetBrains Mono', monospace;">ft</span>
              </div>
              <div class="relative flex items-center">
                <input type="number" id="c-input-height-in-part" value="3" min="0" max="11.9" step="0.1"
                  class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-md py-2.5 pl-4 pr-12 transition-all duration-200 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:bg-white/[0.05]"
                  style="font-family: 'JetBrains Mono', monospace;"
                  aria-label="Height inches" />
                <span class="absolute right-4 text-zinc-400 text-sm select-none pointer-events-none" style="font-family: 'JetBrains Mono', monospace;">in</span>
              </div>
            </div>
          </div>
          <p id="c-height-error" class="text-red-400 text-xs mt-1 hidden" role="alert"></p>
        </div>

        <!-- Weight Section -->
        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <label class="block text-xs font-semibold uppercase tracking-widest text-zinc-400" style="font-family: 'JetBrains Mono', monospace;">
              Weight <span class="text-[#ff6b35]">*</span>
            </label>
            <div class="flex gap-1 bg-white/[0.03] border border-white/[0.1] rounded-md p-0.5" role="radiogroup" aria-label="Weight unit">
              <button type="button" class="c-weight-unit-btn px-3 py-1 text-xs rounded font-medium transition-all" data-unit="kg" style="font-family: 'JetBrains Mono', monospace;">kg</button>
              <button type="button" class="c-weight-unit-btn px-3 py-1 text-xs rounded font-medium transition-all" data-unit="lbs" style="font-family: 'JetBrains Mono', monospace;">lbs</button>
            </div>
          </div>
          <div class="relative flex items-center">
            <input type="number" id="c-input-weight" value="25" min="3" max="200" step="0.1"
              class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-md py-2.5 pl-4 pr-12 transition-all duration-200 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:bg-white/[0.05]"
              style="font-family: 'JetBrains Mono', monospace;"
              aria-label="Weight"
              aria-describedby="c-weight-error" />
            <span id="c-weight-suffix" class="absolute right-4 text-zinc-400 text-sm select-none pointer-events-none" style="font-family: 'JetBrains Mono', monospace;">kg</span>
          </div>
          <p id="c-weight-error" class="text-red-400 text-xs mt-1 hidden" role="alert"></p>
        </div>

        <!-- Age -->
        <div class="mb-5">
          <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400" style="font-family: 'JetBrains Mono', monospace;">
            Age <span class="text-[#ff6b35]">*</span>
          </label>
          <div class="grid grid-cols-2 gap-3">
            <div class="relative flex items-center">
              <input type="number" id="c-input-age-years" value="8" min="2" max="19" step="1"
                class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-md py-2.5 pl-4 pr-16 transition-all duration-200 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:bg-white/[0.05]"
                style="font-family: 'JetBrains Mono', monospace;"
                aria-label="Age years"
                aria-describedby="c-age-error" />
              <span class="absolute right-4 text-zinc-400 text-sm select-none pointer-events-none" style="font-family: 'JetBrains Mono', monospace;">years</span>
            </div>
            <div class="relative flex items-center">
              <input type="number" id="c-input-age-months" value="6" min="0" max="11" step="1"
                class="w-full bg-white/[0.03] border border-white/[0.1] text-white rounded-md py-2.5 pl-4 pr-20 transition-all duration-200 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:bg-white/[0.05]"
                style="font-family: 'JetBrains Mono', monospace;"
                aria-label="Age months" />
              <span class="absolute right-4 text-zinc-400 text-sm select-none pointer-events-none" style="font-family: 'JetBrains Mono', monospace;">months</span>
            </div>
          </div>
          <p id="c-age-error" class="text-red-400 text-xs mt-1 hidden" role="alert"></p>
        </div>

        <!-- Sex (required) -->
        <div class="mb-5">
          <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400" style="font-family: 'JetBrains Mono', monospace;">
            Sex <span class="text-[#ff6b35]">*</span>
          </label>
          <div class="flex gap-6">
            <label class="flex items-center gap-2 cursor-pointer text-sm text-zinc-300 hover:text-white transition-colors">
              <input type="radio" name="childSex" value="male" class="accent-[#ff6b35]" checked /> Male
            </label>
            <label class="flex items-center gap-2 cursor-pointer text-sm text-zinc-300 hover:text-white transition-colors">
              <input type="radio" name="childSex" value="female" class="accent-[#ff6b35]" /> Female
            </label>
          </div>
          <p id="c-sex-error" class="text-red-400 text-xs mt-1 hidden" role="alert"></p>
        </div>

        <div class="mt-6">
          <CalculateButton text="Calculate BMI & Percentile" icon="📊" id="child-bmi-btn" />
        </div>
      </form>

      <!-- Results -->
      <div id="c-results-section" class="hidden mb-12 max-w-2xl mx-auto" aria-live="polite">
        <div class="result-surface p-6 md:p-8 rounded-xl border bg-white/[0.02] border-white/[0.06]">
          
          <!-- BMI + Percentile -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6 text-center">
            <div>
              <p class="text-sm font-medium text-zinc-500 uppercase tracking-wider mb-1">BMI</p>
              <p class="text-4xl font-bold text-white" id="c-result-bmi">0</p>
              <p class="text-sm text-zinc-500 mt-1">kg/m²</p>
            </div>
            <div>
              <p class="text-sm font-medium text-zinc-500 uppercase tracking-wider mb-1">Percentile</p>
              <p class="text-4xl font-bold text-[#2dd4bf]" id="c-result-percentile">0</p>
              <div class="inline-block px-3 py-1 rounded-full font-bold text-xs tracking-wide mt-2" id="c-result-category">
                CATEGORY
              </div>
            </div>
          </div>

          <!-- Context sentence -->
          <div class="text-center mb-6">
            <p class="text-zinc-400 text-sm" id="c-result-context"></p>
          </div>

          <!-- Percentile Bar -->
          <div class="mt-6 px-2">
            <div class="relative">
              <div class="flex h-4 rounded-full overflow-hidden">
                <div class="bg-blue-500/60" style="width: 5%;" title="Underweight"></div>
                <div class="bg-green-500/60" style="width: 80%;" title="Healthy Weight"></div>
                <div class="bg-yellow-500/60" style="width: 10%;" title="Overweight"></div>
                <div class="bg-red-500/60" style="width: 5%;" title="Obese"></div>
              </div>
              <!-- Pointer -->
              <div id="c-gauge-pointer" class="absolute top-[-8px] transition-all duration-500 ease-out" style="left: 0%;">
                <div class="w-0 h-0 border-l-[8px] border-r-[8px] border-t-[10px] border-l-transparent border-r-transparent border-t-white mx-auto"></div>
                <div class="w-0.5 h-5 bg-white mx-auto"></div>
              </div>
              <div class="flex mt-2 text-[10px] font-mono text-zinc-500">
                <div style="width: 5%; text-align: center;">5th</div>
                <div style="width: 80%; text-align: center;">50th</div>
                <div style="width: 10%; text-align: center;">85th</div>
                <div style="width: 5%; text-align: center;">95th</div>
              </div>
            </div>
          </div>

          <!-- Category Legend -->
          <div class="mt-6 pt-4 border-t border-white/[0.05]">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs">
              <div><span class="inline-block w-3 h-3 rounded-full bg-blue-500 mb-1"></span><br/><span class="text-zinc-400">Under&shy;weight</span><br/><span class="text-zinc-600">&lt; 5th</span></div>
              <div><span class="inline-block w-3 h-3 rounded-full bg-green-500 mb-1"></span><br/><span class="text-zinc-400">Healthy</span><br/><span class="text-zinc-600">5th–84th</span></div>
              <div><span class="inline-block w-3 h-3 rounded-full bg-yellow-500 mb-1"></span><br/><span class="text-zinc-400">Over&shy;weight</span><br/><span class="text-zinc-600">85th–94th</span></div>
              <div><span class="inline-block w-3 h-3 rounded-full bg-red-500 mb-1"></span><br/><span class="text-zinc-400">Obese</span><br/><span class="text-zinc-600">≥ 95th</span></div>
            </div>
          </div>

          <!-- Disclaimer -->
          <div class="mt-6 p-4 bg-yellow-500/5 border border-yellow-500/10 rounded-lg">
            <p class="text-xs text-zinc-500 leading-relaxed">
              <strong class="text-yellow-500/80">⚠ Medical Disclaimer:</strong> This calculator uses CDC 2000 growth chart data and is intended for screening purposes only. BMI percentile does not directly measure body fat. Growth patterns should be evaluated over time by a qualified pediatric healthcare provider. Always consult your child's doctor for medical advice.
            </p>
          </div>

          <div class="mt-6 flex justify-center">
            <SaveResultButton id="save-child-bmi-btn" />
          </div>
        </div>
      </div>

      <!-- How to Use -->
      <div class="mb-12 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">How to Use</h2>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
          {[
            { step: '1', title: 'Enter Measurements', desc: 'Input your child\'s height and weight.' },
            { step: '2', title: 'Enter Age & Sex', desc: 'Both are required for percentile lookup.' },
            { step: '3', title: 'Click Calculate', desc: 'Press the Calculate button.' },
            { step: '4', title: 'Review Percentile', desc: 'See BMI, percentile, and weight category.' },
          ].map((item) => (
            <div class="text-center p-4">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3 bg-[#ff6b35]">{item.step}</div>
              <h3 class="font-semibold text-white mb-1">{item.title}</h3>
              <p class="text-sm text-zinc-500">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Common Use Cases -->
      <div class="mb-12 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">Common Use Cases</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { icon: '👶', title: 'Pediatric Wellness Checks', desc: 'Check where your child falls on the CDC growth chart between doctor visits.' },
            { icon: '📈', title: 'Growth Tracking', desc: 'Monitor BMI percentile changes over time as your child grows to identify trends.' },
            { icon: '🏫', title: 'School Health Screenings', desc: 'Many schools require BMI percentile data — calculate it quickly and accurately here.' },
            { icon: '🍎', title: 'Nutrition Planning', desc: 'Use the percentile result to help guide age-appropriate nutrition and activity goals.' },
          ].map((item) => (
            <div class="p-4 bg-white/[0.02] border border-white/[0.06] rounded-xl">
              <div class="text-2xl mb-2">{item.icon}</div>
              <h3 class="font-semibold text-white mb-1">{item.title}</h3>
              <p class="text-sm text-zinc-500">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="mb-12 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Questions</h2>
        <FAQAccordion items={faqItems} id="child-bmi-faq" />
      </div>

      <ToolShare title="Child & Teen BMI Calculator — Percentile Tool (Ages 2–19)" url="https://solverspro.com/health/bmi-calculator-child" />
      <SimilarTools category="health" currentPath="/health/bmi-calculator-child" />
    </div>
  </main>

  <Footer />
</BaseLayout>

