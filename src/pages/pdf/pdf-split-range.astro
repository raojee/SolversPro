---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Split PDF By Range",
  "url": "https://solverspro.com/pdf/pdf-split-range/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Extract a specific page range or subset from multi-page PDF documents and download as a new standalone PDF file client-side.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com/"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqs = [
  {
    question: "Can I extract non-consecutive pages with this tool?",
    answer: "This tool is optimized for extracting continuous page ranges (e.g. pages 5 through 12). To extract every single page separately, use our Split PDF To Pages tool."
  },
  {
    question: "Are bookmarks and hyperlinks preserved in the extracted range?",
    answer: "Internal links and text within the extracted page range remain intact, while links pointing outside the extracted range are automatically pruned for clean document fidelity."
  },
  {
    question: "Is my source PDF uploaded to an external server?",
    answer: "No. The entire page extraction process executes directly within your local browser memory via client-side JavaScript. Your file data never leaves your device."
  }
];
---
<BaseLayout
  title="Split PDF By Range — Extract Custom Page Range | SolversPro"
  description="Extract specific page ranges from any PDF file online. 100% private, client-side extraction with instant download. Free online tool by SolversPro."
  canonical="https://solverspro.com/pdf/pdf-split-range/"
  schema={schema}
>
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'PDF Tools',href:'/pdf/'},{label:'Split PDF By Range'}]} />
      <div class="mb-8 mt-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Split PDF By Range</h1>
        <p class="text-zinc-300 text-base leading-relaxed mb-4 max-w-2xl mx-auto">
          The SolversPro Split PDF By Range tool is a free client-side utility that isolates and extracts a custom sequence of pages from any PDF document into a new standalone file.
        </p>
        <p class="text-zinc-400 text-sm">Extract a specific page range from your PDF. Your file never leaves your browser.</p>
      </div>

      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 space-y-6">
        <!-- Drop Zone -->
        <div id="drop-zone" class="border-2 border-dashed border-white/[0.1] rounded-xl p-10 text-center cursor-pointer hover:border-[#ff6b35]/50 hover:bg-[#ff6b35]/[0.02] transition-all">
          <div class="text-4xl mb-3">📄</div>
          <p class="text-white font-semibold mb-1">Drop PDF here or click to browse</p>
          <p class="text-zinc-500 text-sm">PDF files only</p>
          <input type="file" id="file-input" accept=".pdf" class="hidden" />
        </div>

        <!-- File Info -->
        <div id="file-info" class="hidden bg-[#1a1a24] border border-white/[0.06] rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📄</span>
            <div>
              <p id="file-name" class="text-white font-medium text-sm"></p>
              <p id="file-meta" class="text-zinc-500 text-xs"></p>
            </div>
          </div>
          <button id="clear-btn" class="text-zinc-500 hover:text-red-400 transition-colors text-xs">✕ Clear</button>
        </div>

        <!-- Range Options -->
        <div id="options" class="hidden space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">From Page</label>
              <input type="number" id="from-page" min="1" value="1" class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">To Page</label>
              <input type="number" id="to-page" min="1" value="1" class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]" />
            </div>
          </div>
          <p id="page-hint" class="text-zinc-500 text-xs"></p>
        </div>

        <!-- Action -->
        <button id="extract-btn" class="hidden w-full py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">
          ✂️ Extract Pages
        </button>

        <!-- Status -->
        <div id="status" class="hidden text-center py-3 text-zinc-400 text-sm"></div>

        <!-- Download -->
        <div id="download-section" class="hidden text-center">
          <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-6 mb-4">
            <div class="text-3xl mb-2">✅</div>
            <p class="text-green-400 font-semibold">PDF extracted successfully!</p>
          </div>
          <a id="download-link" class="inline-flex items-center gap-2 px-8 py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">
            ⬇️ Download PDF
          </a>
        </div>
      <!-- Reference Table -->
      <div class="result-surface my-12 p-6 md:p-8 bg-[#0d0d14] border border-white/[0.06] rounded-xl max-w-3xl mx-auto">
        <h2 class="text-xl font-bold text-white mb-4">PDF Range Extraction Syntax &amp; Output Specs</h2>
        <p class="text-sm text-zinc-400 mb-4">Common range selection patterns and document compilation behavior.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300 border-collapse">
            <thead>
              <tr class="border-b border-white/10 text-white font-semibold">
                <th class="py-2.5 px-3">Range Pattern</th>
                <th class="py-2.5 px-3">Example Input</th>
                <th class="py-2.5 px-3">Output Result</th>
                <th class="py-2.5 px-3">Primary Use Case</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Single Page Extraction</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">From: 1, To: 1</td>
                <td class="py-2.5 px-3">Single page PDF document</td>
                <td class="py-2.5 px-3 text-zinc-400">Extracting cover letter or invoice</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Chapter / Section</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">From: 15, To: 28</td>
                <td class="py-2.5 px-3">14-page continuous subset</td>
                <td class="py-2.5 px-3 text-zinc-400">Isolating article or report section</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">First N Pages</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">From: 1, To: 5</td>
                <td class="py-2.5 px-3">Pages 1 through 5</td>
                <td class="py-2.5 px-3 text-zinc-400">Creating document previews or executive summaries</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Trailing Section</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">From: 85, To: 90</td>
                <td class="py-2.5 px-3">Final 6 pages</td>
                <td class="py-2.5 px-3 text-zinc-400">Extracting appendices or disclosures</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={faqs} />

      <ToolShare title="Split PDF By Range" url="https://solverspro.com/pdf/pdf-split-range" />
      <SimilarTools category="pdf" currentPath="/pdf/pdf-split-range" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { PDFDocument } from 'pdf-lib';

  let pdfBytes: Uint8Array | null = null;
  let pageCount = 0;

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info')!;
  const options = document.getElementById('options')!;
  const extractBtn = document.getElementById('extract-btn')!;
  const clearBtn = document.getElementById('clear-btn')!;
  const statusEl = document.getElementById('status')!;
  const downloadSection = document.getElementById('download-section')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
  const fromPage = document.getElementById('from-page') as HTMLInputElement;
  const toPage = document.getElementById('to-page') as HTMLInputElement;

  async function loadPdf(file: File) {
    const buffer = await file.arrayBuffer();
    pdfBytes = new Uint8Array(buffer);
    const doc = await PDFDocument.load(pdfBytes);
    pageCount = doc.getPageCount();

    document.getElementById('file-name')!.textContent = file.name;
    document.getElementById('file-meta')!.textContent = `${pageCount} pages · ${(file.size / 1024).toFixed(1)} KB`;
    document.getElementById('page-hint')!.textContent = `This PDF has ${pageCount} pages. Enter the range you want to extract.`;

    toPage.value = String(pageCount);
    toPage.max = String(pageCount);
    fromPage.max = String(pageCount);

    fileInfo.classList.remove('hidden');
    options.classList.remove('hidden');
    extractBtn.classList.remove('hidden');
    dropZone.classList.add('hidden');
    downloadSection.classList.add('hidden');
    statusEl.classList.add('hidden');
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-[#ff6b35]/50'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-[#ff6b35]/50'));
  dropZone.addEventListener('drop', async (e) => {
    e.preventDefault();
    const file = e.dataTransfer?.files[0];
    if (file && file.type === 'application/pdf') await loadPdf(file);
  });
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (file) await loadPdf(file);
  });

  clearBtn.addEventListener('click', () => {
    pdfBytes = null; pageCount = 0;
    fileInput.value = '';
    fileInfo.classList.add('hidden');
    options.classList.add('hidden');
    extractBtn.classList.add('hidden');
    downloadSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  extractBtn.addEventListener('click', async () => {
    if (!pdfBytes) return;
    const from = parseInt(fromPage.value) - 1;
    const to = parseInt(toPage.value) - 1;
    if (from < 0 || to >= pageCount || from > to) {
      statusEl.textContent = '⚠️ Invalid page range. Please check your input.';
      statusEl.classList.remove('hidden');
      return;
    }
    statusEl.textContent = '⏳ Extracting pages...';
    statusEl.classList.remove('hidden');
    downloadSection.classList.add('hidden');

    try {
      const srcDoc = await PDFDocument.load(pdfBytes);
      const newDoc = await PDFDocument.create();
      const indices = Array.from({ length: to - from + 1 }, (_, i) => from + i);
      const pages = await newDoc.copyPages(srcDoc, indices);
      pages.forEach(p => newDoc.addPage(p));
      const saved = await newDoc.save();
      const blob = new Blob([saved], { type: 'application/pdf' });
      downloadLink.href = URL.createObjectURL(blob);
      downloadLink.download = `pages-${from + 1}-${to + 1}.pdf`;
      statusEl.classList.add('hidden');
      downloadSection.classList.remove('hidden');
    } catch (e) {
      statusEl.textContent = '❌ Error processing PDF. Make sure it is not encrypted.';
    }
  });
</script>
