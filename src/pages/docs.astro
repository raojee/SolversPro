<BaseLayout
  title="User Guide & Documentation — How to Use Every Tool | SolversPro"
  description="Complete user guide for all SolversPro free online tools. Step-by-step how-to instructions, features, and FAQs for 80+ tools including developer utilities, PDF tools, finance calculators, math solvers, and more."
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Documentation' },
      ]} />

      <!-- Hero -->
      <div class="mb-16">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl bg-[#06b6d4]/10">
            📖
          </div>
          <div>
            <h1 class="text-3xl md:text-4xl font-bold text-white">Documentation</h1>
            <p class="text-zinc-500 mt-1">Complete guide to every tool on SolversPro.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
          <div class="bg-[#1a1a2e] border border-zinc-800 rounded-xl p-5 text-center">
            <p class="text-3xl font-bold text-white">80+</p>
            <p class="text-sm text-zinc-500 mt-1">Free Tools</p>
          </div>
          <div class="bg-[#1a1a2e] border border-zinc-800 rounded-xl p-5 text-center">
            <p class="text-3xl font-bold text-white">10</p>
            <p class="text-sm text-zinc-500 mt-1">Categories</p>
          </div>
          <div class="bg-[#1a1a2e] border border-zinc-800 rounded-xl p-5 text-center">
            <p class="text-3xl font-bold text-white">100%</p>
            <p class="text-sm text-zinc-500 mt-1">Client-Side & Private</p>
          </div>
        </div>

        <div class="mt-8 p-4 bg-[#06b6d4]/5 border border-[#06b6d4]/20 rounded-xl">
          <p class="text-sm text-zinc-300">
            <span class="text-[#06b6d4] font-semibold">🔒 Privacy First:</span> Every tool on SolversPro runs entirely in your browser. Your data is never uploaded to any server. You can safely use these tools with sensitive information.
          </p>
        </div>
      </div>

      <!-- Category Jump Links -->
      <div class="mb-16">
        <h2 class="text-lg font-semibold text-white mb-4" style="font-family: 'JetBrains Mono', monospace;">// CATEGORIES</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
          {categories.map(cat => (
            <a
              href={`#${cat.id}`}
              class="group flex items-center gap-2.5 px-4 py-3 bg-[#1a1a2e] border border-zinc-800 rounded-xl hover:border-zinc-600 transition-all duration-200 text-sm"
            >
              <span class="text-lg">{cat.icon}</span>
              <span class="text-zinc-300 group-hover:text-white transition-colors">{cat.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Tool Sections -->
      {categories.map(cat => {
        const tools = toolDocs[cat.id as keyof typeof toolDocs] || [];
        return (
          <section id={cat.id} class="mb-20 scroll-mt-24">
            <div class="flex items-center gap-3 mb-8 pb-4 border-b border-zinc-800">
              <span class="text-2xl">{cat.icon}</span>
              <h2 class="text-2xl font-bold text-white">{cat.label}</h2>
              <span class="ml-auto text-xs font-mono text-zinc-600 bg-zinc-800/50 px-2.5 py-1 rounded-full">{tools.length} tools</span>
            </div>

            <div class="space-y-6">
              {tools.map(tool => (
                <div class="doc-tool-card bg-[#12121a] border border-zinc-800/60 rounded-2xl p-6 hover:border-zinc-700 transition-all duration-300">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                    <h3 class="text-lg font-bold text-white">
                      <a href={tool.href} class="hover:text-[#06b6d4] transition-colors">{tool.title}</a>
                    </h3>
                    <a
                      href={tool.href}
                      class="shrink-0 inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] hover:bg-[#06b6d4]/20 transition-colors"
                      style="font-family: 'JetBrains Mono', monospace;"
                    >
                      Try it →
                    </a>
                  </div>

                  <p class="text-zinc-400 text-sm mb-5 leading-relaxed">{tool.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Features -->
                    <div>
                      <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-500 mb-3" style="font-family: 'JetBrains Mono', monospace;">Features</h4>
                      <ul class="space-y-1.5">
                        {tool.features.map(f => (
                          <li class="flex items-start gap-2 text-sm text-zinc-400">
                            <span class="text-[#2dd4bf] mt-0.5 shrink-0">✓</span>
                            <span>{f}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- How to Use -->
                    <div>
                      <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-500 mb-3" style="font-family: 'JetBrains Mono', monospace;">How to Use</h4>
                      <ol class="space-y-1.5">
                        {tool.steps.map((step, i) => (
                          <li class="flex items-start gap-2.5 text-sm text-zinc-400">
                            <span class="shrink-0 w-5 h-5 rounded-full bg-zinc-800 text-zinc-400 text-xs flex items-center justify-center font-mono font-bold mt-0.5">{i + 1}</span>
                            <span>{step}</span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}

      <!-- Bottom CTA -->
      <div class="text-center py-16 border-t border-zinc-800">
        <h2 class="text-2xl font-bold text-white mb-4">Can't find what you need?</h2>
        <p class="text-zinc-400 mb-8 max-w-xl mx-auto">Use our AI-powered search to find the right tool instantly, or try the Universal AI Solver for custom problems.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
