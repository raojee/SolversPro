---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "URL Encoder & Decoder",
  "url": "https://solverspro.com/text/url-encoder/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Encode and decode RFC 3986 percent-encoded uniform resource identifiers and query parameter components instantly in your browser.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqs = [
  {
    question: "What is the difference between encodeURI and encodeURIComponent?",
    answer: "encodeURI is designed for complete URLs and preserves structural delimiters like ':', '/', '?', '&', and '#'. encodeURIComponent encodes every reserved character into percent notation, making it safe for individual query parameter key-value pairs."
  },
  {
    question: "What happens if a URL contains non-ASCII or UTF-8 characters like emojis?",
    answer: "Both encodeURI and encodeURIComponent transform each multi-byte UTF-8 code point sequence into consecutive percent-encoded hexadecimal byte pairs (for example, the space character becomes %20)."
  },
  {
    question: "How does URL decoding handle malformed percent sequences?",
    answer: "If a string contains an invalid escape sequence (such as a single '%' followed by non-hexadecimal characters), standard decode functions throw a URIError; this tool intercepts that error and provides a clear diagnostic warning."
  },
  {
    question: "Is any entered URL data transmitted across the network?",
    answer: "No. All percent encoding and decoding execute client-side in your local browser sandbox, protecting confidential API keys, tokens, and query strings."
  }
];
---

<BaseLayout
  title="URL Encoder & Decoder | SolversPro"
  description="Instantly encode or decode URLs and query strings. Supports full URL encoding and component-level encoding. 100% private — runs in your browser."
  canonical="https://solverspro.com/text/url-encoder/"
  jsonLd={jsonLd}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Text Tools', href: '/text/' },
        { label: 'URL Encoder & Decoder' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🔗 URL Encoder & Decoder</h1>
        <p class="text-zinc-300 max-w-2xl text-base leading-relaxed">SolversPro URL Encoder & Decoder is a free web utility that escapes and decodes RFC 3986 percent-encoded uniform resource identifiers and individual query parameter components securely in your browser.</p>
      </div>

      <!-- Mode Toggle -->
      <div class="flex gap-2 mb-6">
        <button id="btn-mode-encode" class="px-5 py-2 text-sm font-semibold rounded-lg bg-[#2dd4bf] text-slate-900 transition-all">Encode</button>
        <button id="btn-mode-decode" class="px-5 py-2 text-sm font-semibold rounded-lg bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1] transition-all border border-white/[0.08]">Decode</button>
      </div>

      <!-- Encoding Type -->
      <div class="flex gap-3 mb-6 flex-wrap">
        <label class="flex items-center gap-2 text-sm text-zinc-300 cursor-pointer">
          <input type="radio" name="enc-type" id="enc-component" value="component" checked class="accent-[#2dd4bf]" />
          <span>encodeURIComponent</span>
          <span class="text-xs text-zinc-500">(recommended)</span>
        </label>
        <label class="flex items-center gap-2 text-sm text-zinc-300 cursor-pointer">
          <input type="radio" name="enc-type" id="enc-full" value="full" class="accent-[#2dd4bf]" />
          <span>encodeURI</span>
          <span class="text-xs text-zinc-500">(full URLs)</span>
        </label>
      </div>

      <!-- Input / Output Panels -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Input -->
        <div class="flex flex-col gap-3">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 id="label-input" class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Plain Text / URL</h2>
            <button id="btn-clear" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">Clear</button>
          </div>
          <textarea
            id="input-text"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[280px]"
            placeholder="Paste text or URL to encode..."
            spellcheck="false"
          ></textarea>
        </div>

        <!-- Output -->
        <div class="flex flex-col gap-3">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 id="label-output" class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Encoded URL</h2>
            <button id="btn-copy" class="text-xs font-semibold text-[#2dd4bf] hover:text-[#5eead4] transition-colors flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              Copy
            </button>
          </div>
          <textarea
            id="output-text"
            readonly
            class="flex-1 w-full p-4 bg-[#0d0d14] border border-white/[0.06] rounded-b-xl focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[280px] cursor-text"
            placeholder="Result will appear here..."
            spellcheck="false"
          ></textarea>
        </div>
      </div>

      <!-- Action Button -->
      <div class="mt-6 flex justify-center">
        <button id="btn-convert"
          class="px-10 py-3.5 bg-[#2dd4bf] hover:bg-[#5eead4] text-slate-900 rounded-lg font-bold text-sm transition-all shadow-[0_0_20px_rgba(45,212,191,0.3)] hover:shadow-[0_0_30px_rgba(45,212,191,0.5)]"
        >
          Encode URL →
        </button>
      </div>

      <!-- Error Message -->
      <div id="error-msg" class="hidden mt-4 text-center text-sm font-semibold text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg px-4 py-3"></div>

      <!-- Citable Reference Table -->
      <div class="mt-12 bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl font-bold text-white mb-4">RFC 3986 Reserved Character Percent-Encoding Lookup</h2>
        <p class="text-zinc-400 text-sm mb-6">Standard hexadecimal escape substitutions for URI components and reserved characters:</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300">
            <thead class="bg-white/[0.03] text-zinc-200 uppercase text-xs tracking-wider border-b border-white/[0.08]">
              <tr>
                <th class="py-3 px-4">Raw Character</th>
                <th class="py-3 px-4">Percent Code</th>
                <th class="py-3 px-4">Character Name</th>
                <th class="py-3 px-4">Reserved Role in URI</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.05]">
              <tr>
                <td class="py-3 px-4 font-mono text-zinc-100 font-bold">(space)</td>
                <td class="py-3 px-4 font-mono text-[#2dd4bf] font-bold">%20</td>
                <td class="py-3 px-4">Space</td>
                <td class="py-3 px-4 text-zinc-400">Invalid in raw URIs; encoded as %20 or + in forms</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-zinc-100 font-bold">&</td>
                <td class="py-3 px-4 font-mono text-[#2dd4bf] font-bold">%26</td>
                <td class="py-3 px-4">Ampersand</td>
                <td class="py-3 px-4 text-zinc-400">Query parameter delimiter</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-zinc-100 font-bold">=</td>
                <td class="py-3 px-4 font-mono text-[#2dd4bf] font-bold">%3D</td>
                <td class="py-3 px-4">Equal sign</td>
                <td class="py-3 px-4 text-zinc-400">Key-value assignment delimiter</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-zinc-100 font-bold">?</td>
                <td class="py-3 px-4 font-mono text-[#2dd4bf] font-bold">%3F</td>
                <td class="py-3 px-4">Question mark</td>
                <td class="py-3 px-4 text-zinc-400">Query string initiator</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-zinc-100 font-bold">/</td>
                <td class="py-3 px-4 font-mono text-[#2dd4bf] font-bold">%2F</td>
                <td class="py-3 px-4">Forward slash</td>
                <td class="py-3 px-4 text-zinc-400">Path segment separator</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-mono text-zinc-100 font-bold">#</td>
                <td class="py-3 px-4 font-mono text-[#2dd4bf] font-bold">%23</td>
                <td class="py-3 px-4">Hash / Number sign</td>
                <td class="py-3 px-4 text-zinc-400">Fragment identifier initiator</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Info Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5">
          <h3 class="text-sm font-bold text-[#2dd4bf] uppercase tracking-wider mb-3">encodeURIComponent</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">Encodes all special characters including <code class="text-zinc-300 bg-white/[0.08] px-1 rounded">/ ? & = + # @</code>. Use for encoding individual query parameter values.</p>
        </div>
        <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5">
          <h3 class="text-sm font-bold text-orange-400 uppercase tracking-wider mb-3">encodeURI</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">Preserves URL structure characters like <code class="text-zinc-300 bg-white/[0.08] px-1 rounded">/ ? & = + # @</code>. Use for encoding a full URL while keeping its structure intact.</p>
        </div>
      </div>

      <ToolFAQ faqs={faqs} />
      <ToolShare title="URL Encoder & Decoder" url="https://solverspro.com/text/url-encoder" />
      <SimilarTools category="text" currentPath="/text/url-encoder" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  type Mode = 'encode' | 'decode';
  let mode: Mode = 'encode';

  const inputEl = document.getElementById('input-text') as HTMLTextAreaElement;
  const outputEl = document.getElementById('output-text') as HTMLTextAreaElement;
  const labelInput = document.getElementById('label-input')!;
  const labelOutput = document.getElementById('label-output')!;
  const btnConvert = document.getElementById('btn-convert')!;
  const btnModeEncode = document.getElementById('btn-mode-encode')!;
  const btnModeDecode = document.getElementById('btn-mode-decode')!;
  const errorMsg = document.getElementById('error-msg')!;

  function getEncType(): 'component' | 'full' {
    const el = document.getElementById('enc-component') as HTMLInputElement;
    return el.checked ? 'component' : 'full';
  }

  function setMode(m: Mode) {
    mode = m;
    if (m === 'encode') {
      btnModeEncode.className = 'px-5 py-2 text-sm font-semibold rounded-lg bg-[#2dd4bf] text-slate-900 transition-all';
      btnModeDecode.className = 'px-5 py-2 text-sm font-semibold rounded-lg bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1] transition-all border border-white/[0.08]';
      labelInput.textContent = 'Plain Text / URL';
      labelOutput.textContent = 'Encoded URL';
      btnConvert.textContent = 'Encode URL →';
      inputEl.placeholder = 'Paste text or URL to encode...';
    } else {
      btnModeDecode.className = 'px-5 py-2 text-sm font-semibold rounded-lg bg-[#ff6b35] text-white transition-all';
      btnModeEncode.className = 'px-5 py-2 text-sm font-semibold rounded-lg bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1] transition-all border border-white/[0.08]';
      labelInput.textContent = 'Encoded URL';
      labelOutput.textContent = 'Decoded Text';
      btnConvert.textContent = '← Decode URL';
      inputEl.placeholder = 'Paste encoded URL to decode...';
    }
    outputEl.value = '';
    errorMsg.classList.add('hidden');
  }

  function convert() {
    const input = inputEl.value.trim();
    errorMsg.classList.add('hidden');
    if (!input) { outputEl.value = ''; return; }
    try {
      if (mode === 'encode') {
        const type = getEncType();
        outputEl.value = type === 'component' ? encodeURIComponent(input) : encodeURI(input);
      } else {
        outputEl.value = decodeURIComponent(input.replace(/\+/g, ' '));
      }
    } catch (e: any) {
      errorMsg.textContent = `Error: ${e.message}`;
      errorMsg.classList.remove('hidden');
      outputEl.value = '';
    }
  }

  btnModeEncode.addEventListener('click', () => setMode('encode'));
  btnModeDecode.addEventListener('click', () => setMode('decode'));
  btnConvert.addEventListener('click', convert);
  inputEl.addEventListener('input', convert);
  document.querySelectorAll('input[name="enc-type"]').forEach(el => el.addEventListener('change', convert));

  document.getElementById('btn-clear')?.addEventListener('click', () => {
    inputEl.value = '';
    outputEl.value = '';
    errorMsg.classList.add('hidden');
  });

  document.getElementById('btn-copy')?.addEventListener('click', () => {
    if (!outputEl.value) return;
    copyToClipboard(outputEl.value);
    const btn = document.getElementById('btn-copy')!;
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>Copy`, 2000);
  });
</script>
