---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

const posts = [
  {
    title: "Why Developer Solver Tools and Math Solver Tools Are Essential in 2026",
    description: "Discover how developer solver tools and math solver tools can streamline your workflows. From JSON formatters to matrix and quadratic solvers, explore the best browser-based utilities available today.",
    date: "July 6, 2026",
    category: "Guides",
    readTime: "5 min read",
    href: "/blog/developer-and-math-solver-tools-guide"
  },
  {
    title: "70+ Free Online Tools in One Place: Discover SolversPro's Comprehensive Toolkit",
    description: "Discover SolversPro's comprehensive toolkit of over 70 free, browser-based utilities for developers, students, professionals, and everyday users.",
    date: "March 20, 2024",
    category: "Product Update",
    readTime: "4 min read",
    href: "/blog/70-free-online-tools-in-one-place"
  },
  {
    title: "Top 5 Free Online PDF Tools for Editing, Merging, and Protecting Documents",
    description: "Discover the top 5 free online PDF tools that allow you to merge, split, flatten, and protect your PDF documents securely in your browser.",
    date: "July 20, 2026",
    category: "Guides",
    readTime: "5 min read",
    href: "/blog/top-5-free-online-pdf-tools"
  },
  {
    title: "How to Calculate ROI and Cash-on-Cash Return for Real Estate",
    description: "Learn the difference between ROI and Cash-on-Cash Return, and how to use free online financial calculators to analyze your real estate investments.",
    date: "July 20, 2026",
    category: "Finance Guides",
    readTime: "6 min read",
    href: "/blog/how-to-calculate-roi-and-cash-on-cash-return"
  },
  {
    title: "Essential Network Tools: IP Subnet Calculator and IP Lookup Explained",
    description: "Understand how to manage IP addresses, calculate subnets, and perform IP lookups using our free suite of online network administration tools.",
    date: "July 20, 2026",
    category: "Network Admin",
    readTime: "4 min read",
    href: "/blog/essential-network-tools-ip-subnet-calculator"
  }
];
---

<BaseLayout
  title="Blog | SolversPro"
  description="Read the latest articles, guides, and updates from SolversPro. Discover how to make the most of our free online tools."
>
  <Header />
  <SearchOverlay />
  
  <main class="flex-1 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">SolversPro Blog</h1>
        <p class="text-lg text-zinc-400 max-w-2xl">Guides, updates, and deep dives into making the most of our free online tools.</p>
      </div>

      <div class="grid gap-6">
        {posts.map((post) => (
          <a href={post.href} class="block group">
            <article class="p-6 bg-white/[0.02] border border-white/[0.06] rounded-2xl transition-all hover:bg-white/[0.04] hover:border-[#ff6b35]/30">
              <div class="flex items-center gap-4 text-xs font-semibold uppercase tracking-wider mb-4">
                <span class="text-[#ff6b35]">{post.category}</span>
                <span class="text-zinc-600">•</span>
                <span class="text-zinc-500">{post.date}</span>
                <span class="text-zinc-600">•</span>
                <span class="text-zinc-500">{post.readTime}</span>
              </div>
              
              <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-[#ff6b35] transition-colors">
                {post.title}
              </h2>
              
              <p class="text-zinc-400 leading-relaxed mb-4">
                {post.description}
              </p>
              
              <div class="inline-flex items-center gap-2 text-sm font-semibold text-[#2dd4bf] group-hover:text-[#5eead4] transition-colors">
                Read Article
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
