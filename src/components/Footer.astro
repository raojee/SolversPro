---
---

<footer class="bg-[#0d0d14] border-t border-white/[0.06] py-12 md:py-16 mt-auto">
  <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 no-underline mb-4 group">
          <div class="relative flex items-center justify-center w-8 h-8 border border-white/[0.15] bg-[#0d0d14] overflow-hidden shadow-[0_0_15px_rgba(255,107,53,0.1)] group-hover:border-[#ff6b35]/60 group-hover:shadow-[0_0_20px_rgba(255,107,53,0.3)] transition-all duration-300" style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
            <div class="absolute inset-0 bg-gradient-to-br from-[#ff6b35]/10 to-transparent"></div>
            <span class="text-[11px] font-bold tracking-widest relative z-10 translate-x-[1px]" style="font-family: 'JetBrains Mono', monospace;">
              <span class="text-white drop-shadow-[0_0_2px_rgba(255,255,255,0.5)]">S</span><span class="text-[#ff6b35] drop-shadow-[0_0_5px_rgba(255,107,53,0.5)]">P</span>
            </span>
          </div>
          <span class="text-lg font-bold tracking-tight flex items-center gap-px text-white" style="font-family: 'JetBrains Mono', monospace; letter-spacing: -0.02em;">
            <span class="text-zinc-600 font-light mr-1 opacity-50 group-hover:opacity-100 transition-opacity">[</span>
            <span class="text-white group-hover:text-zinc-200 transition-colors">Solvers</span><span class="text-[#ff6b35]">Pro</span>
            <span class="text-zinc-600 font-light ml-1 opacity-50 group-hover:opacity-100 transition-opacity">]</span>
          </span>
        </a>
        <p class="text-sm leading-relaxed text-zinc-500" style="font-family: 'JetBrains Mono', monospace; font-size: 12px;">
          Master <span id="footer-dynamic-text" class="transition-opacity duration-300">Math</span> with Intelligence
        </p>
      </div>
      <!-- Product -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-4 text-zinc-400" style="font-family: 'JetBrains Mono', monospace; font-size: 12px;">Product</h4>
        <ul class="space-y-2">
          <li><a href="/developer" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Developer</a></li>
          <li><a href="/finance" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Finance</a></li>
          <li><a href="/health" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Health</a></li>
          <li><a href="/math" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Math</a></li>
          <li><a href="/network" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Network</a></li>
          <li><a href="/qr" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">QR Code</a></li>
          <li><a href="/security" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Security</a></li>
          <li><a href="/text" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Text</a></li>
          <li><a href="/trades" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Trades</a></li>
        </ul>
      </div>
      <!-- Company -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-4 text-zinc-400" style="font-family: 'JetBrains Mono', monospace; font-size: 12px;">Company</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">About</a></li>
          <li><a href="/faq" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">FAQ</a></li>
          <li><a href="/blog" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Blog</a></li>
          <li><a href="/contact" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Contact</a></li>
          <li><a href="/docs" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Documentation</a></li>
        </ul>
      </div>
      <!-- Legal -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-4 text-zinc-400" style="font-family: 'JetBrains Mono', monospace; font-size: 12px;">Legal</h4>
        <ul class="space-y-2">
          <li><a href="/privacy" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm transition-colors text-zinc-500 hover:text-[#ff6b35]">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="glow-line mb-8"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-zinc-600" style="font-family: 'JetBrains Mono', monospace;">
        © 2026 SolversPro. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/raojee/SolversPro" target="_blank" rel="noopener noreferrer" class="text-zinc-600 hover:text-[#ff6b35] transition-colors" aria-label="GitHub">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://x.com/solverspro_com" target="_blank" rel="noopener noreferrer" class="text-zinc-600 hover:text-[#ff6b35] transition-colors" aria-label="X (Twitter)">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Scope in an IIFE or block to avoid variable collision if included multiple times
  {
    const words = ['Math', 'Finance', 'Engineering', 'Health', 'Trades', 'Code'];
    let i = 0;
    const footerEl = document.getElementById('footer-dynamic-text');
    
    if (footerEl) {
      setInterval(() => {
        footerEl.style.opacity = '0';
        setTimeout(() => {
          i = (i + 1) % words.length;
          footerEl.textContent = words[i];
          footerEl.style.opacity = '1';
        }, 300);
      }, 2500);
    }
  }
</script>
