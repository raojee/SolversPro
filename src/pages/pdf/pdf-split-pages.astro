---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Split PDF To Pages",
  "url": "https://solverspro.com/pdf/pdf-split-pages/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Separate every page of a PDF file into individual single-page documents and download as a single organized ZIP archive client-side.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com/"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqs = [
  {
    question: "How are the split PDF pages named and packaged?",
    answer: "Each page is extracted as an independent single-page PDF named with its zero-padded page number (e.g. document_page_001.pdf) and bundled into a clean ZIP archive for one-click downloading."
  },
  {
    question: "Is there a limit on how many pages I can split?",
    answer: "You can split documents with dozens or hundreds of pages. Because processing executes directly in your browser's local memory, speed is instantaneous without network upload bottlenecks."
  },
  {
    question: "Are my documents kept private during splitting?",
    answer: "Yes. All page separation and ZIP compression happen 100% locally in your browser. Your confidential files are never uploaded to any remote cloud server."
  }
];
---
<BaseLayout
  title="Split PDF To Pages — Extract Every Page to ZIP | SolversPro"
  description="Split multi-page PDF documents into individual single-page files and download as a ZIP. 100% private, client-side processing. Free online tool."
  canonical="https://solverspro.com/pdf/pdf-split-pages/"
  schema={schema}
>
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'PDF Tools',href:'/pdf/'},{label:'Split PDF To Pages'}]} />
      <div class="mb-8 mt-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Split PDF To Each Page</h1>
        <p class="text-zinc-300 text-base leading-relaxed mb-4 max-w-2xl mx-auto">
          The SolversPro Split PDF To Pages tool is a free client-side utility that separates multi-page PDF documents into individual single-page PDF files and bundles them into an instant ZIP archive.
        </p>
        <p class="text-zinc-400 text-sm">Separate every page of a PDF into its own file. Downloaded as a ZIP archive.</p>
      </div>

      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 space-y-6">
        <div id="drop-zone" class="border-2 border-dashed border-white/[0.1] rounded-xl p-10 text-center cursor-pointer hover:border-[#ff6b35]/50 hover:bg-[#ff6b35]/[0.02] transition-all">
          <div class="text-4xl mb-3">📑</div>
          <p class="text-white font-semibold mb-1">Drop PDF here or click to browse</p>
          <p class="text-zinc-500 text-sm">PDF files only</p>
          <input type="file" id="file-input" accept=".pdf" class="hidden" />
        </div>

        <div id="file-info" class="hidden bg-[#1a1a24] border border-white/[0.06] rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📄</span>
            <div>
              <p id="file-name" class="text-white font-medium text-sm"></p>
              <p id="file-meta" class="text-zinc-500 text-xs"></p>
            </div>
          </div>
          <button id="clear-btn" class="text-zinc-500 hover:text-red-400 transition-colors text-xs">✕ Clear</button>
        </div>

        <div id="page-grid" class="hidden">
          <p class="text-sm text-zinc-400 mb-3">Preview pages to split:</p>
          <div id="page-list" class="space-y-2 max-h-60 overflow-y-auto pr-2"></div>
        </div>

        <button id="split-btn" class="hidden w-full py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">
          📑 Split & Download All Pages (ZIP)
        </button>

        <div id="status" class="hidden text-center py-3 text-zinc-400 text-sm"></div>
        <div id="progress-bar" class="hidden">
          <div class="w-full bg-white/[0.05] rounded-full h-2">
            <div id="progress-fill" class="bg-[#ff6b35] h-2 rounded-full transition-all duration-300" style="width:0%"></div>
          </div>
          <p id="progress-text" class="text-xs text-zinc-500 mt-2 text-center"></p>
        </div>

        <div id="download-section" class="hidden text-center">
          <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-6 mb-4">
            <div class="text-3xl mb-2">✅</div>
            <p class="text-green-400 font-semibold">All pages split successfully!</p>
          </div>
          <a id="download-link" class="inline-flex items-center gap-2 px-8 py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">
            ⬇️ Download ZIP
          </a>
        </div>
      <!-- Reference Table -->
      <div class="result-surface my-12 p-6 md:p-8 bg-[#0d0d14] border border-white/[0.06] rounded-xl max-w-3xl mx-auto">
        <h2 class="text-xl font-bold text-white mb-4">PDF Page Splitting &amp; File Archiving Reference</h2>
        <p class="text-sm text-zinc-400 mb-4">Naming conventions and compression parameters used during client-side page separation.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300 border-collapse">
            <thead>
              <tr class="border-b border-white/10 text-white font-semibold">
                <th class="py-2.5 px-3">Parameter</th>
                <th class="py-2.5 px-3">Specification</th>
                <th class="py-2.5 px-3">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">File Naming Scheme</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">&#123;filename&#125;_page_&#123;001&#125;.pdf</td>
                <td class="py-2.5 px-3 text-zinc-400">Zero-padded 3-digit numbering preserves sorting order</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Archive Packaging</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">ZIP (DEFLATE / Store)</td>
                <td class="py-2.5 px-3 text-zinc-400">Cross-platform archive compatible with Windows/macOS/Linux</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Asset Isolation</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">Dedicated Page Tree</td>
                <td class="py-2.5 px-3 text-zinc-400">Prunes unused parent objects to minimize single-page file sizes</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Memory Execution</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">100% In-Browser</td>
                <td class="py-2.5 px-3 text-zinc-400">Zero network payload, unlimited processing privacy</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={faqs} />

      <ToolShare title="Split PDF To Pages" url="https://solverspro.com/pdf/pdf-split-pages" />
      <SimilarTools category="pdf" currentPath="/pdf/pdf-split-pages" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { PDFDocument } from 'pdf-lib';

  let pdfBytes: Uint8Array | null = null;
  let pageCount = 0;

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info')!;
  const splitBtn = document.getElementById('split-btn')!;
  const clearBtn = document.getElementById('clear-btn')!;
  const statusEl = document.getElementById('status')!;
  const downloadSection = document.getElementById('download-section')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
  const pageGrid = document.getElementById('page-grid')!;
  const pageList = document.getElementById('page-list')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressFill = document.getElementById('progress-fill')!;
  const progressText = document.getElementById('progress-text')!;

  async function loadPdf(file: File) {
    const buffer = await file.arrayBuffer();
    pdfBytes = new Uint8Array(buffer);
    const doc = await PDFDocument.load(pdfBytes);
    pageCount = doc.getPageCount();

    document.getElementById('file-name')!.textContent = file.name;
    document.getElementById('file-meta')!.textContent = `${pageCount} pages · ${(file.size / 1024).toFixed(1)} KB`;

    pageList.innerHTML = Array.from({ length: pageCount }, (_, i) =>
      `<div class="flex items-center gap-3 py-2 px-3 bg-[#1a1a24] rounded-lg text-sm text-zinc-300">
         <span class="text-zinc-500 font-mono w-6 text-right">${i + 1}</span>
         <span class="text-zinc-400">Page ${i + 1}</span>
       </div>`
    ).join('');

    fileInfo.classList.remove('hidden');
    pageGrid.classList.remove('hidden');
    splitBtn.classList.remove('hidden');
    dropZone.classList.add('hidden');
    downloadSection.classList.add('hidden');
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); });
  dropZone.addEventListener('drop', async (e) => {
    e.preventDefault();
    const file = e.dataTransfer?.files[0];
    if (file && file.type === 'application/pdf') await loadPdf(file);
  });
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (file) await loadPdf(file);
  });

  clearBtn.addEventListener('click', () => {
    pdfBytes = null; pageCount = 0;
    fileInput.value = '';
    fileInfo.classList.add('hidden');
    pageGrid.classList.add('hidden');
    splitBtn.classList.add('hidden');
    downloadSection.classList.add('hidden');
    progressBar.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  splitBtn.addEventListener('click', async () => {
    if (!pdfBytes) return;
    statusEl.textContent = '⏳ Splitting pages...';
    statusEl.classList.remove('hidden');
    progressBar.classList.remove('hidden');
    downloadSection.classList.add('hidden');

    // Load JSZip from CDN dynamically
    const { default: JSZip } = await import('https://cdn.jsdelivr.net/npm/jszip@3.10.1/+esm');
    const zip = new JSZip();

    try {
      const srcDoc = await PDFDocument.load(pdfBytes!);
      for (let i = 0; i < pageCount; i++) {
        const newDoc = await PDFDocument.create();
        const [page] = await newDoc.copyPages(srcDoc, [i]);
        newDoc.addPage(page);
        const saved = await newDoc.save();
        zip.file(`page-${String(i + 1).padStart(3, '0')}.pdf`, saved);

        const pct = Math.round(((i + 1) / pageCount) * 100);
        progressFill.style.width = pct + '%';
        progressText.textContent = `Processing page ${i + 1} of ${pageCount}...`;
      }

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      downloadLink.href = URL.createObjectURL(zipBlob);
      downloadLink.download = 'split-pages.zip';
      statusEl.classList.add('hidden');
      progressBar.classList.add('hidden');
      downloadSection.classList.remove('hidden');
    } catch (e) {
      statusEl.textContent = '❌ Error splitting PDF. Make sure the file is not encrypted.';
    }
  });
</script>
