---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Random Password Generator",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Generate strong, cryptographically secure random passwords instantly. Customize length, uppercase, lowercase, numbers, and symbols. Runs entirely in your browser."
};
---

<BaseLayout
  title="Random Password Generator | SolversPro"
  description="Generate strong, cryptographically secure random passwords. Customize length and character sets. 100% private — runs entirely in your browser."
  canonical="https://solverspro.com/security/password-generator"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-3xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Security Tools', href: '/security' },
        { label: 'Password Generator' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🔐 Random Password Generator</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">Generate cryptographically secure passwords with custom length and character sets. Everything runs in your browser — zero data sent to any server.</p>
      </div>

      <!-- Generated Password Display -->
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6 mb-6">
        <div class="flex items-center gap-3 mb-4">
          <div id="password-display"
            class="flex-1 font-mono text-xl text-white bg-[#1a1a24] border border-white/[0.08] rounded-lg px-5 py-4 tracking-widest min-h-[60px] flex items-center break-all select-all"
          >Click Generate to create a password</div>
          <button id="btn-copy"
            class="px-4 py-4 text-sm font-semibold bg-[#2dd4bf]/10 hover:bg-[#2dd4bf]/25 text-[#2dd4bf] rounded-lg transition-all border border-[#2dd4bf]/20 flex-shrink-0"
            title="Copy password"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>
        </div>

        <!-- Strength Meter -->
        <div>
          <div class="flex justify-between text-xs mb-1.5">
            <span class="text-zinc-500 uppercase tracking-wider font-semibold">Strength</span>
            <span id="strength-label" class="font-bold text-zinc-500">—</span>
          </div>
          <div class="h-2 rounded-full bg-white/[0.05] overflow-hidden">
            <div id="strength-bar" class="h-full rounded-full transition-all duration-500 w-0"></div>
          </div>
        </div>
      </div>

      <!-- Options -->
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6 mb-6 space-y-6">
        <!-- Length -->
        <div>
          <div class="flex justify-between items-center mb-3">
            <label class="text-sm font-semibold text-zinc-300 uppercase tracking-wider">Password Length</label>
            <span id="length-display" class="text-2xl font-bold text-[#2dd4bf] tabular-nums w-10 text-right">16</span>
          </div>
          <input id="length-slider" type="range" min="6" max="64" value="16"
            class="w-full h-2 rounded-full appearance-none cursor-pointer accent-[#2dd4bf] bg-white/[0.08]"
          />
          <div class="flex justify-between text-xs text-zinc-600 mt-1.5">
            <span>6</span><span>16</span><span>32</span><span>48</span><span>64</span>
          </div>
        </div>

        <!-- Character Sets -->
        <div>
          <p class="text-sm font-semibold text-zinc-300 uppercase tracking-wider mb-4">Character Types</p>
          <div class="grid grid-cols-2 gap-3">
            {[
              { id: 'opt-upper', label: 'Uppercase (A–Z)', checked: true },
              { id: 'opt-lower', label: 'Lowercase (a–z)', checked: true },
              { id: 'opt-numbers', label: 'Numbers (0–9)', checked: true },
              { id: 'opt-symbols', label: 'Symbols (!@#…)', checked: false },
            ].map(opt => (
              <label class="flex items-center gap-3 cursor-pointer group bg-[#1a1a24] hover:bg-[#1e1e2e] border border-white/[0.06] rounded-lg px-4 py-3 transition-colors">
                <input type="checkbox" id={opt.id} checked={opt.checked}
                  class="w-4 h-4 rounded accent-[#2dd4bf] cursor-pointer"
                />
                <span class="text-sm text-zinc-300 group-hover:text-white transition-colors">{opt.label}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Options Row -->
        <div class="flex flex-wrap gap-3">
          <label class="flex items-center gap-2 cursor-pointer text-sm text-zinc-400 hover:text-zinc-200 transition-colors">
            <input type="checkbox" id="opt-exclude-ambiguous" class="w-4 h-4 rounded accent-[#2dd4bf]" />
            Exclude ambiguous chars (0, O, l, I)
          </label>
          <label class="flex items-center gap-2 cursor-pointer text-sm text-zinc-400 hover:text-zinc-200 transition-colors">
            <input type="checkbox" id="opt-no-repeat" class="w-4 h-4 rounded accent-[#2dd4bf]" />
            No repeating characters
          </label>
        </div>
      </div>

      <!-- Quantity & Generate -->
      <div class="flex flex-col sm:flex-row gap-4 mb-6">
        <div class="flex items-center gap-3 bg-[#0d0d14] border border-white/[0.06] rounded-xl px-4 py-3 flex-1">
          <label class="text-sm text-zinc-400 whitespace-nowrap">Generate</label>
          <select id="qty-select" class="flex-1 bg-transparent text-white font-semibold text-sm focus:outline-none cursor-pointer">
            <option value="1">1 password</option>
            <option value="5">5 passwords</option>
            <option value="10">10 passwords</option>
          </select>
        </div>
        <button id="btn-generate"
          class="flex-1 sm:flex-none px-8 py-3 bg-[#ff6b35] hover:bg-[#ff8555] active:scale-95 text-white font-bold rounded-xl transition-all shadow-lg shadow-[#ff6b35]/20 text-base"
        >
          Generate Password
        </button>
      </div>

      <!-- Bulk Results -->
      <div id="bulk-results" class="hidden bg-[#0d0d14] border border-white/[0.06] rounded-xl p-5 mb-6 space-y-2"></div>

      <div class="mt-4 flex justify-center">
        <SaveResultButton id="save-pw-btn" />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  const passwordDisplay = document.getElementById('password-display') as HTMLDivElement;
  const lengthSlider = document.getElementById('length-slider') as HTMLInputElement;
  const lengthDisplay = document.getElementById('length-display') as HTMLSpanElement;
  const btnGenerate = document.getElementById('btn-generate') as HTMLButtonElement;
  const btnCopy = document.getElementById('btn-copy') as HTMLButtonElement;
  const strengthBar = document.getElementById('strength-bar') as HTMLDivElement;
  const strengthLabel = document.getElementById('strength-label') as HTMLSpanElement;
  const bulkResults = document.getElementById('bulk-results') as HTMLDivElement;
  const qtySelect = document.getElementById('qty-select') as HTMLSelectElement;

  lengthSlider.addEventListener('input', () => {
    lengthDisplay.textContent = lengthSlider.value;
  });

  function getCharset(): string {
    const ambiguous = 'O0lI1';
    let charset = '';
    if ((document.getElementById('opt-upper') as HTMLInputElement).checked) charset += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    if ((document.getElementById('opt-lower') as HTMLInputElement).checked) charset += 'abcdefghijklmnopqrstuvwxyz';
    if ((document.getElementById('opt-numbers') as HTMLInputElement).checked) charset += '0123456789';
    if ((document.getElementById('opt-symbols') as HTMLInputElement).checked) charset += '!@#$%^&*()_+-=[]{}|;:,.<>?';

    if ((document.getElementById('opt-exclude-ambiguous') as HTMLInputElement).checked) {
      charset = charset.split('').filter(c => !ambiguous.includes(c)).join('');
    }
    return charset;
  }

  function generateOne(length: number): string {
    const charset = getCharset();
    if (!charset) return '';

    const noRepeat = (document.getElementById('opt-no-repeat') as HTMLInputElement).checked;
    if (noRepeat && length > charset.length) {
      alert(`Cannot generate ${length}-char password without repetition from charset of ${charset.length} chars.`);
      return '';
    }

    const array = new Uint32Array(length * 3);
    crypto.getRandomValues(array);

    let password = '';
    let idx = 0;

    if (noRepeat) {
      const chars = charset.split('');
      for (let i = 0; i < length; i++) {
        const pick = array[idx++] % chars.length;
        password += chars[pick];
        chars.splice(pick, 1);
      }
    } else {
      for (let i = 0; i < length; i++) {
        password += charset[array[idx++] % charset.length];
      }
    }
    return password;
  }

  function scorePassword(pwd: string): { score: number; label: string; color: string } {
    let score = 0;
    if (pwd.length >= 8) score++;
    if (pwd.length >= 12) score++;
    if (pwd.length >= 16) score++;
    if (/[A-Z]/.test(pwd)) score++;
    if (/[a-z]/.test(pwd)) score++;
    if (/[0-9]/.test(pwd)) score++;
    if (/[^A-Za-z0-9]/.test(pwd)) score++;

    if (score <= 2) return { score: 20, label: 'Weak', color: '#ef4444' };
    if (score <= 4) return { score: 50, label: 'Fair', color: '#f59e0b' };
    if (score <= 5) return { score: 75, label: 'Strong', color: '#22c55e' };
    return { score: 100, label: 'Very Strong', color: '#2dd4bf' };
  }

  function updateStrengthUI(pwd: string) {
    const { score, label, color } = scorePassword(pwd);
    strengthBar.style.width = `${score}%`;
    strengthBar.style.backgroundColor = color;
    strengthLabel.textContent = label;
    strengthLabel.style.color = color;
  }

  function generate() {
    const charset = getCharset();
    if (!charset) { alert('Please select at least one character type.'); return; }

    const length = parseInt(lengthSlider.value);
    const qty = parseInt(qtySelect.value);

    const password = generateOne(length);
    if (!password) return;

    passwordDisplay.textContent = password;
    updateStrengthUI(password);

    if (qty > 1) {
      bulkResults.classList.remove('hidden');
      bulkResults.innerHTML = `<p class="text-xs text-zinc-500 uppercase tracking-wider font-semibold mb-3">All ${qty} Passwords</p>`;
      const passwords = [password];
      for (let i = 1; i < qty; i++) passwords.push(generateOne(length));
      passwords.forEach(pw => {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-3 bg-[#1a1a24] rounded-lg px-4 py-2.5 group hover:bg-[#1e1e2e] transition-colors';
        row.innerHTML = `<code class="font-mono text-sm text-zinc-300 tracking-wider flex-1 break-all">${pw}</code>
          <button class="text-zinc-600 hover:text-[#2dd4bf] transition-colors flex-shrink-0" onclick="copyToClipboard('${pw.replace(/'/g, "\\'")}')">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>`;
        bulkResults.appendChild(row);
      });
    } else {
      bulkResults.classList.add('hidden');
    }

    showSaveBtn(password);
  }

  btnGenerate.addEventListener('click', generate);

  btnCopy.addEventListener('click', () => {
    const pwd = passwordDisplay.textContent || '';
    if (!pwd || pwd === 'Click Generate to create a password') return;
    copyToClipboard(pwd).then(() => {
      btnCopy.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      setTimeout(() => {
        btnCopy.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`;
      }, 1500);
    });
  });

  // Auto-generate on load
  generate();

  function showSaveBtn(password: string) {
    const saveBtn = document.getElementById('save-pw-btn');
    if (saveBtn) {
      saveBtn.classList.remove('hidden');
      saveBtn.onclick = () => {
        if (typeof (window as any).saveToDashboard === 'function') {
          const { label } = scorePassword(password);
          (window as any).saveToDashboard('Password Generator', '/security/password-generator', {
            type: 'key-value',
            data: { 'Password': password.substring(0, 20) + '...', 'Length': lengthSlider.value, 'Strength': label }
          });
        }
      };
    }
  }
</script>
