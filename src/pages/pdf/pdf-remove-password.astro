---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "PDF Password Remover & Unlocker",
  "url": "https://solverspro.com/pdf/pdf-remove-password/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Unlock password-protected PDF documents and strip encryption restrictions entirely in your browser using your known password. 100% private.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com/"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqs = [
  {
    question: "Do I need to know the original PDF password?",
    answer: "Yes. This tool is designed to decrypt and strip password protection from PDF documents you are authorized to access by entering the existing user or owner password."
  },
  {
    question: "Are my unlocked PDFs sent to or stored on any server?",
    answer: "No. Decryption and re-encoding occur 100% locally inside your browser memory using client-side JavaScript. Your password and PDF content never touch an external server."
  },
  {
    question: "Will the resulting PDF open without requiring a password in the future?",
    answer: "Yes. Once unlocked and downloaded, the encryption dictionary is completely removed, allowing you to open, print, and annotate the document freely in any PDF viewer."
  }
];
---
<BaseLayout
  title="Remove PDF Password — Free Online PDF Unlocker | SolversPro"
  description="Unlock password-protected PDF files online and remove security restrictions. 100% private client-side decryption. Free online tool by SolversPro."
  canonical="https://solverspro.com/pdf/pdf-remove-password/"
  schema={schema}
>
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'PDF Tools',href:'/pdf/'},{label:'Remove PDF Password'}]} />
      <div class="mb-8 mt-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Remove PDF Password</h1>
        <p class="text-zinc-300 text-base leading-relaxed mb-4 max-w-2xl mx-auto">
          The SolversPro PDF Password Remover is a free client-side tool that decrypts password-protected PDF documents and strips security restrictions using your authorized password with complete local privacy.
        </p>
        <p class="text-zinc-400 text-sm">Unlock a password-protected PDF file. Enter the known password to decrypt and re-download without protection.</p>
      </div>
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 space-y-6">
        <div id="drop-zone" class="border-2 border-dashed border-white/[0.1] rounded-xl p-10 text-center cursor-pointer hover:border-[#2dd4bf]/50 hover:bg-[#2dd4bf]/[0.02] transition-all">
          <div class="text-4xl mb-3">🔓</div>
          <p class="text-white font-semibold mb-1">Drop password-protected PDF here</p>
          <p class="text-zinc-500 text-sm">PDF files only</p>
          <input type="file" id="file-input" accept=".pdf" class="hidden" />
        </div>
        <div id="file-info" class="hidden bg-[#1a1a24] border border-white/[0.06] rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center gap-3"><span class="text-2xl">📄</span>
            <div><p id="file-name" class="text-white font-medium text-sm"></p><p id="file-size" class="text-zinc-500 text-xs"></p></div>
          </div>
          <button id="clear-btn" class="text-zinc-500 hover:text-red-400 transition-colors text-xs">✕ Clear</button>
        </div>
        <div id="options" class="hidden">
          <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">PDF Password</label>
          <input type="password" id="password" placeholder="Enter the PDF password..." class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#2dd4bf]" />
        </div>
        <button id="decrypt-btn" class="hidden w-full py-3 bg-[#2dd4bf] hover:bg-[#5eead4] text-slate-900 font-semibold rounded-xl transition-colors">🔓 Remove Password & Download</button>
        <div id="status" class="hidden text-center py-3 text-zinc-400 text-sm"></div>
        <div id="download-section" class="hidden text-center">
          <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-6 mb-4">
            <div class="text-3xl mb-2">✅</div>
            <p class="text-green-400 font-semibold">Password removed successfully!</p>
          </div>
          <a id="download-link" class="inline-flex items-center gap-2 px-8 py-3 bg-[#2dd4bf] hover:bg-[#5eead4] text-slate-900 font-semibold rounded-xl transition-colors">⬇️ Download Unlocked PDF</a>
        </div>
      <!-- Reference Table -->
      <div class="result-surface my-12 p-6 md:p-8 bg-[#0d0d14] border border-white/[0.06] rounded-xl max-w-3xl mx-auto">
        <h2 class="text-xl font-bold text-white mb-4">PDF Encryption Standard &amp; Decryption Profiles</h2>
        <p class="text-sm text-zinc-400 mb-4">Security algorithm specifications and compatibility profiles for decrypted document exports.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300 border-collapse">
            <thead>
              <tr class="border-b border-white/10 text-white font-semibold">
                <th class="py-2.5 px-3">Cipher / Standard</th>
                <th class="py-2.5 px-3">Key Length</th>
                <th class="py-2.5 px-3">PDF Version</th>
                <th class="py-2.5 px-3">Decryption Capability</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Standard 40-bit RC4</td>
                <td class="py-2.5 px-3 font-mono">40 bits</td>
                <td class="py-2.5 px-3 font-mono">PDF 1.1 – 1.3</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">Full (Instant)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">Standard 128-bit RC4</td>
                <td class="py-2.5 px-3 font-mono">128 bits</td>
                <td class="py-2.5 px-3 font-mono">PDF 1.4 – 1.5</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">Full (Instant)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">AES-128 (Acrobat 7.0)</td>
                <td class="py-2.5 px-3 font-mono">128 bits</td>
                <td class="py-2.5 px-3 font-mono">PDF 1.6</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">Full (Supported)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-white">AES-256 (Acrobat 9.0 / ISO 32000)</td>
                <td class="py-2.5 px-3 font-mono">256 bits</td>
                <td class="py-2.5 px-3 font-mono">PDF 1.7 – 2.0</td>
                <td class="py-2.5 px-3 font-mono text-[#2dd4bf]">Full (Supported)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={faqs} />

      <ToolShare title="Remove PDF Password" url="https://solverspro.com/pdf/pdf-remove-password" />
      <SimilarTools category="pdf" currentPath="/pdf/pdf-remove-password" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { PDFDocument } from 'pdf-lib';
  let rawBytes: ArrayBuffer | null = null;
  let fileName = '';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info')!;
  const options = document.getElementById('options')!;
  const decryptBtn = document.getElementById('decrypt-btn')!;
  const clearBtn = document.getElementById('clear-btn')!;
  const statusEl = document.getElementById('status')!;
  const downloadSection = document.getElementById('download-section')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  function loadFile(file: File) {
    fileName = file.name;
    const reader = new FileReader();
    reader.onload = (e) => {
      rawBytes = e.target!.result as ArrayBuffer;
      document.getElementById('file-name')!.textContent = file.name;
      document.getElementById('file-size')!.textContent = `${(file.size/1024).toFixed(1)} KB`;
      fileInfo.classList.remove('hidden'); options.classList.remove('hidden');
      decryptBtn.classList.remove('hidden'); dropZone.classList.add('hidden');
      downloadSection.classList.add('hidden');
    };
    reader.readAsArrayBuffer(file);
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', (e) => { e.preventDefault(); const f = e.dataTransfer?.files[0]; if(f?.type==='application/pdf') loadFile(f); });
  fileInput.addEventListener('change', () => { if(fileInput.files?.[0]) loadFile(fileInput.files[0]); });
  clearBtn.addEventListener('click', () => {
    rawBytes = null; fileInput.value = '';
    fileInfo.classList.add('hidden'); options.classList.add('hidden');
    decryptBtn.classList.add('hidden'); downloadSection.classList.add('hidden');
    dropZone.classList.remove('hidden'); statusEl.classList.add('hidden');
  });

  decryptBtn.addEventListener('click', async () => {
    if (!rawBytes) return;
    const pw = passwordInput.value;
    if (!pw) { statusEl.textContent = '⚠️ Please enter the PDF password.'; statusEl.classList.remove('hidden'); return; }

    statusEl.textContent = '⏳ Decrypting PDF...';
    statusEl.classList.remove('hidden'); downloadSection.classList.add('hidden');

    try {
      const doc = await PDFDocument.load(rawBytes, { password: pw });
      const saved = await doc.save(); // saves without password
      const blob = new Blob([saved], { type: 'application/pdf' });
      downloadLink.href = URL.createObjectURL(blob);
      downloadLink.download = fileName.replace('.pdf', '-unlocked.pdf');
      statusEl.classList.add('hidden'); downloadSection.classList.remove('hidden');
    } catch (e: any) {
      if (e?.message?.includes('password')) statusEl.textContent = '❌ Incorrect password. Please try again.';
      else statusEl.textContent = '❌ Error decrypting PDF. The file may not be password-protected.';
    }
  });

  passwordInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') decryptBtn.click(); });
</script>
