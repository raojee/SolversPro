---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "JSON to CSV & CSV to JSON Converter",
  "url": "https://solverspro.com/developer/json-csv/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online bidirectional JSON to CSV and CSV to JSON converter with automatic nested object flattening, delimiter detection, and client-side processing.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="JSON ↔ CSV Converter | SolversPro"
  description="Convert JSON arrays to CSV spreadsheets or CSV data back to JSON instantly. Handles nested objects with dot-notation flattening. Free and browser-based."
  canonical="https://solverspro.com/developer/json-csv/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'JSON ↔ CSV Converter' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">📊 JSON ↔ CSV Converter</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro JSON ↔ CSV Converter is a free browser-based developer utility that converts JSON arrays into CSV spreadsheets and transforms CSV tables into JSON structures with dot-notation flattening in real time.
        </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full min-h-[500px]">
        <!-- JSON Side -->
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">JSON</h2>
            <button id="btn-to-csv" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">To CSV &rarr;</button>
          </div>
          <textarea
            id="input-json"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]"
            placeholder='[{"name":"Alice","age":30},{"name":"Bob","age":25}]'
            spellcheck="false"
          ></textarea>
        </div>

        <!-- CSV Side -->
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <button id="btn-to-json" class="px-3 py-1.5 text-xs font-semibold bg-[#ff6b35]/20 hover:bg-[#ff8c5a]/30 text-[#ff6b35] rounded transition-colors border border-[#ff6b35]/30">&larr; To JSON</button>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">CSV</h2>
          </div>
          <textarea
            id="input-csv"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]"
            placeholder="name,age&#10;Alice,30&#10;Bob,25"
            spellcheck="false"
          ></textarea>
        </div>
      </div>

      <!-- Error display -->
      <div id="error-msg" class="hidden mt-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-mono"></div>

      <!-- Reference Table -->
      <div class="mt-10 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-base font-bold text-white mb-2">JSON &amp; CSV Data Structure Mapping Reference</h2>
        <p class="text-xs text-zinc-400 mb-4">Standard RFC 4180 CSV translation and nested object flattening rules.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-300">
                <th class="py-2.5 px-3 font-semibold">JSON Structure</th>
                <th class="py-2.5 px-3 font-semibold">CSV Column Equivalent</th>
                <th class="py-2.5 px-3 font-semibold">Flattening Rule</th>
                <th class="py-2.5 px-3 font-semibold">RFC 4180 Escaping</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-400 font-mono">
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Top-level Key</td>
                <td class="py-2 px-3 text-emerald-400">Column Header</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Direct mapping to CSV header</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Raw or quoted if special chars</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Nested Object</td>
                <td class="py-2 px-3 text-emerald-400">parent.child</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Dot-notation concatenated keys</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Evaluated as discrete column</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Primitive Array</td>
                <td class="py-2 px-3 text-emerald-400">key[0], key[1]</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Index-suffixed columns or joined</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Wrapped in quotes if delimiter present</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold">Commas in String</td>
                <td class="py-2 px-3 text-emerald-400">"val,1"</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Wrapped in RFC 4180 quotes</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Double quotes escaped as ""</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={[
        {
          question: "How are nested JSON objects converted into CSV columns?",
          answer: "Nested properties are flattened using dot notation (e.g. user.address.city) so each leaf property receives its own CSV column header."
        },
        {
          question: "Does this converter handle commas and quotes in values?",
          answer: "Yes, all fields containing commas, line breaks, or double quotes are escaped and wrapped in RFC 4180 quotes."
        },
        {
          question: "Are my JSON and CSV datasets stored on any server?",
          answer: "No, all transformation logic executes locally in your browser using PapaParse with zero external network transmission."
        },
        {
          question: "Is this tool free?",
          answer: "Yes, the SolversPro JSON to CSV converter is 100% free with no file size limits or paywalls."
        }
      ]} />

      <ToolShare title="JSON ↔ CSV Converter" url="https://solverspro.com/developer/json-csv" />
      <SimilarTools category="developer" currentPath="/developer/json-csv" />
    </div>
  </main>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  import Papa from 'papaparse';

  const jsonEl = document.getElementById('input-json') as HTMLTextAreaElement;
  const csvEl = document.getElementById('input-csv') as HTMLTextAreaElement;
  const errorEl = document.getElementById('error-msg') as HTMLDivElement;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
    setTimeout(() => errorEl.classList.add('hidden'), 5000);
  }

  function flatten(obj: any, prefix = ''): Record<string, any> {
    const result: Record<string, any> = {};
    for (const key of Object.keys(obj)) {
      const newKey = prefix ? `${prefix}.${key}` : key;
      if (obj[key] !== null && typeof obj[key] === 'object' && !Array.isArray(obj[key])) {
        Object.assign(result, flatten(obj[key], newKey));
      } else {
        result[newKey] = obj[key];
      }
    }
    return result;
  }

  document.getElementById('btn-to-csv')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      let parsed = JSON.parse(jsonEl.value.trim());
      if (!Array.isArray(parsed)) parsed = [parsed];
      const flat = parsed.map((row: any) => flatten(row));
      const csv = Papa.unparse(flat);
      csvEl.value = csv;
      csvEl.classList.add('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]');
      setTimeout(() => csvEl.classList.remove('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]'), 500);
    } catch (e: any) {
      showError('Invalid JSON: ' + e.message);
    }
  });

  document.getElementById('btn-to-json')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      const result = Papa.parse(csvEl.value.trim(), { header: true, skipEmptyLines: true });
      if (result.errors.length > 0) {
        showError('CSV Error: ' + result.errors[0].message);
        return;
      }
      jsonEl.value = JSON.stringify(result.data, null, 2);
      jsonEl.classList.add('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]');
      setTimeout(() => jsonEl.classList.remove('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]'), 500);
    } catch (e: any) {
      showError('CSV Error: ' + e.message);
    }
  });
</script>
