---
import '../styles/global.css';
import ActivityTracker from '../components/ActivityTracker.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Toast from '../components/Toast.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  schema?: object;
  robots?: string;
  isHomePage?: boolean;
}

const {
  title = 'SolversPro — Solve Anything. Instantly.',
  description = 'Free problem solvers for finance, health, math, and trades. No signup. No ads. 100% private.',
  canonical,
  ogImage = '/og-image.png',
  ogType,
  schema,
  robots,
  isHomePage = false,
} = Astro.props;

const canonicalUrl = canonical || Astro.url.href;

// ── Dynamic SoftwareApplication Schema for Tool Pages ───────────────────────
const TOOL_CATEGORIES = new Set([
  'developer',
  'pdf',
  'math',
  'text',
  'finance',
  'trades',
  'network',
  'health',
  'qr',
  'security',
]);

const CATEGORY_SCHEMA_MAP: Record<string, string> = {
  developer: 'DeveloperApplication',
  finance: 'FinanceApplication',
  health: 'HealthApplication',
  security: 'SecurityApplication',
  pdf: 'UtilitiesApplication',
  text: 'UtilitiesApplication',
  math: 'EducationalApplication',
  trades: 'UtilitiesApplication',
  network: 'DeveloperApplication',
  qr: 'UtilitiesApplication',
};

// Scan public/images/tools at build-time using Vite's import.meta.glob
const toolScreenshots = import.meta.glob('/public/images/tools/*.{png,jpg,webp,svg}', { eager: true });
const existingScreenshotPaths = new Set(
  Object.keys(toolScreenshots).map((key) => key.replace('/public', ''))
);

const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const isToolPage =
  pathSegments.length === 2 &&
  TOOL_CATEGORIES.has(pathSegments[0]) &&
  pathSegments[1] !== 'index';

let softwareAppSchema: Record<string, any> | null = null;

if (isToolPage) {
  const [category, toolSlug] = pathSegments;
  const toolName = title.split('|')[0].replace(/—.*$/, '').trim();
  const applicationCategory = CATEGORY_SCHEMA_MAP[category] || 'UtilitiesApplication';
  const siteOrigin = Astro.site ? Astro.site.origin : 'https://solverspro.com';
  
  // Format canonical URL ensuring trailing slash for tool URLs
  const formattedUrl = canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`;

  // Check if tool screenshot exists in public/images/tools/
  let screenshotUrl: string | undefined = undefined;
  const extensions = ['.png', '.jpg', '.webp', '.svg'];
  for (const ext of extensions) {
    const relPath = `/images/tools/${toolSlug}${ext}`;
    if (existingScreenshotPaths.has(relPath)) {
      screenshotUrl = `${siteOrigin}${relPath}`;
      break;
    }
  }

  // Standard SoftwareApplication Schema
  softwareAppSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    'name': toolName,
    'description': description,
    'applicationCategory': applicationCategory,
    'operatingSystem': 'Any',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
    },
    'aggregateRating': {
      '@type': 'AggregateRating',
      'ratingValue': '4.8',
      'ratingCount': '1200',
    },
    'url': formattedUrl,
  };

  if (screenshotUrl) {
    softwareAppSchema['screenshot'] = screenshotUrl;
  }

  // Merge with custom schema if passed via props, ensuring mapped applicationCategory is preserved
  if (schema && typeof schema === 'object') {
    softwareAppSchema = {
      ...softwareAppSchema,
      ...schema,
      applicationCategory: applicationCategory,
    };
  }
}

// ── Determine og:type ────────────────────────────────────────────────────────
const resolvedOgType = ogType || (isToolPage ? 'website' : 'website');

// ── Organization Schema (homepage only) ─────────────────────────────────────
const organizationSchema = isHomePage ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'SolversPro',
  'url': 'https://solverspro.com',
  'logo': 'https://solverspro.com/logo.svg',
  'sameAs': [
    'https://twitter.com/solverspro_com',
    'https://github.com/solverspro',
  ],
  'contactPoint': {
    '@type': 'ContactPoint',
    'email': 'support@solverspro.com',
    'contactType': 'customer support',
    'areaServed': 'US',
    'availableLanguage': 'English',
  },
} : null;
---

<!DOCTYPE html>
<html lang="en" class="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="google-adsense-account" content="ca-pub-8138211887478220">

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {robots && <meta name="robots" content={robots} />}

  <!-- hreflang -->
  <link rel="alternate" hreflang="en" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content={resolvedOgType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://solverspro.com')} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SolversPro" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site || 'https://solverspro.com')} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1a1a2e" />

  <!-- AI Agent Discovery & RFC 8288 Link Relations -->
  <link rel="api-catalog" type="application/linkset+json" href="/.well-known/api-catalog" />
  <link rel="service-doc" href="/docs" />
  <link rel="service-desc" type="application/vnd.oai.openapi+json" href="/api/openapi.json" />
  <link rel="agent-skills" type="application/json" href="/.well-known/agent-skills/index.json" />
  <link rel="mcp-server-card" type="application/json" href="/.well-known/mcp/server-card.json" />
  <link rel="oauth-protected-resource" type="application/json" href="/.well-known/oauth-protected-resource" />
  <link rel="author-doc" type="text/markdown" href="/auth.md" />
  <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />
  <link rel="agent-card" type="application/json" href="/.well-known/agent-card.json" />

  <!-- WebMCP (In-browser Agent Tools) -->
  <script is:inline src="/scripts/webmcp.js" defer></script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- SoftwareApplication Schema for Tool Pages -->
  {softwareAppSchema && (
    <script type="application/ld+json" is:raw set:html={JSON.stringify(softwareAppSchema, null, 2)} />
  )}

  <!-- Custom Page Schema (for non-tool pages e.g. category hub FAQs) -->
  {!isToolPage && schema && (
    <script type="application/ld+json" is:raw set:html={JSON.stringify(schema, null, 2)} />
  )}

  <!-- Organization Schema (Homepage only) -->
  {organizationSchema && (
    <script type="application/ld+json" is:raw set:html={JSON.stringify(organizationSchema, null, 2)} />
  )}

  <!-- Website Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "SolversPro",
      "url": "https://solverspro.com",
      "description": "Free problem solvers for finance, health, math, and trades.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://solverspro.com/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <!-- Per-page head slot (e.g. KaTeX, extra stylesheets) -->
  <slot name="head" />

  <!-- Analytics -->
  <GoogleAnalytics />

  <!-- Multi-Language Pre-flight Auto-Detection (Japanese Guests & Preferences) -->
  <script is:inline>
    (function() {
      try {
        var STORAGE_KEY = 'solverspro_lang';
        var stored = localStorage.getItem(STORAGE_KEY);
        var domain = window.location.hostname;

        // Auto-detect Japanese browser visitors if no explicit preference exists
        if (!stored) {
          var navLang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          if (navLang.toLowerCase().indexOf('ja') === 0) {
            stored = 'ja';
            localStorage.setItem(STORAGE_KEY, 'ja');
          }
        }

        // Apply cookie if non-English language is set
        if (stored && stored !== 'en') {
          document.cookie = 'googtrans=/en/' + stored + '; path=/;';
          if (domain.includes('.')) {
            document.cookie = 'googtrans=/en/' + stored + '; path=/; domain=.' + domain + ';';
          }
        }

        // Asynchronously check Cloudflare edge trace for visitors physically in Japan
        if (!stored) {
          fetch('/cdn-cgi/trace')
            .then(function(res) { return res.text(); })
            .then(function(trace) {
              if (!localStorage.getItem(STORAGE_KEY) && /loc=JP/i.test(trace)) {
                localStorage.setItem(STORAGE_KEY, 'ja');
                document.cookie = 'googtrans=/en/ja; path=/;';
                if (domain.includes('.')) {
                  document.cookie = 'googtrans=/en/ja; path=/; domain=.' + domain + ';';
                }
                window.location.reload();
              }
            })
            .catch(function() {});
        }
      } catch (e) {}
    })();

    // Google Translate Initialization
    function googleTranslateElementInit() {
      if (window.google && window.google.translate) {
        new window.google.translate.TranslateElement({
          pageLanguage: 'en',
          includedLanguages: 'en,ja,es,de,fr,zh-CN,pt,it,ko,ar,hi,ru',
          autoDisplay: false
        }, 'google_translate_element');
      }
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-[#0a0a0f] text-zinc-400 pt-16">
  <slot />
  <Toast />
  <ActivityTracker />

  <!-- Hidden Google Translate Element & Script (Global Single Instance) -->
  <div id="google_translate_element" style="display:none;" aria-hidden="true"></div>
  <script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>

  <!-- Clean Google Translate Banner & Body Offset -->
  <script is:inline>
    (function() {
      function cleanGoogleUI() {
        if (document.body) {
          if (document.body.style.top && document.body.style.top !== '0px') {
            document.body.style.setProperty('top', '0px', 'important');
          }
          if (document.body.style.position && document.body.style.position !== 'static') {
            document.body.style.setProperty('position', 'static', 'important');
          }
        }
        var banners = document.querySelectorAll(
          '.goog-te-banner-frame, .VIpgJd-ZVi9od-ORHb-Oxf9gd, iframe[id*=":1.container"], iframe[id*=":2.container"], iframe[name*=":1.container"], .VIpgJd-ZVi9od-aZ2wEe-wOHMyf'
        );
        banners.forEach(function(el) {
          el.style.setProperty('display', 'none', 'important');
          el.style.setProperty('visibility', 'hidden', 'important');
          el.style.setProperty('height', '0px', 'important');
        });
      }

      var observer = new MutationObserver(cleanGoogleUI);
      if (document.body) {
        observer.observe(document.body, { attributes: true, attributeFilter: ['style'], childList: true });
      }
      cleanGoogleUI();
      var interval = setInterval(cleanGoogleUI, 250);
      setTimeout(function() { clearInterval(interval); }, 15000);
    })();
  </script>
</body>
</html>
