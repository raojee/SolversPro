---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "CSV Field Escaper & Unescaper",
  "url": "https://solverspro.com/developer/csv-escape/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online CSV field escaper and unescaper conforming to RFC 4180 for quoting commas, quotes, and multiline values client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};
---

<BaseLayout
  title="CSV Field Escaper & Unescaper | SolversPro"
  description="Escape CSV fields per RFC 4180 — properly quote fields containing commas, quotes, and newlines. Free and browser-based."
  canonical="https://solverspro.com/developer/csv-escape/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Developer Tools',href:'/developer'},{label:'CSV Escape'}]} />
      
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">📑 CSV Field Escaper & Unescaper</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro CSV Escape Tool is a free browser-based utility that formats raw text fields into RFC 4180 compliant CSV cells and unescapes doubled quotes back to raw text.
        </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full min-h-[500px]">
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Raw Fields (one per line)</h2>
            <button id="btn-escape" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Escape &rarr;</button>
          </div>
          <textarea id="input-raw" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]" placeholder='Hello, World&#10;She said "yes"&#10;Line 1&#10;Line 2&#10;Normal field' spellcheck="false"></textarea>
        </div>
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <button id="btn-unescape" class="px-3 py-1.5 text-xs font-semibold bg-[#ff6b35]/20 hover:bg-[#ff8c5a]/30 text-[#ff6b35] rounded transition-colors border border-[#ff6b35]/30">&larr; Unescape</button>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">CSV Escaped Fields</h2>
          </div>
          <textarea id="input-escaped" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]" placeholder='"Hello, World"&#10;"She said ""yes"""&#10;Normal field' spellcheck="false"></textarea>
        </div>
      </div>

      <!-- Reference Table -->
      <div class="mt-10 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-base font-bold text-white mb-2">RFC 4180 CSV Escaping Specification Reference</h2>
        <p class="text-xs text-zinc-400 mb-4">Core formatting rules for RFC 4180 compliance in spreadsheet exports.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-300">
                <th class="py-2.5 px-3 font-semibold">Delimiter / Character</th>
                <th class="py-2.5 px-3 font-semibold">Raw Sample</th>
                <th class="py-2.5 px-3 font-semibold">Escaped RFC 4180 Output</th>
                <th class="py-2.5 px-3 font-semibold">Handling Rule</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-400 font-mono">
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">Field Delimiter (,)</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">New York, NY</td>
                <td class="py-2 px-3 text-emerald-400">"New York, NY"</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Enclose entire cell in double quotes</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">Double Quote (")</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Size: 12"</td>
                <td class="py-2 px-3 text-emerald-400">"Size: 12"""</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Double quote becomes "" and wrap cell</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">Newline (\n or \r\n)</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">Line 1\nLine 2</td>
                <td class="py-2 px-3 text-emerald-400">"Line 1\nLine 2"</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">Preserves multiline cell inside quotes</td>
              </tr>
              <tr>
                <td class="py-2 px-3 text-[#2dd4bf] font-bold font-sans">Standard Text</td>
                <td class="py-2 px-3 text-zinc-300 font-sans">SimpleText</td>
                <td class="py-2 px-3 text-emerald-400">SimpleText</td>
                <td class="py-2 px-3 text-zinc-400 font-sans">No quotes required</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={[
        {
          question: "When does a CSV field require quoting?",
          answer: "Under RFC 4180, fields containing commas, line breaks (CRLF or LF), or double quote marks must be enclosed in double quotes."
        },
        {
          question: "How are double quotes escaped in CSV?",
          answer: "Any double quote character inside a quoted field must be doubled (escaped as \"\")."
        },
        {
          question: "Is my CSV content sent to a server?",
          answer: "No, all string evaluations and regex replacements happen 100% locally in your browser."
        },
        {
          question: "Is this tool free?",
          answer: "Yes, the SolversPro CSV Escape tool is completely free with no usage limits."
        }
      ]} />

      <ToolShare title="CSV Escape" url="https://solverspro.com/developer/csv-escape" />
      <SimilarTools category="developer" currentPath="/developer/csv-escape" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const rawEl = document.getElementById('input-raw') as HTMLTextAreaElement;
  const escEl = document.getElementById('input-escaped') as HTMLTextAreaElement;

  function escapeCsvField(field: string): string {
    if (field.includes(',') || field.includes('"') || field.includes('\n') || field.includes('\r')) {
      return '"' + field.replace(/"/g, '""') + '"';
    }
    return field;
  }
  function unescapeCsvField(field: string): string {
    const trimmed = field.trim();
    if (trimmed.startsWith('"') && trimmed.endsWith('"')) {
      return trimmed.slice(1, -1).replace(/""/g, '"');
    }
    return trimmed;
  }

  document.getElementById('btn-escape')?.addEventListener('click', () => {
    escEl.value = rawEl.value.split('\n').map(f => escapeCsvField(f)).join('\n');
    escEl.classList.add('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]');
    setTimeout(() => escEl.classList.remove('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]'), 500);
  });
  document.getElementById('btn-unescape')?.addEventListener('click', () => {
    rawEl.value = escEl.value.split('\n').map(f => unescapeCsvField(f)).join('\n');
    rawEl.classList.add('ring-2','ring-[#ff6b35]','border-[#ff6b35]');
    setTimeout(() => rawEl.classList.remove('ring-2','ring-[#ff6b35]','border-[#ff6b35]'), 500);
  });
</script>
