---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';

const tools = [
 {
 title: 'Compound Interest Calculator',
 description: 'See how your money grows over time with the power of compound interest.',
 icon: '💰',
 href: '/finance/compound-interest',
 },
 {
 title: 'Cash-on-Cash Return',
 description: 'Evaluate rental property investments by calculating your annual cash return.',
 icon: '🏠',
 href: '/finance/cash-on-cash-return',
 },
 {
 title: 'Simple Interest Calculator',
 description: 'Calculate simple interest on loans and investments quickly.',
 icon: '📊',
 href: '/finance/simple-interest',
 },
];
---

<BaseLayout
 title="Finance Calculators — Free Investment & Interest Tools | SolversPro"
 description="Free online personal finance and investment calculators. Easily calculate ROI, compound interest, mortgage payments, and cash-on-cash return in your browser."
>
 <Header />
 <SearchOverlay />

 <main class="flex-1 py-12">
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
 <Breadcrumbs items={[
 { label: 'Home', href: '/' },
 { label: 'Finance' },
 ]} />

 <div class="mb-12">
 <div class="flex items-center gap-4 mb-4">
 <div
 class="w-14 h-14 rounded-lg flex items-center justify-center text-3xl"
 style="background-color: #eff6ff; border-radius: 16px;"
 >
 💰
 </div>
 <div>
 <h1 class="text-3xl md:text-4xl font-bold text-white ">Finance Tools</h1>
 <p class="text-zinc-500 mt-1">Investment returns, compound interest, and financial analysis.</p>
 </div>
 </div>
 </div>

  <div class="prose prose-invert max-w-none mb-12 text-zinc-300">
    <h2>Personal Finance & Investment Calculators</h2>
    <p>Welcome to the SolversPro Finance Hub. Managing your money, analyzing real estate investments, or planning for retirement shouldn't require complex spreadsheets or expensive software. Our collection of free online financial calculators gives you professional-grade insights instantly.</p>
    <p>Because privacy is paramount when dealing with financial figures, our calculators run 100% locally in your browser. We never transmit, store, or sell your financial data. You get the peace of mind of a private tool combined with the convenience of a web app.</p>
    
    <h3>Tools Available in this Category</h3>
    <ul class="list-disc pl-5 space-y-2 mt-4 mb-6">
      <li><strong>Compound Interest Calculator:</strong> Watch your wealth grow. Visualize how initial investments and regular contributions compound over time with our dynamic charts and annual breakdowns.</li>
      <li><strong>Cash-on-Cash Return:</strong> A must-have for real estate investors. Quickly evaluate rental property profitability by comparing your first-year pre-tax cash flow to your initial cash investment.</li>
      <li><strong>Simple Interest Calculator:</strong> Perfect for straightforward loans and short-term investments. Determine exactly how much interest will accrue without the complexities of compounding.</li>
      <li><strong>Mortgage Calculator (Coming Soon):</strong> Plan your home purchase by factoring in principal, interest, taxes, and insurance for a complete view of your monthly payment.</li>
      <li><strong>ROI Calculator (Coming Soon):</strong> Analyze the efficiency of any investment. Calculate the return on investment percentage and annualized return to compare different financial opportunities.</li>
    </ul>
    <p>Whether you're a seasoned investor evaluating cap rates or a student learning about the time value of money, our intuitive financial calculators are built to provide clarity. Choose a tool below to start analyzing.</p>
  </div>

 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
 {tools.map((tool) => (
 <ToolCard {...tool} />
 ))}
 </div>
 </div>
 </main>

 <Footer />
</BaseLayout>
