---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  cta?: string;
}

const { title, description, icon, href, cta = 'Explore →' } = Astro.props;
---

<a
  href={href}
  class="w-full group block p-6 bg-white/[0.02] border border-white/[0.06] rounded-xl card-hover-fx no-underline"
>
  <!-- Icon -->
  <div
    class="w-10 h-10 rounded-md flex items-center justify-center text-xl mb-4 bg-[#2dd4bf]/10 text-[#2dd4bf] border border-[#2dd4bf]/20 transition-colors group-hover:bg-[#2dd4bf]/20"
  >
    {icon}
  </div>

  <!-- Title -->
  <h3 class="text-xl font-semibold mb-2 text-white" style="font-family: 'JetBrains Mono', monospace;">
    {title}
  </h3>

  <!-- Description -->
  <p class="text-sm leading-relaxed mb-6 text-zinc-400">
    {description}
  </p>

  <!-- CTA -->
  <span class="text-xs font-semibold text-[#2dd4bf] group-hover:text-[#5eead4] transition-colors" style="font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em;">
    {cta}
  </span>
</a>
