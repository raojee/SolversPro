---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<BaseLayout title="Flatten PDF | SolversPro" description="Flatten PDF form fields and annotations for universal compatibility. Free, private, runs in your browser.">
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'PDF Tools',href:'/tools'},{label:'Flatten PDF'}]} />
      <div class="mb-8 mt-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Flatten PDF</h1>
        <p class="text-zinc-400">Flatten form fields and annotations into a static PDF for universal compatibility and simpler sharing.</p>
      </div>
      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 space-y-6">
        <!-- Info box -->
        <div class="bg-[#2dd4bf]/5 border border-[#2dd4bf]/20 rounded-xl p-4 text-sm text-zinc-400">
          <strong class="text-[#2dd4bf]">What does flattening do?</strong> It converts interactive form fields, checkboxes, and annotations into static visual content. The text remains visible but the fields can no longer be edited.
        </div>

        <div id="drop-zone" class="border-2 border-dashed border-white/[0.1] rounded-xl p-10 text-center cursor-pointer hover:border-[#ff6b35]/50 hover:bg-[#ff6b35]/[0.02] transition-all">
          <div class="text-4xl mb-3">📄</div>
          <p class="text-white font-semibold mb-1">Drop PDF here or click to browse</p>
          <p class="text-zinc-500 text-sm">Works best with PDF forms</p>
          <input type="file" id="file-input" accept=".pdf" class="hidden" />
        </div>

        <div id="file-info" class="hidden bg-[#1a1a24] border border-white/[0.06] rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center gap-3"><span class="text-2xl">📄</span>
            <div><p id="file-name" class="text-white font-medium text-sm"></p><p id="file-meta" class="text-zinc-500 text-xs"></p></div>
          </div>
          <button id="clear-btn" class="text-zinc-500 hover:text-red-400 transition-colors text-xs">✕ Clear</button>
        </div>

        <button id="flatten-btn" class="hidden w-full py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">📄 Flatten PDF</button>
        <div id="status" class="hidden text-center py-3 text-zinc-400 text-sm"></div>
        <div id="download-section" class="hidden text-center">
          <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-6 mb-4">
            <div class="text-3xl mb-2">✅</div>
            <p class="text-green-400 font-semibold">PDF flattened successfully!</p>
            <p class="text-zinc-500 text-sm mt-1">All form fields and annotations have been made static.</p>
          </div>
          <a id="download-link" class="inline-flex items-center gap-2 px-8 py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">⬇️ Download Flattened PDF</a>
        </div>
      </div>
      <ToolShare title="Flatten PDF" url="https://solverspro.com/tools/pdf-flatten" />
      <SimilarTools category="tools" currentPath="/tools/pdf-flatten" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { PDFDocument } from 'pdf-lib';
  let pdfBytes: Uint8Array | null = null;

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info')!;
  const flattenBtn = document.getElementById('flatten-btn')!;
  const clearBtn = document.getElementById('clear-btn')!;
  const statusEl = document.getElementById('status')!;
  const downloadSection = document.getElementById('download-section')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;

  async function loadPdf(file: File) {
    const buffer = await file.arrayBuffer();
    pdfBytes = new Uint8Array(buffer);
    const doc = await PDFDocument.load(pdfBytes);
    document.getElementById('file-name')!.textContent = file.name;
    const form = doc.getForm();
    const fieldCount = form.getFields().length;
    document.getElementById('file-meta')!.textContent = `${doc.getPageCount()} pages · ${fieldCount} form field${fieldCount !== 1 ? 's' : ''} · ${(file.size/1024).toFixed(1)} KB`;
    fileInfo.classList.remove('hidden'); flattenBtn.classList.remove('hidden');
    dropZone.classList.add('hidden'); downloadSection.classList.add('hidden'); statusEl.classList.add('hidden');
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', async (e) => { e.preventDefault(); const f = e.dataTransfer?.files[0]; if(f?.type==='application/pdf') await loadPdf(f); });
  fileInput.addEventListener('change', async () => { if(fileInput.files?.[0]) await loadPdf(fileInput.files[0]); });
  clearBtn.addEventListener('click', () => {
    pdfBytes = null; fileInput.value = '';
    fileInfo.classList.add('hidden'); flattenBtn.classList.add('hidden');
    downloadSection.classList.add('hidden'); dropZone.classList.remove('hidden'); statusEl.classList.add('hidden');
  });

  flattenBtn.addEventListener('click', async () => {
    if (!pdfBytes) return;
    statusEl.textContent = '⏳ Flattening PDF...';
    statusEl.classList.remove('hidden'); downloadSection.classList.add('hidden');
    try {
      const doc = await PDFDocument.load(pdfBytes!);
      const form = doc.getForm();
      form.flatten();
      const saved = await doc.save();
      const blob = new Blob([saved], { type: 'application/pdf' });
      downloadLink.href = URL.createObjectURL(blob);
      downloadLink.download = 'flattened.pdf';
      statusEl.classList.add('hidden'); downloadSection.classList.remove('hidden');
    } catch(e) {
      statusEl.textContent = '❌ Error flattening PDF. Make sure the file is not encrypted.';
    }
  });
</script>
