---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InputField from '../../components/InputField.astro';
import SelectField from '../../components/SelectField.astro';
import CalculateButton from '../../components/CalculateButton.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Geometry Calculator",
  "url": "https://solverspro.com/math/geometry-calculator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online geometry calculator to compute area, perimeter, circumference, surface area, and volume for 2D circles, rectangles, triangles, and 3D spheres and cylinders.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};

const faqs = [
  {
    question: "What does this geometry calculator compute?",
    answer: "This geometry calculator computes two-dimensional properties (area, perimeter, and circumference) for planar shapes including circles, rectangles, and triangles, as well as three-dimensional metrics (surface area and volume) for solid geometric bodies including spheres and cylinders."
  },
  {
    question: "How do 2D planar metrics differ from 3D solid metrics?",
    answer: "Two-dimensional metrics evaluate planar boundary measurements in square units (area) and linear units (perimeter or circumference). Three-dimensional solid metrics calculate total external boundary coverage in square units (surface area) and the internal space enclosed in cubic units (volume)."
  },
  {
    question: "What numerical precision is used for Pi (π)?",
    answer: "Calculations rely on high-precision floating point arithmetic using JavaScript's native Math.PI (approximately 3.141592653589793), with final values rounded to 4 decimal places for high accuracy."
  },
  {
    question: "Does the geometry calculator run locally in my browser?",
    answer: "Yes. All geometric formulas execute 100% client-side in your web browser with zero server latency and zero data transfer."
  }
];
---

<BaseLayout
  title="Geometry Calculator — Area, Perimeter, Surface Area & Volume | SolversPro"
  description="Calculate area, perimeter, circumference, surface area, and volume for 2D and 3D shapes. Free, instant, and browser-based geometry tool."
  canonical="https://solverspro.com/math/geometry-calculator/"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Math', href: '/math' },
        { label: 'Geometry' },
      ]} />

      <div class="mb-8 max-w-3xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Geometry Calculator</h1>
        <p class="text-lg text-zinc-400">
          The SolversPro Geometry Calculator is a free browser-based math utility that computes area, perimeter, circumference, surface area, and volume for common 2D and 3D shapes in real time.
        </p>
      </div>

      <form class="form-container max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 shadow-sm mb-8" id="calculator-form">
        <SelectField
          label="Shape"
          name="shape"
          id="select-shape"
          value="circle"
          options={[
            { value: 'circle', label: 'Circle (2D)' },
            { value: 'rectangle', label: 'Rectangle (2D)' },
            { value: 'triangle', label: 'Triangle (2D)' },
            { value: 'sphere', label: 'Sphere (3D)' },
            { value: 'cylinder', label: 'Cylinder (3D)' }
          ]}
        />
        
        <div id="inputs-circle" class="shape-inputs space-y-4 mt-4">
          <InputField label="Radius (r)" name="radius" id="input-radius" type="number" step="any" min="0" placeholder="e.g. 5" />
        </div>
        
        <div id="inputs-rectangle" class="shape-inputs space-y-4 mt-4 hidden">
          <InputField label="Length (l)" name="length" id="input-length" type="number" step="any" min="0" placeholder="e.g. 10" />
          <InputField label="Width (w)" name="width" id="input-width" type="number" step="any" min="0" placeholder="e.g. 4" />
        </div>
        
        <div id="inputs-triangle" class="shape-inputs space-y-4 mt-4 hidden">
          <InputField label="Base (b)" name="base" id="input-base" type="number" step="any" min="0" placeholder="e.g. 6" />
          <InputField label="Height (h)" name="height" id="input-height" type="number" step="any" min="0" placeholder="e.g. 8" />
        </div>
        
        <div id="inputs-sphere" class="shape-inputs space-y-4 mt-4 hidden">
          <InputField label="Radius (r)" name="sphere_radius" id="input-sphere-radius" type="number" step="any" min="0" placeholder="e.g. 3" />
        </div>
        
        <div id="inputs-cylinder" class="shape-inputs space-y-4 mt-4 hidden">
          <InputField label="Radius (r)" name="cyl_radius" id="input-cyl-radius" type="number" step="any" min="0" placeholder="e.g. 4" />
          <InputField label="Height (h)" name="cyl_height" id="input-cyl-height" type="number" step="any" min="0" placeholder="e.g. 10" />
        </div>

        <div class="mt-6">
          <CalculateButton id="calculate-btn" label="Calculate Shape" />
        </div>
      </form>

      <!-- Results -->
      <div id="results-section" class="hidden space-y-8 mb-12 max-w-2xl mx-auto">
        <div class="result-surface p-6 md:p-8 rounded-xl border bg-white/[0.02]" id="result-summary">
          <div class="grid grid-cols-1 gap-6 mb-6" id="result-grid">
            <!-- Dynamic results injected here -->
          </div>
          
          <div class="flex justify-end pt-4 border-t border-white/[0.05]">
            <SaveResultButton id="save-geometry-btn" />
          </div>
        </div>
      </div>

      <!-- Citable Reference Table -->
      <div class="mb-12 max-w-3xl mx-auto bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-xl font-bold text-white mb-2">Geometric Formulas & Dimension Reference</h2>
        <p class="text-zinc-400 text-sm mb-6">Standard mathematical formulas for calculating area, boundary, and volume across common geometries.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-400 font-mono text-xs uppercase">
                <th class="py-3 px-4">Geometric Shape</th>
                <th class="py-3 px-4">Dimension</th>
                <th class="py-3 px-4">Primary Metric Formula</th>
                <th class="py-3 px-4">Boundary / Volume Formula</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-300 font-mono text-xs">
              <tr>
                <td class="py-3 px-4 text-[#2dd4bf] font-bold">Circle</td>
                <td class="py-3 px-4 text-white">2D Planar</td>
                <td class="py-3 px-4 font-mono">Area = πr²</td>
                <td class="py-3 px-4 font-mono">Circumference = 2πr</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#ff6b35] font-bold">Rectangle</td>
                <td class="py-3 px-4 text-white">2D Planar</td>
                <td class="py-3 px-4 font-mono">Area = length × width</td>
                <td class="py-3 px-4 font-mono">Perimeter = 2l + 2w</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#a78bfa] font-bold">Triangle</td>
                <td class="py-3 px-4 text-white">2D Planar</td>
                <td class="py-3 px-4 font-mono">Area = ½ × base × height</td>
                <td class="py-3 px-4 font-mono">Perimeter = a + b + c</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#38bdf8] font-bold">Sphere</td>
                <td class="py-3 px-4 text-white">3D Solid</td>
                <td class="py-3 px-4 font-mono">Surface Area = 4πr²</td>
                <td class="py-3 px-4 font-mono">Volume = 4/3 πr³</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-yellow-400 font-bold">Cylinder</td>
                <td class="py-3 px-4 text-white">3D Solid</td>
                <td class="py-3 px-4 font-mono">Surface Area = 2πrh + 2πr²</td>
                <td class="py-3 px-4 font-mono">Volume = πr²h</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mb-12 max-w-3xl mx-auto">
        <ToolFAQ faqs={faqs} />
      </div>

      <ToolShare title="Geometry Calculator" url="https://solverspro.com/math/geometry-calculator" />
      <SimilarTools category="math" currentPath="/math/geometry-calculator" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const shapeSelect = document.getElementById('select-shape') as HTMLSelectElement;
  
  shapeSelect?.addEventListener('change', (e) => {
    document.querySelectorAll('.shape-inputs').forEach(el => el.classList.add('hidden'));
    const shape = (e.target as HTMLSelectElement).value;
    document.getElementById(`inputs-${shape}`)?.classList.remove('hidden');
    document.getElementById('results-section')?.classList.add('hidden');
  });

  function calculate() {
    const shape = shapeSelect?.value;
    const btn = document.getElementById('calculate-btn');
    btn?.setAttribute('data-loading', 'true');

    setTimeout(() => {
      let results: {label: string, value: string}[] = [];

      if (shape === 'circle') {
        const r = parseFloat((document.getElementById('input-radius') as HTMLInputElement)?.value) || 0;
        results.push({ label: 'Area (πr²)', value: (Math.PI * r * r).toFixed(4) });
        results.push({ label: 'Circumference (2πr)', value: (2 * Math.PI * r).toFixed(4) });
      } else if (shape === 'rectangle') {
        const l = parseFloat((document.getElementById('input-length') as HTMLInputElement)?.value) || 0;
        const w = parseFloat((document.getElementById('input-width') as HTMLInputElement)?.value) || 0;
        results.push({ label: 'Area (l × w)', value: (l * w).toFixed(4) });
        results.push({ label: 'Perimeter (2l + 2w)', value: (2 * l + 2 * w).toFixed(4) });
      } else if (shape === 'triangle') {
        const b = parseFloat((document.getElementById('input-base') as HTMLInputElement)?.value) || 0;
        const h = parseFloat((document.getElementById('input-height') as HTMLInputElement)?.value) || 0;
        results.push({ label: 'Area (½bh)', value: (0.5 * b * h).toFixed(4) });
      } else if (shape === 'sphere') {
        const r = parseFloat((document.getElementById('input-sphereRadius') as HTMLInputElement)?.value) || 0;
        results.push({ label: 'Volume (4/3πr³)', value: ((4/3) * Math.PI * Math.pow(r, 3)).toFixed(4) });
        results.push({ label: 'Surface Area (4πr²)', value: (4 * Math.PI * Math.pow(r, 2)).toFixed(4) });
      } else if (shape === 'cylinder') {
        const r = parseFloat((document.getElementById('input-cylRadius') as HTMLInputElement)?.value) || 0;
        const h = parseFloat((document.getElementById('input-cylHeight') as HTMLInputElement)?.value) || 0;
        results.push({ label: 'Volume (πr²h)', value: (Math.PI * Math.pow(r, 2) * h).toFixed(4) });
        results.push({ label: 'Surface Area (2πrh + 2πr²)', value: (2 * Math.PI * r * h + 2 * Math.PI * Math.pow(r, 2)).toFixed(4) });
      }

      const grid = document.getElementById('result-grid');
      if (grid) {
        grid.innerHTML = results.map(r => `
          <div class="flex justify-between items-center border-b border-white/[0.05] pb-4">
            <span class="text-zinc-400 font-medium">${r.label}</span>
            <span class="text-2xl font-bold text-[#ff6b35]">${r.value}</span>
          </div>
        `).join('');
      }

      document.getElementById('results-section')?.classList.remove('hidden');
      btn?.removeAttribute('data-loading');
      
      const saveBtn = document.getElementById('save-geometry-btn');
      if (saveBtn) {
        saveBtn.classList.remove('hidden');
        saveBtn.onclick = () => {
          if (typeof window.saveToDashboard === 'function') {
            const dataToSave: Record<string, string> = {
              'Shape': shape.charAt(0).toUpperCase() + shape.slice(1)
            };
            results.forEach(r => {
              dataToSave[r.label.split(' ')[0]] = r.value;
            });
            const success = window.saveToDashboard('Geometry Calculator', '/math/geometry-calculator', {
              type: 'key-value',
              data: dataToSave
            });
            if (success) {
              const textEl = saveBtn.querySelector('.btn-text');
              const iconSave = saveBtn.querySelector('.icon-save');
              const iconCheck = saveBtn.querySelector('.icon-check');
              if (textEl) textEl.textContent = 'Saved!';
              if (iconSave) iconSave.classList.add('hidden');
              if (iconCheck) iconCheck.classList.remove('hidden');
              saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              setTimeout(() => {
                if (textEl) textEl.textContent = 'Save Result';
                if (iconSave) iconSave.classList.remove('hidden');
                if (iconCheck) iconCheck.classList.add('hidden');
                saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              }, 2000);
            }
          }
        };
      }
    }, 300);
  }

  document.getElementById('calculator-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
</script>
