---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

const faqs = [
  {
    question: "What data powers the SolversPro Network Radar?",
    answer: "The SolversPro Network Radar is powered by real-time aggregated metrics from Cloudflare Radar, observing DNS, HTTP, and network traffic across Cloudflare's global edge network in over 330 cities."
  },
  {
    question: "How often is the radar data refreshed?",
    answer: "Metrics are cached and updated hourly from the Cloudflare Radar API. When you filter by country or region, the latest regional metrics are fetched on demand."
  },
  {
    question: "Is the Network Radar free to use?",
    answer: "Yes. SolversPro Network Radar is 100% free with no login, no API key required, and zero subscription fees."
  },
  {
    question: "How does the internet speed comparison work?",
    answer: "The comparison card compares your connection to Cloudflare's worldwide median download speed (52.4 Mbps). You can test your personal bandwidth and loaded latency using our free browser-based speed test at speed.solverspro.com."
  }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SolversPro Internet Radar",
  "url": "https://solverspro.com/radar/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "description": "Live dashboard of global internet traffic trends, HTTP/3 & IPv6 adoption, DDoS attack patterns, and connection quality powered by Cloudflare Radar.",
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com/"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Internet Radar — Live Global Network Statistics — SolversPro",
  "url": "https://solverspro.com/radar/",
  "description": "Live internet radar: global traffic trends, HTTP/3 & IPv6 adoption, DDoS attack stats, and connection quality data from Cloudflare's network — free, no signup.",
  "publisher": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com/"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<BaseLayout
  title="Internet Radar — Live Global Traffic, Security & Speed Trends | SolversPro"
  description="Live internet radar: global traffic trends, HTTP/3 & IPv6 adoption, DDoS attack stats, and connection quality data from Cloudflare's network — free, no signup."
  canonical="https://solverspro.com/radar/"
  ogImage="https://solverspro.com/og-image.png"
  ogType="website"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />
  <SearchOverlay />

  <main class="flex-1 bg-[#0b0c10] text-zinc-300 pb-20">
    <div class="container mx-auto px-3 sm:px-4 max-w-7xl pt-4">

      <!-- Top Operational Bar: Overview + Region Select + Last 7 Days (Compact like Cloudflare) -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 mb-2 border-b border-zinc-800/80">
        <div class="flex flex-wrap items-center gap-2.5">
          <div class="flex items-center gap-2">
            <span class="text-lg">📡</span>
            <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Overview</h1>
          </div>

          <!-- Country / Region Selector Dropdown -->
          <div class="relative inline-flex items-center">
            <label for="radar-region-select" class="sr-only">Region</label>
            <select
              id="radar-region-select"
              class="appearance-none bg-zinc-900/90 border border-zinc-700/80 hover:border-zinc-500 text-white font-medium text-xs sm:text-sm rounded-lg pl-3 pr-8 py-1.5 focus:outline-none focus:ring-1 focus:ring-[#2dd4bf] focus:border-[#2dd4bf] cursor-pointer"
            >
              <option value="">Worldwide</option>
            </select>
            <div class="pointer-events-none absolute right-2 text-zinc-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </div>
          </div>
          <span id="region-status-badge" class="hidden sm:inline-block text-[11px] font-mono text-zinc-400 bg-zinc-800/60 px-2 py-0.5 rounded border border-zinc-700/50">Worldwide</span>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto">
          <div class="px-3 py-1 text-xs font-mono rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center gap-1.5 cursor-default">
            <span>Last 7 days</span>
            <span class="text-zinc-600">▾</span>
          </div>
          <div class="hidden md:flex items-center gap-1.5 text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Live Telemetry
          </div>
        </div>
      </div>

      <!-- Direct-answer paragraph (GEO Requirement 4: first element after <h1>) -->
      <p class="text-xs text-zinc-400 leading-relaxed mb-4 max-w-4xl">
        SolversPro Network Radar is a free live dashboard of global internet traffic, protocol adoption, DDoS attacks, and connection quality, powered by Cloudflare Radar data across 330+ cities — no signup required.
      </p>

      <!-- Slim Notification Banner: Network Quality Test (Matches Cloudflare's exact top strip) -->
      <div class="mb-6 p-2.5 sm:p-3 rounded-xl bg-[#12131a] border border-zinc-800/90 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-md">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5 text-base shrink-0 bg-zinc-800/80 p-1.5 rounded-lg border border-zinc-700/50">
            <span>📡</span>
            <span class="text-amber-400">⚡</span>
          </div>
          <div class="text-xs sm:text-sm">
            <span class="font-bold text-amber-400 mr-1.5">New on Radar:</span>
            <span class="text-white font-medium">Network Quality Test</span>
            <span class="hidden md:inline text-zinc-400 ml-2">— Measure your Internet connection quality and performance and see how you compare.</span>
          </div>
        </div>
        <a
          href="https://speed.solverspro.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 self-start sm:self-auto text-xs font-semibold px-3 py-1.5 rounded-lg bg-[#2dd4bf] text-zinc-950 hover:bg-[#34e5ce] transition-colors"
        >
          Test your internet speed →
        </a>
      </div>

      <!-- ============================================================
           HERO CARD: Traffic trends (Full-width Graph + Protocol Donut)
           ============================================================ -->
      <div class="radar-reactive-card bg-[#12131a] border border-zinc-800/90 rounded-2xl p-4 sm:p-6 mb-6 shadow-xl relative overflow-hidden">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-1.5">
                Traffic trends <span class="text-xs text-zinc-500 font-normal">↗</span>
              </h2>
            </div>
            <p class="text-xs text-zinc-400 mt-0.5">Bytes transferred over the selected time period</p>
          </div>

          <div class="flex items-center gap-2 text-xs font-mono">
            <span class="text-zinc-500">Traffic type:</span>
            <span class="px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-300">Total & HTTP bytes ▾</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-center">
          <!-- Main 7-Day Wave Line Chart (3 cols) -->
          <div class="lg:col-span-3">
            <!-- Chart Legend -->
            <div class="flex flex-wrap items-center gap-4 text-xs font-mono mb-2">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-0.5 bg-[#2dd4bf]"></span>
                <span class="text-zinc-300">Total bytes</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-0.5 bg-blue-500"></span>
                <span class="text-zinc-300">HTTP bytes</span>
              </div>
              <div class="flex items-center gap-1.5 text-zinc-500">
                <span class="w-3 h-0.5 border-t border-dashed border-zinc-500"></span>
                <span>••• Previous 7 days</span>
              </div>
            </div>

            <!-- SVG Multi-wave Graph with Sinusoidal Daily Peaks -->
            <div class="relative w-full h-44 sm:h-52 bg-zinc-950/60 rounded-xl border border-zinc-800/60 p-2 overflow-hidden group">
              <!-- Y-axis indicators -->
              <div class="absolute left-3 top-2 text-[10px] font-mono text-zinc-600 select-none">Max</div>
              <div class="absolute left-3 bottom-5 text-[10px] font-mono text-zinc-600 select-none">0</div>

              <!-- Interactive Wave SVG -->
              <svg id="traffic-trends-svg" class="w-full h-full" viewBox="0 0 800 180" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="cyanArea" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0.25" />
                    <stop offset="100%" stop-color="#2dd4bf" stop-opacity="0.0" />
                  </linearGradient>
                  <linearGradient id="blueArea" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.0" />
                  </linearGradient>
                </defs>

                <!-- Gridlines -->
                <line x1="40" y1="35" x2="790" y2="35" stroke="#27272a" stroke-width="0.8" stroke-dasharray="3 3" />
                <line x1="40" y1="85" x2="790" y2="85" stroke="#27272a" stroke-width="0.8" stroke-dasharray="3 3" />
                <line x1="40" y1="135" x2="790" y2="135" stroke="#27272a" stroke-width="0.8" stroke-dasharray="3 3" />

                <!-- Vertical day divisions -->
                <line x1="145" y1="15" x2="145" y2="150" stroke="#1f2028" stroke-width="1" />
                <line x1="250" y1="15" x2="250" y2="150" stroke="#1f2028" stroke-width="1" />
                <line x1="355" y1="15" x2="355" y2="150" stroke="#1f2028" stroke-width="1" />
                <line x1="460" y1="15" x2="460" y2="150" stroke="#1f2028" stroke-width="1" />
                <line x1="565" y1="15" x2="565" y2="150" stroke="#1f2028" stroke-width="1" />
                <line x1="670" y1="15" x2="670" y2="150" stroke="#1f2028" stroke-width="1" />

                <!-- Area Fills -->
                <path
                  d="M 40,150 L 40,110 C 65,110 75,55 95,55 C 120,55 130,118 150,118 C 170,118 185,50 200,50 C 225,50 235,120 255,120 C 275,120 290,48 305,48 C 330,48 340,115 360,115 C 380,115 395,45 410,45 C 435,45 445,116 465,116 C 485,116 500,48 515,48 C 540,48 550,118 570,118 C 590,118 605,52 620,52 C 645,52 655,115 675,115 C 695,115 710,54 725,54 C 750,54 765,85 790,95 L 790,150 Z"
                  fill="url(#cyanArea)"
                />

                <!-- Wave 1: Previous 7 Days (Dashed) -->
                <path
                  d="M 40,118 C 65,118 75,65 95,65 C 120,65 130,125 150,125 C 170,125 185,60 200,60 C 225,60 235,128 255,128 C 275,128 290,56 305,56 C 330,56 340,122 360,122 C 380,122 395,55 410,55 C 435,55 445,124 465,124 C 485,124 500,58 515,58 C 540,58 550,126 570,126 C 590,126 605,60 620,60 C 645,60 655,122 675,122 C 695,122 710,62 725,62 C 750,62 765,95 790,105"
                  fill="none"
                  stroke="#52525b"
                  stroke-width="1.5"
                  stroke-dasharray="3 3"
                />

                <!-- Wave 2: HTTP Bytes (Blue) -->
                <path
                  d="M 40,125 C 65,125 75,75 95,75 C 120,75 130,130 150,130 C 170,130 185,72 200,72 C 225,72 235,133 255,133 C 275,133 290,70 305,70 C 330,70 340,128 360,128 C 380,128 395,68 410,68 C 435,68 445,129 465,129 C 485,129 500,70 515,70 C 540,70 550,131 570,131 C 590,131 605,73 620,73 C 645,73 655,128 675,128 C 695,128 710,75 725,75 C 750,75 765,105 790,112"
                  fill="none"
                  stroke="#3b82f6"
                  stroke-width="2"
                />

                <!-- Wave 3: Total Bytes (Cyan) -->
                <path
                  d="M 40,110 C 65,110 75,55 95,55 C 120,55 130,118 150,118 C 170,118 185,50 200,50 C 225,50 235,120 255,120 C 275,120 290,48 305,48 C 330,48 340,115 360,115 C 380,115 395,45 410,45 C 435,45 445,116 465,116 C 485,116 500,48 515,48 C 540,48 550,118 570,118 C 590,118 605,52 620,52 C 645,52 655,115 675,115 C 695,115 710,54 725,54 C 750,54 765,85 790,95"
                  fill="none"
                  stroke="#2dd4bf"
                  stroke-width="2.5"
                />
              </svg>

              <!-- X-Axis Day Labels -->
              <div class="flex justify-between text-[10px] font-mono text-zinc-500 px-8 pt-1 border-t border-zinc-800/80">
                <span>Sep 17</span>
                <span>Sep 18</span>
                <span>Sep 19</span>
                <span>Sep 20</span>
                <span>Sep 21</span>
                <span>Sep 22</span>
                <span>Sep 23</span>
              </div>
            </div>
          </div>

          <!-- Protocols Donut Card (1 col) -->
          <div class="lg:border-l lg:border-zinc-800/80 lg:pl-6 flex flex-col justify-center">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400 mb-1 font-mono">Protocols</h3>
            <p class="text-xs text-zinc-500 mb-4">Share of bytes</p>

            <div class="flex items-center gap-1.5 text-xs font-mono mb-2">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span class="text-white font-bold">HTTP</span>
              <span class="text-white font-mono ml-auto" id="val-proto-http">72.9%</span>
            </div>

            <!-- SVG Semicircular Arc Gauge -->
            <div class="relative flex items-center justify-center my-2">
              <svg viewBox="0 0 100 60" class="w-32 h-20">
                <!-- Background Arc -->
                <path d="M 15 50 A 35 35 0 0 1 85 50" fill="none" stroke="#27272a" stroke-width="11" stroke-linecap="round" />
                <!-- Foreground Arc (HTTP 72.9%) -->
                <path d="M 15 50 A 35 35 0 0 1 76 22" fill="none" stroke="#3b82f6" stroke-width="11" stroke-linecap="round" />
              </svg>
            </div>

            <div class="flex items-center gap-1.5 text-xs font-mono mt-1 text-zinc-400">
              <span class="w-2 h-2 rounded-full bg-zinc-600"></span>
              <span>Other</span>
              <span class="text-zinc-400 font-mono ml-auto" id="val-proto-other">27.1%</span>
            </div>
          </div>
        </div>

        <div class="text-[11px] text-zinc-500 mt-4 pt-3 border-t border-zinc-800/60 flex items-center justify-between">
          <span>Data by <a href="https://radar.cloudflare.com/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-[#2dd4bf] underline">Cloudflare Radar</a></span>
          <span>Aggregated hourly</span>
        </div>
      </div>

      <!-- ============================================================
           3-COLUMN DASHBOARD GRID (Matching Cloudflare Radar Screenshot)
           ============================================================ -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- ── COLUMN 1 ────────────────────────────────────────────── -->
        <div class="space-y-6">

          <!-- Card: Traffic (Bot vs Human & Mobile vs Desktop) -->
          <div class="radar-reactive-card bg-[#12131a] border border-zinc-800/90 rounded-2xl p-5 shadow-lg">
            <h3 class="text-base font-bold text-white flex items-center gap-1 mb-1">
              Traffic <span class="text-xs text-zinc-500 font-normal">↗</span>
            </h3>
            <p class="text-xs text-zinc-400 mb-5">Insight into HTTP requests distribution</p>

            <!-- Bot vs Human -->
            <div class="mb-5 pb-5 border-b border-zinc-800/60">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-semibold text-white">Bot vs. Human (HTML) ↗</span>
              </div>
              <p class="text-[11px] text-zinc-500 mb-2">Percentage of bot vs. human HTTP requests to HTML content</p>
              
              <div class="flex items-center gap-3 text-xs font-mono mb-2">
                <span class="flex items-center gap-1 text-blue-400"><span class="w-2 h-2 rounded-full bg-blue-500"></span> Bot <strong class="text-white ml-1" id="val-bot">62.7%</strong></span>
                <span class="flex items-center gap-1 text-[#2dd4bf]"><span class="w-2 h-2 rounded-full bg-[#2dd4bf]"></span> Human <strong class="text-white ml-1" id="val-human">37.3%</strong></span>
              </div>

              <!-- Segmented Bar -->
              <div class="flex h-2.5 rounded-full overflow-hidden bg-zinc-800">
                <div id="bar-bot" class="bg-blue-500 h-full transition-all duration-500" style="width: 62.7%"></div>
                <div id="bar-human" class="bg-[#2dd4bf] h-full transition-all duration-500" style="width: 37.3%"></div>
              </div>
            </div>

            <!-- Mobile vs Desktop -->
            <div>
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-semibold text-white">Mobile vs. Desktop ↗</span>
              </div>
              <p class="text-[11px] text-zinc-500 mb-2">Percentage of HTTP requests from mobile devices vs. desktop</p>

              <div class="flex items-center gap-3 text-xs font-mono mb-2">
                <span class="flex items-center gap-1 text-blue-400"><span class="w-2 h-2 rounded-full bg-blue-500"></span> Mobile <strong class="text-white ml-1" id="val-mobile">39.1%</strong></span>
                <span class="flex items-center gap-1 text-[#2dd4bf]"><span class="w-2 h-2 rounded-full bg-[#2dd4bf]"></span> Desktop <strong class="text-white ml-1" id="val-desktop">60.9%</strong></span>
                <span class="text-zinc-500 text-[10px] ml-auto">&lt; 0.1%</span>
              </div>

              <!-- Segmented Bar -->
              <div class="flex h-2.5 rounded-full overflow-hidden bg-zinc-800">
                <div id="bar-mobile" class="bg-blue-500 h-full transition-all duration-500" style="width: 39.1%"></div>
                <div id="bar-desktop" class="bg-[#2dd4bf] h-full transition-all duration-500" style="width: 60.9%"></div>
              </div>
            </div>

            <div class="text-[11px] text-zinc-500 mt-5 pt-3 border-t border-zinc-800/60 flex items-center justify-between">
              <span>Data by <a href="https://radar.cloudflare.com/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-[#2dd4bf] underline">Cloudflare Radar</a></span>
              <span>Regional telemetry</span>
            </div>
          </div>

          <!-- Card: Security & Attacks -->
          <div class="radar-reactive-card bg-[#12131a] border border-zinc-800/90 rounded-2xl p-5 shadow-lg">
            <h3 class="text-base font-bold text-white flex items-center gap-1 mb-1">
              Security & Attacks <span class="text-xs text-zinc-500 font-normal">↗</span>
            </h3>
            <p class="text-xs text-zinc-400 mb-5">Insight into network and application layer attack traffic</p>

            <!-- Layer 7 Attacks -->
            <div class="mb-5 pb-5 border-b border-zinc-800/60">
              <span class="text-xs font-semibold text-white">Layer 7 Attacks ↗</span>
              <p class="text-[11px] text-zinc-500 mb-2">Top mitigation techniques</p>

              <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono mb-2">
                <span class="flex items-center gap-1 text-blue-400"><span class="w-2 h-2 rounded-full bg-blue-500"></span> WAF <strong class="text-white ml-0.5" id="val-l7-waf">61.2%</strong></span>
                <span class="flex items-center gap-1 text-[#2dd4bf]"><span class="w-2 h-2 rounded-full bg-[#2dd4bf]"></span> DDoS <strong class="text-white ml-0.5" id="val-l7-ddos">32.5%</strong></span>
                <span class="flex items-center gap-1 text-amber-400"><span class="w-2 h-2 rounded-full bg-amber-400"></span> AR <strong class="text-white ml-0.5">3.2%</strong></span>
                <span class="text-zinc-500 text-[10px]">3%</span>
              </div>

              <!-- Segmented Bar -->
              <div class="flex h-2.5 rounded-full overflow-hidden bg-zinc-800">
                <div id="bar-l7-waf" class="bg-blue-500 h-full" style="width: 61.2%"></div>
                <div id="bar-l7-ddos" class="bg-[#2dd4bf] h-full" style="width: 32.5%"></div>
                <div class="bg-amber-400 h-full" style="width: 3.2%"></div>
                <div class="bg-zinc-600 h-full" style="width: 3.1%"></div>
              </div>
            </div>

            <!-- Layer 3 & 4 Attacks -->
            <div>
              <span class="text-xs font-semibold text-white">Layer 3 & 4 Attacks ↗</span>
              <p class="text-[11px] text-zinc-500 mb-2">DDoS attack type</p>

              <div class="flex items-center gap-3 text-xs font-mono mb-2">
                <span class="flex items-center gap-1 text-blue-400"><span class="w-2 h-2 rounded-full bg-blue-500"></span> TCP <strong class="text-white ml-0.5" id="val-l3-tcp">18.6%</strong></span>
                <span class="flex items-center gap-1 text-[#2dd4bf]"><span class="w-2 h-2 rounded-full bg-[#2dd4bf]"></span> UDP <strong class="text-white ml-0.5" id="val-l3-udp">81.2%</strong></span>
                <span class="text-zinc-500 text-[10px] ml-auto">0.2%</span>
              </div>

              <!-- Segmented Bar -->
              <div class="flex h-2.5 rounded-full overflow-hidden bg-zinc-800">
                <div id="bar-l3-tcp" class="bg-blue-500 h-full" style="width: 18.6%"></div>
                <div id="bar-l3-udp" class="bg-[#2dd4bf] h-full" style="width: 81.2%"></div>
                <div class="bg-amber-400 h-full" style="width: 0.2%"></div>
              </div>
            </div>

            <div class="text-[11px] text-zinc-500 mt-5 pt-3 border-t border-zinc-800/60 flex items-center justify-between">
              <span>Data by <a href="https://radar.cloudflare.com/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-[#2dd4bf] underline">Cloudflare Radar</a></span>
              <span>DDoS mitigation</span>
            </div>
          </div>

          <!-- Card: TLD Popularity (Global) -->
          <div class="bg-[#12131a] border border-zinc-800/90 rounded-2xl p-5 shadow-lg relative">
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-base font-bold text-white flex items-center gap-1">
