---
interface Props {
  text: string;
  id?: string;
  icon?: string;
}

const { text, id = "calculate-btn", icon } = Astro.props;
---

<button
  id={id}
  type="submit"
  class="w-full sm:w-auto px-8 py-3.5 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white rounded-md font-semibold text-sm transition-all shadow-[0_0_15px_rgba(255,107,53,0.3)] hover:shadow-[0_0_25px_rgba(255,107,53,0.5)] flex items-center justify-center gap-2"
  style="font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em;"
>
  {icon && <span class="text-lg">{icon}</span>}
  {text}
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 12h14M12 5l7 7-7 7"/>
  </svg>
</button>
