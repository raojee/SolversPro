---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

const faqs = [
  {
    question: "What is SolversPro?",
    answer: "SolversPro is a comprehensive suite of free, lightning-fast utilities and calculators for professionals, students, and everyday use. We cover everything from finance and health metrics to complex engineering calculations and developer tools."
  },
  {
    question: "Are the tools really 100% free?",
    answer: "Yes! We believe that essential calculation tools shouldn't be locked behind paywalls. All of our standard calculators and converters are completely free to use."
  },
  {
    question: "Do you store my data?",
    answer: "No. The vast majority of our tools run entirely client-side in your browser. If you use the Dashboard to save results, that data is stored locally on your device using your browser's localStorage. We do not transmit or store your personal calculation data on our servers."
  },
  {
    question: "Do I need to create an account?",
    answer: "No account is required to use any of our calculators. You can start calculating instantly without signing up."
  },
  {
    question: "How do I request a new tool or calculator?",
    answer: "We are constantly expanding our library! If you have a specific tool you'd like to see, please head over to our Contact page and send us a message."
  }
];
---

<BaseLayout
  title="Frequently Asked Questions | SolversPro"
  description="Find answers to common questions about SolversPro's free, client-side calculation engines."
>
  <Header />
  <SearchOverlay />
  
  <main class="flex-1 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="mb-12">
        <span class="scifi-badge mb-6">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          SUPPORT
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Frequently Asked Questions</h1>
        <p class="text-lg text-zinc-400">Everything you need to know about the platform and how it works.</p>
      </div>

      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 shadow-sm transition-all hover:border-white/[0.1]">
            <h3 class="text-lg font-semibold text-white mb-3 flex items-start gap-3">
              <span class="text-[#ff6b35] mt-1">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
              {faq.question}
            </h3>
            <p class="text-zinc-400 ml-7 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
      
      <div class="mt-12 p-6 bg-[#ff6b35]/10 border border-[#ff6b35]/20 rounded-xl text-center">
        <h3 class="text-white font-semibold mb-2">Still have questions?</h3>
        <p class="text-zinc-400 mb-4">We're here to help. Reach out to our team directly.</p>
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white rounded font-semibold text-sm transition-colors shadow-[0_0_15px_rgba(255,107,53,0.3)]">
          Contact Us
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
