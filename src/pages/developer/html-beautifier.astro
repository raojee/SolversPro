---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

import ToolFAQ from '../../components/ToolFAQ.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "HTML Beautifier",
  "url": "https://solverspro.com/developer/html-beautifier/",
  "applicationCategory": "DeveloperToolsApplication",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Free online HTML beautifier to format, indent, and prettify messy or minified HTML markup with customizable 2-space, 4-space, or tab indentation.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "SolversPro",
    "url": "https://solverspro.com"
  }
};

const faqs = [
  {
    question: "What does an HTML beautifier do?",
    answer: "An HTML beautifier parses minified, unformatted, or single-line HTML markup and reconstructs it with consistent hierarchical indentation, line breaks around block elements, and normalized attribute spacing for human readability."
  },
  {
    question: "Does beautifying HTML alter the webpage rendering?",
    answer: "No. Standard HTML formatting changes only whitespace between tags. While CSS white-space properties inside <pre> or <code> tags preserve whitespace, standard DOM structure, element attributes, and inline script behaviors remain functionally unchanged."
  },
  {
    question: "How are void or self-closing tags handled during formatting?",
    answer: "Self-closing and void tags such as <img>, <br>, <meta>, <input>, and <hr> do not require closing tags and will not increment the indentation level of subsequent sibling elements."
  },
  {
    question: "Is my HTML code sent to a remote server?",
    answer: "No. The SolversPro HTML Beautifier runs entirely client-side inside your web browser using JavaScript string and regex processing. Your code and confidential markup never leave your local machine."
  }
];
---

<BaseLayout title="HTML Beautifier — Format & Prettify HTML Code | SolversPro" description="HTML Beautifier formats, indents, and prettifies messy or minified HTML markup instantly in your browser with custom tab or space indentation." canonical="https://solverspro.com/developer/html-beautifier/" schema={schema}>
  <Header /><SearchOverlay />
  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-5xl">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Developer Tools',href:'/developer'},{label:'HTML Beautifier'}]} />
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">🌐 HTML Beautifier</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">
          The SolversPro HTML Beautifier is a free, browser-based developer utility that formats, indents, and cleans minified or unorganized HTML code with customizable 2-space, 4-space, or tab indentation in real time.
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 min-h-[500px]">
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Minified HTML</h2>
            <div class="flex items-center gap-3">
              <select id="indent-size" class="bg-[#1a1a24] border border-white/[0.1] text-xs text-zinc-300 rounded px-2 py-1 outline-none focus:border-[#2dd4bf]">
                <option value="2">2 Spaces</option>
                <option value="4">4 Spaces</option>
                <option value="tab">Tabs</option>
              </select>
              <button id="btn-format" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">Format &rarr;</button>
            </div>
          </div>
          <textarea id="input-raw" class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[400px]" placeholder='<div class="wrapper"><header><h1>Title</h1></header><main><p>Content</p></main></div>' spellcheck="false"></textarea>
        </div>
        <div class="flex flex-col">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Formatted HTML</h2>
            <button id="btn-copy" class="text-xs font-semibold text-[#2dd4bf] hover:text-[#5eead4] transition-colors">Copy</button>
          </div>
          <textarea id="output-code" readonly class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:outline-none font-mono text-sm text-[#2dd4bf] resize-none min-h-[400px]" placeholder="<!-- Formatted HTML will appear here -->"></textarea>
        </div>
      </div>

      <!-- Citable Reference Table -->
      <div class="mt-12 bg-[#0d0d14] border border-white/[0.06] rounded-xl p-6">
        <h2 class="text-xl font-bold text-white mb-2">HTML Element Formatting Rules</h2>
        <p class="text-zinc-400 text-sm mb-6">Standard indentation and nesting behaviors applied across HTML5 document elements.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-zinc-400 font-mono text-xs uppercase">
                <th class="py-3 px-4">Tag Classification</th>
                <th class="py-3 px-4">Example Elements</th>
                <th class="py-3 px-4">Indentation Behavior</th>
                <th class="py-3 px-4">Newline Handling</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-zinc-300 font-mono text-xs">
              <tr>
                <td class="py-3 px-4 text-[#2dd4bf] font-bold">Block Containers</td>
                <td class="py-3 px-4 text-white">&lt;div&gt;, &lt;section&gt;, &lt;main&gt;, &lt;article&gt;</td>
                <td class="py-3 px-4">Increments nesting level (+1)</td>
                <td class="py-3 px-4">Preceding and trailing newline</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#ff6b35] font-bold">Head Elements</td>
                <td class="py-3 px-4 text-white">&lt;head&gt;, &lt;title&gt;, &lt;meta&gt;, &lt;link&gt;</td>
                <td class="py-3 px-4">Nested inside &lt;html&gt; root</td>
                <td class="py-3 px-4">Standard sequential lines</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#a78bfa] font-bold">Void / Self-Closing</td>
                <td class="py-3 px-4 text-white">&lt;img&gt;, &lt;input&gt;, &lt;br&gt;, &lt;hr&gt;, &lt;meta&gt;</td>
                <td class="py-3 px-4">Zero indent shift (level unchanged)</td>
                <td class="py-3 px-4">Single line placement</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-[#38bdf8] font-bold">Inline Text Elements</td>
                <td class="py-3 px-4 text-white">&lt;span&gt;, &lt;a&gt;, &lt;strong&gt;, &lt;em&gt;</td>
                <td class="py-3 px-4">Follows parent container indentation</td>
                <td class="py-3 px-4">Formatted inline or wrapped</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={faqs} />

      <ToolShare title="HTML Beautifier" url="https://solverspro.com/developer/html-beautifier" />
      <SimilarTools category="developer" currentPath="/developer/html-beautifier" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { copyToClipboard } from '../../utils/clipboard';
  const rawEl = document.getElementById('input-raw') as HTMLTextAreaElement;
  const outEl = document.getElementById('output-code') as HTMLTextAreaElement;
  const indentSelect = document.getElementById('indent-size') as HTMLSelectElement;

  function formatHTML(html: string, indentString: string): string {
    let formatted = '';
    let indentLevel = 0;
    
    // Remove formatting
    html = html.replace(/\n/g, '').replace(/[\s]+/g, ' ').replace(/>\s*</g, '><').trim();
    
    const elements = html.split(/(<[^>]+>)/g).filter(item => item.trim() !== '');
    
    for (let i = 0; i < elements.length; i++) {
      let el = elements[i];
      
      if (el.match(/^<\w[^>]*[^\/]>.*$/) && !el.match(/^<(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)[^>]*>$/)) {
        // Open tag
        formatted += indentString.repeat(indentLevel) + el + '\n';
        indentLevel++;
      } else if (el.match(/^<\/\w/)) {
        // Close tag
        indentLevel = Math.max(0, indentLevel - 1);
        
        // Check if previous was text, if so, put on same line
        if (i > 0 && !elements[i-1].match(/<[^>]+>/)) {
           formatted = formatted.trimEnd() + el + '\n';
        } else {
           formatted += indentString.repeat(indentLevel) + el + '\n';
        }
      } else if (el.match(/^<.*>$/)) {
         // Self closing tag or comments
         formatted += indentString.repeat(indentLevel) + el + '\n';
      } else {
        // Text node
        formatted += indentString.repeat(indentLevel) + el.trim() + '\n';
      }
    }
    
    return formatted.trim();
  }

  document.getElementById('btn-format')?.addEventListener('click', () => {
    const val = indentSelect.value;
    const indentStr = val === 'tab' ? '\t' : ' '.repeat(parseInt(val));
    outEl.value = formatHTML(rawEl.value, indentStr);
    outEl.classList.add('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]');
    setTimeout(() => outEl.classList.remove('ring-2','ring-[#2dd4bf]','border-[#2dd4bf]'), 500);
  });

  document.getElementById('btn-copy')?.addEventListener('click', () => { if (outEl.value) copyToClipboard(outEl.value); });
</script>
