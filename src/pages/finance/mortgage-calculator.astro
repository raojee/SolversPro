---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import ToolFAQ from '../../components/ToolFAQ.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InputField from '../../components/InputField.astro';
import SelectField from '../../components/SelectField.astro';
import CalculateButton from '../../components/CalculateButton.astro';
import SaveResultButton from '../../components/SaveResultButton.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Mortgage Calculator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Calculate monthly mortgage payments, total interest cost, and amortization schedules. Free financial calculator with interactive chart breakdown.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqs = [
  {
    question: "How is the monthly mortgage payment calculated?",
    answer: "The monthly payment is calculated using the standard amortization formula: M = P * [r(1+r)^n] / [(1+r)^n - 1], where P is loan principal (price minus down payment), r is monthly interest rate, and n is total monthly payments."
  },
  {
    question: "Does this estimate include property taxes and homeowners insurance?",
    answer: "This tool calculates the principal and interest (P&I) payment. Property taxes, homeowners insurance, and local HOA fees vary by location and can be budgeted separately."
  },
  {
    question: "Can I save my mortgage calculation to compare scenarios?",
    answer: "Yes! Click the 'Save Result' button to store your calculation directly inside your browser dashboard for quick comparison across multiple properties."
  }
];
---

<BaseLayout
  title="Mortgage Calculator — Calculate Monthly Payments & Interest | SolversPro"
  description="Estimate monthly mortgage payments, loan principal, and total interest costs. Free online home loan calculator with interactive payment breakdown charts."
  canonical="https://solverspro.com/finance/mortgage-calculator"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Finance', href: '/finance' },
        { label: 'Mortgage Calculator' },
      ]} />

      <!-- Hero Section -->
      <div class="mb-10 max-w-4xl mx-auto text-center">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">🏠 Mortgage Calculator</h1>
        <p class="text-lg text-zinc-300 leading-relaxed">
          Calculate your estimated monthly mortgage payment, interest breakdown, and total loan cost in seconds with our free online Mortgage Calculator. Designed for prospective homebuyers, real estate investors, and homeowners exploring refinancing options, this tool provides a comprehensive financial analysis of your housing expenses. Easily adjust your home purchase price, down payment amount, annual interest rate, and loan term (15-year or 30-year fixed) to view exact principal vs. interest payment allocations. Visualize your long-term debt trajectory with interactive charts and export your results directly to your personal dashboard to compare multiple borrowing scenarios effortlessly.
        </p>
      </div>

      <form class="form-container max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 shadow-sm mb-8" id="calculator-form">
        <SelectField
          label="Currency"
          name="currency"
          id="select-currency"
          value="USD"
          options={[
            { value: 'USD', label: 'USD ($)' },
            { value: 'EUR', label: 'EUR (€)' },
            { value: 'GBP', label: 'GBP (£)' }
          ]}
        />
        <InputField label="Home Price" name="homePrice" prefix="$" value={350000} min={0} step={1000} placeholder="350,000" />
        <InputField label="Down Payment" name="downPayment" prefix="$" value={70000} min={0} step={1000} placeholder="70,000" />
        <InputField label="Loan Term (Years)" name="years" value={30} min={1} max={50} step={1} placeholder="30" />
        <InputField label="Interest Rate (%)" name="annualRate" suffix="%" value={6.5} min={0.1} max={30} step={0.1} placeholder="6.5" />

        <div class="mt-6">
          <CalculateButton text="Calculate Payment" icon="🏠" id="calculate-btn" />
        </div>
      </form>

      <!-- Results -->
      <div id="results-section" class="hidden space-y-8 mb-12 max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="result-surface p-6 md:p-8 rounded-xl border bg-white/[0.02] flex flex-col justify-center border-white/[0.08]">
            <div class="mb-6">
              <p class="label mb-1 text-sm font-medium text-zinc-500 uppercase tracking-wider">Estimated Monthly Payment</p>
              <p class="text-4xl font-bold text-[#ff6b35]" id="result-monthly">$0</p>
            </div>
            <div class="space-y-4">
              <div class="flex justify-between border-b border-white/[0.05] pb-2">
                <span class="text-zinc-400">Principal Amount</span>
                <span class="text-white font-bold" id="result-principal">$0</span>
              </div>
              <div class="flex justify-between border-b border-white/[0.05] pb-2">
                <span class="text-zinc-400">Total Interest Paid</span>
                <span class="text-[#2dd4bf] font-bold" id="result-total-interest">$0</span>
              </div>
              <div class="flex justify-between">
                <span class="text-zinc-400">Total Cost of Loan</span>
                <span class="text-white font-bold" id="result-total-cost">$0</span>
              </div>
            </div>
            <div class="w-full flex justify-end mt-8 border-t border-white/[0.05] pt-4">
              <SaveResultButton id="save-mortgage-btn" />
            </div>
          </div>
          <div class="result-surface p-6 rounded-xl border bg-white/[0.02] flex items-center justify-center min-h-[300px] border-white/[0.08]">
            <canvas id="mortgageChart"></canvas>
          </div>
        </div>
      </div>

      <!-- How to Use & Common Use Cases Sections -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-16 max-w-4xl mx-auto">
        <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 md:p-8">
          <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-[#ff6b35]">📖</span> How to Use the Calculator
          </h2>
          <ol class="space-y-3 text-zinc-300 text-sm list-decimal list-inside leading-relaxed">
            <li><strong>Select Currency & Price:</strong> Choose your currency symbol ($/€/£) and input the total property purchase price.</li>
            <li><strong>Input Down Payment:</strong> Enter your planned down payment amount to establish the starting loan principal balance.</li>
            <li><strong>Set Interest Rate & Term:</strong> Specify your expected annual interest rate and mortgage term in years (e.g., 15 or 30).</li>
            <li><strong>Calculate & Review:</strong> Click <strong>Calculate Payment</strong> to see your monthly obligation, total interest, and payment chart.</li>
          </ol>
        </div>

        <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 md:p-8">
          <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-[#2dd4bf]">🚀</span> Common Use Cases
          </h2>
          <ul class="space-y-3 text-zinc-300 text-sm list-disc list-inside leading-relaxed">
            <li><strong>Home Buying Affordability:</strong> Determining your monthly housing budget before shopping for real estate listings.</li>
            <li><strong>Loan Duration Comparison:</strong> Evaluating total interest savings between a 15-year mortgage vs a 30-year fixed loan.</li>
            <li><strong>Down Payment Planning:</strong> Seeing how putting 10% vs 20% down alters your monthly mortgage payment.</li>
            <li><strong>Mortgage Refinance Evaluation:</strong> Checking if refinancing your current loan to a lower interest rate saves money.</li>
          </ul>
        </div>
      </div>

      <!-- FAQ Section -->
      <ToolFAQ faqs={faqs} />

      <div class="mt-12 max-w-4xl mx-auto">
        <ToolShare title="Mortgage Calculator" url="https://solverspro.com/finance/mortgage-calculator" />
        <SimilarTools category="finance" currentPath="/finance/mortgage-calculator" />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const CURRENCIES = { USD: '$', EUR: '€', GBP: '£' };
  let chartInstance: any = null;

  function formatCurrency(n: number): string {
    const currencyCode = (document.getElementById('select-currency') as HTMLSelectElement)?.value || 'USD';
    return new Intl.NumberFormat('en-US', {
      style: 'currency', currency: currencyCode, minimumFractionDigits: 0, maximumFractionDigits: 0,
    }).format(n);
  }

  function updateInputPrefixes() {
    const currencyCode = (document.getElementById('select-currency') as HTMLSelectElement)?.value || 'USD';
    const symbol = CURRENCIES[currencyCode as keyof typeof CURRENCIES] || '$';
    
    ['input-homePrice', 'input-downPayment'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        const wrapper = el.closest('.relative');
        const prefixEl = wrapper?.querySelector('.prefix-el');
        if (prefixEl) prefixEl.textContent = symbol;
      }
    });
    if (!document.getElementById('results-section')?.classList.contains('hidden')) calculate();
  }

  document.getElementById('select-currency')?.addEventListener('change', (e) => {
    localStorage.setItem('preferredCurrency', (e.target as HTMLSelectElement).value);
    updateInputPrefixes();
  });

  function calculate() {
    const homePrice = parseFloat((document.getElementById('input-homePrice') as HTMLInputElement)?.value) || 0;
    const downPayment = parseFloat((document.getElementById('input-downPayment') as HTMLInputElement)?.value) || 0;
    const annualRate = parseFloat((document.getElementById('input-annualRate') as HTMLInputElement)?.value) || 0;
    const years = parseFloat((document.getElementById('input-years') as HTMLInputElement)?.value) || 0;

    const principal = homePrice - downPayment;
    if (principal <= 0 || years <= 0) return;

    const btn = document.getElementById('calculate-btn');
    btn?.setAttribute('data-loading', 'true');

    setTimeout(() => {
      const r = (annualRate / 100) / 12;
      const n = years * 12;
      
      let M = 0;
      if (r === 0) {
        M = principal / n;
      } else {
        M = principal * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
      }
      
      const totalCost = M * n;
      const totalInterest = totalCost - principal;

      document.getElementById('result-monthly')!.textContent = formatCurrency(M);
      document.getElementById('result-principal')!.textContent = formatCurrency(principal);
      document.getElementById('result-[#2dd4bf]') || (document.getElementById('result-total-interest')!.textContent = formatCurrency(totalInterest));
      document.getElementById('result-total-cost')!.textContent = formatCurrency(totalCost);

      updateChart(principal, totalInterest);

      document.getElementById('results-section')?.classList.remove('hidden');
      btn?.removeAttribute('data-loading');
      
      const saveBtn = document.getElementById('save-mortgage-btn');
      if (saveBtn) {
        saveBtn.classList.remove('hidden');
        saveBtn.onclick = () => {
          if (typeof window.saveToDashboard === 'function') {
            const success = window.saveToDashboard('Mortgage Calculator', '/finance/mortgage-calculator', {
              type: 'key-value',
              data: {
                'Monthly Payment': formatCurrency(M),
                'Principal': formatCurrency(principal),
                'Total Interest': formatCurrency(totalInterest),
                'Total Cost': formatCurrency(totalCost)
              }
            });
            if (success) {
              const textEl = saveBtn.querySelector('.btn-text');
              const iconSave = saveBtn.querySelector('.icon-save');
              const iconCheck = saveBtn.querySelector('.icon-check');
              if (textEl) textEl.textContent = 'Saved!';
              if (iconSave) iconSave.classList.add('hidden');
              if (iconCheck) iconCheck.classList.remove('hidden');
              saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              setTimeout(() => {
                if (textEl) textEl.textContent = 'Save Result';
                if (iconSave) iconSave.classList.remove('hidden');
                if (iconCheck) iconCheck.classList.add('hidden');
                saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              }, 2000);
            }
          }
        };
      }
    }, 300);
  }

  function updateChart(principal: number, interest: number) {
    const ctx = document.getElementById('mortgageChart') as HTMLCanvasElement;
    if (!ctx) return;
    
    // @ts-ignore
    if (chartInstance) chartInstance.destroy();
    
    // @ts-ignore
    chartInstance = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Principal', 'Total Interest'],
        datasets: [{
          data: [principal, interest],
          backgroundColor: ['#ffffff', '#2dd4bf'],
          borderWidth: 0,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { color: '#a1a1aa', padding: 20, font: { family: "'JetBrains Mono', monospace" } } }
        },
        cutout: '75%'
      }
    });
  }

  document.getElementById('calculator-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });

  // Init Currency Selection
  let savedCurrency = localStorage.getItem('preferredCurrency');
  if (!savedCurrency) {
    try {
      const prefs = JSON.parse(localStorage.getItem('solvers_preferences') || '{}');
      if (prefs.defaultCurrency) savedCurrency = prefs.defaultCurrency;
    } catch(e) {}
  }
  const currencySelect = document.getElementById('select-currency') as HTMLSelectElement;
  if (savedCurrency && currencySelect) currencySelect.value = savedCurrency;
  if (currencySelect) updateInputPrefixes();
</script>
