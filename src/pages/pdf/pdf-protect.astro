---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<BaseLayout
  title="Protect PDF With Password | SolversPro"
  description="Add password protection to PDF files. Set user and owner passwords with granular permissions. 100% private — runs in your browser."
>
  <Header />
  <SearchOverlay />
  <main class="flex-1 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{label:'Home',href:'/'},{label:'PDF Tools',href:'/pdf'},{label:'Protect PDF'}]} />
      <div class="mb-8 mt-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Protect PDF With Password</h1>
        <p class="text-zinc-400">Encrypt your PDF with a password. Set permissions for printing, copying and editing.</p>
      </div>

      <div class="bg-[#0d0d14] border border-white/[0.06] rounded-2xl p-8 space-y-6">
        <div id="drop-zone" class="border-2 border-dashed border-white/[0.1] rounded-xl p-10 text-center cursor-pointer hover:border-[#ff6b35]/50 hover:bg-[#ff6b35]/[0.02] transition-all">
          <div class="text-4xl mb-3">🔒</div>
          <p class="text-white font-semibold mb-1">Drop PDF here or click to browse</p>
          <p class="text-zinc-500 text-sm">PDF files only</p>
          <input type="file" id="file-input" accept=".pdf" class="hidden" />
        </div>

        <div id="file-info" class="hidden bg-[#1a1a24] border border-white/[0.06] rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📄</span>
            <div>
              <p id="file-name" class="text-white font-medium text-sm"></p>
              <p id="file-meta" class="text-zinc-500 text-xs"></p>
            </div>
          </div>
          <button id="clear-btn" class="text-zinc-500 hover:text-red-400 transition-colors text-xs">✕ Clear</button>
        </div>

        <div id="options" class="hidden space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">User Password <span class="text-zinc-600 font-normal normal-case">(to open)</span></label>
              <input type="password" id="user-password" placeholder="Enter password..." class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Owner Password <span class="text-zinc-600 font-normal normal-case">(to edit)</span></label>
              <input type="password" id="owner-password" placeholder="Enter password..." class="w-full bg-[#1a1a24] border border-white/[0.08] rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#ff6b35]" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-3">Permissions</label>
            <div class="grid grid-cols-2 gap-3">
              {['printing', 'modifying', 'copying', 'annotating'].map(perm => (
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" checked class={`perm-check accent-[#ff6b35]`} data-perm={perm} />
                  <span class="text-sm text-zinc-300 capitalize">{perm}</span>
                </label>
              ))}
            </div>
          </div>
        </div>

        <button id="protect-btn" class="hidden w-full py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">
          🔒 Protect PDF
        </button>

        <div id="status" class="hidden text-center py-3 text-zinc-400 text-sm"></div>
        <div id="download-section" class="hidden text-center">
          <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-6 mb-4">
            <div class="text-3xl mb-2">✅</div>
            <p class="text-green-400 font-semibold">PDF protected successfully!</p>
          </div>
          <a id="download-link" class="inline-flex items-center gap-2 px-8 py-3 bg-[#ff6b35] hover:bg-[#ff8c5a] text-white font-semibold rounded-xl transition-colors">
            ⬇️ Download Protected PDF
          </a>
        </div>
      </div>
      <ToolShare title="Protect PDF With Password" url="https://solverspro.com/pdf/pdf-protect" />
      <SimilarTools category="pdf" currentPath="/pdf/pdf-protect" />
    
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { PDFDocument } from 'pdf-lib';

  let pdfBytes: Uint8Array | null = null;

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info')!;
  const options = document.getElementById('options')!;
  const protectBtn = document.getElementById('protect-btn')!;
  const clearBtn = document.getElementById('clear-btn')!;
  const statusEl = document.getElementById('status')!;
  const downloadSection = document.getElementById('download-section')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;

  async function loadPdf(file: File) {
    const buffer = await file.arrayBuffer();
    pdfBytes = new Uint8Array(buffer);
    const doc = await PDFDocument.load(pdfBytes);
    document.getElementById('file-name')!.textContent = file.name;
    document.getElementById('file-meta')!.textContent = `${doc.getPageCount()} pages · ${(file.size/1024).toFixed(1)} KB`;
    fileInfo.classList.remove('hidden');
    options.classList.remove('hidden');
    protectBtn.classList.remove('hidden');
    dropZone.classList.add('hidden');
    downloadSection.classList.add('hidden');
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', async (e) => {
    e.preventDefault();
    const file = e.dataTransfer?.files[0];
    if (file?.type === 'application/pdf') await loadPdf(file);
  });
  fileInput.addEventListener('change', async () => {
    if (fileInput.files?.[0]) await loadPdf(fileInput.files[0]);
  });
  clearBtn.addEventListener('click', () => {
    pdfBytes = null; fileInput.value = '';
    fileInfo.classList.add('hidden'); options.classList.add('hidden');
    protectBtn.classList.add('hidden'); downloadSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  protectBtn.addEventListener('click', async () => {
    if (!pdfBytes) return;
    const userPw = (document.getElementById('user-password') as HTMLInputElement).value;
    const ownerPw = (document.getElementById('owner-password') as HTMLInputElement).value;
    if (!userPw) { statusEl.textContent = '⚠️ Please enter a user password.'; statusEl.classList.remove('hidden'); return; }

    statusEl.textContent = '⏳ Protecting PDF...';
    statusEl.classList.remove('hidden');
    downloadSection.classList.add('hidden');

    try {
      const doc = await PDFDocument.load(pdfBytes!);
      const checks = document.querySelectorAll('.perm-check') as NodeListOf<HTMLInputElement>;
      const perms: Record<string, boolean> = {};
      checks.forEach(c => { perms[c.dataset.perm!] = c.checked; });

      const saved = await doc.save({
        userPassword: userPw,
        ownerPassword: ownerPw || userPw + '_owner',
        permissions: {
          printing: perms['printing'] ? 'highResolution' : undefined,
          modifying: perms['modifying'],
          copying: perms['copying'],
          annotating: perms['annotating'],
        } as any
      });

      const blob = new Blob([saved], { type: 'application/pdf' });
      downloadLink.href = URL.createObjectURL(blob);
      downloadLink.download = 'protected.pdf';
      statusEl.classList.add('hidden');
      downloadSection.classList.remove('hidden');
    } catch (e) {
      statusEl.textContent = '❌ Error protecting PDF. The file may already be encrypted.';
    }
  });
</script>
