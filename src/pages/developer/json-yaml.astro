---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShare from '../../components/ToolShare.astro';
import SimilarTools from '../../components/SimilarTools.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "JSON to YAML / YAML to JSON Converter",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5/JavaScript",
  "description": "Convert between JSON and YAML formats instantly. Perfect for Kubernetes configs, CI/CD pipelines, and API specs. Free and browser-based."
};
---

<BaseLayout
  title="JSON ↔ YAML Converter | SolversPro"
  description="Convert between JSON and YAML formats instantly. Perfect for Kubernetes configs, CI/CD pipelines, and API specs. Free and browser-based."
  canonical="https://solverspro.com/developer/json-yaml"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'JSON ↔ YAML Converter' },
      ]} />

      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">📋 JSON ↔ YAML Converter</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">Convert between JSON and YAML formats instantly. Perfect for Kubernetes configs, Docker Compose files, and API specifications.</p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 w-full min-h-[500px]">
        <!-- JSON Side -->
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">JSON</h2>
            <button id="btn-to-yaml" class="px-3 py-1.5 text-xs font-semibold bg-[#2dd4bf]/20 hover:bg-[#2dd4bf]/30 text-[#2dd4bf] rounded transition-colors border border-[#2dd4bf]/30">To YAML &rarr;</button>
          </div>
          <textarea
            id="input-json"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#ff6b35] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]"
            placeholder='{"apiVersion":"v1","kind":"Service","metadata":{"name":"my-app"}}'
            spellcheck="false"
          ></textarea>
        </div>

        <!-- YAML Side -->
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex justify-between items-center bg-[#0d0d14] px-4 py-3 border border-white/[0.06] rounded-t-xl border-b-0">
            <button id="btn-to-json" class="px-3 py-1.5 text-xs font-semibold bg-[#ff6b35]/20 hover:bg-[#ff6b35]/30 text-[#ff6b35] rounded transition-colors border border-[#ff6b35]/30">&larr; To JSON</button>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">YAML</h2>
          </div>
          <textarea
            id="input-yaml"
            class="flex-1 w-full p-4 bg-[#1a1a24] border border-white/[0.06] rounded-b-xl focus:ring-1 focus:ring-[#2dd4bf] focus:outline-none font-mono text-sm text-zinc-300 resize-none min-h-[350px]"
            placeholder="apiVersion: v1&#10;kind: Service&#10;metadata:&#10;  name: my-app"
            spellcheck="false"
          ></textarea>
        </div>
      </div>

      <div id="error-msg" class="hidden mt-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-mono"></div>

      <ToolShare title="JSON ↔ YAML Converter" url="https://solverspro.com/developer/json-yaml" />
      <SimilarTools category="developer" currentPath="/developer/json-yaml" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import * as jsYaml from 'js-yaml';

  const jsonEl = document.getElementById('input-json') as HTMLTextAreaElement;
  const yamlEl = document.getElementById('input-yaml') as HTMLTextAreaElement;
  const errorEl = document.getElementById('error-msg') as HTMLDivElement;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
    setTimeout(() => errorEl.classList.add('hidden'), 5000);
  }

  document.getElementById('btn-to-yaml')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      const parsed = JSON.parse(jsonEl.value.trim());
      yamlEl.value = jsYaml.dump(parsed, { indent: 2, lineWidth: -1 });
      yamlEl.classList.add('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]');
      setTimeout(() => yamlEl.classList.remove('ring-2', 'ring-[#2dd4bf]', 'border-[#2dd4bf]'), 500);
    } catch (e: any) {
      showError('Invalid JSON: ' + e.message);
    }
  });

  document.getElementById('btn-to-json')?.addEventListener('click', () => {
    try {
      errorEl.classList.add('hidden');
      const parsed = jsYaml.load(yamlEl.value.trim());
      jsonEl.value = JSON.stringify(parsed, null, 2);
      jsonEl.classList.add('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]');
      setTimeout(() => jsonEl.classList.remove('ring-2', 'ring-[#ff6b35]', 'border-[#ff6b35]'), 500);
    } catch (e: any) {
      showError('Invalid YAML: ' + e.message);
    }
  });
</script>
