---
// src/components/ToolShare.astro
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const canonicalUrl = url.endsWith('/') ? url : `${url}/`;
const embedUrl = `${canonicalUrl}?embed=1`;
const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(title);

const iframeSnippet = `<iframe src="${embedUrl}" width="100%" height="620" style="border:1px solid #27272a;border-radius:12px;background:#0a0a0f;" loading="lazy" title="${title} — SolversPro"></iframe>\n<p style="font-size:12px;margin-top:6px;font-family:sans-serif;">Powered by <a href="${canonicalUrl}" target="_blank" rel="noopener">${title} — SolversPro</a></p>`;

const linkSnippet = `<a href="${canonicalUrl}" target="_blank" rel="noopener">${title} — SolversPro</a>`;

const shareLinks = [
  {
    id: 'copy',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>',
    color: 'text-zinc-400',
    bg: 'bg-white/[0.05]',
    hover: 'hover:bg-white/[0.1]',
    title: 'Copy link to clipboard'
  },
  {
    id: 'email',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
    color: 'text-[#3b5998]',
    bg: 'bg-[#3b5998]/10',
    hover: 'hover:bg-[#3b5998]/20',
    title: 'Share via Email',
    href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`
  },
  {
    id: 'facebook',
    icon: '<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>',
    color: 'text-[#1877F2]',
    bg: 'bg-[#1877F2]/10',
    hover: 'hover:bg-[#1877F2]/20',
    title: 'Share via Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`
  },
  {
    id: 'twitter',
    icon: '<path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>',
    color: 'text-[#1DA1F2]',
    bg: 'bg-[#1DA1F2]/10',
    hover: 'hover:bg-[#1DA1F2]/20',
    title: 'Share via X',
    href: `https://x.com/share?url=${encodedUrl}&text=${encodedTitle}`
  },
  {
    id: 'linkedin',
    icon: '<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/>',
    color: 'text-[#0077B5]',
    bg: 'bg-[#0077B5]/10',
    hover: 'hover:bg-[#0077B5]/20',
    title: 'Share via LinkedIn',
    href: `https://linkedin.com/shareArticle?url=${encodedUrl}&title=${encodedTitle}`
  },
  {
    id: 'reddit',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    color: 'text-[#FF4500]',
    bg: 'bg-[#FF4500]/10',
    hover: 'hover:bg-[#FF4500]/20',
    title: 'Share via Reddit',
    href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`
  },
  {
    id: 'whatsapp',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>',
    color: 'text-[#25D366]',
    bg: 'bg-[#25D366]/10',
    hover: 'hover:bg-[#25D366]/20',
    title: 'Share via WhatsApp',
    href: `https://wa.me/?text=${encodedTitle} ${encodedUrl}`
  }
];
---

<div class="mt-16 pt-8 border-t border-white/[0.06]">
  <h2 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
    <svg class="w-4 h-4 text-[#ff6b35]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
    Share &amp; Embed
  </h2>
  <div class="flex flex-wrap items-center gap-3">
    {shareLinks.map((link) => (
      link.href ? (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class={`w-10 h-10 flex items-center justify-center rounded-xl transition-colors ${link.bg} ${link.hover} ${link.color}`}
          title={link.title}
          aria-label={link.title}
        >
          <svg class="w-5 h-5" fill={link.id === 'copy' || link.id === 'email' || link.id === 'whatsapp' ? 'none' : 'currentColor'} stroke={link.id === 'copy' || link.id === 'email' || link.id === 'whatsapp' ? 'currentColor' : 'none'} viewBox="0 0 24 24" set:html={link.icon} />
        </a>
      ) : (
        <button
          id={`tool-share-btn-${link.id}`}
          type="button"
          class={`w-10 h-10 flex items-center justify-center rounded-xl transition-colors ${link.bg} ${link.hover} ${link.color}`}
          title={link.title}
          aria-label={link.title}
          data-url={canonicalUrl}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={link.icon} />
        </button>
      )
    ))}

    <!-- Embed on Your Website Button -->
    <button
      type="button"
      data-embed-toggle
      class="h-10 px-4 flex items-center gap-2 rounded-xl text-xs font-semibold transition-colors bg-[#2dd4bf]/10 hover:bg-[#2dd4bf]/20 text-[#2dd4bf] border border-[#2dd4bf]/20"
      title="Embed this calculator on your website or blog"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
      <span>Embed on Your Site</span>
    </button>
  </div>

  <!-- Collapsible Embed Drawer -->
  <div data-embed-drawer class="hidden mt-4 p-5 rounded-xl bg-[#0d0d14] border border-white/[0.08] space-y-4">
    <div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-white uppercase tracking-wider font-mono">1. Interactive Calculator Widget (HTML Embed)</span>
        <button
          type="button"
          data-copy-snippet={iframeSnippet}
          class="px-3 py-1 rounded-lg text-xs font-semibold bg-[#ff6b35] hover:bg-[#ff8555] text-white transition-colors"
        >
          Copy Embed Code
        </button>
      </div>
      <p class="text-xs text-zinc-400 mb-2">Paste this snippet into your blog, school portal, or website to embed the live {title}:</p>
      <pre class="p-3 rounded-lg bg-black/50 border border-white/[0.06] text-[11px] text-zinc-300 font-mono overflow-x-auto select-all">{iframeSnippet}</pre>
    </div>

    <div class="pt-3 border-t border-white/[0.06]">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-white uppercase tracking-wider font-mono">2. Direct Citation / Backlink HTML</span>
        <button
          type="button"
          data-copy-snippet={linkSnippet}
          class="px-3 py-1 rounded-lg text-xs font-semibold bg-white/[0.08] hover:bg-white/[0.15] text-white transition-colors"
        >
          Copy Link HTML
        </button>
      </div>
      <pre class="p-3 rounded-lg bg-black/50 border border-white/[0.06] text-[11px] text-zinc-300 font-mono overflow-x-auto select-all">{linkSnippet}</pre>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../utils/clipboard';

  document.querySelectorAll('[id^="tool-share-btn-copy"]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const url = button.dataset.url || window.location.href;
      
      copyToClipboard(url).then(() => {
        const originalHtml = button.innerHTML;
        button.innerHTML = '<svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(() => {
          button.innerHTML = originalHtml;
        }, 1500);
      });
    });
  });

  document.querySelectorAll('[data-embed-toggle]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const container = button.closest('div.mt-16');
      const drawer = container?.querySelector('[data-embed-drawer]');
      drawer?.classList.toggle('hidden');
    });
  });

  document.querySelectorAll('[data-copy-snippet]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const snippet = button.getAttribute('data-copy-snippet') || '';
      const originalText = button.textContent;
      copyToClipboard(snippet).then(() => {
        button.textContent = 'Copied!';
        setTimeout(() => {
          button.textContent = originalText;
        }, 1500);
      });
    });
  });
</script>
