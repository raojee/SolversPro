---
export interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FAQ[];
}

const { title = "Frequently Asked Questions", faqs } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<div class="mt-16 w-full max-w-3xl mx-auto">
  <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
    <svg class="w-6 h-6 text-[#ff6b35]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    {title}
  </h2>
  
  <div class="space-y-4">
    {faqs.map((faq, index) => (
      <details class="group border border-white/[0.06] bg-white/[0.02] rounded-xl overflow-hidden open:bg-white/[0.04] transition-all">
        <summary class="flex items-center justify-between p-4 cursor-pointer list-none text-zinc-200 font-semibold select-none group-hover:text-white">
          {faq.question}
          <span class="transition group-open:rotate-180">
            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
          </span>
        </summary>
        <div class="p-4 pt-0 text-zinc-400 text-sm leading-relaxed border-t border-white/[0.06] mt-1 pt-4">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
