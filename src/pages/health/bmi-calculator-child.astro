  // ── Standard Normal CDF (Abramowitz & Stegun approximation) ─────────────
  function normalCDF(z: number): number {
    if (z < -12) return 0;
    if (z > 12) return 1;
    const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741;
    const a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
    const sign = z < 0 ? -1 : 1;
    const x = Math.abs(z) / Math.sqrt(2);
    const t = 1.0 / (1.0 + p * x);
    const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
    return 0.5 * (1.0 + sign * y);
  }

  // ── State ────────────────────────────────────────────────────────────────
  let cHeightUnit = 'cm';
  let cWeightUnit = 'kg';

  // ── DOM refs ─────────────────────────────────────────────────────────────
  const cHeightCmGroup = document.getElementById('c-height-cm-group')!;
  const cHeightFtinGroup = document.getElementById('c-height-ftin-group')!;
  const cHeightCmInput = document.getElementById('c-input-height-cm') as HTMLInputElement;
  const cHeightFtInput = document.getElementById('c-input-height-ft') as HTMLInputElement;
  const cHeightInPartInput = document.getElementById('c-input-height-in-part') as HTMLInputElement;
  const cWeightInput = document.getElementById('c-input-weight') as HTMLInputElement;
  const cWeightSuffix = document.getElementById('c-weight-suffix')!;

  // ── Restore preferences ─────────────────────────────────────────────────
  try {
    const prefs = JSON.parse(localStorage.getItem('bmi_child_prefs') || '{}');
    if (prefs.heightUnit) cHeightUnit = prefs.heightUnit;
    if (prefs.weightUnit) cWeightUnit = prefs.weightUnit;
  } catch(e) {}

  function cGetHeightCm(): number {
    if (cHeightUnit === 'cm') {
      return parseFloat(cHeightCmInput.value) || 0;
    } else {
      const ft = parseFloat(cHeightFtInput.value) || 0;
      const inches = parseFloat(cHeightInPartInput.value) || 0;
      return (ft * 12 + inches) * 2.54;
    }
  }

  function cGetWeightKg(): number {
    const val = parseFloat(cWeightInput.value) || 0;
    return cWeightUnit === 'kg' ? val : val * 0.453592;
  }

  function cSetHeightUnit(newUnit: string) {
    const oldCm = cGetHeightCm();
    cHeightUnit = newUnit;
    cHeightCmGroup.classList.toggle('hidden', newUnit !== 'cm');
    cHeightFtinGroup.classList.toggle('hidden', newUnit !== 'ftin');
    if (oldCm > 0) {
      if (newUnit === 'cm') {
        cHeightCmInput.value = oldCm.toFixed(1);
      } else {
        const totalIn = oldCm / 2.54;
        cHeightFtInput.value = Math.floor(totalIn / 12).toString();
        cHeightInPartInput.value = (totalIn % 12).toFixed(1);
      }
    }
    document.querySelectorAll('.c-height-unit-btn').forEach(btn => {
      const isActive = (btn as HTMLElement).dataset.unit === newUnit;
      btn.classList.toggle('bg-[#ff6b35]', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('text-zinc-400', !isActive);
    });
    cSavePrefs();
  }

  function cSetWeightUnit(newUnit: string) {
    const oldKg = cGetWeightKg();
    cWeightUnit = newUnit;
    if (oldKg > 0) {
      cWeightInput.value = newUnit === 'kg' ? oldKg.toFixed(1) : (oldKg / 0.453592).toFixed(1);
    }
    cWeightSuffix.textContent = newUnit;
    document.querySelectorAll('.c-weight-unit-btn').forEach(btn => {
      const isActive = (btn as HTMLElement).dataset.unit === newUnit;
      btn.classList.toggle('bg-[#ff6b35]', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('text-zinc-400', !isActive);
    });
    cSavePrefs();
  }

  function cSavePrefs() {
    try {
      localStorage.setItem('bmi_child_prefs', JSON.stringify({ heightUnit: cHeightUnit, weightUnit: cWeightUnit }));
    } catch(e) {}
  }

  // Init
  cSetHeightUnit(cHeightUnit);
  cSetWeightUnit(cWeightUnit);

  document.querySelectorAll('.c-height-unit-btn').forEach(btn => {
    btn.addEventListener('click', () => cSetHeightUnit((btn as HTMLElement).dataset.unit!));
  });
  document.querySelectorAll('.c-weight-unit-btn').forEach(btn => {
    btn.addEventListener('click', () => cSetWeightUnit((btn as HTMLElement).dataset.unit!));
  });

  // ── Validation helpers ──────────────────────────────────────────────────
  function cShowError(id: string, msg: string) {
    const el = document.getElementById(id)!;
    el.textContent = msg;
    el.classList.remove('hidden');
  }
  function cClearError(id: string) {
    const el = document.getElementById(id)!;
    el.textContent = '';
    el.classList.add('hidden');
  }

  // ── Calculate ───────────────────────────────────────────────────────────
  function calculateChild() {
    cClearError('c-height-error');
    cClearError('c-weight-error');
    cClearError('c-age-error');
    cClearError('c-sex-error');

    const heightCm = cGetHeightCm();
    const weightKg = cGetWeightKg();
    const ageYears = parseInt((document.getElementById('c-input-age-years') as HTMLInputElement).value) || 0;
    const ageExtraMonths = parseInt((document.getElementById('c-input-age-months') as HTMLInputElement).value) || 0;
    const sexRadio = document.querySelector('input[name="childSex"]:checked') as HTMLInputElement | null;

    let valid = true;
    if (heightCm < 50 || heightCm > 220) { cShowError('c-height-error', 'Please enter a valid height.'); valid = false; }
    if (weightKg < 3 || weightKg > 200) { cShowError('c-weight-error', 'Please enter a valid weight.'); valid = false; }
    if (ageYears < 2 || ageYears > 19) { cShowError('c-age-error', 'Age must be between 2 and 19 years.'); valid = false; }
    if (!sexRadio) { cShowError('c-sex-error', 'Please select sex.'); valid = false; }
    if (!valid) return;

    const totalMonths = ageYears * 12 + ageExtraMonths;
    if (totalMonths < 24 || totalMonths > 240) {
      cShowError('c-age-error', 'Age must be between 2 years 0 months and 20 years 0 months.');
      return;
    }

    const sex = sexRadio!.value;
    const btn = document.getElementById('child-bmi-btn');
    btn?.setAttribute('data-loading', 'true');

    setTimeout(() => {
      // Step 1: Calculate BMI
      const m = heightCm / 100;
      const bmi = weightKg / (m * m);
      const bmiFormatted = bmi.toFixed(1);

      // Step 2: Look up LMS — data indexed by (month - 24), each entry is at half-month
      const lmsData = sex === 'male' ? CDC_LMS.boys : CDC_LMS.girls;
      const idx = totalMonths - 24; // 0-based index for month 24
      
      let L: number, M: number, S: number;
      if (idx >= 0 && idx < lmsData.length) {
        [L, M, S] = lmsData[idx];
      } else {
        // Clamp to boundaries
        const clamped = Math.max(0, Math.min(lmsData.length - 1, idx));
        [L, M, S] = lmsData[clamped];
      }

      // Step 3: Calculate Z-score
      let zScore: number;
      if (Math.abs(L) > 0.001) {
        zScore = (Math.pow(bmi / M, L) - 1) / (L * S);
      } else {
        zScore = Math.log(bmi / M) / S;
      }

      // Step 4: Convert Z to percentile
      const percentile = normalCDF(zScore) * 100;
      const percentileRounded = Math.round(percentile);
      const pctClamped = Math.max(1, Math.min(99, percentileRounded));

      // Step 5: Determine category
      let categoryText = '';
      let catClasses = '';
      if (pctClamped < 5) {
        categoryText = 'UNDERWEIGHT';
        catClasses = 'bg-blue-500/20 text-blue-400';
      } else if (pctClamped < 85) {
        categoryText = 'HEALTHY WEIGHT';
        catClasses = 'bg-green-500/20 text-green-400';
      } else if (pctClamped < 95) {
        categoryText = 'OVERWEIGHT';
        catClasses = 'bg-yellow-500/20 text-yellow-400';
      } else {
        categoryText = 'OBESE';
        catClasses = 'bg-red-500/20 text-red-400';
      }

      // Update UI
      document.getElementById('c-result-bmi')!.textContent = bmiFormatted;

      // Ordinal suffix
      const ordinal = (n: number) => {
        const s = ['th','st','nd','rd'];
        const v = n % 100;
        return n + (s[(v-20)%10] || s[v] || s[0]);
      };
      document.getElementById('c-result-percentile')!.textContent = ordinal(pctClamped);

      const catEl = document.getElementById('c-result-category')!;
      catEl.className = 'inline-block px-3 py-1 rounded-full font-bold text-xs tracking-wide mt-2';
      catEl.textContent = categoryText;
      catClasses.split(' ').forEach(c => catEl.classList.add(c));

      // Context sentence
      const sexLabel = sex === 'male' ? 'boy' : 'girl';
      const ageLabel = ageExtraMonths > 0
        ? `${ageYears}-year, ${ageExtraMonths}-month-old`
        : `${ageYears}-year-old`;
      document.getElementById('c-result-context')!.textContent =
        `For a ${ageLabel} ${sexLabel}, a BMI of ${bmiFormatted} is at the ${ordinal(pctClamped)} percentile.`;

      // Percentile bar pointer
      const pctPos = Math.min(100, Math.max(0, pctClamped));
      const pointer = document.getElementById('c-gauge-pointer')!;
      pointer.style.left = `calc(${pctPos}% - 8px)`;

      document.getElementById('c-results-section')?.classList.remove('hidden');
      document.getElementById('c-results-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      btn?.removeAttribute('data-loading');

      // Save button
      const saveBtn = document.getElementById('save-child-bmi-btn');
      if (saveBtn) {
        saveBtn.classList.remove('hidden');
        saveBtn.onclick = () => {
          if (typeof (window as any).saveToDashboard === 'function') {
            const success = (window as any).saveToDashboard('Child BMI Calculator', '/health/bmi-calculator-child', {
              type: 'key-value',
              data: {
                'BMI': bmiFormatted,
                'Percentile': ordinal(pctClamped),
                'Category': categoryText,
                'Age': `${ageYears}y ${ageExtraMonths}m`,
                'Sex': sex === 'male' ? 'Male' : 'Female'
              }
            });
            if (success) {
              const textEl = saveBtn.querySelector('.btn-text');
              const iconSave = saveBtn.querySelector('.icon-save');
              const iconCheck = saveBtn.querySelector('.icon-check');
              if (textEl) textEl.textContent = 'Saved!';
              if (iconSave) iconSave.classList.add('hidden');
              if (iconCheck) iconCheck.classList.remove('hidden');
              saveBtn.classList.add('bg-green-500/20', 'text-green-400', 'border-green-500/30');
              saveBtn.classList.remove('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              setTimeout(() => {
                if (textEl) textEl.textContent = 'Save Result';
                if (iconSave) iconSave.classList.remove('hidden');
                if (iconCheck) iconCheck.classList.add('hidden');
                saveBtn.classList.remove('bg-green-500/20', 'text-green-400', 'border-green-500/30');
                saveBtn.classList.add('bg-white/[0.05]', 'text-zinc-300', 'border-white/[0.1]');
              }, 2000);
            }
          }
        };
      }
    }, 300);
  }

  document.getElementById('child-bmi-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculateChild();
  });
</script>
