---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';

const posts = [
  {
    title: "50+ Free Online Tools in One Place: Discover SolversPro's Comprehensive Toolkit",
    description: "In a digital landscape cluttered with single-purpose websites, ad-heavy interfaces, and tools locked behind paywalls, finding reliable utilities shouldn't feel like a treasure hunt.",
    date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    category: "Tools & Resources",
    readTime: "4 min read",
    href: "/blog/50-free-online-tools-in-one-place"
  }
];
---

<BaseLayout
  title="Blog | SolversPro"
  description="Read the latest articles, guides, and updates from SolversPro. Discover how to make the most of our free online tools."
>
  <Header />
  <SearchOverlay />
  
  <main class="flex-1 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">SolversPro Blog</h1>
        <p class="text-lg text-zinc-400 max-w-2xl">Guides, updates, and deep dives into making the most of our free online tools.</p>
      </div>

      <div class="grid gap-6">
        {posts.map((post) => (
          <a href={post.href} class="block group">
            <article class="p-6 bg-white/[0.02] border border-white/[0.06] rounded-2xl transition-all hover:bg-white/[0.04] hover:border-[#ff6b35]/30">
              <div class="flex items-center gap-4 text-xs font-semibold uppercase tracking-wider mb-4">
                <span class="text-[#ff6b35]">{post.category}</span>
                <span class="text-zinc-600">•</span>
                <span class="text-zinc-500">{post.date}</span>
                <span class="text-zinc-600">•</span>
                <span class="text-zinc-500">{post.readTime}</span>
              </div>
              
              <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-[#ff6b35] transition-colors">
                {post.title}
              </h2>
              
              <p class="text-zinc-400 leading-relaxed mb-4">
                {post.description}
              </p>
              
              <div class="inline-flex items-center gap-2 text-sm font-semibold text-[#2dd4bf] group-hover:text-[#5eead4] transition-colors">
                Read Article
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
