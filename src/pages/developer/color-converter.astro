---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Color Code Converter",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Convert color codes between HEX, RGB, and HSL formats instantly. Perfect for web developers and designers. Free, fast, and runs entirely in your browser.",
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "ratingCount": "89" }
};
---

<BaseLayout
  title="Color Converter | SolversPro"
  description="Convert color codes between HEX, RGB, and HSL formats instantly. Perfect for web developers and designers. Free, fast, and runs entirely in your browser."
  canonical="https://solverspro.com/developer/color-converter"
  schema={schema}
>
  <Header />
  <SearchOverlay />

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Developer Tools', href: '/developer' },
        { label: 'Color Converter' },
      ]} />
      <div class="mb-10 mt-4">
        <h1 class="text-4xl font-bold text-white mb-4">Color Converter</h1>
        <p class="text-zinc-400 text-lg max-w-2xl">Convert color formats instantly between HEX, RGB, and HSL.</p>
      </div>

      <div class="max-w-2xl mx-auto bg-white/[0.02] border border-white/[0.06] rounded-xl p-6 md:p-8 shadow-sm mb-8 relative overflow-hidden">
        
        <div id="color-preview" class="absolute top-0 left-0 w-full h-2 bg-[#ff6b35] transition-colors duration-300"></div>

        <div class="space-y-6 mt-4">
          <div>
            <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400">HEX Code</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-zinc-500 font-mono">#</span>
              <input type="text" id="input-hex" class="w-full bg-[#0d0d14] border border-white/[0.1] text-white rounded-md py-3 pl-8 pr-4 font-mono focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] transition-colors" placeholder="ff6b35" />
            </div>
          </div>

          <div>
            <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400">RGB</label>
            <input type="text" id="input-rgb" class="w-full bg-[#0d0d14] border border-white/[0.1] text-white rounded-md py-3 px-4 font-mono focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] transition-colors" placeholder="rgb(255, 107, 53)" />
          </div>

          <div>
            <label class="block mb-2 text-xs font-semibold uppercase tracking-widest text-zinc-400">HSL</label>
            <input type="text" id="input-hsl" class="w-full bg-[#0d0d14] border border-white/[0.1] text-white rounded-md py-3 px-4 font-mono focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] transition-colors" placeholder="hsl(16, 100%, 60%)" />
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/[0.06] text-center">
          <input type="color" id="color-picker" value="#ff6b35" class="w-16 h-16 rounded cursor-pointer bg-transparent border-0 p-0" />
          <p class="text-xs text-zinc-500 mt-2">Or use the color picker</p>
        </div>

      </div>

    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const hexInput = document.getElementById('input-hex') as HTMLInputElement;
  const rgbInput = document.getElementById('input-rgb') as HTMLInputElement;
  const hslInput = document.getElementById('input-hsl') as HTMLInputElement;
  const picker = document.getElementById('color-picker') as HTMLInputElement;
  const preview = document.getElementById('color-preview');

  let activeInput = '';

  function hexToRgb(hex: string) {
    hex = hex.replace(/^#/, '');
    if (hex.length === 3) hex = hex.split('').map(x => x + x).join('');
    const num = parseInt(hex, 16);
    return [num >> 16, (num >> 8) & 255, num & 255];
  }

  function rgbToHex(r: number, g: number, b: number) {
    return ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toLowerCase();
  }

  function rgbToHsl(r: number, g: number, b: number) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
  }

  function hslToRgb(h: number, s: number, l: number) {
    s /= 100; l /= 100;
    const k = (n: number) => (n + h / 30) % 12;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
    return [Math.round(255 * f(0)), Math.round(255 * f(8)), Math.round(255 * f(4))];
  }

  function updateFromHex(hex: string) {
    const cleanHex = hex.replace(/[^0-9a-fA-F]/g, '');
    if (cleanHex.length === 3 || cleanHex.length === 6) {
      const [r, g, b] = hexToRgb(cleanHex);
      if (activeInput !== 'rgb') rgbInput.value = `rgb(${r}, ${g}, ${b})`;
      const [h, s, l] = rgbToHsl(r, g, b);
      if (activeInput !== 'hsl') hslInput.value = `hsl(${h}, ${s}%, ${l}%)`;
      updatePreview(cleanHex.length === 3 ? cleanHex.split('').map(x=>x+x).join('') : cleanHex);
    }
  }

  function updateFromRgb(rgbStr: string) {
    const match = rgbStr.match(/\d+/g);
    if (match && match.length >= 3) {
      let r = Math.min(255, Math.max(0, parseInt(match[0])));
      let g = Math.min(255, Math.max(0, parseInt(match[1])));
      let b = Math.min(255, Math.max(0, parseInt(match[2])));
      const hex = rgbToHex(r, g, b);
      if (activeInput !== 'hex') hexInput.value = hex;
      const [h, s, l] = rgbToHsl(r, g, b);
      if (activeInput !== 'hsl') hslInput.value = `hsl(${h}, ${s}%, ${l}%)`;
      updatePreview(hex);
    }
  }

  function updateFromHsl(hslStr: string) {
    const match = hslStr.match(/\d+/g);
    if (match && match.length >= 3) {
      let h = Math.min(360, Math.max(0, parseInt(match[0])));
      let s = Math.min(100, Math.max(0, parseInt(match[1])));
      let l = Math.min(100, Math.max(0, parseInt(match[2])));
      const [r, g, b] = hslToRgb(h, s, l);
      if (activeInput !== 'rgb') rgbInput.value = `rgb(${r}, ${g}, ${b})`;
      const hex = rgbToHex(r, g, b);
      if (activeInput !== 'hex') hexInput.value = hex;
      updatePreview(hex);
    }
  }

  function updatePreview(hex: string) {
    const fullHex = `#${hex}`;
    if (preview) preview.style.backgroundColor = fullHex;
    if (picker && activeInput !== 'picker') picker.value = fullHex;
  }

  hexInput?.addEventListener('input', (e) => {
    activeInput = 'hex';
    updateFromHex((e.target as HTMLInputElement).value);
  });

  rgbInput?.addEventListener('input', (e) => {
    activeInput = 'rgb';
    updateFromRgb((e.target as HTMLInputElement).value);
  });

  hslInput?.addEventListener('input', (e) => {
    activeInput = 'hsl';
    updateFromHsl((e.target as HTMLInputElement).value);
  });

  picker?.addEventListener('input', (e) => {
    activeInput = 'picker';
    const hex = (e.target as HTMLInputElement).value;
    hexInput.value = hex.replace('#', '');
    updateFromHex(hexInput.value);
  });
</script>
